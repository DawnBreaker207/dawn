---
import PostCardGridView from '@/components/blog/PostCardGridView.astro';
import PostRowView from '@/components/blog/PostRowView.astro';
import Pagination from '@/components/blog/Pagination.astro';
import type { Post } from '@/lib/utils/blog';

interface Props {
  title: string;
  subtitle?: string;
  posts: Post[];
  pagination?: { currentPage: number; totalPages: number; basePath: string };
  showEmpty?: boolean;
}

const {
  title,
  subtitle = 'Articles, tutorials, and engineering notes.',
  posts,
  pagination,
  showEmpty = true,
} = Astro.props;
---

<div class="divide-y divide-(--border)">
  <header class="space-y-5 pt-1 pb-7">
    <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-sm text-(--fg-faint)">
      <div class="flex items-center gap-2">
        <span class="inline-block size-2 rounded-full bg-(--accent)"></span>
        <span class="text-(--fg)">~/dawn/{pagination?.basePath || 'blog'}</span>
        <span class="text-(--border)">·</span>
        <span>{posts.length} posts</span>
      </div>
      <a href="/topics" class="text-(--fg-dim) no-underline hover:text-(--accent)">
        /topics →
      </a>
    </div>

    <div class="space-y-3">
      <h1 class="m-0 bg-gradient-to-r from-rose-600 via-pink-600 to-amber-500 bg-clip-text text-transparent text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight dark:from-rose-400 dark:via-pink-400 dark:to-amber-300">
        {title}
      </h1>
      <p class="m-0 max-w-2xl border-l-2 border-(--accent) pl-3.5 text-base sm:text-lg leading-relaxed text-(--fg-dim)">
        {subtitle}
      </p>
    </div>

    <div class="flex flex-col gap-3 pt-1 sm:flex-row sm:items-center sm:justify-between">
      <div class="relative flex-1 max-w-md">
        <label>
          <span class="sr-only">Search articles</span>
          <input
            aria-label="Search articles"
            type="text"
            data-blog-search
            data-umami-event="blog-search-input"
            placeholder="Search articles..."
            class="focus:border-(--accent) block w-full rounded-lg border border-(--border) bg-(--bg-alt) px-3.5 py-2 pr-10 text-sm text-(--fg) placeholder:text-(--fg-faint) outline-none"
          />
        </label>
        <svg
          class="pointer-events-none absolute top-2.5 right-3 size-4 text-(--fg-faint)"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
          />
        </svg>
      </div>

      <div
        class="flex shrink-0 self-start sm:self-auto items-center gap-0.5 rounded-lg border border-(--border) bg-(--bg-alt) p-0.5 font-mono text-xs"
        role="group"
        aria-label="View mode"
      >
        <button
          type="button"
          data-view-toggle="grid"
          data-umami-event="view-grid"
          title="Grid view"
          aria-pressed="true"
          aria-label="Grid view"
          class="cursor-pointer rounded-md px-2.5 py-1.5 text-(--fg-dim) transition-colors hover:text-(--fg) aria-pressed:bg-(--bg) aria-pressed:text-(--accent)"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7" />
            <rect x="14" y="3" width="7" height="7" />
            <rect x="14" y="14" width="7" height="7" />
            <rect x="3" y="14" width="7" height="7" />
          </svg>
        </button>
        <button
          type="button"
          data-view-toggle="list"
          data-umami-event="view-list"
          title="List view"
          aria-pressed="false"
          aria-label="List view"
          class="cursor-pointer rounded-md px-2.5 py-1.5 text-(--fg-dim) transition-colors hover:text-(--fg) aria-pressed:bg-(--bg) aria-pressed:text-(--accent)"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="8" x2="21" y1="6" y2="6" />
            <line x1="8" x2="21" y1="12" y2="12" />
            <line x1="8" x2="21" y1="18" y2="18" />
            <line x1="3" x2="3.01" y1="6" y2="6" />
            <line x1="3" x2="3.01" y1="12" y2="12" />
            <line x1="3" x2="3.01" y1="18" y2="18" />
          </svg>
        </button>
      </div>
    </div>
  </header>

  {!posts.length && showEmpty ? (
    <div class="py-10 text-sm text-(--fg-dim)">No posts found.</div>
  ) : (
    <div data-post-list>
      <div
        data-view="grid"
        class="grid grid-cols-1 gap-6 py-8 md:grid-cols-2 xl:grid-cols-3"
      >
        {posts.map((post) => (
          <div
            data-search-item
            data-title={post.data.title}
            data-tags={post.data.tags.join(' ')}
            data-summary={post.data.summary ?? ''}
          >
            <PostCardGridView post={post} />
          </div>
        ))}
      </div>
      <div data-view="list" class="hidden divide-y divide-(--border) py-4">
        {posts.map((post) => (
          <div
            data-search-item
            data-title={post.data.title}
            data-tags={post.data.tags.join(' ')}
            data-summary={post.data.summary ?? ''}
          >
            <PostRowView post={post} />
          </div>
        ))}
      </div>
    </div>
  )}
</div>

<script is:inline>
  (function () {
    var mode = localStorage.getItem('view-mode');
    if (mode === 'grid' || mode === 'list') {
      document.querySelectorAll('[data-view-toggle]').forEach(function (b) {
        b.setAttribute('aria-pressed', String(b.dataset.viewToggle === mode));
      });
      document.querySelectorAll('[data-view]').forEach(function (v) {
        v.classList.toggle('hidden', v.dataset.view !== mode);
      });
    }
  })();
</script>

{pagination && pagination.totalPages > 1 && (
  <Pagination basePath={pagination.basePath} currentPage={pagination.currentPage} totalPages={pagination.totalPages} />
)}