---
import PostCardGridView from '@/components/blog/PostCardGridView.astro';
import Pagination from '@/components/blog/Pagination.astro';
import type { Post } from '@/lib/utils/blog';

interface Props {
  title: string;
  posts: Post[];
  pagination?: { currentPage: number; totalPages: number; basePath: string };
  showEmpty?: boolean;
}

const { title, posts, pagination, showEmpty = true } = Astro.props;
---

<div class="divide-y divide-gray-200 dark:divide-gray-700">
  <div class="space-y-2 pt-6 pb-8 md:space-y-5">
    <h1 class="text-3xl leading-9 font-extrabold tracking-tight text-gray-900 sm:text-4xl sm:leading-10 md:text-6xl md:leading-14 dark:text-gray-100">
      {title}
    </h1>
    <div class="relative max-w-lg">
      <label>
        <span class="sr-only">Search articles</span>
        <input
          aria-label="Search articles"
          type="text"
          data-blog-search
          placeholder="Search articles"
          class="focus:border-primary-500 focus:ring-primary-500 block w-full rounded-md border border-gray-300 bg-white px-4 py-2 text-gray-900 dark:border-gray-900 dark:bg-gray-800 dark:text-gray-100"
        />
      </label>
      <svg
        class="absolute top-3 right-3 h-5 w-5 text-gray-400 dark:text-gray-300"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>
  </div>

  {!posts.length && showEmpty ? (
    <div class="py-10">No posts found</div>
  ) : (
    <div data-post-list class="grid grid-cols-1 gap-x-8 py-10 md:gap-y-16 lg:grid-cols-2 xl:grid-cols-3">
      {posts.map((post) => (
        <div
          data-search-item
          data-title={post.data.title}
          data-tags={post.data.tags.join(' ')}
          data-summary={post.data.summary ?? ''}
        >
          <PostCardGridView post={post} />
        </div>
      ))}
    </div>
  )}
</div>
{pagination && pagination.totalPages > 1 && (
  <Pagination basePath={pagination.basePath} currentPage={pagination.currentPage} totalPages={pagination.totalPages} />
)}
