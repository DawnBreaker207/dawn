---
import PageTitle from '@/components/ui/PageTitle.astro';
import ScrollTopAndComment from '@/components/ui/ScrollTopAndComment.astro';
import BlogTags from '@/components/blog/BlogTags.astro';
import BlogMeta from '@/components/blog/BlogMeta.astro';
import TableOfContents from '@/components/blog/TableOfContents.astro';
import PostRowView from '@/components/blog/PostRowView.astro';
import Reactions from '@/components/blog/Reactions.astro';
import BlogNav from '@/components/blog/BlogNav.astro';
import { LABS, type LabEntry } from '@/data/labs';
import type { Post } from '@/lib/utils/blog';
import { GISCUS_ENABLED, SITE } from '@/lib/site';

interface Props {
  title: string;
  tags: string[];
  date: Date;
  slug: string;
  minutes: number;
  toc: { value: string; url: string; depth: number }[];
  next?: { path: string; title: string };
  prev?: { path: string; title: string };
  related?: Post[];
}

const { title, tags, date, slug, minutes, toc, next, prev, related } = Astro.props;

const LAB_KEYWORD_MAP: Array<{ keywords: RegExp; href: string }> = [
  { keywords: /microservice|saga|distributed/i, href: '/lab/microservices' },
  { keywords: /jdbc|sql|postgres|mysql|database|query/i, href: '/lab/sql' },
  { keywords: /java|spring|jvm|backend/i, href: '/lab/java' },
  { keywords: /angular|frontend|rxjs|signal/i, href: '/lab/angular' },
  { keywords: /\bgit\b|branch|rebase/i, href: '/lab/git' },
  { keywords: /devops|ci\/cd|gitops|pipeline/i, href: '/lab/devops' },
  { keywords: /k8s|kubernetes|docker|container/i, href: '/lab/k8s' },
  { keywords: /network|tcp|tls|http|dns|proxy/i, href: '/lab/foundations' },
  { keywords: /\bai\b|agent|llm/i, href: '/lab/ai-agent-architecture' },
];

const searchHaystack = `${title} ${slug} ${tags.join(' ')}`;
const matchedHrefs = Array.from(
  new Set(LAB_KEYWORD_MAP.filter((m) => m.keywords.test(searchHaystack)).map((m) => m.href))
);
if (matchedHrefs.length === 0) {
  matchedHrefs.push('/lab/architecture');
}
const relatedLabs: LabEntry[] = matchedHrefs
  .map((href) => LABS.find((l) => l.href === href))
  .filter((l): l is LabEntry => Boolean(l))
  .slice(0, 2);

const giscusConfig = JSON.stringify({
  'data-repo': SITE.comments.giscusConfig.repo,
  'data-repo-id': SITE.comments.giscusConfig.repositoryId,
  'data-category': SITE.comments.giscusConfig.category,
  'data-category-id': SITE.comments.giscusConfig.categoryId,
  'data-mapping': SITE.comments.giscusConfig.mapping,
  'data-reactions-enabled': SITE.comments.giscusConfig.reactions,
  'data-emit-metadata': SITE.comments.giscusConfig.metadata,
  'data-theme': SITE.comments.giscusConfig.theme,
  'data-lang': 'en',
});
---

<section class="mx-auto max-w-3xl px-4 sm:px-6 xl:max-w-5xl xl:px-0" data-post-page>
  <ScrollTopAndComment />

  <article>
    <header>
      <div class="dark:border-gray space-y-1 border-b border-gray-200 pb-10">
        <div class="space-y-6">
          <PageTitle>{title}</PageTitle>
          <BlogTags tags={tags} />
          <dl>
            <div>
              <dt class="sr-only">Published on</dt>
              <BlogMeta date={date} slug={slug} minutes={minutes} />
            </div>
          </dl>
          <!-- GitLens Style Inline Blame & Source Link -->
          <div class="mt-2.5 flex flex-wrap items-center justify-between gap-2 font-mono text-xs text-(--fg-faint) border-t border-(--border)/60 pt-2.5">
            <div class="flex flex-wrap items-center gap-2">
              <span class="inline-flex items-center gap-1 text-(--accent)">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="6" y1="3" x2="6" y2="15"></line>
                  <circle cx="18" cy="6" r="3"></circle>
                  <circle cx="6" cy="18" r="3"></circle>
                  <path d="M18 9a9 9 0 0 1-9 9"></path>
                </svg>
                <span>main</span>
              </span>
              <span>•</span>
              <span>Tung Anh (Dawn)</span>
              <span>•</span>
              <a
                href={`https://github.com/DawnBreaker207/dawn/blob/main/data/blog/${slug}.mdx`}
                target="_blank"
                rel="noopener noreferrer"
                data-track-event="post-view-source"
                class="inline-flex items-center gap-1 hover:text-(--accent) underline underline-offset-2 transition-colors"
                title="Open source file on GitHub"
              >
                <span>Open in GitHub</span>
                <span>↗</span>
              </a>
            </div>

            <button
              type="button"
              id="btn-article-zen"
              data-track-event="article-zen-toggle"
              class="inline-flex items-center gap-1.5 rounded-md border border-(--border) bg-(--bg-alt) px-2.5 py-1 text-xs text-(--fg-dim) hover:text-(--fg) hover:border-(--accent) cursor-pointer select-none transition-colors"
              title="Chế độ đọc toàn màn hình tập trung (Phím tắt: Z)"
              aria-label="Bật chế độ Zen Mode"
            >
              <span aria-hidden="true">📖</span>
              <span>Zen Mode</span>
              <kbd class="hidden sm:inline rounded bg-(--bg) border border-(--border) px-1 py-0.2 text-[9px] text-(--fg-faint)">Z</kbd>
            </button>
          </div>
        </div>
      </div>
    </header>

    <main class="grid grid-cols-1 gap-12 pt-8 lg:grid-cols-12 lg:pt-10">
      <div class="divide-y divide-gray-200 lg:col-span-8 xl:col-span-9 dark:divide-gray-700">
        <div class="prose lg:prose-lg max-w-none lg:pb-8">
          <slot />
        </div>
      </div>

      <div class="hidden lg:col-span-4 lg:block xl:col-span-3">
        <div class="space-y-4 divide-y divide-gray-200 lg:sticky lg:top-16 dark:divide-gray-700">
          <TableOfContents toc={toc} />
          <Reactions class="pt-6" slug={slug} />
        </div>
      </div>
    </main>

    <footer>
      <BlogNav next={next} prev={prev} />

      {relatedLabs.length > 0 && (
        <section class="mt-10 border-t border-(--border) pt-6" aria-label="Interactive labs">
          <div class="mb-3 flex items-baseline justify-between gap-2">
            <h2 class="m-0 font-mono text-xs sm:text-sm font-semibold uppercase tracking-[0.12em] text-(--accent)">
              Try the Interactive Lab
            </h2>
            <a href="/lab" class="font-mono text-xs sm:text-sm text-(--fg-faint) hover:text-(--accent) no-underline">
              All labs →
            </a>
          </div>
          <div class={`grid grid-cols-1 gap-3 ${relatedLabs.length > 1 ? 'sm:grid-cols-2' : ''}`}>
            {relatedLabs.map((lab) => (
              <a
                href={lab.href}
                data-track-event="post-related-lab"
                class="group flex items-center justify-between gap-4 rounded-xl border border-(--border) bg-(--bg-alt) p-4 no-underline transition-colors hover:border-(--accent)"
              >
                <div class="min-w-0 space-y-1">
                  <div class="font-mono text-xs text-(--fg-faint)">{lab.tag}</div>
                  <div class="text-base font-bold text-(--fg) group-hover:text-(--accent) leading-snug">
                    {lab.title}
                  </div>
                  <p class="m-0 line-clamp-2 text-xs sm:text-sm text-(--fg-dim) leading-relaxed">
                    {lab.intro}
                  </p>
                </div>
                <span class="shrink-0 font-mono text-xs sm:text-sm text-(--fg-dim) group-hover:text-(--accent)">
                  ▶ Launch
                </span>
              </a>
            ))}
          </div>
        </section>
      )}

      {related && related.length > 0 && (
        <section class="mt-12 border-t border-(--border) pt-6" aria-label="Related posts">
          <h2 class="mb-2 font-mono text-sm tracking-wide uppercase text-(--fg-dim)">Related posts</h2>
          {related.map((p) => <PostRowView post={p} />)}
        </section>
      )}

      {GISCUS_ENABLED && (
        <div class="pt-6 pb-6 text-center text-gray-700 dark:text-gray-300" id="comment" data-giscus>
          <script is:inline type="application/json" data-giscus-config set:html={giscusConfig}></script>
        </div>
      )}
    </footer>
  </article>
</section>
