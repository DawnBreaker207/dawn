---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ChapterPicker from '@/components/lab/architecture/ChapterPicker.astro';
import SceneRenderer from '@/components/lab/architecture/SceneRenderer';
import SimulationWorkbench from '@/components/lab/architecture/SimulationWorkbench.astro';
import '@/styles/simulation.css';
import '@/styles/lab-architecture.css';
import { ALL_SCENES } from '@/data/scenes';
import { CURRICULUM_MODULES, getLessonHref } from '@/data/curriculum';
import type { Lesson } from '@/lib/simulator/types';

export const prerender = true;

interface Props {
  title: string;
  description: string;
  lessonId: string;
  trackId?: string;
  moduleId?: string;
}

const { title, description, lessonId, trackId, moduleId } = Astro.props;

const labLesson = ALL_SCENES[lessonId] as unknown as Lesson;
const scenes = labLesson?.steps?.map((s) => s.scene) ?? [];
// A lesson can be reachable from several URLs (e.g. /lab/angular and
// /lab/angular-flow); the canonical one is the URL the site links to.
const canonicalPath = getLessonHref(lessonId);
// build-og.mjs renders a social card for every curriculum lesson.
const ogImage = CURRICULUM_MODULES.some((m) => m.lessons.some((l) => l.id === lessonId)) ? `lab-${lessonId}` : undefined;
---

<BaseLayout title={title} description={description} fullBleed={true} canonicalPath={canonicalPath} ogImage={ogImage}>
  <div slot="topbar-actions" class="topbar-lab-controls">
    <ChapterPicker currentLessonId={lessonId} trackId={trackId} moduleId={moduleId} />
  </div>

  <div id="sim-view" class="sim-window is-embedded sim-view-container w-full h-full flex flex-col flex-1 min-h-0">
    <SimulationWorkbench lesson={labLesson!}>
      <SceneRenderer slot="canvas" lessonId={lessonId} scenes={scenes} client:load />
    </SimulationWorkbench>
  </div>
</BaseLayout>

<style>
  .topbar-lab-controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }
</style>

<script>
  const getLayout = (w: number, h: number) =>
    w >= 860 ? 'desktop' : 'stack';

  function updateSimLayout() {
    const simView = document.getElementById('sim-view');
    const w = simView && simView.clientWidth > 0 ? simView.clientWidth : window.innerWidth;
    const h = simView && simView.clientHeight > 0 ? simView.clientHeight : window.innerHeight;
    document.documentElement.dataset.layout = getLayout(w, h);
  }

  function setupLabPage() {
    // Only default to hidden if user hasn't explicitly opened the rail
    const userRailPref = localStorage.getItem('dawn:railHidden');
    if (userRailPref === null) {
      document.documentElement.setAttribute('data-rail', 'hidden');
      localStorage.setItem('dawn:railHidden', 'hidden');
    } else if (userRailPref === 'false') {
      document.documentElement.removeAttribute('data-rail');
    } else {
      document.documentElement.setAttribute('data-rail', 'hidden');
    }

    // Restore mobile panel state if user opened it
    const savedMobile = sessionStorage.getItem('dawn:mobilePanel');
    if (savedMobile) {
      const shell = document.getElementById('studio-shell');
      if (shell) shell.dataset.mobilePanel = savedMobile;
    }

    updateSimLayout();
    window.addEventListener('resize', updateSimLayout);

    const currentLab = window.location.pathname.replace('/lab/', '').replace(/\/$/, '') || 'architecture';
    window.umami?.track('lab-view', {
      lab: currentLab,
      title: document.title || '',
      url: window.location.pathname,
    });
  }

  setupLabPage();
  document.addEventListener('astro:page-load', setupLabPage);
  document.addEventListener('astro:before-swap', (e: any) => {
    window.removeEventListener('resize', updateSimLayout);
    document.documentElement.removeAttribute('data-layout');
    // Preserve rail attribute for incoming page based on user preference
    const userRailPref = localStorage.getItem('dawn:railHidden');
    const newDoc = e.newDocument || e.detail?.newDocument;
    if (newDoc?.documentElement) {
      if (userRailPref === 'false') {
        newDoc.documentElement.removeAttribute('data-rail');
      } else {
        newDoc.documentElement.setAttribute('data-rail', 'hidden');
      }
      const savedMobile = sessionStorage.getItem('dawn:mobilePanel');
      const newShell = newDoc.getElementById('studio-shell');
      if (savedMobile && newShell) {
        newShell.dataset.mobilePanel = savedMobile;
      }
    }
  });
</script>
