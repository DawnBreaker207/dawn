---
import Link from '@/components/ui/Link.astro';
import Tag from '@/components/ui/Tag.astro';
import Pagination from '@/components/blog/Pagination.astro';
import { slugify } from '@/lib/utils/blog';
import { formatDate } from '@/lib/site';
import type { Post } from '@/lib/utils/blog';

interface Props {
  title: string;
  posts: Post[];
  sortedTags: { tag: string; count: number }[];
  activeTag: string;
  pagination?: { currentPage: number; totalPages: number; basePath: string };
}

const { title, posts, sortedTags, activeTag, pagination } = Astro.props;
---

<div>
  <div class="pt-6 pb-6">
    <h1 class="text-3xl leading-9 font-extrabold tracking-tight text-gray-900 sm:hidden sm:text-4xl sm:leading-10 md:text-6xl md:leading-14 dark:text-gray-100">
      {title}
    </h1>
  </div>
  <div class="flex sm:space-x-24">
    <div class="hidden h-full max-h-screen max-w-[280px] min-w-[280px] flex-wrap overflow-auto rounded bg-gray-50 pt-5 shadow-md sm:flex dark:bg-gray-900/70 dark:shadow-gray-800/40">
      <div class="px-6 py-4">
        <Link
          href="/blog"
          class="hover:text-primary-500 dark:hover:text-primary-500 font-bold text-gray-700 uppercase dark:text-gray-300"
        >
          All Posts
        </Link>
        <ul>
          {sortedTags.map(({ tag: t, count }) => (
            <li class="my-3">
              {slugify(t) === activeTag ? (
                <h3 class="text-primary-500 inline px-3 py-2 text-sm font-bold uppercase">
                  {`${slugify(t)} (${count})`}
                </h3>
              ) : (
                <Link
                  href={`/tags/${slugify(t)}`}
                  class="hover:text-primary-500 dark:hover:text-primary-500 px-3 py-2 text-sm font-medium text-gray-500 uppercase dark:text-gray-300"
                  aria-label={`View posts tagged ${slugify(t)}`}
                >
                  {`${slugify(t)} (${count})`}
                </Link>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div>
      <ul>
        {posts.map((post) => (
          <li class="py-5">
            <article class="flex flex-col space-y-2 xl:space-y-0">
              <dl>
                <dt class="sr-only">Published on</dt>
                <dd class="text-base leading-6 font-medium text-gray-500 dark:text-gray-400">
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                </dd>
              </dl>
              <div class="space-y-3">
                <div>
                  <h2 class="text-2xl leading-8 font-bold tracking-tight">
                    <Link href={`/blog/${post.id}`} class="text-gray-900 dark:text-gray-100">
                      {post.data.title}
                    </Link>
                  </h2>
                  <div class="flex flex-wrap">
                    <Tag tags={post.data.tags} />
                  </div>
                </div>
                <div class="prose max-w-none text-gray-500 dark:text-gray-400">
                  {post.data.summary}
                </div>
              </div>
            </article>
          </li>
        ))}
      </ul>
      {pagination && pagination.totalPages > 1 && (
        <Pagination basePath={pagination.basePath} currentPage={pagination.currentPage} totalPages={pagination.totalPages} />
      )}
    </div>
  </div>
</div>
