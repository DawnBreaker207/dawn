---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/project/ProjectCard.astro';
import { slugify } from '@/lib/utils/blog';
import projectsData from '@/data/projectsData.json';
import { fetchRepoData, type GithubRepository } from '@/lib/runtime/github';

export const prerender = true;

type Project = {
  type: 'work' | 'self';
  title: string;
  description?: string;
  imgSrc: string;
  url?: string;
  repo?: string | GithubRepository | null;
  builtWith: string[];
};

const projectList = projectsData as Project[];

const projects = await Promise.all(
  projectList.map(async (p) =>
    typeof p.repo === 'string' ? { ...p, repo: await fetchRepoData(p.repo) } : p
  )
);

const groups = [
  { title: 'Work', note: 'commercial / professional', items: projects.filter(({ type }) => type === 'work') },
  { title: 'Side projects', note: 'open-source / personal', items: projects.filter(({ type }) => type === 'self') },
];
---

<BaseLayout
  title="Projects"
  description="Explore commercial software and open-source side projects built by Tung Anh (Dawn) with Java, TypeScript, Spring Boot, and modern web frameworks."
>
  <header class="mb-9 space-y-5 border-b border-(--border) pt-1 pb-7">
    <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-sm text-(--fg-faint)">
      <div class="flex items-center gap-2">
        <span class="inline-block size-2 rounded-full bg-(--accent)"></span>
        <span class="text-(--fg)">~/dawn/projects.astro</span>
      </div>
      <a href="/lab" class="text-(--fg-dim) no-underline hover:text-(--accent)">
        /lab →
      </a>
    </div>
    <div class="space-y-3">
      <h1 class="m-0 bg-gradient-to-r from-rose-600 via-pink-600 to-amber-500 bg-clip-text text-transparent text-3xl sm:text-4xl md:text-5xl font-extrabold leading-[1.15] pb-1 tracking-tight dark:from-rose-400 dark:via-pink-400 dark:to-amber-300">
        Projects
      </h1>
      <p class="m-0 max-w-2xl border-l-2 border-(--accent) pl-3.5 text-base sm:text-lg leading-relaxed text-(--fg-dim)">
        Side projects I've built and shipped on my own.
      </p>
    </div>
  </header>

  {groups.map((group) =>
    group.items.length > 0 && (
      <section class="mb-12">
        <div class="mb-5 flex items-end justify-between">
          <h2 class="m-0 text-[22px] font-semibold tracking-[-0.04em] text-(--fg)">
            {group.title}
          </h2>
          <span class="font-mono text-xs text-(--fg-faint)">{group.note}</span>
        </div>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          {group.items.map((p) => (
            <div id={slugify(p.title)} class="contents scroll-mt-24">
              <ProjectCard project={p} />
            </div>
          ))}
        </div>
      </section>
    )
  )}
</BaseLayout>