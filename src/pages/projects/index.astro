---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/project/ProjectCard.astro';
import projectsData from '../../../projectsData.json';
import { fetchRepoData, type GithubRepository } from '@/lib/runtime/github';

export const prerender = true;

type Project = {
  type: 'work' | 'self';
  title: string;
  description?: string;
  imgSrc: string;
  url?: string;
  repo?: string | GithubRepository | null;
  builtWith: string[];
};

const projectList = projectsData as Project[];

const projects = await Promise.all(
  projectList.map(async (p) =>
    typeof p.repo === 'string' ? { ...p, repo: await fetchRepoData(p.repo) } : p
  )
);

const description = 'My side projects and stuff which I built';

const workProjects = projects.filter(({ type }) => type === 'work');
const sideProjects = projects.filter(({ type }) => type === 'self');
---

<BaseLayout title="Projects">
  <div class="divide-y divide-gray-200 dark:divide-gray-700">
    <div class="space-y-2 pt-6 pb-8 md:space-y-5">
      <h1 class="text-3xl leading-9 font-extrabold tracking-tight text-gray-900 sm:text-4xl sm:leading-10 md:text-6xl md:leading-14 dark:text-gray-100">
        Projects
      </h1>
      <p class="text-lg leading-7 text-gray-500 dark:text-gray-400">{description}</p>
    </div>

    {workProjects.length > 0 && (
      <div class="container py-12">
        <h3 class="mb-4 text-3xl leading-9 font-extrabold tracking-tight text-gray-900 dark:text-gray-100">
          Work
        </h3>
        <div class="-m-4 flex flex-wrap">
          {workProjects.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    )}

    {sideProjects.length > 0 && (
      <div class="container py-12">
        <h3 class="mb-4 text-3xl leading-9 font-extrabold tracking-tight text-gray-900 dark:text-gray-100">
          Side projects
        </h3>
        <div class="-m-4 flex flex-wrap">
          {sideProjects.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    )}
  </div>
</BaseLayout>