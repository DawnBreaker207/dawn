---
import BaseLayout from '@/layouts/BaseLayout.astro';
import nowData from '@/data/now.json';
import booksData from '@/data/books.json';

export const prerender = true;

const currentlyReading = (booksData.currentlyReading ?? []).slice(0, 3) as Array<{
  title: string;
  link: string;
  authorName: string;
  bookMediumImageUrl?: string;
}>;

const BUILD_LIMIT = 3;
const buildingVisible = nowData.building.slice(0, BUILD_LIMIT);
const buildingExtra = nowData.building.slice(BUILD_LIMIT);
const currentStatus = (nowData as { currentStatus?: string[] }).currentStatus ?? [];

type MusicItem = string | { label: string; items: string[] };
const musicItems: MusicItem[] = Array.isArray(nowData.entertainment.music)
  ? (nowData.entertainment.music as MusicItem[])
  : nowData.entertainment.music
    ? [nowData.entertainment.music as string]
    : [];
---

<BaseLayout title="Now" description="What I'm doing right now — projects, learning focus, books, and hobbies. Inspired by Derek Sivers.">
  <div class="space-y-10 pb-12">
    <!-- 1. Open Editorial Header (synced with /about) -->
    <header class="space-y-5 border-b border-(--border) pt-1 pb-7">
      <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-sm text-(--fg-faint)">
        <div class="flex items-center gap-2">
          <span class="inline-block size-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-(--fg)">~/dawn/now.md</span>
          <span class="text-(--border)">·</span>
          <span>{nowData.location}</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="font-mono text-xs text-(--fg-faint)">Updated {nowData.updatedAt}</span>
          <a href="/about" class="text-(--fg-dim) no-underline hover:text-(--accent)">
            /about →
          </a>
        </div>
      </div>

      <div class="space-y-4">
        <h1 class="m-0 bg-gradient-to-r from-rose-600 via-pink-600 to-amber-500 bg-clip-text text-transparent text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight dark:from-rose-400 dark:via-pink-400 dark:to-amber-300">
          Now
        </h1>

        {currentStatus.length > 0 ? (
          <div class="space-y-2.5 pt-3">
            <div class="flex items-center justify-between gap-2">
              <span class="font-mono text-xs sm:text-sm font-semibold uppercase tracking-[0.12em] text-(--accent)">
                Current Status
              </span>
              <span class="font-mono text-xs sm:text-sm text-(--fg-faint)">
                {currentStatus.length} notes
              </span>
            </div>
            <ul class="m-0 grid list-none grid-cols-1 gap-x-6 gap-y-1.5 p-0 sm:grid-cols-2">
              {currentStatus.map((line) => (
                <li class="flex items-start gap-2.5 text-sm sm:text-base text-(--fg-dim)">
                  <span class="mt-2.5 size-1.5 rounded-full bg-(--accent) shrink-0" aria-hidden="true" />
                  <span class="leading-relaxed">{line}</span>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          nowData.status && (
            <p class="m-0 max-w-3xl border-l-2 border-(--accent) pl-3.5 text-base sm:text-lg leading-relaxed text-(--fg)">
              {nowData.status}
            </p>
          )
        )}
      </div>
    </header>

    <!-- 2. Visual Bookshelf Spotlight -->
    {currentlyReading.length > 0 && (
      <section class="space-y-4">
        <div class="flex items-baseline justify-between">
          <div>
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-(--accent)">
              Bookshelf
            </span>
            <h2 class="m-0 mt-0.5 text-xl font-bold tracking-tight text-(--fg) sm:text-2xl md:text-3xl">
              Currently Reading
            </h2>
          </div>
          <a href="/books" data-track-event="now-books-shelf" class="font-mono text-sm text-(--fg-faint) hover:text-(--accent) no-underline">
            All books →
          </a>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          {currentlyReading.map((book) => (
            <a
              href={book.link}
              target="_blank"
              rel="noopener noreferrer"
              data-umami-event="now-reading-book"
              class="group flex items-center gap-4 rounded-lg border border-(--border) bg-(--bg-alt) p-3.5 no-underline transition-colors hover:border-(--accent)"
            >
              {book.bookMediumImageUrl ? (
                <img
                  src={book.bookMediumImageUrl}
                  alt={book.title}
                  class="h-20 w-14 shrink-0 rounded border border-(--border) object-cover shadow-xs"
                />
              ) : (
                <div class="h-20 w-14 shrink-0 rounded border border-(--border) bg-(--bg) flex items-center justify-center font-mono text-xs text-(--fg-faint)">
                  BK
                </div>
              )}
              <div class="min-w-0 space-y-1">
                <div class="line-clamp-2 text-sm sm:text-base font-semibold leading-snug text-(--fg) group-hover:text-(--accent)">
                  {book.title}
                </div>
                <div class="truncate font-mono text-xs sm:text-sm text-(--fg-faint)">{book.authorName}</div>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- 3. Unboxed Shipping Columns -->
    {nowData.building.length > 0 && (
      <section class="border-t border-(--border) pt-8 space-y-5">
        <div class="flex items-baseline justify-between">
          <div>
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-(--accent)">
              Shipping
            </span>
            <h2 class="m-0 mt-0.5 text-xl font-bold tracking-tight text-(--fg) sm:text-2xl md:text-3xl">
              What I'm Building
            </h2>
          </div>
          <span class="font-mono text-sm text-(--fg-faint)">{nowData.building.length} active</span>
        </div>

        <div class={`grid grid-cols-1 gap-6 ${buildingVisible.length === 2 ? 'md:grid-cols-2' : buildingVisible.length >= 3 ? 'md:grid-cols-3' : ''}`}>
          {buildingVisible.map((item, idx) => (
            <div class="space-y-2.5 border-t border-(--border) pt-4">
              <div class="flex items-center justify-between gap-2">
                <span class="font-mono text-xs font-semibold text-(--accent)">0{idx + 1}</span>
                {item.tag && (
                  <div class="flex flex-wrap gap-1.5">
                    {item.tag.split(' ').filter(Boolean).map((t) => (
                      <span class="rounded border border-(--border) bg-(--bg-alt) px-2 py-0.5 font-mono text-xs text-(--fg-dim)">
                        {t}
                      </span>
                    ))}
                  </div>
                )}
              </div>
              <h3 class="m-0 text-lg font-bold text-(--fg)">{item.title}</h3>
              {item.desc && <p class="m-0 text-sm sm:text-base leading-relaxed text-(--fg-dim)">{item.desc}</p>}
            </div>
          ))}
        </div>

        {buildingExtra.length > 0 && (
          <details class="pt-1">
            <summary class="cursor-pointer font-mono text-sm text-(--accent) select-none hover:underline">
              Show more ({buildingExtra.length} more)
            </summary>
            <div class="mt-4 grid grid-cols-1 gap-6 md:grid-cols-3">
              {buildingExtra.map((item, idx) => (
                <div class="space-y-2.5 border-t border-(--border) pt-4">
                  <div class="flex items-center justify-between gap-2">
                    <span class="font-mono text-xs font-semibold text-(--accent)">
                      {String(BUILD_LIMIT + idx + 1).padStart(2, '0')}
                    </span>
                    {item.tag && (
                      <div class="flex flex-wrap gap-1.5">
                        {item.tag.split(' ').filter(Boolean).map((t) => (
                          <span class="rounded border border-(--border) bg-(--bg-alt) px-2 py-0.5 font-mono text-xs text-(--fg-dim)">
                            {t}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                  <h3 class="m-0 text-lg font-bold text-(--fg)">{item.title}</h3>
                  {item.desc && <p class="m-0 text-sm sm:text-base leading-relaxed text-(--fg-dim)">{item.desc}</p>}
                </div>
              ))}
            </div>
          </details>
        )}
      </section>
    )}

    <!-- 4. Split 7/5: Learning Radar (open list) + Offline (Playing & Listening) -->
    <section class="border-t border-(--border) pt-8 grid grid-cols-1 gap-8 lg:grid-cols-12 items-start">
      {nowData.studying.length > 0 && (
        <div class="lg:col-span-7 space-y-5">
          <div class="flex items-baseline justify-between">
            <div>
              <span class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-(--accent)">
                Deep Dives
              </span>
              <h2 class="m-0 mt-0.5 text-xl font-bold tracking-tight text-(--fg) sm:text-2xl md:text-3xl">
                Learning Radar
              </h2>
            </div>
            <span class="font-mono text-sm text-(--fg-faint)">{nowData.studying.length} tracks</span>
          </div>

          <div class="max-h-[540px] lg:h-[540px] overflow-y-auto thin-scrollbar pr-2 divide-y divide-(--border) border-y border-(--border)">
            {nowData.studying.map((item) => (
              <div class="flex items-start gap-3 py-3">
                <span class="mt-2.5 size-1.5 rounded-full bg-(--accent) shrink-0" aria-hidden="true" />
                <span class="text-sm sm:text-base text-(--fg-dim) leading-relaxed">{item}</span>
              </div>
            ))}
          </div>
        </div>
      )}

      {(nowData.entertainment.games.length > 0 || musicItems.length > 0) && (
        <aside class="lg:col-span-5 space-y-5">
          <div class="flex items-baseline justify-between">
            <div>
              <span class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-(--accent)">
                Downtime
              </span>
              <h2 class="m-0 mt-0.5 text-xl font-bold tracking-tight text-(--fg) sm:text-2xl md:text-3xl">
                Offline
              </h2>
            </div>
            <span class="font-mono text-sm text-(--fg-faint)">afk</span>
          </div>

          <div class="rounded-lg border border-(--border) bg-(--bg-alt) overflow-hidden divide-y divide-(--border) lg:h-[540px] lg:overflow-y-auto thin-scrollbar">
            {nowData.entertainment.games.length > 0 && (
              <div class="p-4 space-y-2.5">
                <div class="font-mono text-xs sm:text-sm font-semibold uppercase tracking-[0.12em] text-(--accent)">
                  Playing
                </div>
                <div class="divide-y divide-(--border)">
                  {nowData.entertainment.games.map((g) => (
                    <div class="flex flex-col gap-0.5 py-2 first:pt-0 last:pb-0">
                      <span class="text-base font-semibold text-(--fg)">{g.name}</span>
                      {g.detail && <span class="text-sm sm:text-base text-(--fg-dim)">{g.detail}</span>}
                    </div>
                  ))}
                </div>
              </div>
            )}

            {musicItems.length > 0 && (
              <div class="p-4 space-y-2.5">
                <div class="font-mono text-xs sm:text-sm font-semibold uppercase tracking-[0.12em] text-(--accent)">
                  Listening
                </div>
                <ul class="m-0 list-none divide-y divide-(--border) p-0">
                  {musicItems.flatMap((item) =>
                    typeof item === 'string'
                      ? [item]
                      : item.items
                  ).map((track) => {
                    const sep = track.indexOf(':');
                    const label = sep > 0 ? track.slice(0, sep).trim() : '';
                    const detail = sep > 0 ? track.slice(sep + 1).trim() : track;
                    return (
                      <li class="flex items-baseline gap-2.5 py-2 first:pt-0 last:pb-0">
                        <span class="font-mono text-xs sm:text-sm text-(--accent) shrink-0">♪</span>
                        <div class="min-w-0 leading-relaxed">
                          {label && (
                            <span class="block font-mono text-xs sm:text-sm text-(--fg-faint)">{label}</span>
                          )}
                          <span class="text-sm sm:text-base text-(--fg-dim)">{detail}</span>
                        </div>
                      </li>
                    );
                  })}
                </ul>
              </div>
            )}
          </div>
        </aside>
      )}
    </section>
  </div>
</BaseLayout>
