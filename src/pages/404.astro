---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Link from '@/components/ui/Link.astro';

export const prerender = true;
---

<BaseLayout title="404">
  <div class="flex flex-col items-start justify-start md:mt-24 md:flex-row md:items-center md:justify-center md:space-x-6">
    <div class="space-x-2 pt-6 pb-8 md:space-y-5">
      <h1 class="text-6xl leading-9 font-extrabold tracking-tight text-(--fg) md:border-r-2 md:border-(--border) md:px-6 md:text-8xl md:leading-14">
        404
      </h1>
    </div>
    <div class="max-w-md">
      <p class="mb-4 text-xl leading-normal font-bold md:text-2xl text-(--fg)">Sorry we couldn't find this page.</p>
      <p class="mb-8 text-(--fg-dim)">But dont worry, you can find plenty of other things on our homepage.</p>
      <Link
        href="/"
        class="inline-flex rounded-lg border border-transparent bg-(--accent) px-4 py-2 text-sm leading-5 font-medium text-white shadow-xs transition-colors duration-150 hover:bg-(--accent-hover) focus:outline-hidden"
      >
        Back to homepage
      </Link>
    </div>
  </div>
</BaseLayout>