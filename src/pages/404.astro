---
import BaseLayout from '@/layouts/BaseLayout.astro';

export const prerender = true;
---

<BaseLayout title="404 — Not Found" noindex={true}>
  <div class="mx-auto flex max-w-4xl flex-col items-center justify-center py-8 text-center md:py-16">
    <!-- Retro Terminal Monitor Card -->
    <div class="w-full overflow-hidden rounded-xl border border-(--border) bg-(--bg-alt) shadow-2xl">
      <!-- Terminal Header Bar (Developer / Windows Terminal style, NO macOS dots) -->
      <div class="flex items-center justify-between border-b border-(--border) bg-(--bg) px-4 py-2.5 sm:px-5">
        <div class="flex items-center gap-2.5">
          <div class="flex h-5 w-5 items-center justify-center rounded bg-(--accent-subtle) font-mono text-[11px] font-bold text-(--accent)">
            &gt;_
          </div>
          <span class="font-mono text-xs font-semibold text-(--fg)">terminal://dawn-blog/404_not_found</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="flex items-center gap-1.5 rounded-full border border-(--border) bg-(--bg-subtle) px-2.5 py-0.5 font-mono text-[11px] text-rose-500">
            <span class="h-1.5 w-1.5 rounded-full bg-rose-500 animate-pulse"></span>
            ERR_404
          </span>
          <div class="hidden sm:flex items-center gap-2.5 text-(--fg-faint) text-xs font-mono">
            <span class="cursor-default select-none hover:text-(--fg)">_</span>
            <span class="cursor-default select-none hover:text-(--fg)">□</span>
            <span class="cursor-default select-none hover:text-rose-500">✕</span>
          </div>
        </div>
      </div>

      <!-- Animated GIF Screen Area -->
      <div class="relative flex flex-col items-center justify-center p-4 sm:p-8">
        <div class="relative w-full max-w-2xl overflow-hidden rounded-xl border border-(--border) bg-black shadow-2xl aspect-video">
          <img
            src="/static/images/404.gif"
            alt="Obi-Wan Kenobi: These aren't the droids you're looking for"
            width="640"
            height="360"
            loading="eager"
            class="h-full w-full object-cover"
          />
          <!-- Subtle CRT scanline overlay -->
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent via-black/5 to-black/20"></div>
        </div>

        <!-- System Status Bar below Screen (Unobstructed GIF) -->
        <div class="mt-3 flex w-full max-w-2xl flex-wrap items-center justify-between gap-2 px-1.5 sm:px-2 font-mono text-[11px] sm:text-xs">
          <span class="inline-flex items-center gap-1.5 font-medium text-rose-500 whitespace-nowrap">
            <span class="h-1.5 w-1.5 rounded-full bg-rose-500 animate-pulse"></span>
            [SYSTEM_HALTED: ROUTE_NOT_RESOLVED]
          </span>
          <span class="font-mono text-[11px] sm:text-xs text-(--fg-faint) whitespace-nowrap">
            EXIT_CODE: 0x404 · JEDI_MIND_TRICK: ACTIVE
          </span>
        </div>

        <!-- Terminal Error Text -->
        <div class="mt-8 space-y-3">
          <h1 class="m-0 font-mono text-3xl font-bold tracking-tight text-(--fg) sm:text-4xl">
            Whoops! Lost in the Void
          </h1>
          <p class="mx-auto max-w-lg text-base text-(--fg-dim)">
            The route or file you requested does not exist on this branch. It may have been relocated, deleted, or never merged.
          </p>
        </div>

        <!-- Action Buttons -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a
            href="/"
            data-umami-event="404-home"
            class="inline-flex cursor-pointer items-center gap-2 rounded-lg bg-(--accent) px-5 py-2.5 font-mono text-sm font-semibold text-white shadow-md transition-all hover:bg-(--accent-hover) hover:shadow-lg active:translate-y-px"
          >
            <span>❯ cd /home</span>
          </a>
          <button
            type="button"
            data-open-terminal
            data-umami-event="404-terminal"
            class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-(--border) bg-(--bg) px-5 py-2.5 font-mono text-sm text-(--fg) shadow-[2px_2px_0_var(--border)] transition-colors hover:text-(--accent) active:translate-y-px"
          >
            <span>Search (Ctrl + K)</span>
          </button>
          <a
            href="/blog"
            data-umami-event="404-blog"
            class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-(--border) bg-(--bg) px-5 py-2.5 font-mono text-sm text-(--fg-dim) transition-colors hover:text-(--fg)"
          >
            <span>Browse Blog</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>