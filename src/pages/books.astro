---
import BaseLayout from '@/layouts/BaseLayout.astro';
import booksData from '../data/books.json';

export const prerender = true;

type Book = {
  title: string;
  link: string;
  bookMediumImageUrl: string;
  authorName: string;
  userRating: string;
  userReadAt: string;
};

const currentlyReading = (booksData.currentlyReading ?? []).slice(0, 4) as Book[];
const read = (booksData.read ?? []) as Book[];

const READ_LIMIT = 5;

function rating(r: string): number {
  const n = parseInt(r, 10);
  return isNaN(n) ? 0 : Math.min(Math.max(n, 0), 5);
}
---

<BaseLayout
  title="Books"
  description="Reading list and personal recommendations on software architecture, engineering, systems design, and personal development."
>
  <header class="mb-9 space-y-5 border-b border-(--border) pt-1 pb-7">
    <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-sm text-(--fg-faint)">
      <div class="flex items-center gap-2">
        <span class="inline-block size-2 rounded-full bg-(--accent)"></span>
        <span class="text-(--fg)">~/dawn/books.astro</span>
      </div>
      <a
        href="https://www.goodreads.com/review/list/204322578"
        target="_blank"
        rel="noopener noreferrer"
        data-track-event="goodreads-link"
        class="text-(--fg-dim) no-underline hover:text-(--accent)"
      >
        Goodreads ↗
      </a>
    </div>
    <div class="space-y-3">
      <h1 class="m-0 bg-gradient-to-r from-rose-600 via-pink-600 to-amber-500 bg-clip-text text-transparent text-3xl sm:text-4xl md:text-5xl font-extrabold leading-[1.15] pb-1 tracking-tight dark:from-rose-400 dark:via-pink-400 dark:to-amber-300">
        Books
      </h1>
      <p class="m-0 max-w-2xl border-l-2 border-(--accent) pl-3.5 text-base sm:text-lg leading-relaxed text-(--fg-dim)">
        What I've read, and what I'm reading right now.
      </p>
    </div>
  </header>

  {currentlyReading.length > 0 && (
    <section class="mb-12">
      <div class="mb-5 flex items-end justify-between">
        <h2 class="m-0 text-[22px] font-semibold tracking-[-0.04em] text-(--fg)">
          Currently reading
        </h2>
        <span class="font-mono text-xs text-(--fg-faint)">{currentlyReading.length} books</span>
      </div>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        {currentlyReading.map((book) => (
          <a
            href={book.link}
            target="_blank"
            rel="noopener noreferrer"
            data-track-event="book-link-current"
            class="group flex min-h-[120px] gap-4 rounded-2xl border border-(--border) bg-(--bg) p-4 no-underline transition-shadow hover:shadow-[4px_4px_0_var(--border)]"
          >
            {book.bookMediumImageUrl && (
              <img
                src={book.bookMediumImageUrl}
                alt={book.title}
                width="60"
                height="90"
                loading="lazy"
                class="h-[90px] w-[60px] shrink-0 rounded-md border border-(--border) object-cover"
              />
            )}
            <div class="min-w-0">
              <h3 class="m-0 truncate text-[17px] font-semibold tracking-[-0.02em] text-(--fg) group-hover:text-(--accent)">
                {book.title}
              </h3>
              <p class="mt-1 truncate text-[13px] text-(--fg-dim)">{book.authorName}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {read.length > 0 && (
    <section>
      <div class="mb-5 flex items-end justify-between">
        <h2 class="m-0 text-[22px] font-semibold tracking-[-0.04em] text-(--fg)">
          Read
        </h2>
        <span class="font-mono text-xs text-(--fg-faint)">{read.length} books</span>
      </div>
      <div class="divide-y divide-(--border)">
        {read.slice(0, READ_LIMIT).map((book) => (
          <a
            href={book.link}
            target="_blank"
            rel="noopener noreferrer"
            data-track-event="book-link-read"
            class="group grid grid-cols-1 items-start gap-4.5 py-4.5 no-underline md:grid-cols-[56px_1fr_auto]"
          >
            {book.bookMediumImageUrl && (
              <img
                src={book.bookMediumImageUrl}
                alt={book.title}
                width="56"
                height="84"
                loading="lazy"
                class="h-[84px] w-[56px] shrink-0 rounded-md border border-(--border) object-cover"
              />
            )}
            <div class="min-w-0">
              <h3 class="m-0 text-[17px] leading-tight font-semibold tracking-[-0.02em] text-(--fg) group-hover:text-(--accent)">
                {book.title}
              </h3>
              <p class="mt-1 text-[13px] text-(--fg-dim)">{book.authorName}</p>
            </div>
            <div class="shrink-0 pt-0.5 font-mono text-xs text-(--fg-dim)">
              {rating(book.userRating) > 0 && (
                <span class="text-(--accent-dim)">Goodreads {book.userRating}/5</span>
              )}
            </div>
          </a>
        ))}
      </div>
      {read.length > READ_LIMIT && (
        <details class="mt-4">
          <summary class="cursor-pointer font-mono text-[13px] text-(--accent) select-none hover:underline" data-track-event="books-show-more">
            Show more ({read.length - READ_LIMIT} more)
          </summary>
          <div class="mt-4 divide-y divide-(--border)">
            {read.slice(READ_LIMIT).map((book) => (
              <a
                href={book.link}
                target="_blank"
                rel="noopener noreferrer"
                data-track-event="book-link-read-more"
                class="group grid grid-cols-1 items-start gap-4.5 py-4.5 no-underline md:grid-cols-[56px_1fr_auto]"
              >
                {book.bookMediumImageUrl && (
                  <img
                    src={book.bookMediumImageUrl}
                    alt={book.title}
                    width="56"
                    height="84"
                    loading="lazy"
                    class="h-[84px] w-[56px] shrink-0 rounded-md border border-(--border) object-cover"
                  />
                )}
                <div class="min-w-0">
                  <h3 class="m-0 text-[17px] leading-tight font-semibold tracking-[-0.02em] text-(--fg) group-hover:text-(--accent)">
                    {book.title}
                  </h3>
                  <p class="mt-1 text-[13px] text-(--fg-dim)">{book.authorName}</p>
                </div>
                <div class="shrink-0 pt-0.5 font-mono text-xs text-(--fg-dim)">
                  {rating(book.userRating) > 0 && (
                    <span class="text-(--accent-dim)">Goodreads {book.userRating}/5</span>
                  )}
                </div>
              </a>
            ))}
          </div>
        </details>
      )}
    </section>
  )}

  {currentlyReading.length === 0 && read.length === 0 && (
    <section class="rounded-2xl border border-(--border) bg-(--bg-alt) p-6">
      <p class="m-0 text-sm text-(--fg-dim)">
        No books synced yet. Browse the full shelf directly on{' '}
        <a
          href="https://www.goodreads.com/review/list/204322578"
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-(--accent) hover:underline"
        >
          Goodreads ↗
        </a>
        .
      </p>
    </section>
  )}
</BaseLayout>