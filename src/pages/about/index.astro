---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProfileCard from '@/components/profile/ProfileCard.astro';
import Twemoji from '@/components/ui/Twemoji.astro';
import CareerTimeline from '@/components/about/CareerTimeline.astro';
import { SITE } from '@/lib/site';

export const prerender = true;

const SOCIALS = [
  { platform: 'github', handle: SITE.socialAccounts.github, href: `https://github.com/${SITE.socialAccounts.github}` },
  { platform: 'linkedin', handle: SITE.socialAccounts.linkedin, href: `https://www.linkedin.com/in/${SITE.socialAccounts.linkedin}` },
  { platform: 'x', handle: SITE.socialAccounts.x, href: `https://x.com/${SITE.socialAccounts.x}` },
];
---

<BaseLayout title="About">
  <div class="about divide-y divide-gray-200 dark:divide-gray-700">
    <div class="space-y-2 pt-6 pb-8 md:mb-6 md:space-y-5">
      <h1 class="text-3xl leading-9 font-extrabold tracking-tight text-gray-900 sm:text-4xl sm:leading-10 md:text-6xl md:leading-14 dark:text-gray-100">
        About
      </h1>
      <p class="text-base text-gray-500 md:text-lg md:leading-7 dark:text-gray-400">
        A peek behind the screen — what I'm studying, and what I'm building along
        the way.
      </p>
    </div>

    <div class="items-start space-y-2 py-16 md:grid md:grid-cols-3 xl:space-y-0 xl:gap-x-8">
      <div class="">
        <ProfileCard />
      </div>

      <div class="prose max-w-none pb-8 md:pl-10 xl:col-span-2">
<h2>
        Hi, I'm Tung Anh <Twemoji class="mx-2" emoji="waving-hand" />
      </h2>
      <p>
        I'm a developer who loves to learn, endlessly curious about how real
        systems come together. Backend is where my focus sits — Java, Spring, and
        PostgreSQL side by side, with some Angular on the front-end and devops as
        something I'm always experimenting with.
      </p>
      <p>
        This blog is my small corner of the internet: part workbench, part
        notebook. It's where people get to see who I am and what I do — and with
        the <a href="/lab">lab</a> attached, my go-to spot for experimenting and
        messing around with whatever I'm curious about.
      </p>
      <p>
        When I'm not at the keyboard, I'm usually still not far from it —
        researching whatever's caught my interest, most of it around the tech
        field. When that's done, you'll find me playing a game.
      </p>
      </div>
    </div>

    <div class="prose max-w-none py-16 md:pl-10">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold">Career</h2>

        <a
          href="/static/resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="no-underline inline-flex items-center gap-1.5 rounded-lg border border-(--border) bg-(--bg) px-3.5 py-2 font-mono text-xs text-(--fg) shadow-[3px_3px_0_var(--border)] transition-colors hover:text-(--accent) active:translate-x-px active:translate-y-px active:shadow-[1px_1px_0_var(--border)]"
        >
          <span>View resume</span>
          <Twemoji emoji="page-facing-up" size="base" class="!m-0" />
        </a>
      </div>
      <CareerTimeline />

      <h2>Tech stack</h2>
      <ul class="not-prose mt-6 space-y-2.5">
        <li class="flex items-center gap-2.5 text-[15px] leading-relaxed">
          <Twemoji emoji="desktop-computer" size="base" class="!m-0 shrink-0" />
          <span>Astro v7 + Node adapter — static posts &amp; SSR endpoints.</span>
        </li>
        <li class="flex items-center gap-2.5 text-[15px] leading-relaxed">
          <Twemoji emoji="keyboard" size="base" class="!m-0 shrink-0" />
          <span>TypeScript end to end + MDX content collection.</span>
        </li>
        <li class="flex items-center gap-2.5 text-[15px] leading-relaxed">
          <Twemoji emoji="inbox-tray" size="base" class="!m-0 shrink-0" />
          <span>Notion as CMS — posts synced to MDX via <code>sync-notion</code>.</span>
        </li>
        <li class="flex items-center gap-2.5 text-[15px] leading-relaxed">
          <Twemoji emoji="hammer-and-wrench" size="base" class="!m-0 shrink-0" />
          <span>Tailwind CSS v4 + CSS custom properties for theming.</span>
        </li>
        <li class="flex items-center gap-2.5 text-[15px] leading-relaxed">
          <Twemoji emoji="bar-chart" size="base" class="!m-0 shrink-0" />
          <span><a href="https://umami.is/" target="_blank">Umami</a> for privacy-friendly analytics.</span>
        </li>
        <li class="flex items-center gap-2.5 text-[15px] leading-relaxed">
          <Twemoji emoji="clapping-hands" size="base" class="!m-0 shrink-0" />
          <span><a href="https://giscus.app/" target="_blank">Giscus</a> for comments.</span>
        </li>
        <li class="flex items-center gap-2.5 text-[15px] leading-relaxed">
          <Twemoji emoji="face-with-monocle" size="base" class="!m-0 shrink-0" />
          <span>Dark mode inspired by the <a href="https://github.com/folke/tokyonight.nvim" target="_blank">Tokyonight Neovim Theme</a>.</span>
        </li>
      </ul>

      <h2>Social</h2>
      <p>Reach me at <a href={`mailto:${SITE.email}`}>{SITE.email}</a> or find me on social:</p>
      <ul class="not-prose flex flex-wrap items-center gap-2.5">
        {SOCIALS.map(({ platform, href }) => (
          <li>
            <a
              href={href}
              target="_blank"
              rel="me noreferrer"
              data-umami-event={`about-social-${platform}`}
              title={platform === 'github' ? 'GitHub' : platform === 'linkedin' ? 'LinkedIn' : 'X'}
              aria-label={platform === 'github' ? 'GitHub' : platform === 'linkedin' ? 'LinkedIn' : 'X'}
              class="grid size-10 place-items-center rounded-full border border-(--border) bg-(--bg) text-(--fg) transition-colors hover:border-(--accent) hover:text-(--accent)"
            >
              {platform === 'github' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                  <path d="M9 18c-4.51 2-5-2-7-2" />
                </svg>
              )}
              {platform === 'linkedin' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" /><rect width="4" height="12" x="2" y="9" /><circle cx="4" cy="4" r="2" />
                </svg>
              )}
              {platform === 'x' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                </svg>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</BaseLayout>