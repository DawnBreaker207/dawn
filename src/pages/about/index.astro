---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CareerTimeline from '@/components/about/CareerTimeline.astro';
import { SITE } from '@/lib/site';

export const prerender = true;

const SOCIALS = [
  { platform: 'GitHub', handle: `@${SITE.socialAccounts.github}`, href: `https://github.com/${SITE.socialAccounts.github}`, key: 'github' },
  { platform: 'LinkedIn', handle: `in/${SITE.socialAccounts.linkedin}`, href: `https://www.linkedin.com/in/${SITE.socialAccounts.linkedin}`, key: 'linkedin' },
  { platform: 'X', handle: `@${SITE.socialAccounts.x}`, href: `https://x.com/${SITE.socialAccounts.x}`, key: 'x' },
];

const COLOPHON_ITEMS = [
  { k: 'Core', v: 'Astro 5 · TypeScript · React 19 · Tailwind v4' },
  { k: 'Engine', v: 'Custom 2.5D SVG Simulator · Prisma · PostgreSQL' },
  { k: 'Credits', v: 'Umami · Giscus · Andromeda Theme' },
];
---

<BaseLayout
  title="About"
  description="Background, technical journey, and career timeline of Tung Anh (Dawn) — a software engineer based in Hanoi exploring distributed systems and web architectures."
>
  <div class="about space-y-10 pb-12">
    <!-- Top Studio Breadcrumb -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-(--border) pt-1 pb-3 font-mono text-sm text-(--fg-faint)">
      <div class="flex items-center gap-2">
        <span class="inline-block size-2 rounded-full bg-(--accent)"></span>
        <span>~/dawn/about.md</span>
      </div>
      <a href="/now" class="text-(--fg-dim) no-underline hover:text-(--accent)">
        What I'm doing /now →
      </a>
    </div>

    <!-- 1. Open Spotlight Hero (no outer box) -->
    <section class="flex flex-col items-start gap-7 md:flex-row md:items-center md:gap-10">
      <!-- Gradient-framed Avatar with signature shadow -->
      <div class="relative shrink-0">
        <div class="rounded-2xl bg-gradient-to-br from-rose-500 via-pink-500 to-amber-400 p-[3px] shadow-ruby dark:shadow-andromeda">
          <div class="overflow-hidden rounded-[13px] bg-(--bg-alt)">
            <img
              src="/static/images/avatar.jpg"
              alt="Tung Anh Ngo"
              width="350"
              height="350"
              loading="eager"
              class="size-64 sm:size-72 md:size-[350px] object-cover block"
              style="object-position: 50% 15%;"
            />
          </div>
        </div>
      </div>

      <!-- Identity + Bio + Actions -->
      <div class="flex-1 space-y-4 min-w-0">
        <div class="space-y-1.5">
          <div class="flex flex-wrap items-center gap-2.5">
            <h1 class="m-0 bg-gradient-to-r from-rose-600 via-pink-600 to-amber-500 bg-clip-text text-transparent text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight dark:from-rose-400 dark:via-pink-400 dark:to-amber-300">
              Tung Anh Ngo
            </h1>
            <span class="rounded-md border border-(--border) bg-(--bg-alt) px-2.5 py-0.5 font-mono text-sm sm:text-base text-(--fg-dim)">
              @Dawn
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full border border-(--border) bg-(--bg-alt) px-3 py-0.5 font-mono text-xs sm:text-sm font-medium text-emerald-600 dark:text-emerald-400">
              <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              Open to work
            </span>
          </div>
          <p class="m-0 font-mono text-sm sm:text-base text-(--fg-faint)">
            Software Engineer · Hanoi, Vietnam
          </p>
        </div>

        <div class="space-y-3 max-w-2xl text-base sm:text-lg leading-relaxed text-(--fg-dim)">
          <p class="m-0">
            I'm a curious developer focused on how real systems come together — mostly backend with <span class="font-medium text-(--fg)">Java, Spring, and PostgreSQL</span>, alongside <span class="font-medium text-(--fg)">Angular</span> on the front-end and ongoing <span class="font-medium text-(--fg)">DevOps</span> experiments.
          </p>
          <p class="m-0">
            This site is my small corner of the internet: part workbench, part notebook — with the <a href="/lab" data-track-event="about-lab-link" class="text-(--accent) underline underline-offset-4">lab</a> attached as my playground for whatever sparks my interest. Away from the keyboard, I'm usually still reading up on tech or unwinding with a game.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5 pt-1 font-mono text-sm sm:text-base">
          <a
            href="/static/resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event="about-resume"
            class="inline-flex items-center gap-1.5 rounded-md border border-(--accent) bg-(--accent) px-4 py-2 font-semibold text-white no-underline transition-colors hover:bg-(--accent-hover)"
          >
            <span>Resume.pdf</span>
            <span aria-hidden="true">↗</span>
          </a>
          <a
            href={`mailto:${SITE.email}`}
            data-umami-event="about-contact-email"
            class="inline-flex items-center gap-1.5 rounded-md border border-(--border) bg-(--bg-alt) px-4 py-2 text-(--fg) no-underline transition-colors hover:border-(--accent) hover:text-(--accent)"
          >
            <span>{SITE.email}</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 2. Split: Career (left 7 cols) + Connect & Under the hood (right 5 cols) -->
    <section class="border-t border-(--border) pt-8 grid grid-cols-1 gap-8 lg:grid-cols-12 items-start">
      <div class="lg:col-span-7 space-y-5">
        <div class="flex items-baseline justify-between">
          <div>
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-(--accent)">
              Timeline
            </span>
            <h2 class="m-0 mt-0.5 text-xl font-bold tracking-tight text-(--fg) sm:text-2xl md:text-3xl">Career &amp; Education</h2>
          </div>
          <a
            href="/static/resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-sm text-(--fg-faint) hover:text-(--accent) no-underline"
          >
            Full CV ↗
          </a>
        </div>
        <CareerTimeline />
      </div>

      <aside class="lg:col-span-5 space-y-5">
        <div class="flex items-baseline justify-between">
          <div>
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-(--accent)">
              Links
            </span>
            <h2 class="m-0 mt-0.5 text-xl font-bold tracking-tight text-(--fg) sm:text-2xl md:text-3xl">Connect</h2>
          </div>
          <span class="font-mono text-sm text-(--fg-faint)">links.json</span>
        </div>

        <div class="rounded-lg border border-(--border) bg-(--bg-alt) overflow-hidden divide-y divide-(--border)">
          {SOCIALS.map(({ platform, handle, href, key }) => (
            <a
              href={href}
              target="_blank"
              rel="me noreferrer"
              data-umami-event={`about-social-${key}`}
              class="group flex items-center justify-between gap-3 px-4 py-3.5 no-underline transition-colors hover:bg-(--bg)"
            >
              <div class="flex items-center gap-3 min-w-0">
                <span class="grid size-9 shrink-0 place-items-center rounded-md border border-(--border) bg-(--bg) text-(--fg-dim) transition-colors group-hover:border-(--accent) group-hover:text-(--accent)">
                  {key === 'github' && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                      <path d="M9 18c-4.51 2-5-2-7-2" />
                    </svg>
                  )}
                  {key === 'linkedin' && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" /><rect width="4" height="12" x="2" y="9" /><circle cx="4" cy="4" r="2" />
                    </svg>
                  )}
                  {key === 'x' && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                    </svg>
                  )}
                </span>
                <div class="min-w-0">
                  <div class="text-sm sm:text-base font-semibold text-(--fg) group-hover:text-(--accent)">{platform}</div>
                  <div class="truncate font-mono text-xs sm:text-sm text-(--fg-faint)">{handle}</div>
                </div>
              </div>
              <span class="font-mono text-sm text-(--fg-faint) group-hover:text-(--accent)">↗</span>
            </a>
          ))}
        </div>

        <!-- Collapsible Under the hood (Pipeline + Colophon) -->
        <details class="group/hood rounded-lg border border-(--border) bg-(--bg-alt) overflow-hidden">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-2 px-4 py-3.5 font-mono text-sm select-none [&::-webkit-details-marker]:hidden hover:bg-(--bg)">
            <div class="flex items-center gap-2 min-w-0">
              <span class="shrink-0 whitespace-nowrap font-semibold uppercase tracking-[0.1em] text-(--accent) text-xs">
                Under the hood
              </span>
              <span class="truncate text-xs text-(--fg-faint)">Stack &amp; Colophon</span>
            </div>
            <svg
              class="size-4 shrink-0 text-(--fg-faint) transition-transform duration-200 group-open/hood:rotate-90 group-hover/hood:text-(--accent)"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6" />
            </svg>
          </summary>
          <div class="border-t border-(--border) px-4 py-3.5 space-y-3">
            <a
              href="/lab/architecture"
              data-umami-event="about-site-architecture"
              class="flex items-center justify-between rounded border border-(--border) bg-(--bg) px-3 py-2 font-mono text-xs text-(--fg) no-underline transition-colors hover:border-(--accent) hover:text-(--accent)"
            >
              <span>See how this site runs (2.5D)</span>
              <span>→</span>
            </a>
            <div class="rounded border border-(--border) bg-(--bg) px-3 py-2 font-mono text-xs text-(--fg-dim) flex flex-wrap items-center gap-1.5">
              <span>Notion CMS</span>
              <span class="text-(--accent)">→</span>
              <span>Astro SSG + React</span>
              <span class="text-(--accent)">→</span>
              <span>Vercel Edge</span>
            </div>
            <dl class="m-0 space-y-1.5 text-sm">
              {COLOPHON_ITEMS.map((item) => (
                <div class="flex items-baseline justify-between gap-3">
                  <dt class="font-mono text-xs text-(--fg-faint) shrink-0">{item.k}</dt>
                  <dd class="m-0 text-right text-(--fg-dim)">{item.v}</dd>
                </div>
              ))}
            </dl>
            <div class="pt-2 border-t border-(--border) flex items-center justify-between font-mono text-xs">
              <a href="/books" class="text-(--fg-faint) no-underline hover:text-(--accent)">/books</a>
              <a
                href={SITE.siteRepo}
                target="_blank"
                rel="noopener noreferrer"
                class="text-(--accent) no-underline hover:underline"
              >
                Source on GitHub ↗
              </a>
            </div>
          </div>
        </details>
      </aside>
    </section>

    <!-- 3. Quiet Colophon Strip -->
    <footer class="border-t border-(--border) pt-4 flex flex-wrap items-center justify-between gap-2 font-mono text-xs text-(--fg-faint)">
      <span>
        Colophon: built with Astro 5, React 19 &amp; Tailwind v4 · synced from Notion · analytics by{' '}
        <a href="https://umami.is/" target="_blank" rel="noopener noreferrer" data-umami-event="about-credit-umami" class="underline hover:text-(--accent)">Umami</a>
        {' '}· comments via{' '}
        <a href="https://giscus.app/" target="_blank" rel="noopener noreferrer" data-umami-event="about-credit-giscus" class="underline hover:text-(--accent)">Giscus</a>
      </span>
      <a href={SITE.siteRepo} target="_blank" rel="noopener noreferrer" class="hover:text-(--accent) no-underline">
        DawnBreaker207/dawn ↗
      </a>
    </footer>
  </div>
</BaseLayout>