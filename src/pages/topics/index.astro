---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPosts, slugify } from '@/lib/utils/blog';

export const prerender = true;

const posts = await getPosts();
const counts = new Map<string, number>();
const tagLatestPost = new Map<string, { id: string; title: string; date: Date }>();

for (const post of posts) {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
    if (!tagLatestPost.has(tag)) {
      tagLatestPost.set(tag, {
        id: post.id,
        title: post.data.title,
        date: post.data.date,
      });
    }
  }
}

const tags = [...counts.keys()].sort(
  (a, b) => (counts.get(b) ?? 0) - (counts.get(a) ?? 0) || a.localeCompare(b)
);
---

<BaseLayout title="Topics" description="Topics I write about">
  <header class="mb-9 border-b border-(--border) pb-7">
    <div class="mb-2 flex items-center gap-2 font-mono text-xs text-(--fg-faint)">
      <span class="text-(--accent)">#</span>
      <span>Index</span>
      <span class="text-(--border)">/</span>
      <span>{tags.length} topics</span>
    </div>
    <h1 class="m-0 font-mono text-[clamp(40px,6vw,74px)] leading-[0.96] tracking-[-0.07em] text-(--fg)">
      topics
    </h1>
    <p class="mt-4 max-w-[42.5rem] text-lg text-(--fg-dim)">
      Explore articles cataloged by domain, architecture patterns, and engineering technologies.
    </p>
  </header>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {tags.length === 0 && <p class="text-sm text-(--fg-dim)">No topics found.</p>}
    {tags.map((tag) => {
      const count = counts.get(tag) ?? 0;
      const latest = tagLatestPost.get(tag);
      const formattedDate = latest ? new Intl.DateTimeFormat('en-CA').format(latest.date) : '';
      return (
        <a
          href={`/topics/${slugify(tag)}`}
          data-track-event="topic-card-click"
          class="group flex flex-col justify-between rounded-xl border border-(--border) bg-(--bg-alt) p-4.5 no-underline transition-all hover:-translate-y-0.5 hover:border-(--accent) hover:shadow-sm"
        >
          <div>
            <div class="flex items-center justify-between gap-2">
              <h2 class="m-0 font-mono text-base font-semibold text-(--fg) transition-colors group-hover:text-(--accent)">
                #{tag}
              </h2>
              <span class="rounded-full border border-(--border) bg-(--bg) px-2 py-0.5 font-mono text-[10px] text-(--fg-dim)">
                {count} {count === 1 ? 'article' : 'articles'}
              </span>
            </div>
            {latest && (
              <p class="mt-3 line-clamp-2 text-xs leading-relaxed text-(--fg-dim)">
                <span class="font-mono text-[10px] text-(--fg-faint) uppercase">Latest: </span>
                {latest.title}
              </p>
            )}
          </div>
          <div class="mt-4 flex items-center justify-between border-t border-(--border) pt-2.5 font-mono text-[11px] text-(--fg-faint)">
            <span>{formattedDate}</span>
            <span class="flex items-center gap-1 transition-transform group-hover:translate-x-1 group-hover:text-(--accent)">
              browse <span>→</span>
            </span>
          </div>
        </a>
      );
    })}
  </div>
</BaseLayout>