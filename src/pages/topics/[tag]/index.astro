---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ListLayout from '@/layouts/ListLayout.astro';
import { getPosts, slugify, POSTS_PER_PAGE } from '@/lib/utils/blog';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getPosts();
  const tagSet = new Set(posts.flatMap((p) => p.data.tags.map(slugify)));
  return [...tagSet].map((tag) => ({ params: { tag } }));
}

const tag = Astro.params.tag ?? '';

const posts = await getPosts();
const filteredPosts = posts.filter((p) => p.data.tags.map(slugify).includes(tag));

const tagNames = [...new Set(posts.flatMap((p) => p.data.tags))];
const title = tagNames.find((t) => slugify(t) === tag) ?? tag;
const totalPages = Math.ceil(filteredPosts.length / POSTS_PER_PAGE);
const initialDisplayPosts = filteredPosts.slice(0, POSTS_PER_PAGE);
---

<BaseLayout title={`${title} — Topic`}>
  <ListLayout
    title={title}
    posts={initialDisplayPosts}
    pagination={{ currentPage: 1, totalPages, basePath: `topics/${tag}` }}
  />
</BaseLayout>