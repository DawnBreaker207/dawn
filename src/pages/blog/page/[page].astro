---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ListLayout from '@/layouts/ListLayout.astro';
import { getPosts, POSTS_PER_PAGE } from '@/lib/utils/blog';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getPosts();
  const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
  // page 1 = /blog — chỉ build trang 2 trở đi để tránh trùng canonical
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const currentPage = Number(Astro.params.page);
const posts = await getPosts();
const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
const initialDisplayPosts = posts.slice(
  POSTS_PER_PAGE * (currentPage - 1),
  POSTS_PER_PAGE * currentPage
);
---

<BaseLayout title={currentPage > 1 ? `Blog — Page ${currentPage}` : "Blog"}>
  <ListLayout
    title="All Posts"
    posts={initialDisplayPosts}
    pagination={{ currentPage, totalPages, basePath: 'blog' }}
  />
</BaseLayout>