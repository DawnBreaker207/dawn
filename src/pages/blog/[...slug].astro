---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostLayout from '@/layouts/PostLayout.astro';
import { getPosts, readingMinutes } from '@/lib/utils/blog';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const posts = await getPosts();
const postIndex = posts.findIndex((p) => p.id === post.id);
const prev = posts[postIndex + 1];
const next = posts[postIndex - 1];
const minutes = readingMinutes(post);
const toc = headings
  .filter((h) => h.depth > 1)
  .map((h) => ({ value: h.text, url: `#${h.slug}`, depth: h.depth }));
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <PostLayout
    title={post.data.title}
    tags={post.data.tags}
    date={post.data.date}
    slug={post.id}
    minutes={minutes}
    toc={toc}
    next={next && { path: `blog/${next.id}`, title: next.data.title }}
    prev={prev && { path: `blog/${prev.id}`, title: prev.data.title }}
  >
    <Content />
  </PostLayout>
</BaseLayout>