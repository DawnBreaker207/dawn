  .sql-tree-leaf-dim   { opacity: .4; }
  :where(.dark, .dark *) .sql-tree-root   { border-color: rgb(34 211 238/0.5); color: #67e8f9; background: rgb(34 211 238/0.08); }
  :where(.dark, .dark *) .sql-tree-branch { border-color: rgb(34 211 238/0.3); background: rgb(34 211 238/0.05); }
  :where(.dark, .dark *) .sql-tree-leaf       { border-color: rgb(148 163 184/0.2); }
  :where(.dark, .dark *) .sql-tree-leaf-hl    { border-color: rgb(74 222 128/0.5); color: #4ade80; background: rgb(74 222 128/0.08); }
  .sql-tree-label { font-size: 9px; color: var(--fg-faint); margin-top: 2px; }

  /* N+1 diagram */
  .sql-queries-viz { display: flex; flex-direction: column; gap: 2px; margin: 6px 0; }
  .sql-query-row   {
    font-size: 10px; border-radius: 4px; border-left: 2px solid;
