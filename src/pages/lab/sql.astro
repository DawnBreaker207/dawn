      <summary class="flex cursor-pointer select-none items-center justify-between gap-3 p-3 font-mono text-xs text-(--fg-dim) hover:text-(--fg) [&::-webkit-details-marker]:hidden">
        <span class="font-semibold">Monitor replication lag — psql queries</span>
        <svg class="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="border-t border-(--border) p-4 font-mono text-xs text-(--fg-dim)">
        <pre class="sql-details-pre thin-scrollbar">{`-- On PRIMARY: check standby lag
SELECT client_addr,
       state,
       sent_lsn,
       write_lsn,
       flush_lsn,
       replay_lsn,
       write_lag,
       flush_lag,
       replay_lag
  FROM pg_stat_replication;

-- replay_lag > 0 → standby is behind
-- flush_lag  > write_lag → standby disk is slow
-- sync_state = 'async' | 'sync' | 'quorum'

-- On STANDBY: how far behind am I?
SELECT now() - pg_last_xact_replay_timestamp() AS replication_lag;
-- > 30s → investigate primary load or network

-- Bytes of WAL not yet applied on standby
SELECT pg_wal_lsn_diff(pg_current_wal_lsn(), replay_lsn) AS lag_bytes
  FROM pg_stat_replication;`}</pre>
      </div>
    </details>
  </div>
