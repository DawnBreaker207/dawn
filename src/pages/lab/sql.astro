---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ScenarioPicker from '@/components/lab/sql/ScenarioPicker.astro';
import ExecutionOrder from '@/components/lab/sql/ExecutionOrder.astro';
import CaseRouting from '@/components/lab/sql/CaseRouting.astro';
import BTreeTraversal from '@/components/lab/sql/BTreeTraversal.astro';
import MvccVisibility from '@/components/lab/sql/MvccVisibility.astro';
import FootprintCalc from '@/components/lab/sql/FootprintCalc.astro';
import InfraTools from '@/components/lab/sql/InfraTools.astro';
import ExplainOverviewCard from '@/components/lab/sql/ExplainOverviewCard.astro';
import EnginePipeline from '@/components/lab/sql/EnginePipeline.astro';
import PartitionVisualizer from '@/components/lab/sql/PartitionVisualizer.astro';
import ReplicationTimeline from '@/components/lab/sql/ReplicationTimeline.astro';
import { EO_SQL, EO_STEPS, CASE_BRANCHES } from '@/scripts/lab/sql/execution-order';

export const prerender = true;
---

<BaseLayout
  title="Visual SQL EXPLAIN & Query Plan Explorer"
  description="Interactive PostgreSQL query plan simulator — compare Seq Scan vs B-Tree, fix Hibernate N+1, MVCC isolation, index footprint, connection pool."
>
  <header class="mb-5 border-b border-(--border) pb-4">
    <div class="mb-2 flex items-center gap-2">
      <h1 class="m-0 font-mono text-[clamp(28px,4.5vw,48px)] leading-[0.96] tracking-[-0.06em] text-(--fg)">
        sql explain explorer
      </h1>
      <span class="inline-flex items-center gap-1 rounded-full border border-(--border) bg-(--bg-alt) px-2 py-0.5 text-[10px] font-mono text-cyan-600 dark:text-cyan-400">
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-cyan-400"></span>
        PostgreSQL 16
      </span>
    </div>
    <p class="mt-1 text-sm text-(--fg-dim)">
      Query plans, B-tree, MVCC, index sizing, infra, partitioning, replication — 8 interactive simulations.
    </p>
  </header>

  <!-- Tab bar (Sticky, horizontal-scroll on mobile) -->
  <div id="sql-tab-bar" class="sticky top-0 z-20 mb-5 overflow-x-auto border-b border-(--border) bg-(--bg)/90 backdrop-blur-sm pb-3 pt-2" style="-webkit-overflow-scrolling:touch;scroll-snap-type:x mandatory">
    <div class="flex gap-1.5 font-mono text-xs whitespace-nowrap">
      <button data-sql-tab="engine"    class="sql-tab sql-tab-active">Engine</button>
      <button data-sql-tab="explain"   class="sql-tab">EXPLAIN</button>
      <button data-sql-tab="btree"     class="sql-tab">B-Tree</button>
      <button data-sql-tab="mvcc"      class="sql-tab">MVCC</button>
      <button data-sql-tab="footprint"   class="sql-tab">Footprint</button>
      <button data-sql-tab="infra"       class="sql-tab">Infra</button>
      <button data-sql-tab="partition"   class="sql-tab">Partition</button>
      <button data-sql-tab="replication" class="sql-tab">Replication</button>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       Tab 0 — Engine Pipeline
  ════════════════════════════════════════════════════════════════════════ -->
  <div data-sql-pane="engine" class="space-y-4">

    <!-- Concept strip -->
    <div class="grid grid-cols-3 gap-2 font-mono text-xs">
      <div class="rounded-lg border border-(--border) bg-(--bg-alt) p-2.5 text-center">
        <div class="text-base">🗺️</div>
        <div class="mt-0.5 font-bold text-cyan-500">5 stages</div>
        <div class="text-[10px] text-(--fg-faint)">per query</div>
      </div>
      <div class="rounded-lg border border-(--border) bg-(--bg-alt) p-2.5 text-center">
        <div class="text-base">📦</div>
        <div class="mt-0.5 font-bold text-amber-500">shared_buffers</div>
        <div class="text-[10px] text-(--fg-faint)">page cache</div>
      </div>
      <div class="rounded-lg border border-(--border) bg-(--bg-alt) p-2.5 text-center">
        <div class="text-base">📜</div>
        <div class="mt-0.5 font-bold text-emerald-500">WAL</div>
        <div class="text-[10px] text-(--fg-faint)">durability</div>
      </div>
    </div>

    <EnginePipeline />

    <!-- Theory: 5-stage pipeline -->
    <details class="group rounded-xl border border-(--border) bg-(--bg-alt)">
      <summary class="flex cursor-pointer select-none items-center justify-between gap-3 p-3 font-mono text-xs text-(--fg-dim) hover:text-(--fg) [&::-webkit-details-marker]:hidden">
        <span class="font-semibold">Query pipeline — 5 stages explained</span>
        <svg class="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="border-t border-(--border) p-4 space-y-3 font-mono text-xs">

        <!-- Stage rows -->
        <div class="space-y-1.5">
          {[
            { n:'1', icon:'📝', name:'Parse',   color:'text-violet-400', detail:'Lexer tokenises SQL → Parser builds ParseTree. Grammar check only — no catalog lookup. Typically < 0.1 ms.' },
            { n:'2', icon:'🔎', name:'Analyze', color:'text-sky-400',    detail:'Resolve table/column names to OIDs from pg_class / pg_attribute. Acquire AccessShareLock. Expand views via rewrite rules.' },
            { n:'3', icon:'🗺️', name:'Plan',   color:'text-amber-400',  detail:'Cost model picks the cheapest plan: SeqScan = pages × 1.0, IndexScan = levels × 4.0. Stats from pg_statistic (n_distinct, correlation).' },
            { n:'4', icon:'⚙️', name:'Execute', color:'text-cyan-400',   detail:'Volcano/iterator model — each node calls GetNext() on its child. Reads pages from shared_buffers; spills to temp file if result > work_mem.' },
            { n:'5', icon:'💾', name:'Commit',  color:'text-emerald-400',detail:'Write WAL commit record → fsync(). Dirty buffer pages flushed later by bgwriter. Release all locks. Read-only queries skip this stage.' },
          ].map(s => (
            <div class="flex items-start gap-3 rounded-lg border border-(--border) bg-(--bg) px-3 py-2.5">
              <span class={`mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border font-black text-[10px] ${s.color} border-current/30`}>{s.n}</span>
              <div class="min-w-0">
                <span class={`font-bold ${s.color}`}>{s.icon} {s.name}</span>
                <span class="ml-2 text-[11px] text-(--fg-dim)">{s.detail}</span>
              </div>
            </div>
          ))}
        </div>

        <!-- Volcano + Cost side by side -->
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
          <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
            <p class="mb-2 text-[10px] font-semibold uppercase tracking-wider text-(--fg-faint)">Volcano iterator model</p>
            <pre class="overflow-x-auto text-[10px] leading-relaxed text-(--fg-dim) thin-scrollbar">{`Sort
 └─ HashAgg
      └─ HashJoin
           ├─ SeqScan users   ← build hash table
           └─ SeqScan orders  ← probe each row

Each node pulls rows lazily via GetNext().
Spills to disk if HashJoin > work_mem.`}</pre>
          </div>
          <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
            <p class="mb-2 text-[10px] font-semibold uppercase tracking-wider text-(--fg-faint)">Cost model (planner)</p>
            <div class="space-y-2 text-[10px] text-(--fg-dim)">
              <div>
                <span class="text-rose-400 font-semibold">Seq Scan</span>
                <pre class="mt-0.5 text-[10px]">{`cost = pages × seq_page_cost(1.0)
     = 4,255 × 1.0 = 4,255`}</pre>
                <p class="text-(--fg-faint)">Use when selectivity &gt; ~5%</p>
              </div>
              <div>
                <span class="text-emerald-400 font-semibold">Index Scan</span>
                <pre class="mt-0.5 text-[10px]">{`cost = levels × random_page_cost(4.0)
     = 3 × 4.0 + 1 heap = 16`}</pre>
                <p class="text-(--fg-faint)">Set random_page_cost=1.1 on SSD</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </details>

    <!-- Theory: Shared Buffers -->
    <details class="group rounded-xl border border-(--border) bg-(--bg-alt)">
      <summary class="flex cursor-pointer select-none items-center justify-between gap-3 p-3 font-mono text-xs text-(--fg-dim) hover:text-(--fg) [&::-webkit-details-marker]:hidden">
        <span class="font-semibold">Shared Buffers — page cache internals</span>
        <svg class="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="border-t border-(--border) p-4 space-y-3 font-mono text-xs text-(--fg-dim)">
        <p class="text-[11px]"><strong class="text-(--fg)">Shared Buffers</strong> is PostgreSQL's in-process page cache — a fixed pool of 8 KB slots shared across all backend processes. The OS page cache provides a second layer below it.</p>
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
          <div class="rounded-lg border border-(--border) bg-(--bg) p-3 space-y-1.5">
            <p class="text-[10px] font-semibold text-cyan-400">Buffer lifecycle</p>
            <div class="space-y-1 text-[10px]">
              <div class="flex gap-2"><span class="shrink-0 text-(--fg-faint)">1.</span><span>Read request arrives: check buffer hash table (OID + page#)</span></div>
              <div class="flex gap-2"><span class="shrink-0 text-emerald-400">HIT</span><span>Page found → pin it, return pointer. Zero I/O.</span></div>
              <div class="flex gap-2"><span class="shrink-0 text-rose-400">MISS</span><span>Evict a victim (clock-sweep) → read from OS/disk → insert.</span></div>
              <div class="flex gap-2"><span class="shrink-0 text-(--fg-faint)">Write</span><span>Mark page dirty → bgwriter or checkpoint flushes later.</span></div>
            </div>
          </div>
          <div class="rounded-lg border border-(--border) bg-(--bg) p-3 space-y-1.5">
            <p class="text-[10px] font-semibold text-amber-400">Sizing & tuning</p>
            <pre class="text-[10px] text-(--fg-dim)">{`shared_buffers = 25% of RAM   # recommended
                               # (OS page cache = second layer)
work_mem       = 4MB           # per sort / hash — multiply by
                               # max_connections × queries
effective_cache_size = 75%     # tells planner how much is cached`}</pre>
            <p class="text-[10px] text-(--fg-faint) border-l-2 border-amber-500/40 pl-2">Raising shared_buffers beyond 40% of RAM rarely helps — the OS cache is already doing the work.</p>
          </div>
        </div>
        <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
          <p class="mb-1.5 text-[10px] font-semibold uppercase tracking-wider text-(--fg-faint)">Monitor buffer hit ratio (should be &gt; 99%)</p>
          <pre class="sql-details-pre thin-scrollbar">{`SELECT sum(heap_blks_hit) / nullif(sum(heap_blks_hit + heap_blks_read), 0) AS hit_ratio
  FROM pg_statio_user_tables;
-- < 95% → shared_buffers too small or query does full scans

SELECT buffers_checkpoint, buffers_clean, buffers_backend
  FROM pg_stat_bgwriter;
-- buffers_backend high → bgwriter can't keep up → tune bgwriter_lru_maxpages`}</pre>
        </div>
      </div>
    </details>

    <!-- Theory: WAL + Locks -->
    <details class="group rounded-xl border border-(--border) bg-(--bg-alt)">
      <summary class="flex cursor-pointer select-none items-center justify-between gap-3 p-3 font-mono text-xs text-(--fg-dim) hover:text-(--fg) [&::-webkit-details-marker]:hidden">
        <span class="font-semibold">WAL &amp; Lock Table — durability and concurrency control</span>
        <svg class="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="border-t border-(--border) p-4 space-y-3 font-mono text-xs text-(--fg-dim)">
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
          <!-- WAL -->
          <div class="space-y-2">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-amber-400">WAL — Write-Ahead Log</p>
            <p class="text-[11px]">Every change is written to WAL <strong class="text-(--fg)">before</strong> the heap page is modified. Sequential append → safe to crash at any point.</p>
            <pre class="sql-details-pre thin-scrollbar">{`WAL record structure:
  LSN      uint64   — monotonic log position
  XID      uint32   — transaction id
  op       uint8    — INSERT / UPDATE / DELETE / COMMIT
  rel      OID      — table / index
  blkno    uint32   — heap page number
  offset   uint16   — slot on the page
  data     bytes[]  — before + after images

Crash recovery: replay WAL from last checkpoint.
Replication: standby streams WAL records → apply.`}</pre>
            <div class="rounded-lg border border-amber-500/25 bg-amber-500/5 p-2.5">
              <p class="text-[10px] text-amber-400 font-semibold mb-1">synchronous_commit options</p>
              <div class="space-y-0.5 text-[10px]">
                <div><code class="text-amber-300">on</code> <span class="text-(--fg-faint)">— fsync WAL before ACK (safe, default)</span></div>
                <div><code class="text-amber-300">off</code> <span class="text-(--fg-faint)">— ACK before fsync (up to 3×faster, may lose ~60ms)</span></div>
                <div><code class="text-amber-300">remote_apply</code> <span class="text-(--fg-faint)">— standby applied before ACK (zero data loss)</span></div>
              </div>
            </div>
          </div>
          <!-- Lock table -->
          <div class="space-y-2">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-violet-400">Lock Table — 8 modes</p>
            <div class="space-y-1 rounded-lg border border-(--border) bg-(--bg) p-3">
              {[
                { mode:'AccessShare',     by:'SELECT',                   blocks:'AccessExclusive only',      safe: true },
                { mode:'RowShare',        by:'SELECT FOR UPDATE/SHARE',  blocks:'Exclusive+',                safe: true },
                { mode:'RowExclusive',    by:'INSERT / UPDATE / DELETE', blocks:'Share+',                   safe: true },
                { mode:'ShareUpdateEx',   by:'VACUUM, ANALYZE',          blocks:'ShareUpdateEx+',            safe: true },
                { mode:'Share',           by:'CREATE INDEX',             blocks:'RowExclusive+',             safe: true },
                { mode:'ShareRowEx',      by:'SELECT FOR NO KEY UPDATE', blocks:'ShareUpdateEx+',            safe: false },
                { mode:'Exclusive',       by:'Internal (index ops)',      blocks:'RowShare+',                safe: false },
                { mode:'AccessExclusive', by:'DROP / ALTER / TRUNCATE',  blocks:'Everything — full block',  safe: false },
              ].map(r => (
                <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5 text-[10px]">
                  <code class="shrink-0 text-violet-400">{r.mode}</code>
                  <span class="text-(--fg-faint)">← {r.by}</span>
                  <span class={`ml-auto shrink-0 ${r.safe ? 'text-(--fg-faint)' : 'text-rose-400'}`}>blocks: {r.blocks}</span>
                </div>
              ))}
            </div>
            <p class="text-[10px] text-(--fg-faint) border-l-2 border-violet-500/40 pl-2">ALTER TABLE / DROP TABLE take AccessExclusiveLock — blocks even a plain SELECT until the DDL finishes.</p>
          </div>
        </div>
      </div>
    </details>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       Tab 1 — EXPLAIN Explorer
  ════════════════════════════════════════════════════════════════════════ -->
  <div data-sql-pane="explain" hidden class="space-y-4">

    <!-- Concept strip -->
    <div class="grid grid-cols-3 gap-2 font-mono text-xs">
      <div class="rounded-lg border border-(--border) bg-(--bg-alt) p-2.5 text-center">
        <div class="text-base">🐌</div>
        <div class="mt-0.5 font-bold text-rose-500">O(n)</div>
        <div class="text-[10px] text-(--fg-faint)">Seq Scan</div>
      </div>
      <div class="rounded-lg border border-(--border) bg-(--bg-alt) p-2.5 text-center">
        <div class="text-base">⚡</div>
        <div class="mt-0.5 font-bold text-emerald-500">O(log n)</div>
        <div class="text-[10px] text-(--fg-faint)">Index Scan</div>
      </div>
      <div class="rounded-lg border border-(--border) bg-(--bg-alt) p-2.5 text-center">
        <div class="text-base">💣</div>
        <div class="mt-0.5 font-bold text-amber-500">N+1</div>
        <div class="text-[10px] text-(--fg-faint)">queries/row</div>
      </div>
    </div>

    <ScenarioPicker />
    <ExecutionOrder eoSql={EO_SQL} eoSteps={EO_STEPS} />

    <details class="group rounded-xl border border-(--border) bg-(--bg-alt)">
      <summary class="flex cursor-pointer select-none items-center justify-between gap-3 p-3 font-mono text-xs text-(--fg-dim) hover:text-(--fg) [&::-webkit-details-marker]:hidden">
        <span class="font-semibold">Visual overview — Seq Scan vs Index, N+1 vs JOIN FETCH</span>
        <svg class="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="border-t border-(--border) p-4">
        <ExplainOverviewCard />
      </div>
    </details>

    <details class="group rounded-xl border border-(--border) bg-(--bg-alt)">
      <summary class="flex cursor-pointer select-none items-center justify-between gap-3 p-3 font-mono text-xs text-(--fg-dim) hover:text-(--fg) [&::-webkit-details-marker]:hidden">
        <span class="font-semibold">More patterns — Hash Join, Covering Index, Anti-Join</span>
        <svg class="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="border-t border-(--border) p-4 space-y-4 font-mono text-xs">
        <CaseRouting caseBranches={CASE_BRANCHES} />
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
          <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
            <div class="mb-1.5 flex items-center gap-1.5">
              <span class="rounded bg-amber-500/15 px-1.5 py-0.5 text-[10px] font-bold text-amber-600 dark:text-amber-400">Hash Join</span>
              <span class="text-(--fg-faint)">vs</span>
              <span class="rounded bg-cyan-500/15 px-1.5 py-0.5 text-[10px] font-bold text-cyan-600 dark:text-cyan-400">Nested Loop</span>
            </div>
            <ul class="space-y-1 text-[11px] text-(--fg-dim) list-none">
              <li>🔶 Hash: build hash table from small side → stream large side. Good for large×large joins.</li>
              <li>🔷 Nested Loop: for each outer row, probe inner index. Good when outer set is tiny.</li>
            </ul>
            <p class="mt-2 border-l-2 border-amber-500/50 pl-2 text-[10px] text-amber-700 dark:text-amber-300">Planner chooses by cost estimate — stale stats silently flip the pick.</p>
          </div>
          <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
            <div class="mb-1.5">
              <span class="rounded bg-emerald-500/15 px-1.5 py-0.5 text-[10px] font-bold text-emerald-600 dark:text-emerald-400">Covering Index</span>
            </div>
            <p class="text-[11px] text-(--fg-dim)">All projected columns live in the index leaf — no heap fetch needed.</p>
            <pre class="sql-pre mt-2">CREATE INDEX idx_orders_cov
  ON orders (customer_id)
  INCLUDE (total_usd, status);
-- → Index Only Scan  Heap Fetches: 0</pre>
          </div>
        </div>
      </div>
    </details>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       Tab 2 — B-Tree
  ════════════════════════════════════════════════════════════════════════ -->
  <div data-sql-pane="btree" hidden class="space-y-4">

    <!-- Concept strip -->
    <div class="grid grid-cols-3 gap-2 font-mono text-xs">
      <div class="rounded-lg border border-(--border) bg-(--bg-alt) p-2.5 text-center">
        <div class="text-base">🌳</div>
        <div class="mt-0.5 font-bold text-cyan-500">≤ 4 levels</div>
        <div class="text-[10px] text-(--fg-faint)">even at 1B rows</div>
      </div>
      <div class="rounded-lg border border-(--border) bg-(--bg-alt) p-2.5 text-center">
        <div class="text-base">📄</div>
        <div class="mt-0.5 font-bold text-amber-500">8 KB</div>
        <div class="text-[10px] text-(--fg-faint)">per page</div>
      </div>
      <div class="rounded-lg border border-(--border) bg-(--bg-alt) p-2.5 text-center">
        <div class="text-base">⚡</div>
        <div class="mt-0.5 font-bold text-emerald-500">O(log n)</div>
        <div class="text-[10px] text-(--fg-faint)">lookup cost</div>
      </div>
    </div>

    <BTreeTraversal />

    <details class="group rounded-xl border border-(--border) bg-(--bg-alt)">
      <summary class="flex cursor-pointer select-none items-center justify-between gap-3 p-3 font-mono text-xs text-(--fg-dim) hover:text-(--fg) [&::-webkit-details-marker]:hidden">
        <span class="font-semibold">B-Tree anatomy — Root → Branch → Leaf → Heap</span>
        <svg class="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="border-t border-(--border) p-4">
    <div class="sql-visual-card">
      <p class="sql-visual-title">Anatomy of a B-Tree index</p>
      <div class="sql-btree-diagram">

        <!-- Root -->
        <div class="sql-btd-level">
          <div class="sql-btd-label">Root<br/><span class="sql-btd-sub">always cached</span></div>
          <div class="sql-btd-nodes">
            <div class="sql-btd-node sql-btd-root">
              <span>25</span><span class="sql-btd-div">|</span><span>60</span>
            </div>
          </div>
        </div>

        <!-- Branch arrows -->
        <div class="sql-btd-arrows">
          <span class="sql-btd-arrow-label">&lt; 25</span>
          <span class="sql-btd-arrow-label">25–60</span>
          <span class="sql-btd-arrow-label">&gt; 60</span>
        </div>

        <!-- Branch level -->
        <div class="sql-btd-level">
          <div class="sql-btd-label">Branch<br/><span class="sql-btd-sub">usually cached</span></div>
          <div class="sql-btd-nodes">
            <div class="sql-btd-node sql-btd-branch"><span>10</span><span class="sql-btd-div">|</span><span>18</span></div>
            <div class="sql-btd-node sql-btd-branch"><span>35</span><span class="sql-btd-div">|</span><span>47</span></div>
            <div class="sql-btd-node sql-btd-branch"><span>72</span><span class="sql-btd-div">|</span><span>88</span></div>
          </div>
        </div>

        <!-- Leaf level -->
        <div class="sql-btd-level">
          <div class="sql-btd-label">Leaf<br/><span class="sql-btd-sub">1 real IO</span></div>
          <div class="sql-btd-nodes sql-btd-leaves">
            <div class="sql-btd-node sql-btd-leaf">3·7·9</div>
            <div class="sql-btd-node sql-btd-leaf sql-btd-leaf-hl">12·<strong>15</strong>·22</div>
            <div class="sql-btd-node sql-btd-leaf">26·31</div>
            <div class="sql-btd-node sql-btd-leaf">…</div>
            <div class="sql-btd-node sql-btd-leaf">…</div>
            <div class="sql-btd-node sql-btd-leaf">…</div>
            <div class="sql-btd-node sql-btd-leaf">…</div>
          </div>
        </div>

        <!-- Heap -->
