---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SqlModulePicker from '@/components/lab/sql/SqlModulePicker.astro';
import EngineTab from '@/components/lab/sql/tabs/EngineTab.astro';
import ExplainTab from '@/components/lab/sql/tabs/ExplainTab.astro';
import BTreeTab from '@/components/lab/sql/tabs/BTreeTab.astro';
import MvccTab from '@/components/lab/sql/tabs/MvccTab.astro';
import FootprintTab from '@/components/lab/sql/tabs/FootprintTab.astro';
import InfraTab from '@/components/lab/sql/tabs/InfraTab.astro';
import PartitionTab from '@/components/lab/sql/tabs/PartitionTab.astro';
import ReplicationTab from '@/components/lab/sql/tabs/ReplicationTab.astro';
import '@/styles/lab-sql.css';

export const prerender = true;
---

<BaseLayout
  title="Visual SQL EXPLAIN & Query Plan Explorer"
  description="Interactive PostgreSQL query plan simulator — compare Seq Scan vs B-Tree, fix Hibernate N+1, MVCC isolation, index footprint, connection pool."
  fullBleed={true}
>
  <!-- Topbar Action Slot: Module Dropdown Picker + DB Version Badge -->
  <div slot="topbar-actions" class="flex items-center gap-2">
    <SqlModulePicker />
    <span class="inline-flex items-center gap-1 rounded border border-(--border) bg-(--bg-alt) px-2 py-0.5 text-[10px] font-mono text-cyan-600 dark:text-cyan-400">
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-cyan-400"></span>
      PostgreSQL 16
    </span>
  </div>

  <div class="sql-lab">
    <header class="mb-4">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h1 class="m-0 font-mono text-[clamp(24px,4vw,36px)] font-bold tracking-tight text-(--fg)">
          PostgreSQL Engine Architecture
        </h1>
        <p class="m-0 font-mono text-xs text-(--fg-dim)">
          Query Lifecycle · Volcano Iterator · Shared Buffers · WAL Durability
        </p>
      </div>
    </header>

    <!-- Tab Panels -->
    <EngineTab />
    <ExplainTab />
    <BTreeTab />
    <MvccTab />
    <FootprintTab />
    <InfraTab />
    <PartitionTab />
    <ReplicationTab />
  </div>
</BaseLayout>

<script>
  function initSqlTabs() {
    // Hide empty blog rail on lab pages so 3D workbench expands to full width
    document.documentElement.setAttribute('data-rail', 'hidden');

    const dropdownRoot = document.getElementById('sql-module-picker-root');
    const dropdownBtn  = document.getElementById('btn-sql-module-dropdown');
    const dropdownMenu = document.getElementById('sql-dropdown-menu');
    const titleEl      = document.getElementById('sql-active-module-title');
    const tabs         = document.querySelectorAll<HTMLButtonElement>('[data-sql-tab]');
    const panes        = document.querySelectorAll<HTMLElement>('[data-sql-pane]');
    if (!tabs.length) return;

    // Toggle dropdown
    if (dropdownBtn && dropdownMenu && dropdownBtn.dataset.bound !== 'true') {
      dropdownBtn.dataset.bound = 'true';
      dropdownBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !dropdownMenu.hidden;
        dropdownMenu.hidden = isOpen;
        dropdownBtn.setAttribute('aria-expanded', String(!isOpen));
      });

      document.addEventListener('click', (e) => {
        if (dropdownRoot && !dropdownRoot.contains(e.target as Node)) {
          dropdownMenu.hidden = true;
          dropdownBtn.setAttribute('aria-expanded', 'false');
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !dropdownMenu.hidden) {
          dropdownMenu.hidden = true;
          dropdownBtn.setAttribute('aria-expanded', 'false');
          dropdownBtn.focus();
        }
      });
    }

    const activate = (tab: string, updateHash = true) => {
      tabs.forEach(b => {
        const isTarget = b.dataset.sqlTab === tab;
        b.classList.toggle('is-current', isTarget);
        const pill = b.querySelector<HTMLElement>('[data-sql-pill]');
        if (pill) pill.hidden = !isTarget;
        if (isTarget && titleEl && b.dataset.sqlTitle) {
          titleEl.textContent = b.dataset.sqlTitle;
        }
      });

      panes.forEach(p => {
        p.hidden = p.dataset.sqlPane !== tab;
      });

      if (dropdownMenu && dropdownBtn) {
        dropdownMenu.hidden = true;
        dropdownBtn.setAttribute('aria-expanded', 'false');
      }

      try {
        localStorage.setItem('sql_lab_tab', tab);
        if (updateHash && window.location.hash.slice(1) !== tab) {
          history.replaceState(null, '', '#' + tab);
        }
      } catch {}
    };

    tabs.forEach(btn => {
      if (btn.dataset.bound !== 'true') {
        btn.dataset.bound = 'true';
        btn.addEventListener('click', () => activate(btn.dataset.sqlTab!));
      }
    });

    // 1. Prioritize URL hash (e.g. /lab/sql#btree)
    const hash = window.location.hash.slice(1);
    if (hash && [...tabs].some(b => b.dataset.sqlTab === hash)) {
      activate(hash, false);
      return;
    }

    // 2. Fallback to localStorage
    try {
      const saved = localStorage.getItem('sql_lab_tab');
      if (saved && [...tabs].some(b => b.dataset.sqlTab === saved)) {
        activate(saved, false);
        return;
      }
    } catch {}

    activate('engine', false);
  }

  initSqlTabs();
  document.addEventListener('astro:page-load', initSqlTabs);
</script>
