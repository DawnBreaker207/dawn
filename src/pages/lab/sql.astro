  <!-- ═══════════════════════════════════════════════════════════════════════
       Tab 5 — Infra Tools
  ════════════════════════════════════════════════════════════════════════ -->
  <div data-sql-pane="infra" hidden class="space-y-5">

    <div class="sql-visual-card">
      <p class="sql-visual-title">Two primitives every backend hits in production</p>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">

        <!-- Connection Pool -->
        <div class="sql-explain-box" style="border-color:rgb(34 211 238/0.35)">
          <strong class="text-cyan-400">Connection Pool</strong>
          <p class="mt-1 text-[11px] text-(--fg-dim)">
            Opening a database connection is expensive (~10–50 ms: TCP handshake, auth, SSL). A pool keeps N connections open and reuses them.
            Workers <em>borrow</em> a slot, run their query, and <em>return</em> it.
          </p>
          <div class="sql-pool-diagram mt-3">
            <div class="sql-pool-row">
              {Array.from({length:5}).map((_, i) => (
                <div class:list={["sql-pool-slot-static", i < 3 ? "sql-pool-used" : "sql-pool-free"]}>
                  {i < 3 ? "W" + (i+1) : "—"}
                </div>
              ))}
            </div>
            <p class="text-[10px] text-(--fg-faint) mt-1">Pool size = 5 · 3 workers active · 2 slots free</p>
          </div>
          <p class="mt-2 text-[10px] text-(--fg-faint) border-l-2 border-rose-500/40 pl-2">
            When all slots are taken: new requests <em>queue</em>. If the queue fills too — connection timeout. This is what "pool exhaustion" looks like.
          </p>
        </div>

        <!-- Token Bucket -->
        <div class="sql-explain-box" style="border-color:rgb(251 191 36/0.35)">
          <strong class="text-amber-400">Token Bucket (Rate Limiter)</strong>
          <p class="mt-1 text-[11px] text-(--fg-dim)">
            A bucket holds up to <em>capacity</em> tokens. It refills at <em>fill rate</em> tokens/second. Each incoming request consumes 1 token. If the bucket is empty, the request is dropped.
          </p>
          <div class="sql-bucket-diagram mt-3">
            <div class="sql-bucket-visual">
              <div class="sql-bucket-fill" style="height:60%">
                <span>12</span>
              </div>
              <div class="sql-bucket-cap-label">20</div>
            </div>
            <div class="sql-bucket-info text-[10px] text-(--fg-dim)">
              <div>Capacity: 20 tokens</div>
              <div class="text-emerald-400">Fill: +5 tok/s</div>
              <div class="text-rose-400">Requests: 8 req/s</div>
              <div class="text-amber-400">→ 3 req/s dropped</div>
            </div>
          </div>
          <p class="mt-2 text-[10px] text-(--fg-faint) border-l-2 border-amber-500/40 pl-2">
            Burst traffic up to <em>capacity</em> is absorbed. Sustained traffic above <em>fill rate</em> will always drop some requests.
          </p>
        </div>
      </div>

    </div>

    <InfraTools />

    <details class="group rounded-xl border border-(--border) bg-(--bg-alt) p-4 font-mono text-xs">
      <summary class="flex cursor-pointer select-none items-center justify-between font-semibold text-(--fg)">
