---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ScenarioPicker from '@/components/lab/sql/ScenarioPicker.astro';
import ExecutionOrder from '@/components/lab/sql/ExecutionOrder.astro';
import CaseRouting from '@/components/lab/sql/CaseRouting.astro';
import BTreeTraversal from '@/components/lab/sql/BTreeTraversal.astro';
import MvccVisibility from '@/components/lab/sql/MvccVisibility.astro';
import FootprintCalc from '@/components/lab/sql/FootprintCalc.astro';
import InfraTools from '@/components/lab/sql/InfraTools.astro';
import ExplainOverviewCard from '@/components/lab/sql/ExplainOverviewCard.astro';
import EnginePipeline from '@/components/lab/sql/EnginePipeline.astro';
import { EO_SQL, EO_STEPS, CASE_BRANCHES } from '@/scripts/lab/sql/execution-order';

export const prerender = true;
---

<BaseLayout
  title="Visual SQL EXPLAIN & Query Plan Explorer"
  description="Interactive PostgreSQL query plan simulator — compare Seq Scan vs B-Tree, fix Hibernate N+1, MVCC isolation, index footprint, connection pool."
>
  <header class="mb-5 border-b border-(--border) pb-4">
    <div class="mb-2 flex items-center gap-2">
      <h1 class="m-0 font-mono text-[clamp(28px,4.5vw,48px)] leading-[0.96] tracking-[-0.06em] text-(--fg)">
        sql explain explorer
      </h1>
      <span class="inline-flex items-center gap-1 rounded-full border border-(--border) bg-(--bg-alt) px-2 py-0.5 text-[10px] font-mono text-cyan-600 dark:text-cyan-400">
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-cyan-400"></span>
        PostgreSQL 16
      </span>
    </div>
    <p class="mt-1 text-sm text-(--fg-dim)">
      Query plans, B-tree, MVCC, index sizing, infra — 5 interactive simulations.
    </p>
  </header>

  <!-- Tab bar (Sticky, horizontal-scroll on mobile) -->
  <div id="sql-tab-bar" class="sticky top-0 z-20 mb-5 overflow-x-auto border-b border-(--border) bg-(--bg)/90 backdrop-blur-sm pb-3 pt-2" style="-webkit-overflow-scrolling:touch;scroll-snap-type:x mandatory">
    <div class="flex gap-1.5 font-mono text-xs whitespace-nowrap">
      <button data-sql-tab="engine"    class="sql-tab sql-tab-active">Engine</button>
      <button data-sql-tab="explain"   class="sql-tab">EXPLAIN</button>
      <button data-sql-tab="btree"     class="sql-tab">B-Tree</button>
      <button data-sql-tab="mvcc"      class="sql-tab">MVCC</button>
      <button data-sql-tab="footprint" class="sql-tab">Footprint</button>
      <button data-sql-tab="infra"     class="sql-tab">Infra</button>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       Tab 0 — Engine Pipeline
  ════════════════════════════════════════════════════════════════════════ -->
  <div data-sql-pane="engine" class="space-y-4">

    <!-- Concept strip -->
    <div class="grid grid-cols-3 gap-2 font-mono text-xs">
      <div class="rounded-lg border border-(--border) bg-(--bg-alt) p-2.5 text-center">
        <div class="text-base">🗺️</div>
        <div class="mt-0.5 font-bold text-cyan-500">5 stages</div>
        <div class="text-[10px] text-(--fg-faint)">per query</div>
      </div>
      <div class="rounded-lg border border-(--border) bg-(--bg-alt) p-2.5 text-center">
        <div class="text-base">📦</div>
        <div class="mt-0.5 font-bold text-amber-500">shared_buffers</div>
        <div class="text-[10px] text-(--fg-faint)">page cache</div>
      </div>
      <div class="rounded-lg border border-(--border) bg-(--bg-alt) p-2.5 text-center">
        <div class="text-base">📜</div>
        <div class="mt-0.5 font-bold text-emerald-500">WAL</div>
        <div class="text-[10px] text-(--fg-faint)">durability</div>
      </div>
    </div>

    <EnginePipeline />
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       Tab 1 — EXPLAIN Explorer
  ════════════════════════════════════════════════════════════════════════ -->
  <div data-sql-pane="explain" hidden class="space-y-4">

    <!-- Concept strip -->
    <div class="grid grid-cols-3 gap-2 font-mono text-xs">
      <div class="rounded-lg border border-(--border) bg-(--bg-alt) p-2.5 text-center">
        <div class="text-base">🐌</div>
        <div class="mt-0.5 font-bold text-rose-500">O(n)</div>
        <div class="text-[10px] text-(--fg-faint)">Seq Scan</div>
      </div>
      <div class="rounded-lg border border-(--border) bg-(--bg-alt) p-2.5 text-center">
        <div class="text-base">⚡</div>
        <div class="mt-0.5 font-bold text-emerald-500">O(log n)</div>
        <div class="text-[10px] text-(--fg-faint)">Index Scan</div>
      </div>
      <div class="rounded-lg border border-(--border) bg-(--bg-alt) p-2.5 text-center">
        <div class="text-base">💣</div>
        <div class="mt-0.5 font-bold text-amber-500">N+1</div>
        <div class="text-[10px] text-(--fg-faint)">queries/row</div>
      </div>
    </div>

    <ScenarioPicker />
    <ExecutionOrder eoSql={EO_SQL} eoSteps={EO_STEPS} />

    <details class="group rounded-xl border border-(--border) bg-(--bg-alt)">
      <summary class="flex cursor-pointer select-none items-center justify-between gap-3 p-3 font-mono text-xs text-(--fg-dim) hover:text-(--fg) [&::-webkit-details-marker]:hidden">
        <span class="font-semibold">Visual overview — Seq Scan vs Index, N+1 vs JOIN FETCH</span>
        <svg class="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="border-t border-(--border) p-4">
        <ExplainOverviewCard />
      </div>
    </details>

    <details class="group rounded-xl border border-(--border) bg-(--bg-alt)">
      <summary class="flex cursor-pointer select-none items-center justify-between gap-3 p-3 font-mono text-xs text-(--fg-dim) hover:text-(--fg) [&::-webkit-details-marker]:hidden">
        <span class="font-semibold">More patterns — Hash Join, Covering Index, Anti-Join</span>
        <svg class="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="border-t border-(--border) p-4 space-y-4 font-mono text-xs">
        <CaseRouting caseBranches={CASE_BRANCHES} />
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
          <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
            <div class="mb-1.5 flex items-center gap-1.5">
              <span class="rounded bg-amber-500/15 px-1.5 py-0.5 text-[10px] font-bold text-amber-600 dark:text-amber-400">Hash Join</span>
              <span class="text-(--fg-faint)">vs</span>
              <span class="rounded bg-cyan-500/15 px-1.5 py-0.5 text-[10px] font-bold text-cyan-600 dark:text-cyan-400">Nested Loop</span>
            </div>
            <ul class="space-y-1 text-[11px] text-(--fg-dim) list-none">
              <li>🔶 Hash: build hash table from small side → stream large side. Good for large×large joins.</li>
              <li>🔷 Nested Loop: for each outer row, probe inner index. Good when outer set is tiny.</li>
            </ul>
            <p class="mt-2 border-l-2 border-amber-500/50 pl-2 text-[10px] text-amber-700 dark:text-amber-300">Planner chooses by cost estimate — stale stats silently flip the pick.</p>
          </div>
          <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
            <div class="mb-1.5">
              <span class="rounded bg-emerald-500/15 px-1.5 py-0.5 text-[10px] font-bold text-emerald-600 dark:text-emerald-400">Covering Index</span>
            </div>
            <p class="text-[11px] text-(--fg-dim)">All projected columns live in the index leaf — no heap fetch needed.</p>
            <pre class="sql-pre mt-2">CREATE INDEX idx_orders_cov
  ON orders (customer_id)
  INCLUDE (total_usd, status);
-- → Index Only Scan  Heap Fetches: 0</pre>
          </div>
        </div>
      </div>
    </details>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       Tab 2 — B-Tree
  ════════════════════════════════════════════════════════════════════════ -->
  <div data-sql-pane="btree" hidden class="space-y-4">

    <!-- Concept strip -->
    <div class="grid grid-cols-3 gap-2 font-mono text-xs">
      <div class="rounded-lg border border-(--border) bg-(--bg-alt) p-2.5 text-center">
        <div class="text-base">🌳</div>
        <div class="mt-0.5 font-bold text-cyan-500">≤ 4 levels</div>
        <div class="text-[10px] text-(--fg-faint)">even at 1B rows</div>
      </div>
      <div class="rounded-lg border border-(--border) bg-(--bg-alt) p-2.5 text-center">
        <div class="text-base">📄</div>
        <div class="mt-0.5 font-bold text-amber-500">8 KB</div>
        <div class="text-[10px] text-(--fg-faint)">per page</div>
      </div>
      <div class="rounded-lg border border-(--border) bg-(--bg-alt) p-2.5 text-center">
        <div class="text-base">⚡</div>
        <div class="mt-0.5 font-bold text-emerald-500">O(log n)</div>
        <div class="text-[10px] text-(--fg-faint)">lookup cost</div>
      </div>
    </div>

    <BTreeTraversal />

    <details class="group rounded-xl border border-(--border) bg-(--bg-alt)">
      <summary class="flex cursor-pointer select-none items-center justify-between gap-3 p-3 font-mono text-xs text-(--fg-dim) hover:text-(--fg) [&::-webkit-details-marker]:hidden">
        <span class="font-semibold">B-Tree anatomy — Root → Branch → Leaf → Heap</span>
        <svg class="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="border-t border-(--border) p-4">
    <div class="sql-visual-card">
      <p class="sql-visual-title">Anatomy of a B-Tree index</p>
      <div class="sql-btree-diagram">

        <!-- Root -->
        <div class="sql-btd-level">
          <div class="sql-btd-label">Root<br/><span class="sql-btd-sub">always cached</span></div>
          <div class="sql-btd-nodes">
            <div class="sql-btd-node sql-btd-root">
              <span>25</span><span class="sql-btd-div">|</span><span>60</span>
            </div>
          </div>
        </div>

        <!-- Branch arrows -->
        <div class="sql-btd-arrows">
          <span class="sql-btd-arrow-label">&lt; 25</span>
          <span class="sql-btd-arrow-label">25–60</span>
          <span class="sql-btd-arrow-label">&gt; 60</span>
        </div>

        <!-- Branch level -->
        <div class="sql-btd-level">
          <div class="sql-btd-label">Branch<br/><span class="sql-btd-sub">usually cached</span></div>
          <div class="sql-btd-nodes">
            <div class="sql-btd-node sql-btd-branch"><span>10</span><span class="sql-btd-div">|</span><span>18</span></div>
            <div class="sql-btd-node sql-btd-branch"><span>35</span><span class="sql-btd-div">|</span><span>47</span></div>
            <div class="sql-btd-node sql-btd-branch"><span>72</span><span class="sql-btd-div">|</span><span>88</span></div>
          </div>
        </div>

        <!-- Leaf level -->
        <div class="sql-btd-level">
          <div class="sql-btd-label">Leaf<br/><span class="sql-btd-sub">1 real IO</span></div>
          <div class="sql-btd-nodes sql-btd-leaves">
            <div class="sql-btd-node sql-btd-leaf">3·7·9</div>
            <div class="sql-btd-node sql-btd-leaf sql-btd-leaf-hl">12·<strong>15</strong>·22</div>
            <div class="sql-btd-node sql-btd-leaf">26·31</div>
            <div class="sql-btd-node sql-btd-leaf">…</div>
            <div class="sql-btd-node sql-btd-leaf">…</div>
            <div class="sql-btd-node sql-btd-leaf">…</div>
            <div class="sql-btd-node sql-btd-leaf">…</div>
          </div>
        </div>

        <!-- Heap -->
        <div class="sql-btd-level">
          <div class="sql-btd-label">Heap<br/><span class="sql-btd-sub">actual row</span></div>
          <div class="sql-btd-nodes">
            <div class="sql-btd-node sql-btd-heap">ctid → (page 4, slot 2)<br/>email='dawn@dev.com'</div>
          </div>
        </div>

        <p class="sql-btd-caption">
          Searching for key=15: Root (binary search) → branch [10|18] → leaf [12·<strong>15</strong>·22] → fetch heap row by ctid.
          3 buffer hits. A 1-billion-row table needs just 4 levels.
        </p>
      </div>

      <!-- Split explanation -->
      <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-2">
        <div class="sql-explain-box" style="border-color:rgb(251 191 36/0.3)">
          <strong class="text-amber-600 dark:text-amber-400">When does a node split?</strong>
          <p class="mt-1 text-[11px] text-(--fg-dim)">A node can hold at most 2 keys (in this simulator). When a 3rd key arrives, the middle key <em>bubbles up</em> to the parent and the node splits into two.</p>
          <div class="sql-split-demo mt-2">
            <div class="sql-split-before">
              <span class="sql-btd-node sql-btd-branch" style="font-size:10px">10·<span class="text-amber-700 dark:text-amber-300">20</span>·30</span>
              <span class="sql-split-arrow">+25 →</span>
            </div>
            <div class="sql-split-after">
              <span class="sql-btd-node sql-btd-branch" style="font-size:10px">10·20</span>
              <span class="text-amber-700 dark:text-amber-300 font-mono text-[10px] px-1">↑25 to parent</span>
              <span class="sql-btd-node sql-btd-branch" style="font-size:10px">30</span>
            </div>
          </div>
        </div>
        <div class="sql-explain-box" style="border-color:rgb(34 211 238/0.3)">
          <strong class="text-cyan-600 dark:text-cyan-400">Random vs sequential keys</strong>
          <p class="mt-1 text-[11px] text-(--fg-dim)">Random inserts split pages ~50/50 → ~70% fill factor. Sequential inserts (auto-increment IDs, timestamps) always hit the rightmost leaf → 100% fill, smaller index, but writers contend on the same hot page.</p>
          <pre class="sql-pre mt-2">-- ✓ sequential key — compact, no splits
CREATE TABLE events (
  id    BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  data  JSONB
);

-- ✗ UUID — random, 30% more pages, hot-page contention
id UUID DEFAULT gen_random_uuid() PRIMARY KEY</pre>
          <p class="mt-1.5 text-[10px] text-(--fg-faint) border-l-2 border-cyan-500/40 pl-2">Try in the simulator: insert 1, 2, 3, 4… and compare to inserting 50, 10, 80, 30…</p>
        </div>
      </div>

    </div>
    </div></details>

    <details class="group rounded-xl border border-(--border) bg-(--bg-alt)">
      <summary class="flex cursor-pointer select-none items-center justify-between gap-3 p-3 font-mono text-xs text-(--fg-dim) hover:text-(--fg) [&::-webkit-details-marker]:hidden">
        <span class="font-semibold">Page internals, DDL reference, bloat queries</span>
        <svg class="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="border-t border-(--border) p-4 space-y-4 font-mono text-xs text-(--fg-dim)">
        <pre class="sql-details-pre thin-scrollbar">        ┌───────────────────────────────────────────────┐
        │ header: LSN · high key · right-link → sibling │
        ├───────────────────────────────────────────────┤
 ptr →  │ ItemId 1 · ItemId 2 · ItemId 3 …   (grow down)│
        │                  … free space …               │
        │              (tuples grow up)                 │
        │ ██ key+TID ██ ██ key+TID ██ ██ key+TID ██     │
        └───────────────────────────────────────────────┘
        internal page: ‹pointer · key› pairs — leaf adds the heap TID</pre>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
            <strong class="text-cyan-600 dark:text-cyan-400">Lehman-Yao B-link tree</strong>
            <p class="mt-1">Every page carries a High Key + right-sibling pointer. A reader that descends and finds itself past the High Key just follows the sibling link — no re-descent, no full-path latch. That is the source of PostgreSQL's high-concurrency index claim.</p>
          </div>
          <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
            <strong class="text-cyan-600 dark:text-cyan-400">TID, HOT & index bloat</strong>
            <p class="mt-1">UPDATE on an indexed column inserts a new entry into every index. If no indexed column changed and the new version fits on the same heap page → HOT update: the index still points at the old TID and follows the chain. Bloat = dead index tuples — <code>REINDEX</code> / <code>pg_repack</code> reclaim space.</p>
          </div>
        </div>
        <pre class="sql-details-pre thin-scrollbar">-- Partial index — only rows you actually query
CREATE INDEX idx_orders_pending ON orders (created_at) WHERE status = 'pending';

-- Covering index — skip heap fetch entirely
CREATE INDEX idx_orders_cov ON orders (customer_id) INCLUDE (total_usd, status);

-- Multi-column (left-most prefix rule applies)
CREATE INDEX idx_logs_user_ts ON logs (user_id, created_at DESC);

-- Check usage & bloat
SELECT indexname, idx_scan FROM pg_stat_user_indexes WHERE relname = 'orders';
SELECT relname, n_dead_tup FROM pg_stat_user_tables WHERE n_dead_tup > 10000;</pre>
      </div>
    </details>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       Tab 3 — MVCC
  ════════════════════════════════════════════════════════════════════════ -->
  <div data-sql-pane="mvcc" hidden class="space-y-4">

    <!-- Concept strip -->
    <div class="grid grid-cols-3 gap-2 font-mono text-xs">
      <div class="rounded-lg border border-(--border) bg-(--bg-alt) p-2.5 text-center">
        <div class="text-base">🔓</div>
        <div class="mt-0.5 font-bold text-emerald-500">No lock</div>
        <div class="text-[10px] text-(--fg-faint)">on reads</div>
      </div>
      <div class="rounded-lg border border-(--border) bg-(--bg-alt) p-2.5 text-center">
        <div class="text-base">🏷️</div>
        <div class="mt-0.5 font-bold text-amber-500">xmin / xmax</div>
        <div class="text-[10px] text-(--fg-faint)">per tuple</div>
      </div>
      <div class="rounded-lg border border-(--border) bg-(--bg-alt) p-2.5 text-center">
        <div class="text-base">🧹</div>
        <div class="mt-0.5 font-bold text-cyan-500">VACUUM</div>
        <div class="text-[10px] text-(--fg-faint)">reclaims dead</div>
      </div>
    </div>

    <MvccVisibility />

    <!-- Version chain + isolation levels -->
    <details class="group rounded-xl border border-(--border) bg-(--bg-alt)">
      <summary class="flex cursor-pointer select-none items-center justify-between gap-3 p-3 font-mono text-xs text-(--fg-dim) hover:text-(--fg) [&::-webkit-details-marker]:hidden">
        <span class="font-semibold">Version chain — xmin, xmax, READ COMMITTED vs REPEATABLE READ</span>
        <svg class="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="border-t border-(--border) p-4 space-y-4 font-mono text-xs">
        <p class="text-[11px] text-(--fg-dim)">PostgreSQL <strong class="text-(--fg)">never overwrites a row in place</strong>. Every UPDATE writes a new version and marks the old one dead. Each transaction sees only versions that existed when its snapshot was taken.</p>

        <!-- Version chain -->
        <div class="sql-mvcc-timeline">
          <div class="sql-mvcc-time">
            <span>xid 99</span><span>→</span><span>xid 100 (Txn A: UPDATE)</span><span>→</span><span>xid 101 (COMMIT)</span>
          </div>
          <div class="sql-mvcc-chain">
            <div class="sql-mvcc-ver sql-mvcc-dead">
              <div class="sql-mvcc-ver-head">v1 — DEAD after commit</div>
              <div class="sql-mvcc-ver-fields">
                <span class="sql-mvcc-field"><span class="sql-mvcc-field-lbl">xmin</span><span class="text-amber-600 dark:text-amber-400">99</span></span>
                <span class="sql-mvcc-field"><span class="sql-mvcc-field-lbl">xmax</span><span class="text-rose-600 dark:text-rose-400">100</span></span>
                <span class="sql-mvcc-field"><span class="sql-mvcc-field-lbl">data</span><span class="text-(--fg)">balance 1000</span></span>
              </div>
            </div>
            <div class="sql-mvcc-ver sql-mvcc-live">
              <div class="sql-mvcc-ver-head">v2 — LIVE</div>
              <div class="sql-mvcc-ver-fields">
                <span class="sql-mvcc-field"><span class="sql-mvcc-field-lbl">xmin</span><span class="text-amber-600 dark:text-amber-400">100</span></span>
                <span class="sql-mvcc-field"><span class="sql-mvcc-field-lbl">xmax</span><span class="text-emerald-600 dark:text-emerald-400">∞</span></span>
                <span class="sql-mvcc-field"><span class="sql-mvcc-field-lbl">data</span><span class="text-(--fg)">balance 500</span></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Isolation levels -->
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
          <div class="sql-explain-box" style="border-color:rgb(167 139 250/0.35)">
            <div class="mb-1.5 flex items-center gap-1.5">
              <span class="rounded bg-violet-500/15 px-1.5 py-0.5 text-[10px] font-bold text-violet-600 dark:text-violet-400">READ COMMITTED</span>
              <span class="text-[10px] text-(--fg-faint)">default</span>
            </div>
            <p class="text-[11px] text-(--fg-dim)">Fresh snapshot at <em>each statement</em> — same query, different result within one transaction.</p>
            <pre class="sql-pre mt-2">BEGIN;
SELECT balance WHERE name='Alice'; -- 1000
-- A commits here
SELECT balance WHERE name='Alice'; -- 500 ← non-repeatable!</pre>
          </div>
          <div class="sql-explain-box" style="border-color:rgb(34 211 238/0.35)">
            <div class="mb-1.5">
              <span class="rounded bg-cyan-500/15 px-1.5 py-0.5 text-[10px] font-bold text-cyan-600 dark:text-cyan-400">REPEATABLE READ</span>
            </div>
            <p class="text-[11px] text-(--fg-dim)">One snapshot at <em>first statement</em> — A's commit invisible for the entire transaction.</p>
            <pre class="sql-pre mt-2">BEGIN ISOLATION LEVEL REPEATABLE READ;
SELECT balance WHERE name='Alice'; -- 1000
-- A commits here
SELECT balance WHERE name='Alice'; -- 1000 ← frozen</pre>
          </div>
        </div>
      </div>
    </details>

    <!-- psql reference -->
    <details class="group rounded-xl border border-(--border) bg-(--bg-alt)">
      <summary class="flex cursor-pointer select-none items-center justify-between gap-3 p-3 font-mono text-xs text-(--fg-dim) hover:text-(--fg) [&::-webkit-details-marker]:hidden">
        <span class="font-semibold">Inspect xmin/xmax — psql queries</span>
        <svg class="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="border-t border-(--border) p-4 font-mono text-xs">
        <pre class="sql-details-pre thin-scrollbar">-- Hidden system columns
SELECT xmin, xmax, ctid, * FROM accounts WHERE name = 'Alice';
-- xmin = xid that created this version
-- xmax = xid that deleted/updated it  (0 = still live)
-- ctid  = physical (page, slot) on disk

-- Dead-tuple bloat monitor
SELECT relname, n_live_tup, n_dead_tup,
       round(100.0 * n_dead_tup / nullif(n_live_tup+n_dead_tup,0),1) AS dead_pct
  FROM pg_stat_user_tables WHERE n_dead_tup > 1000 ORDER BY dead_pct DESC;

VACUUM ANALYZE accounts; -- autovacuum does this automatically</pre>
      </div>
    </details>
  </div>

