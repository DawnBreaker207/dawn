---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ScenarioPicker from '@/components/lab/sql/ScenarioPicker.astro';
import ExecutionOrder from '@/components/lab/sql/ExecutionOrder.astro';
import CaseRouting from '@/components/lab/sql/CaseRouting.astro';
import BTreeTraversal from '@/components/lab/sql/BTreeTraversal.astro';
import MvccVisibility from '@/components/lab/sql/MvccVisibility.astro';
import FootprintCalc from '@/components/lab/sql/FootprintCalc.astro';
import InfraTools from '@/components/lab/sql/InfraTools.astro';
import { EO_SQL, EO_STEPS, CASE_BRANCHES } from '@/scripts/lab/sql/execution-order';

export const prerender = true;
---

<BaseLayout
  title="Visual SQL EXPLAIN & Query Plan Explorer"
  description="Interactive PostgreSQL query plan simulator — compare Seq Scan vs B-Tree, fix Hibernate N+1, MVCC isolation, index footprint, connection pool."
>
  <header class="mb-5 border-b border-(--border) pb-4">
    <div class="mb-2 flex items-center">
      <span class="ml-auto inline-flex items-center gap-1 rounded-full border border-(--border) bg-(--bg-alt) px-2 py-0.5 text-[10px] font-mono text-cyan-400">
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-cyan-400"></span>
        PostgreSQL 16 Simulator
      </span>
    </div>
    <h1 class="m-0 font-mono text-[clamp(28px,4.5vw,48px)] leading-[0.96] tracking-[-0.06em] text-(--fg)">
      sql explain explorer
    </h1>
    <p class="mt-2 text-sm leading-relaxed text-(--fg-dim)">
      Five interactive labs — query plans, B-tree internals, MVCC isolation, index sizing, infra rate limiting.
    </p>
  </header>

  <!-- Tab bar -->
  <div id="sql-tab-bar" class="mb-5 flex flex-wrap gap-1.5 border-b border-(--border) pb-3 font-mono text-xs">
    <button data-sql-tab="explain"   class="sql-tab sql-tab-active">⚡ EXPLAIN</button>
    <button data-sql-tab="btree"     class="sql-tab">🌳 B-Tree</button>
    <button data-sql-tab="mvcc"      class="sql-tab">🔀 MVCC</button>
    <button data-sql-tab="footprint" class="sql-tab">📐 Footprint</button>
    <button data-sql-tab="infra"     class="sql-tab">🔌 Infra</button>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       Tab 1 — EXPLAIN Explorer
  ════════════════════════════════════════════════════════════════════════ -->
  <div data-sql-pane="explain" class="space-y-5">

    <!-- Visual: Seq Scan vs Index + N+1 vs JOIN in one card -->
    <div class="sql-visual-card">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">

        <!-- Seq Scan vs Index -->
        <div>
          <p class="sql-visual-title">Index scan vs Seq Scan</p>
          <div class="grid grid-cols-1 gap-2">
            <div class="sql-side sql-side-bad">
              <div class="sql-side-head">
                <span class="sql-badge sql-badge-bad">Seq Scan</span>
                <code class="sql-code-inline">no index</code>
              </div>
              <div class="sql-blocks-row">
                {Array.from({length:8}).map((_, i) => (
                  <div class:list={["sql-block", i === 5 ? "sql-block-target" : "sql-block-plain"]}>
                    {i === 5 ? "✓" : ""}
                  </div>
                ))}
                <span class="sql-blocks-label">…1 M blocks</span>
              </div>
              <p class="sql-side-note">Reads <strong>every block</strong> — O(N). 142 ms.</p>
            </div>
            <div class="sql-side sql-side-good">
              <div class="sql-side-head">
                <span class="sql-badge sql-badge-good">Index Scan</span>
                <code class="sql-code-inline">CREATE INDEX ON users(email)</code>
              </div>
              <div class="sql-tree-mini">
                <div class="sql-tree-node sql-tree-root">[ 50 | 750k ]</div>
                <div class="sql-tree-row">
                  <div class="sql-tree-node sql-tree-branch">[ 25 | 37 ]</div>
                  <div class="sql-tree-node sql-tree-branch">[ 55 | 68 ]</div>
                </div>
                <div class="sql-tree-row">
                  <div class="sql-tree-node sql-tree-leaf sql-tree-leaf-hl">dawn@… ✓</div>
                  <div class="sql-tree-node sql-tree-leaf sql-tree-leaf-dim">…</div>
                  <div class="sql-tree-node sql-tree-leaf sql-tree-leaf-dim">…</div>
                </div>
                <p class="sql-tree-label">3 buffer hits → root → branch → leaf</p>
              </div>
              <p class="sql-side-note">O(log N) regardless of table size. <strong>0.08 ms</strong>.</p>
            </div>
          </div>
        </div>

        <!-- N+1 vs JOIN -->
        <div>
          <p class="sql-visual-title">N+1 vs JOIN FETCH</p>
          <div class="grid grid-cols-1 gap-2">
            <div class="sql-side sql-side-bad">
              <div class="sql-side-head">
                <span class="sql-badge sql-badge-bad">N+1 (lazy load)</span>
              </div>
              <div class="sql-queries-viz">
                <div class="sql-query-row sql-query-root">SELECT * FROM orders LIMIT 10</div>
                {Array.from({length:3}).map((_, i) => (
                  <div class="sql-query-row sql-query-child">
                    ↳ SELECT * FROM items WHERE order_id = {i+1}
                  </div>
                ))}
                <div class="sql-query-row sql-query-child sql-query-dots">↳ … × 10 total = 11 round-trips</div>
              </div>
            </div>
            <div class="sql-side sql-side-good">
              <div class="sql-side-head">
                <span class="sql-badge sql-badge-good">JOIN FETCH</span>
              </div>
              <div class="sql-queries-viz">
                <div class="sql-query-row sql-query-root sql-query-root-good">
                  SELECT o.*, i.* FROM orders o<br/>
                  JOIN items i ON i.order_id = o.id
                </div>
              </div>
              <p class="sql-side-note"><strong>1 round-trip</strong> — database joins, not your app loop.</p>
            </div>
          </div>
        </div>

      </div>
    </div>

    <p id="sp-explain" class="text-xs font-mono text-(--fg-dim)">
      Pick a scenario below and hit <strong>Run</strong> to watch the engine log both strategies.
    </p>
    <ScenarioPicker />
    <ExecutionOrder eoSql={EO_SQL} eoSteps={EO_STEPS} />

    <details class="group rounded-xl border border-(--border) bg-(--bg-alt) p-4 font-mono text-xs">
      <summary class="flex cursor-pointer select-none items-center justify-between font-semibold text-(--fg)">
        <span class="text-(--accent)">🔀 CASE routing + More patterns — Hash Join, Covering Index, Anti-Join</span>
        <span class="text-(--fg-faint) transition-transform group-open:rotate-180">▼</span>
      </summary>
      <div class="mt-4 border-t border-(--border) pt-3 space-y-4">
        <CaseRouting caseBranches={CASE_BRANCHES} />
      </div>
      <div class="mt-4 grid grid-cols-1 gap-4 border-t border-(--border) pt-3 text-(--fg-dim) md:grid-cols-2">
        <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
          <strong class="text-amber-400">Hash Join vs Nested Loop</strong>
          <p class="mt-1">Hash Join: hashes the smaller table into RAM, then streams the larger — best when both sides are large. Nested Loop: for each outer row, probe the inner index — best when the outer set is tiny.</p>
          <p class="mt-1.5 border-l-2 border-amber-500/60 pl-2 text-amber-200/80">The planner chooses by row-count estimates — stale statistics (ANALYZE lag) flip the pick silently.</p>
        </div>
        <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
          <strong class="text-emerald-400">Covering Index</strong>
          <p class="mt-1">Every column the query touches lives in the index leaf — no heap fetch needed → <code>Heap Fetches: 0</code>.</p>
          <pre class="sql-pre mt-2">-- include projected columns to skip heap entirely
CREATE INDEX CONCURRENTLY idx_orders_cov
  ON orders (customer_id)
  INCLUDE (total_usd, status);

SELECT total_usd, status
  FROM orders WHERE customer_id = 42;
-- → Index Only Scan   Heap Fetches: 0</pre>
          <p class="mt-1.5 border-l-2 border-amber-500/60 pl-2 text-amber-200/80">Each heap fetch = one random page read per row. Folding the columns in converts them to a single sequential range scan.</p>
        </div>
      </div>
    </details>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       Tab 2 — B-Tree
  ════════════════════════════════════════════════════════════════════════ -->
  <div data-sql-pane="btree" hidden class="space-y-5">

    <!-- Visual: what a B-tree looks like -->
    <div class="sql-visual-card">
      <p class="sql-visual-title">Anatomy of a B-Tree index — before you use the simulator</p>
      <div class="sql-btree-diagram">

        <!-- Root -->
        <div class="sql-btd-level">
          <div class="sql-btd-label">Root<br/><span class="sql-btd-sub">always cached</span></div>
          <div class="sql-btd-nodes">
            <div class="sql-btd-node sql-btd-root">
              <span>25</span><span class="sql-btd-div">|</span><span>60</span>
            </div>
          </div>
        </div>

        <!-- Branch arrows -->
        <div class="sql-btd-arrows">
          <span class="sql-btd-arrow-label">&lt; 25</span>
          <span class="sql-btd-arrow-label">25–60</span>
          <span class="sql-btd-arrow-label">&gt; 60</span>
        </div>

        <!-- Branch level -->
        <div class="sql-btd-level">
          <div class="sql-btd-label">Branch<br/><span class="sql-btd-sub">usually cached</span></div>
          <div class="sql-btd-nodes">
            <div class="sql-btd-node sql-btd-branch"><span>10</span><span class="sql-btd-div">|</span><span>18</span></div>
            <div class="sql-btd-node sql-btd-branch"><span>35</span><span class="sql-btd-div">|</span><span>47</span></div>
            <div class="sql-btd-node sql-btd-branch"><span>72</span><span class="sql-btd-div">|</span><span>88</span></div>
          </div>
        </div>

        <!-- Leaf level -->
        <div class="sql-btd-level">
          <div class="sql-btd-label">Leaf<br/><span class="sql-btd-sub">1 real IO</span></div>
          <div class="sql-btd-nodes sql-btd-leaves">
            <div class="sql-btd-node sql-btd-leaf">3·7·9</div>
            <div class="sql-btd-node sql-btd-leaf sql-btd-leaf-hl">12·<strong>15</strong>·22</div>
            <div class="sql-btd-node sql-btd-leaf">26·31</div>
            <div class="sql-btd-node sql-btd-leaf">…</div>
            <div class="sql-btd-node sql-btd-leaf">…</div>
            <div class="sql-btd-node sql-btd-leaf">…</div>
            <div class="sql-btd-node sql-btd-leaf">…</div>
          </div>
        </div>

        <!-- Heap -->
        <div class="sql-btd-level">
          <div class="sql-btd-label">Heap<br/><span class="sql-btd-sub">actual row</span></div>
          <div class="sql-btd-nodes">
            <div class="sql-btd-node sql-btd-heap">ctid → (page 4, slot 2)<br/>email='dawn@dev.com'</div>
          </div>
        </div>

        <p class="sql-btd-caption">
          Searching for key=15: Root (binary search) → branch [10|18] → leaf [12·<strong>15</strong>·22] → fetch heap row by ctid.
          3 buffer hits. A 1-billion-row table needs just 4 levels.
        </p>
      </div>

      <!-- Split explanation -->
      <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-2">
        <div class="sql-explain-box" style="border-color:rgb(251 191 36/0.3)">
          <strong class="text-amber-400">When does a node split?</strong>
          <p class="mt-1 text-[11px] text-(--fg-dim)">A node can hold at most 2 keys (in this simulator). When a 3rd key arrives, the middle key <em>bubbles up</em> to the parent and the node splits into two.</p>
          <div class="sql-split-demo mt-2">
            <div class="sql-split-before">
              <span class="sql-btd-node sql-btd-branch" style="font-size:10px">10·<span class="text-amber-300">20</span>·30</span>
              <span class="sql-split-arrow">+25 →</span>
            </div>
            <div class="sql-split-after">
              <span class="sql-btd-node sql-btd-branch" style="font-size:10px">10·20</span>
              <span class="text-amber-300 font-mono text-[10px] px-1">↑25 to parent</span>
              <span class="sql-btd-node sql-btd-branch" style="font-size:10px">30</span>
            </div>
          </div>
        </div>
        <div class="sql-explain-box" style="border-color:rgb(34 211 238/0.3)">
          <strong class="text-cyan-400">Random vs sequential keys</strong>
          <p class="mt-1 text-[11px] text-(--fg-dim)">Random inserts split pages ~50/50 → ~70% fill factor. Sequential inserts (auto-increment IDs, timestamps) always hit the rightmost leaf → 100% fill, smaller index, but writers contend on the same hot page.</p>
          <pre class="sql-pre mt-2">-- ✓ sequential key — compact, no splits
CREATE TABLE events (
  id    BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  data  JSONB
);

-- ✗ UUID — random, 30% more pages, hot-page contention
id UUID DEFAULT gen_random_uuid() PRIMARY KEY</pre>
          <p class="mt-1.5 text-[10px] text-(--fg-faint) border-l-2 border-cyan-500/40 pl-2">Try in the simulator: insert 1, 2, 3, 4… and compare to inserting 50, 10, 80, 30…</p>
        </div>
      </div>

    </div>

    <BTreeTraversal />

    <details class="group rounded-xl border border-(--border) bg-(--bg-alt) p-4 font-mono text-xs">
      <summary class="flex cursor-pointer select-none items-center justify-between font-semibold text-(--fg)">
        <span class="text-(--accent)">📄 Page internals, DDL reference, bloat queries</span>
        <span class="text-(--fg-faint) transition-transform group-open:rotate-180">▼</span>
      </summary>
      <div class="mt-4 space-y-4 border-t border-(--border) pt-3 text-(--fg-dim)">
        <pre class="sql-details-pre thin-scrollbar">        ┌───────────────────────────────────────────────┐
        │ header: LSN · high key · right-link → sibling │
        ├───────────────────────────────────────────────┤
 ptr →  │ ItemId 1 · ItemId 2 · ItemId 3 …   (grow down)│
        │                  … free space …               │
        │              (tuples grow up)                 │
        │ ██ key+TID ██ ██ key+TID ██ ██ key+TID ██     │
        └───────────────────────────────────────────────┘
        internal page: ‹pointer · key› pairs — leaf adds the heap TID</pre>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
            <strong class="text-cyan-400">Lehman-Yao B-link tree</strong>
            <p class="mt-1">Every page carries a High Key + right-sibling pointer. A reader that descends and finds itself past the High Key just follows the sibling link — no re-descent, no full-path latch. That is the source of PostgreSQL's high-concurrency index claim.</p>
          </div>
          <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
            <strong class="text-cyan-400">TID, HOT & index bloat</strong>
            <p class="mt-1">UPDATE on an indexed column inserts a new entry into every index. If no indexed column changed and the new version fits on the same heap page → HOT update: the index still points at the old TID and follows the chain. Bloat = dead index tuples — <code>REINDEX</code> / <code>pg_repack</code> reclaim space.</p>
          </div>
        </div>
        <pre class="sql-details-pre thin-scrollbar">-- Partial index — only rows you actually query
CREATE INDEX idx_orders_pending ON orders (created_at) WHERE status = 'pending';

-- Covering index — skip heap fetch entirely
CREATE INDEX idx_orders_cov ON orders (customer_id) INCLUDE (total_usd, status);

-- Multi-column (left-most prefix rule applies)
CREATE INDEX idx_logs_user_ts ON logs (user_id, created_at DESC);

-- Check usage & bloat
SELECT indexname, idx_scan FROM pg_stat_user_indexes WHERE relname = 'orders';
SELECT relname, n_dead_tup FROM pg_stat_user_tables WHERE n_dead_tup > 10000;</pre>
      </div>
    </details>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       Tab 3 — MVCC
  ════════════════════════════════════════════════════════════════════════ -->
  <div data-sql-pane="mvcc" hidden class="space-y-5">

    <!-- Visual: version chain concept -->
    <div class="sql-visual-card">
      <p class="sql-visual-title">How MVCC keeps reads and writes from blocking each other</p>

      <p class="mb-3 text-[11px] font-mono text-(--fg-dim)">
        PostgreSQL never overwrites a row in place. Every UPDATE writes a <em>new version</em> and marks the old one dead.
        Each transaction sees only the versions that existed when its snapshot was taken.
      </p>

      <!-- Version chain timeline -->
      <div class="sql-mvcc-timeline">
        <!-- Time axis -->
        <div class="sql-mvcc-time">
          <span>xid 99</span><span>→</span><span>xid 100 (Txn A: UPDATE)</span><span>→</span><span>xid 101 (Txn A: COMMIT)</span>
        </div>

        <!-- Row versions -->
        <div class="sql-mvcc-chain">
          <div class="sql-mvcc-ver sql-mvcc-dead">
            <div class="sql-mvcc-ver-head">Row v1 — DEAD after A commits</div>
            <div class="sql-mvcc-ver-fields">
              <span class="sql-mvcc-field"><span class="sql-mvcc-field-lbl">xmin</span><span class="text-amber-400">99</span></span>
              <span class="sql-mvcc-field"><span class="sql-mvcc-field-lbl">xmax</span><span class="text-rose-400">100</span></span>
              <span class="sql-mvcc-field"><span class="sql-mvcc-field-lbl">data</span><span class="text-(--fg)">Alice · balance 1000</span></span>
            </div>
          </div>
          <div class="sql-mvcc-ver sql-mvcc-live">
            <div class="sql-mvcc-ver-head">Row v2 — LIVE</div>
            <div class="sql-mvcc-ver-fields">
              <span class="sql-mvcc-field"><span class="sql-mvcc-field-lbl">xmin</span><span class="text-amber-400">100</span></span>
              <span class="sql-mvcc-field"><span class="sql-mvcc-field-lbl">xmax</span><span class="text-emerald-400">∞</span></span>
              <span class="sql-mvcc-field"><span class="sql-mvcc-field-lbl">data</span><span class="text-(--fg)">Alice · balance 500</span></span>
            </div>
          </div>
        </div>

        <!-- Isolation level comparison -->
        <div class="grid grid-cols-1 gap-3 mt-4 md:grid-cols-2">
          <div class="sql-explain-box" style="border-color:rgb(167 139 250/0.35)">
            <strong class="text-violet-400">READ COMMITTED</strong>
            <p class="mt-1 text-[11px] text-(--fg-dim)">Txn B takes a fresh snapshot at <em>each statement</em>. A SELECT run before Txn A commits sees v1. Run the same SELECT again after the commit → sees v2. Same query, different result within one transaction.</p>
            <pre class="sql-pre mt-2">-- Session B (READ COMMITTED, the default)
BEGIN;
SELECT balance FROM accounts WHERE name='Alice';
-- → 1000  (A hasn't committed yet)

-- ... Txn A commits here ...

SELECT balance FROM accounts WHERE name='Alice';
-- → 500   (sees A's commit — non-repeatable read!)</pre>
            <div class="sql-vis-row mt-1">
              <span class="sql-vis-step">B: SELECT before commit</span><span class="sql-vis-arrow">→</span><span class="sql-vis-result sql-vis-old">v1 (balance 1000)</span>
            </div>
            <div class="sql-vis-row">
              <span class="sql-vis-step">B: SELECT after commit</span><span class="sql-vis-arrow">→</span><span class="sql-vis-result sql-vis-new">v2 (balance 500)</span>
            </div>
          </div>
          <div class="sql-explain-box" style="border-color:rgb(34 211 238/0.35)">
            <strong class="text-cyan-400">REPEATABLE READ</strong>
            <p class="mt-1 text-[11px] text-(--fg-dim)">Txn B takes one snapshot at its <em>first statement</em>. No matter how many times it queries, it always sees the world as it was when the transaction started — Txn A's commit is invisible.</p>
            <pre class="sql-pre mt-2">-- Session B (REPEATABLE READ)
BEGIN ISOLATION LEVEL REPEATABLE READ;
SELECT balance FROM accounts WHERE name='Alice';
-- → 1000

-- ... Txn A commits here ...

SELECT balance FROM accounts WHERE name='Alice';
-- → 1000  (snapshot is frozen — A invisible)
COMMIT;</pre>
            <div class="sql-vis-row mt-1">
              <span class="sql-vis-step">B: SELECT before commit</span><span class="sql-vis-arrow">→</span><span class="sql-vis-result sql-vis-old">v1 (balance 1000)</span>
            </div>
            <div class="sql-vis-row">
              <span class="sql-vis-step">B: SELECT after commit</span><span class="sql-vis-arrow">→</span><span class="sql-vis-result sql-vis-old">v1 (balance 1000) ← same</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <MvccVisibility />

    <details class="group rounded-xl border border-(--border) bg-(--bg-alt) p-4 font-mono text-xs">
      <summary class="flex cursor-pointer select-none items-center justify-between font-semibold text-(--fg)">
        <span class="text-(--accent)">🔬 Inspect xmin/xmax yourself — psql queries</span>
        <span class="text-(--fg-faint) transition-transform group-open:rotate-180">▼</span>
      </summary>
      <div class="mt-4 border-t border-(--border) pt-3">
        <pre class="sql-details-pre thin-scrollbar">-- Hidden system columns on any table
SELECT xmin, xmax, ctid, * FROM accounts WHERE name = 'Alice';
-- xmin = xid that created this version
-- xmax = xid that deleted/updated it  (0 = still live)
-- ctid  = physical (page, slot) on disk

-- Dead-tuple bloat
SELECT relname, n_live_tup, n_dead_tup,
       round(100.0 * n_dead_tup / nullif(n_live_tup+n_dead_tup,0), 1) AS dead_pct
  FROM pg_stat_user_tables WHERE n_dead_tup > 1000 ORDER BY dead_pct DESC;

VACUUM ANALYZE accounts;  -- autovacuum does this; run manually after bulk writes</pre>
      </div>
    </details>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       Tab 4 — Footprint
  ════════════════════════════════════════════════════════════════════════ -->
  <div data-sql-pane="footprint" hidden class="space-y-5">

    <div class="sql-visual-card">
      <p class="sql-visual-title">B-Tree vs BRIN — when does each index type make sense?</p>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div class="sql-explain-box" style="border-color:rgb(34 211 238/0.35)">
          <strong class="text-cyan-400">B-Tree</strong>
          <ul class="mt-1 space-y-1 text-[11px] text-(--fg-dim) list-none">
            <li>✓ Random access, point lookups, range scans</li>
            <li>✓ ORDER BY, GROUP BY on the indexed column</li>
            <li>✓ Equality: <code>WHERE email = '…'</code></li>
            <li>✗ Larger on disk — key + TID per row</li>
            <li>✗ Random inserts cause page splits and bloat</li>
          </ul>
          <p class="mt-2 text-[10px] text-(--fg-faint) border-l-2 border-cyan-500/40 pl-2">Rule: default choice for any indexed column used in WHERE or JOIN.</p>
        </div>
        <div class="sql-explain-box" style="border-color:rgb(251 191 36/0.35)">
          <strong class="text-amber-400">BRIN (Block Range Index)</strong>
          <ul class="mt-1 space-y-1 text-[11px] text-(--fg-dim) list-none">
            <li>✓ Tiny — stores only min/max per 128-page range</li>
            <li>✓ Append-only tables: timestamps, sequential IDs</li>
            <li>✓ Huge tables where B-Tree would be GBs</li>
            <li>✗ Useless if data is not correlated with insert order</li>
            <li>✗ No point lookup — eliminates blocks, not rows</li>
          </ul>
          <p class="mt-2 text-[10px] text-(--fg-faint) border-l-2 border-amber-500/40 pl-2">Rule: only when physical order matches key order — time-series, log tables, event streams.</p>
        </div>
      </div>

    </div>

    <FootprintCalc />

    <details class="group rounded-xl border border-(--border) bg-(--bg-alt) p-4 font-mono text-xs">
      <summary class="flex cursor-pointer select-none items-center justify-between font-semibold text-(--fg)">
        <span class="text-(--accent)">📋 DDL examples + size inspection queries</span>
        <span class="text-(--fg-faint) transition-transform group-open:rotate-180">▼</span>
      </summary>
      <div class="mt-4 grid grid-cols-1 gap-4 border-t border-(--border) pt-3 md:grid-cols-2">
        <div>
          <p class="mb-1 text-[10px] font-semibold text-cyan-400">B-Tree — 1M rows BIGINT ≈ 35 MB</p>
          <pre class="sql-details-pre thin-scrollbar">CREATE INDEX idx_events_ts ON events (created_at);

SELECT pg_size_pretty(pg_relation_size('idx_events_ts'));
-- → 35 MB

SELECT * FROM bt_metap('idx_events_ts');
-- level: 3  (root → branch → leaf)</pre>
        </div>
        <div>
          <p class="mb-1 text-[10px] font-semibold text-amber-400">BRIN — same column ≈ 48 KB (700× smaller)</p>
          <pre class="sql-details-pre thin-scrollbar">CREATE INDEX idx_events_brin
  ON events USING brin (created_at);

SELECT pg_size_pretty(pg_relation_size('idx_events_brin'));
-- → 48 kB

-- Only eliminates pages, not rows
-- ✓ WHERE created_at > now() - '7d'
-- ✗ WHERE user_id = 42  (random dist.)</pre>
        </div>
      </div>
    </details>
