<script>
  function initSqlTabs() {
    const bar = document.getElementById('sql-tab-bar');
    if (!bar) return;
    const tabs  = bar.querySelectorAll<HTMLButtonElement>('[data-sql-tab]');
    const panes = document.querySelectorAll<HTMLElement>('[data-sql-pane]');

    const activate = (tab: string, updateHash = true) => {
      tabs.forEach(b  => b.classList.toggle('sql-tab-active', b.dataset.sqlTab === tab));
      panes.forEach(p => { p.hidden = p.dataset.sqlPane !== tab; });
      try {
        localStorage.setItem('sql_lab_tab', tab);
        if (updateHash && window.location.hash.slice(1) !== tab) {
          history.replaceState(null, '', '#' + tab);
        }
      } catch {}
    };

    tabs.forEach(btn =>
      btn.addEventListener('click', () => activate(btn.dataset.sqlTab!))
    );

    // 1. Prioritize URL hash (e.g. /lab/sql#btree)
    const hash = window.location.hash.slice(1);
    if (hash && [...tabs].some(b => b.dataset.sqlTab === hash)) {
      activate(hash, false);
      return;
    }

    // 2. Fallback to localStorage
    try {
      const saved = localStorage.getItem('sql_lab_tab');
      if (saved && [...tabs].some(b => b.dataset.sqlTab === saved)) {
        activate(saved, false);
        return;
      }
    } catch {}

    activate('engine', false);
  }

  document.addEventListener('astro:page-load', initSqlTabs);
</script>
