    <FootprintCalc />

    <!-- B-Tree vs BRIN comparison -->
    <details class="group rounded-xl border border-(--border) bg-(--bg-alt)">
      <summary class="flex cursor-pointer select-none items-center justify-between gap-3 p-3 font-mono text-xs text-(--fg-dim) hover:text-(--fg) [&::-webkit-details-marker]:hidden">
        <span class="font-semibold">B-Tree vs BRIN — when each type fits</span>
        <svg class="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="border-t border-(--border) p-4 font-mono text-xs">
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
          <div class="sql-explain-box" style="border-color:rgb(34 211 238/0.35)">
            <div class="mb-1.5"><span class="rounded bg-cyan-500/15 px-1.5 py-0.5 text-[10px] font-bold text-cyan-600 dark:text-cyan-400">B-Tree</span></div>
            <ul class="space-y-1 text-[11px] text-(--fg-dim) list-none">
              <li>✓ Point lookups, range scans, ORDER BY</li>
              <li>✓ Equality: <code>WHERE email = '…'</code></li>
              <li>✗ Larger on disk — key + TID per row</li>
              <li>✗ Random inserts cause page splits</li>
            </ul>
            <p class="mt-2 text-[10px] text-(--fg-faint) border-l-2 border-cyan-500/40 pl-2">Default choice for any column in WHERE / JOIN.</p>
          </div>
          <div class="sql-explain-box" style="border-color:rgb(251 191 36/0.35)">
            <div class="mb-1.5"><span class="rounded bg-amber-500/15 px-1.5 py-0.5 text-[10px] font-bold text-amber-600 dark:text-amber-400">BRIN</span></div>
            <ul class="space-y-1 text-[11px] text-(--fg-dim) list-none">
              <li>✓ Tiny — min/max per 128-page range</li>
              <li>✓ Append-only: timestamps, sequential IDs</li>
              <li>✗ Useless if data not correlated with insert order</li>
              <li>✗ Eliminates blocks, not rows</li>
            </ul>
            <p class="mt-2 text-[10px] text-(--fg-faint) border-l-2 border-amber-500/40 pl-2">Only when physical order matches key order.</p>
          </div>
        </div>
      </div>
    </details>

    <!-- DDL reference -->
    <details class="group rounded-xl border border-(--border) bg-(--bg-alt)">
      <summary class="flex cursor-pointer select-none items-center justify-between gap-3 p-3 font-mono text-xs text-(--fg-dim) hover:text-(--fg) [&::-webkit-details-marker]:hidden">
        <span class="font-semibold">DDL examples + size inspection queries</span>
        <svg class="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="border-t border-(--border) p-4 font-mono text-xs">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <div>
            <p class="mb-1 text-[10px] font-semibold text-cyan-600 dark:text-cyan-400">B-Tree — 1M rows BIGINT ≈ 35 MB</p>
            <pre class="sql-details-pre thin-scrollbar">CREATE INDEX idx_events_ts ON events (created_at);

SELECT pg_size_pretty(pg_relation_size('idx_events_ts'));
-- → 35 MB

SELECT * FROM bt_metap('idx_events_ts');
-- level: 3  (root → branch → leaf)</pre>
          </div>
          <div>
            <p class="mb-1 text-[10px] font-semibold text-amber-600 dark:text-amber-400">BRIN — same column ≈ 48 KB (700×)</p>
            <pre class="sql-details-pre thin-scrollbar">CREATE INDEX idx_events_brin
  ON events USING brin (created_at);

SELECT pg_size_pretty(pg_relation_size('idx_events_brin'));
-- → 48 kB

-- ✓ WHERE created_at > now() - '7d'
-- ✗ WHERE user_id = 42  (random dist.)</pre>
          </div>
        </div>
      </div>
    </details>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       Tab 5 — Infra Tools
  ════════════════════════════════════════════════════════════════════════ -->
  <div data-sql-pane="infra" hidden class="space-y-4">

    <!-- Concept strip -->
    <div class="grid grid-cols-3 gap-2 font-mono text-xs">
      <div class="rounded-lg border border-(--border) bg-(--bg-alt) p-2.5 text-center">
        <div class="text-base">🔄</div>
        <div class="mt-0.5 font-bold text-cyan-500">Pool</div>
        <div class="text-[10px] text-(--fg-faint)">reuse N conns</div>
      </div>
      <div class="rounded-lg border border-(--border) bg-(--bg-alt) p-2.5 text-center">
        <div class="text-base">🪣</div>
        <div class="mt-0.5 font-bold text-amber-500">Bucket</div>
        <div class="text-[10px] text-(--fg-faint)">burst → drop</div>
      </div>
      <div class="rounded-lg border border-(--border) bg-(--bg-alt) p-2.5 text-center">
        <div class="text-base">⚙️</div>
        <div class="mt-0.5 font-bold text-emerald-500">HikariCP</div>
        <div class="text-[10px] text-(--fg-faint)">cores×2 + disks</div>
      </div>
    </div>

    <InfraTools />

    <!-- Pool + Token bucket explanation -->
    <details class="group rounded-xl border border-(--border) bg-(--bg-alt)">
      <summary class="flex cursor-pointer select-none items-center justify-between gap-3 p-3 font-mono text-xs text-(--fg-dim) hover:text-(--fg) [&::-webkit-details-marker]:hidden">
        <span class="font-semibold">Connection pool &amp; token bucket — how they work</span>
        <svg class="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="border-t border-(--border) p-4 font-mono text-xs">
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
          <div class="sql-explain-box" style="border-color:rgb(34 211 238/0.35)">
            <div class="mb-1.5"><span class="rounded bg-cyan-500/15 px-1.5 py-0.5 text-[10px] font-bold text-cyan-600 dark:text-cyan-400">Connection Pool</span></div>
            <p class="text-[11px] text-(--fg-dim)">Opening a DB connection costs ~10–50 ms (TCP + auth + SSL). A pool keeps N connections open and <em>reuses</em> them — workers borrow a slot, run the query, return it.</p>
            <div class="sql-pool-diagram mt-3">
              <div class="sql-pool-row">
                {Array.from({length:5}).map((_, i) => (
                  <div class:list={["sql-pool-slot-static", i < 3 ? "sql-pool-used" : "sql-pool-free"]}>
                    {i < 3 ? "W" + (i+1) : "—"}
                  </div>
                ))}
              </div>
              <p class="text-[10px] text-(--fg-faint) mt-1">Pool 5 · 3 active · 2 free</p>
            </div>
            <p class="mt-2 text-[10px] text-(--fg-faint) border-l-2 border-rose-500/40 pl-2">All slots taken → requests queue → timeout. That is pool exhaustion.</p>
          </div>
          <div class="sql-explain-box" style="border-color:rgb(251 191 36/0.35)">
            <div class="mb-1.5"><span class="rounded bg-amber-500/15 px-1.5 py-0.5 text-[10px] font-bold text-amber-600 dark:text-amber-400">Token Bucket</span></div>
            <p class="text-[11px] text-(--fg-dim)">Bucket holds up to <em>capacity</em> tokens, refills at <em>fill rate</em>/s. Each request consumes 1 token. Empty bucket → request dropped.</p>
            <div class="sql-bucket-diagram mt-3">
              <div class="sql-bucket-visual">
                <div class="sql-bucket-fill" style="height:60%"><span>12</span></div>
                <div class="sql-bucket-cap-label">20</div>
              </div>
              <div class="sql-bucket-info text-[10px] text-(--fg-dim)">
                <div>Capacity: 20 tokens</div>
                <div class="text-emerald-600 dark:text-emerald-400">Fill: +5 tok/s</div>
                <div class="text-rose-600 dark:text-rose-400">Requests: 8 req/s</div>
                <div class="text-amber-600 dark:text-amber-400">→ 3 req/s dropped</div>
              </div>
            </div>
            <p class="mt-2 text-[10px] text-(--fg-faint) border-l-2 border-amber-500/40 pl-2">Burst up to capacity is absorbed. Sustained above fill rate always drops.</p>
          </div>
        </div>
      </div>
    </details>

    <!-- Config reference -->
    <details class="group rounded-xl border border-(--border) bg-(--bg-alt)">
      <summary class="flex cursor-pointer select-none items-center justify-between gap-3 p-3 font-mono text-xs text-(--fg-dim) hover:text-(--fg) [&::-webkit-details-marker]:hidden">
        <span class="font-semibold">Config reference — HikariCP &amp; Express rate-limit</span>
        <svg class="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="border-t border-(--border) p-4 font-mono text-xs">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <div>
            <p class="mb-1 text-[10px] font-semibold text-cyan-600 dark:text-cyan-400">HikariCP (Spring Boot)</p>
            <pre class="sql-details-pre thin-scrollbar">spring.datasource.hikari.maximum-pool-size=20
spring.datasource.hikari.minimum-idle=5
spring.datasource.hikari.connection-timeout=3000
spring.datasource.hikari.idle-timeout=600000
spring.datasource.hikari.max-lifetime=1800000

# Rule: pool = (cores × 2) + disk spindles
# 4 cores, SSD → ~10 is usually optimal</pre>
          </div>
          <div>
            <p class="mb-1 text-[10px] font-semibold text-amber-600 dark:text-amber-400">express-rate-limit (Node.js)</p>
            <pre class="sql-details-pre thin-scrollbar">{"import rateLimit from 'express-rate-limit';\napp.use('/api/', rateLimit({\n  windowMs: 1000, max: 10,\n  standardHeaders: true,\n  handler: (_req, res) =>\n    res.status(429).json({ error: 'rate limited' })\n}));\n// HTTP 429 + Retry-After header"}</pre>
          </div>
        </div>
      </div>
    </details>
  </div>
</BaseLayout>

<style is:global>
  /* ── Tab bar ───────────────────────────────────────────────────────────── */
  .sql-tab {
    border-radius: 6px; border: 1px solid var(--border);
    background: var(--bg); padding: 5px 14px;
    font-size: 11px; font-family: monospace;
    color: var(--fg-dim); cursor: pointer;
    transition: color .15s, border-color .15s, background .15s;
    touch-action: manipulation;
    scroll-snap-align: start;
    min-height: 36px;
    white-space: nowrap;
    display: inline-flex; align-items: center;
  }
  .sql-tab:hover { color: var(--fg); }
  .sql-tab-active {
    border-color: var(--accent); color: var(--accent);
    background: color-mix(in oklch, var(--accent) 8%, transparent);
  }

  /* ── Shared visual card shell ──────────────────────────────────────────── */
  .sql-visual-card {
    border-radius: 12px; border: 1px solid var(--border);
    background: var(--bg-alt); padding: 16px; font-family: monospace; font-size: 12px;
  }
  .sql-visual-title {
    font-size: 11px; font-weight: 700; color: var(--fg);
    text-transform: uppercase; letter-spacing: .06em; margin-bottom: 12px;
  }
  .sql-explain-box {
    border-radius: 8px; border: 1px solid var(--border);
    background: var(--bg); padding: 10px 12px; font-size: 12px;
  }
  .sql-explain-box p, .sql-explain-box ul { margin: 0; }

  /* ── Seq Scan vs Index ─────────────────────────────────────────────────── */
  .sql-side { border-radius: 8px; border: 1px solid; background: var(--bg); padding: 10px 12px; }
  .sql-side-bad  { border-color: rgb(248 113 113/0.35); }
  .sql-side-good { border-color: rgb(74 222 128/0.35); }
  .sql-side-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 8px; }
  .sql-side-note { font-size: 10px; color: var(--fg-dim); margin: 6px 0 0; line-height: 1.5; }
  .sql-side-note strong { color: var(--fg); }
  .sql-badge {
    border-radius: 4px; padding: 1px 8px; font-size: 10px; font-weight: 700;
    text-transform: uppercase; letter-spacing: .04em; border: 1px solid;
  }
  .sql-badge-bad  { border-color: rgb(220 38 38/0.5); color: #dc2626; background: rgb(220 38 38/0.08); }
  .sql-badge-good { border-color: rgb(22 163 74/0.5); color: #16a34a; background: rgb(22 163 74/0.08); }
  :where(.dark, .dark *) .sql-badge-bad  { border-color: rgb(248 113 113/0.5); color: #f87171; background: rgb(248 113 113/0.1); }
  :where(.dark, .dark *) .sql-badge-good { border-color: rgb(74 222 128/0.5); color: #4ade80; background: rgb(74 222 128/0.1); }
  .sql-code-inline { font-size: 10px; color: var(--fg-faint); }
  .sql-pre {
    margin-top: 6px; font-size: 10px; line-height: 1.6;
    background: var(--terminal); border: 1px solid var(--border);
    border-radius: 6px; padding: 8px 10px; color: var(--fg);
    overflow-x: auto; white-space: pre;
  }
  :where(.dark, .dark *) .sql-pre { color: var(--fg-dim); }

  /* Block row for Seq Scan diagram */
  .sql-blocks-row {
    display: flex; flex-wrap: wrap; gap: 3px; align-items: center; margin: 6px 0;
  }
  .sql-block {
    width: 22px; height: 22px; border-radius: 3px; border: 1px solid;
    display: flex; align-items: center; justify-content: center;
    font-size: 9px; font-weight: 700;
  }
  .sql-block-plain  { border-color: rgb(148 163 184/0.4); background: rgb(148 163 184/0.1); color: var(--fg-faint); }
  .sql-block-target { border-color: rgb(220 38 38/0.6); background: rgb(220 38 38/0.12); color: #dc2626; }
  :where(.dark, .dark *) .sql-block-plain  { border-color: rgb(148 163 184/0.2); background: rgb(148 163 184/0.06); }
  :where(.dark, .dark *) .sql-block-target { border-color: rgb(248 113 113/0.6); background: rgb(248 113 113/0.15); color: #f87171; }
  .sql-blocks-label { font-size: 10px; color: var(--fg-faint); }

  /* Mini tree for Index Scan diagram */
  .sql-tree-mini { display: flex; flex-direction: column; align-items: center; gap: 4px; margin: 6px 0; }
  .sql-tree-row  { display: flex; gap: 6px; }
  .sql-tree-node { border-radius: 5px; border: 1px solid; padding: 3px 8px; font-size: 10px; text-align: center; }
