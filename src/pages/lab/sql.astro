  id      BIGINT,
  user_id BIGINT
) PARTITION BY HASH (user_id);

-- 4 even shards
CREATE TABLE orders_0
  PARTITION OF orders
  FOR VALUES WITH (MODULUS 4, REMAINDER 0);

CREATE TABLE orders_1
  PARTITION OF orders
  FOR VALUES WITH (MODULUS 4, REMAINDER 1);
-- ... 2, 3`}</pre>
            <p class="text-[10px] text-(--fg-faint) border-l-2 border-violet-500/40 pl-2">Even distribution. No pruning on range queries — only equality on the hash key.</p>
