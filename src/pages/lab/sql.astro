  }
  .sql-query-root  { border-color: rgb(220 38 38/0.5); color: var(--fg); }
  .sql-query-root-good { border-color: rgb(22 163 74/0.5) !important; }
  .sql-query-child { border-color: rgb(220 38 38/0.3); margin-left: 12px; }
  :where(.dark, .dark *) .sql-query-root  { border-color: rgb(248 113 113/0.5); }
  :where(.dark, .dark *) .sql-query-root-good { border-color: rgb(74 222 128/0.4) !important; }
  :where(.dark, .dark *) .sql-query-child { border-color: rgb(248 113 113/0.25); }
  .sql-query-dots  { opacity: .6; }

  /* ── B-Tree diagram ────────────────────────────────────────────────────── */
  .sql-btree-diagram { display: flex; flex-direction: column; gap: 6px; }
  .sql-btd-level { display: flex; align-items: center; gap: 12px; }
  .sql-btd-label { font-size: 9px; color: var(--fg-faint); text-align: right; width: 60px; flex-shrink: 0; line-height: 1.4; }
  .sql-btd-sub   { color: var(--fg-faint); font-weight: 400; }
  .sql-btd-nodes { display: flex; gap: 6px; flex-wrap: wrap; }
  .sql-btd-node  {
    border-radius: 5px; border: 1px solid; padding: 4px 10px;
    font-size: 11px; display: flex; gap: 4px; align-items: center;
  }
  .sql-btd-root   { border-color: rgb(8 145 178/0.6); color: #0e7490; background: rgb(8 145 178/0.1); }
  .sql-btd-branch { border-color: rgb(8 145 178/0.3); color: var(--fg-dim); background: rgb(8 145 178/0.04); }
  .sql-btd-leaf   { border-color: rgb(148 163 184/0.4); color: var(--fg-faint); font-size: 10px; padding: 3px 7px; }
  .sql-btd-leaf-hl { border-color: rgb(22 163 74/0.5); color: #16a34a; background: rgb(22 163 74/0.08); }
  .sql-btd-leaves { gap: 4px; }
  .sql-btd-heap   { border-color: rgb(161 98 7/0.5); color: #92400e; background: rgb(161 98 7/0.06); font-size: 10px; line-height: 1.5; }
  .sql-btd-div    { color: rgb(148 163 184/0.5); }
  :where(.dark, .dark *) .sql-btd-root   { border-color: rgb(34 211 238/0.6); color: #67e8f9; background: rgb(34 211 238/0.1); }
  :where(.dark, .dark *) .sql-btd-branch { border-color: rgb(34 211 238/0.3); background: rgb(34 211 238/0.04); }
  :where(.dark, .dark *) .sql-btd-leaf   { border-color: rgb(148 163 184/0.2); }
  :where(.dark, .dark *) .sql-btd-leaf-hl { border-color: rgb(74 222 128/0.5); color: #4ade80; background: rgb(74 222 128/0.08); }
  :where(.dark, .dark *) .sql-btd-heap   { border-color: rgb(251 191 36/0.4); color: #fbbf24; background: rgb(251 191 36/0.06); }
  :where(.dark, .dark *) .sql-btd-div    { color: rgb(148 163 184/0.3); }
  .sql-btd-arrows { display: flex; gap: 0; padding-left: 74px; }
  .sql-btd-arrow-label { flex: 1; text-align: center; font-size: 9px; color: var(--fg-faint); }
  .sql-btd-caption { font-size: 10px; color: var(--fg-dim); line-height: 1.5; margin-top: 6px; padding-left: 74px; }
  .sql-split-demo  { display: flex; flex-direction: column; gap: 4px; }
  .sql-split-before, .sql-split-after { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .sql-split-arrow { font-size: 10px; color: var(--fg-faint); }

  /* ── MVCC timeline ─────────────────────────────────────────────────────── */
  .sql-mvcc-timeline { display: flex; flex-direction: column; gap: 8px; }
  .sql-mvcc-time {
    display: flex; gap: 8px; align-items: center; flex-wrap: wrap;
    font-size: 10px; color: var(--fg-faint); padding-bottom: 6px;
    border-bottom: 1px dashed var(--border);
  }
