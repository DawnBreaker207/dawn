---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LabSimCard from '@/components/LabSimCard.astro';

export const prerender = true;

// One route, condenses Java-Lab + JVM lab + Spring internals into switchable tabs.
// Each tab: one-line explanation, a drawn mechanism, a code sliver. Nothing else.
interface JavaTab {
  id: string;
  title: string;
  badge: string;
  tone: string;
  explain: string;
  why: string;
  flow: string;
  diagram: string;
  code: string;
}

interface SubTopic {
  id: string;
  label: string;
  explain: string;
  why: string;
  flow: string;
  diagram: string;
  code: string;
}

// Four concurrency engine models, switched by a <select> inside one tab.
const SUBS: SubTopic[] = [
  {
    id: 'threads',
    label: 'Threads & Monitors',
    explain:
      'Picture a bathroom with one mirror: new Thread() builds the person object, start() actually sends them to work. Every Java object IS a tiny bathroom (one built-in monitor door) — one thread inside, others park at the door (BLOCKED), and wait() moves holders into the waiting room until notify() calls them back.',
    why: 'Why does the lock live INSIDE every object? Because the monitor must protect that exact data — gluing the lock to the object means anyone who can reach the field can also coordinate access, with no extra lock registry to lose, forget or order wrong.',
    flow: 'Read it left to right: new Thread() only builds an object on your heap — the real OS thread appears the moment start() runs. From RUNNABLE there are exactly three exits: monitor taken first → park as BLOCKED in the entry set; holder calls wait() → move to the wait set until notify(); run() finishes → TERMINATED and the OS thread is gone.',
    diagram: `
      <div class="jx-row"><span class="jx-n">new Thread()</span><span class="jx-a">→</span><span class="jx-n">start()</span><span class="jx-a">→</span><span class="jx-n hot">RUNNABLE</span></div>
      <div class="jx-row pl-4"><span class="jx-a">├</span><span class="jx-n">monitor taken</span><span class="jx-a">→</span><span class="jx-n bad">BLOCKED</span><span class="jx-tag">entry set</span></div>
      <div class="jx-row pl-4"><span class="jx-a">├</span><span class="jx-n">wait()</span><span class="jx-a">→</span><span class="jx-n">WAITING</span><span class="jx-tag">needs notify()</span></div>
      <div class="jx-row pl-4"><span class="jx-a">└</span><span class="jx-n">run() returns</span><span class="jx-a">→</span><span class="jx-n io">TERMINATED</span></div>
    `,
    code: `synchronized void add(int v) { shared.add(v); } // ONE monitor guards shared state
new Thread(() -> add(1)).start();  // racing free-for-all = lost updates
// deadlock: T1 locks A wants B · T2 locks B wants A — always lock in one order`,
  },
  {
    id: 'executor',
    label: 'Thread Pools',
    explain:
      'A pool is a small kitchen: a few permanent cooks (core), a waiting shelf (queue), cooks you may call in only when the shelf is full (max), and a rule for a FULL night (rejection). The famous trap: extra cooks are hired only AFTER the shelf overflows — not merely because the core cooks are busy.',
    why: 'Why the odd order (core → queue → extra threads)? Threads are EXPENSIVE — ~1 MB of OS stack each. The queue absorbs cheap bursts so the pool only pays for extra threads when demand is proven to persist.',
    flow: 'Every task walks the same admission ladder: idle core? take it. Cores busy? wait on the queue shelf. Shelf full? hire a max cook. Kitchen and shelf both full? the rejection policy throws the order away. That ladder is the entire lifecycle of one execute() call.',
    diagram: `
      <div class="jx-row"><span class="jx-n">submit(task)</span><span class="jx-a">→</span><span class="jx-n hot">core free?</span><span class="jx-a">→</span><span class="jx-n io">run</span></div>
      <div class="jx-row pl-4"><span class="jx-a">├</span><span class="jx-n">queue full?</span><span class="jx-a">→</span><span class="jx-n">spawn up to max</span></div>
      <div class="jx-row pl-4"><span class="jx-a">└</span><span class="jx-n">max+queue busy</span><span class="jx-a">→</span><span class="jx-n bad">reject</span><span class="jx-tag">CallerRuns = backpressure</span></div>
      <div class="jx-row"><span class="jx-tag">CPU-bound ≈ cores · IO-bound ≈ cores × (1 + wait/compute)</span></div>
    `,
    code: `new ThreadPoolExecutor(4, 16, 60, SECONDS,
    new ArrayBlockingQueue<>(100), new ThreadPoolExecutor.CallerRunsPolicy());`,
  },
  {
    id: 'completable',
    label: 'CompletableFuture',
    explain:
      'CompletableFuture is a chain of callbacks, like connecting flights: when leg A lands, leg B departs by itself — you never stand at the gate blocking. Errors travel down the chain as values too, and exceptionally() is the built-in detour when a leg crashes.',
    why: 'Why callbacks instead of get()? Every get() parks a whole thread just to wait. Composition lets each thread run whatever is READY next, so a few threads can drive hundreds of in-flight stages without blocking anyone.',
    flow: 'Read it like connecting flights: supplyAsync departs leg A, thenApply is boarded the instant A lands, the two parallel legs race and applyToEither picks whoever arrives first. exceptionally() is the rebooking desk — it fires only when a leg crashes. join() at the end just reads the final boarding pass.',
    diagram: `
      <div class="jx-row"><span class="jx-n">supplyAsync(io)</span><span class="jx-a">→</span><span class="jx-n">thenApply</span><span class="jx-a">→</span><span class="jx-n">thenCompose</span></div>
      <div class="jx-row"><span class="jx-n">cf1.thenCombine(cf2)</span><span class="jx-a">→</span><span class="jx-n io">join()</span><span class="jx-tag">no parking</span></div>
      <div class="jx-row"><span class="jx-n bad">exception</span><span class="jx-a">→</span><span class="jx-n">exceptionally</span><span class="jx-tag">error = just another stage</span></div>
    `,
    code: `supplyAsync(() -> fetchUser(id), ioPool)
    .thenCompose(u -> api.balance(u))
    .exceptionally(ex -> ZERO)
    .thenAccept(out::send);`,
  },
  {
    id: 'virtual',
    label: 'Virtual Threads (JDK 21)',
    explain:
      'A virtual thread is a cheap, make-believe thread the JVM juggles for you. When it blocks on IO, the JVM saves its stack to the heap (unmount), frees the real carrier thread, and mounts another VT — like putting a book aside mid-page and reading a different one, with no bookshelf cost.',
    why: 'Why park stacks to the heap instead of the OS? A real OS thread costs ~1 MB of kernel memory and a syscall to juggle; a parked VT is just plain bytes in Java heap — that is how millions of idle tasks sit on top of a handful of carriers.',
    flow: 'One carrier (real thread) mounts a VT and runs it; IO blocks → the JVM copies that stack into the heap and the carrier instantly mounts the NEXT VT; IO completes → resume from the snapshot. The diagram is one loop — mount, block, unmount, remount — and no OS thread ever sits idle waiting.',
    diagram: `
      <div class="jx-row"><span class="jx-n hot">1M VTs</span><span class="jx-a">→</span><span class="jx-n">few carriers (ForkJoin)</span></div>
      <div class="jx-row"><span class="jx-n">IO blocks</span><span class="jx-a">→</span><span class="jx-n io">UNMOUNT</span><span class="jx-a">→</span><span class="jx-tag">stack saved to heap, carrier free</span></div>
      <div class="jx-row"><span class="jx-n bad">pinning</span><span class="jx-a">→</span><span class="jx-tag">synchronized / native frames can NOT unmount — use ReentrantLock</span></div>
    `,
    code: `try (var ex = Executors.newVirtualThreadPerTaskExecutor()) {
    ex.submit(() -> fetch(i));   // one VT per task — never pool VTs
}`,
  },
];

interface SimCaseData {
  label: string;
  steps: { log: string; explain: string; tone?: 'info' | 'warn' | 'error' }[];
}

// Cases per topic — one entry per runnable case button. Modeled 1-1 on the
// JVM GC visualizer: every step logs one line and explains itself in the banner.
const SIMCASES: Record<string, SimCaseData[]> = {
  threads: [
    {
      label: '⚡ unlocked race',
      steps: [
        { log: '[T-1] reads shared count = 0', explain: 'Both threads hit the same field with no lock — whoever writes last wins. Count starts at 0.', tone: 'info' },
        { log: '[T-2] reads count = 0 (stale!)', explain: 'T-2 reads BEFORE T-1 commits: the two reads overlap inside the race window.', tone: 'warn' },
        { log: 'both write → expected 2 · actual 1 (lost update)', explain: 'Read-modify-write is 3 machine ops; without a monitor they interleave arbitrarily and one add evaporates.', tone: 'error' },
        { log: 'fix: synchronized add() or AtomicInteger', explain: 'One monitor (or a CAS) makes the read-modify-write atomic — the race window closes for good.', tone: 'info' },
      ],
    },
    {
      label: '🔒 monitor guarded',
      steps: [
        { log: '[T-1] enters synchronized(add) — monitor ACQUIRED', explain: 'The object monitor is handed to T-1; only one thread can be inside at a time.', tone: 'info' },
        { log: '[T-2] monitor taken → BLOCKED · parked 140 µs', explain: 'T-2 parks in the entry set — an OS-level park costing ~1–10 µs vs nanoseconds uncontended.', tone: 'warn' },
        { log: '[T-1] add(1) done → releases monitor', explain: 'synchronized is reentrant: T-1 could legally re-lock its own monitor without self-deadlocking.', tone: 'info' },
        { log: '[T-2] acquires → add(2) done', explain: 'Queued waiters progress roughly FIFO, but barging is legal — fairness is not guaranteed.', tone: 'info' },
        { log: 'both TERMINATED · race-free', explain: 'ONE monitor guarding the shared list = correctness; the contended taps are the price.', tone: 'info' },
      ],
    },
    {
      label: '💀 deadlock',
      steps: [
        { log: '[T-1] locks A → wants B', explain: 'T-1 holds A and now blocks asking for B — half way into the cycle.', tone: 'info' },
        { log: '[T-2] locks B → wants A', explain: 'Opposite lock order is the classic poison: T-2 holds B and asks for A.', tone: 'warn' },
        { log: 'circular wait — both WAIT forever', explain: 'Neither thread releases; the JVM will never unwind a deadlock for you (no auto-recovery).', tone: 'error' },
        { log: 'fix: global lock ORDER A→B · or tryLock + timeout', explain: 'Consistent ordering removes the cycle; tryLock converts deadlock into a retryable timeout.', tone: 'info' },
      ],
    },
  ],
  executor: [
    {
      label: '▶ steady flow',
      steps: [
        { log: 'pool warm: core=2 · queue=1 · max=4', explain: 'Four knobs govern everything: core size, queue capacity, max threads, rejection policy.', tone: 'info' },
        { log: 'submit c1 → core worker W1 runs', explain: 'Idle cores execute immediately.', tone: 'info' },
        { log: 'submit c2 → core worker W2 runs', explain: 'All cores busy now — next submits head to the queue.', tone: 'info' },
        { log: 'submit c3 → queue (1/1)', explain: 'Extra tasks queue once every core is busy.', tone: 'warn' },
        { log: 'submit c4 → queue FULL → spawn extra W3', explain: 'THE surprise: pool extras spawn only AFTER the queue fills, not when cores are busy.', tone: 'warn' },
        { log: 'submit c5 → W4 (max reached)', explain: 'No more threads may spawn — capacity is locked.', tone: 'info' },
        { log: 'W1 done → pulls c3 · 0 rejected', explain: 'The queue feeds freed workers; steady state, nothing lost.', tone: 'info' },
      ],
    },
    {
      label: '💥 rejection',
      steps: [
        { log: 'core+queue+max all saturated', explain: '4 workers busy, queue holds its 1 slot.', tone: 'info' },
        { log: 'submit c6 → RejectedExecutionException (AbortPolicy)', explain: 'The DEFAULT policy throws on the caller thread — callers must catch it or lose the task.', tone: 'error' },
        { log: 'swap CallerRunsPolicy → the submitter runs c6 itself', explain: 'The producer slows down to consumer speed instead of throwing: natural backpressure.', tone: 'info' },
        { log: 'steady: 0 drops · latency grows at the producer', explain: 'The queue cap bounds how far production may run ahead of consumption.', tone: 'warn' },
      ],
    },
    {
      label: '🌙 idle drain',
      steps: [
        { log: 'peak passed: queue empty · extras idle', explain: 'Extras above core size are transient burst capacity.', tone: 'info' },
        { log: 'idle > keepAlive (60 s) → extras terminate', explain: 'Wind-down on demand is what keeps a pooled fleet lean between bursts.', tone: 'warn' },
        { log: 'core = 2 stays warm', explain: 'Core threads are permanent — allowCoreThreadTimeOut(false) by default.', tone: 'info' },
      ],
    },
  ],
  completable: [
    {
      label: '✅ happy pipeline',
      steps: [
        { log: 'supplyAsync(fetchUser) → io-pool thread A', explain: 'Pass an explicit executor — the default commonPool is sized cores-1 and wants your IO.', tone: 'info' },
        { log: 'thenApply(addPremium) · runs on thread A', explain: 'Callbacks run on whichever thread completes the stage — no forced hop unless you use *Async.', tone: 'info' },
        { log: 'thenCompose(fetchBalance) → thread B', explain: 'Compose flattens a future-of-future: one chain, one final value.', tone: 'info' },
        { log: 'thenCombine(discount) · waits for BOTH stages', explain: 'Two independent sources joined — the wait is cooperative, nobody parks.', tone: 'info' },
        { log: 'exceptionally skipped — happy path', explain: 'Fallback exists but never fires this run.', tone: 'info' },
        { log: 'thenAccept(sendInvoice) · 38 ms · 0 blocked', explain: 'Wall time is the longest stage, not the sum — and no thread was ever parked.', tone: 'info' },
      ],
    },
    {
      label: '⛔ failure path',
      steps: [
        { log: 'fetchUser THROWS (404 not found)', explain: 'The stage completes with an exception instead of a value.', tone: 'error' },
        { log: 'thenApply / thenCompose skipped', explain: 'A broken stage short-circuits every normal downstream callback.', tone: 'warn' },
        { log: 'exceptionally(ex) → fallback ZERO', explain: 'The error bends back into the value world as data.', tone: 'info' },
        { log: 'pipeline completes normally — consumer unharmed', explain: 'try/catch becomes composition: errors are just another stage.', tone: 'info' },
      ],
    },
    {
      label: '🕳 join() trap',
      steps: [
        { log: 'cf.join() called inside a pool task', explain: 'join() BLOCKS its calling thread — parking sneaks back in through the side door.', tone: 'warn' },
        { log: 'caller stack = commonPool worker', explain: 'Blocking commonPool workers starves every other parallel operation on the JVM.', tone: 'error' },
        { log: 'worst case: same pool owns upstream stages → deadlock', explain: 'A child stage may never get a worker: the pool is waiting on itself.', tone: 'error' },
        { log: 'fix: stay composed · or pass your own executor', explain: 'Compose > block, always.', tone: 'info' },
      ],
    },
  ],
  virtual: [
    {
      label: '📈 1M-task storm',
      steps: [
        { log: 'spawn 1,000,000 VTs (one per task)', explain: 'Virtual threads are NOT pooled — one thread per task is the idiomatic shape.', tone: 'info' },
        { log: 'scheduled over 4 carrier threads', explain: 'Carriers = ForkJoin workers ≈ CPU cores; everything else is cheap memory.', tone: 'info' },
        { log: 'VT-1 calls jdbc.query() → IO stall', explain: 'A blocking call would be fatal on platform threads; here it is routine.', tone: 'info' },
        { log: 'UNMOUNT: stack → heap · carrier freed', explain: 'Parking is a heap copy, not an OS wait: microseconds, not milliseconds.', tone: 'info' },
        { log: 'VT-2 remounts carrier-1 (same id, new stack)', explain: 'Continuations resume with the same thread identity the code always sees.', tone: 'info' },
        { log: 'drain: 820 ms wall · 4 OS threads only', explain: 'Blocking IO at a million concurrency with four OS threads.', tone: 'info' },
      ],
    },
    {
      label: '📌 pinning',
      steps: [
        { log: 'synchronized(jdbcConn) wraps a blocking call', explain: 'Owning an intrinsic monitor PINS the VT to its carrier.', tone: 'warn' },
        { log: 'IO stall → can NOT unmount', explain: 'The held frame must stay on the carrier stack — unmounting is impossible.', tone: 'error' },
        { log: 'carrier stuck → other VTs starve silently', explain: 'No exception, no stack trace — just throughput quietly evaporating.', tone: 'warn' },
        { log: 'at 1M scale: a 4-carrier pool behaves like 3', explain: 'Every pinned VT permanently removes one carrier from the fleet.', tone: 'error' },
      ],
    },
    {
      label: '🔓 repaired',
      steps: [
        { log: 'swap synchronized → ReentrantLock', explain: 'ReentrantLock is not an intrinsic monitor, so unmounting stays free.', tone: 'info' },
        { log: 'IO stall → UNMOUNT clean', explain: 'The virtual thread parks to the heap as designed.', tone: 'info' },
        { log: 'carriers rotate 1M VTs · 820 ms wall', explain: 'Same load, same four threads — the collapse is gone.', tone: 'info' },
      ],
    },
    {
      label: '⚙ scheduler internals',
      steps: [
        { log: 'ForkJoinPool.commonPool: 4 carrier threads (= CPU cores)', explain: 'The carrier pool is sized to physical cores; the VT scheduler sits on top as a cooperative layer.', tone: 'info' },
        { log: 'VT scheduler: work-stealing deque per carrier', explain: 'Each carrier has its own task queue; idle carriers steal from busy ones.', tone: 'info' },
        { log: 'VT-1 mounts carrier-0, runs until IO', explain: 'Mount = copy heap stack to carrier stack frame, resume execution.', tone: 'info' },
        { log: 'IO → UNMOUNT: continuation parked in heap', explain: 'Continuation object holds the entire stack in a byte array ~few KB.', tone: 'info' },
        { log: 'carrier-0 free → steals VT-47 from carrier-2 deque', explain: 'Work-stealing keeps all carriers busy without a central scheduler.', tone: 'info' },
        { log: 'IO completes → VT-1 rescheduled to whichever carrier is free', explain: 'Thread affinity is LOST after unmount — do NOT use ThreadLocal for state you need post-IO.', tone: 'warn' },
      ],
    },
  ],
  string: [
    {
      label: '🔗 pool hit',
      steps: [
        { log: 'a = "code" → literal resolved → pool entry created', explain: 'A string literal compiles to a constant; the JVM places it in the pool the first time it is seen.', tone: 'info' },
        { log: 'b = "code" → SAME pool entry reused', explain: 'Identical literals share one pooled object — zero new allocation.', tone: 'info' },
        { log: 'a == b → true (same identity)', explain: 'Identity equality holds because both variables point at the same pooled instance.', tone: 'info' },
        { log: 'a.hashCode() → cached in the String field', explain: 'The hash is computed once, then reused: Strings are ideal map keys at zero re-hash cost.', tone: 'info' },
      ],
    },
    {
      label: '🆕 heap copy & intern',
      steps: [
        { log: 's3 = new String("code") → separate heap object', explain: 'Explicit new always allocates a fresh object outside the pool, even though "code" is pooled.', tone: 'info' },
        { log: 's3 == a → false · s3.equals(a) → true', explain: 'Same characters, different identity: compare content with equals, identity with ==.', tone: 'warn' },
        { log: 's3.intern() == a → true', explain: 'intern() hands back the pooled twin — classic trick to trade memory dedup for lookup cost.', tone: 'info' },
        { log: 'pool lives on the heap since JDK 7', explain: 'Unreferenced pool entries are weakly referenced and can be collected — no PermGen leaks any more.', tone: 'info' },
      ],
    },
    {
      label: '🧵 concat in loop',
      steps: [
        { log: 'String s = ""; loop i in 1..100k: s += i', explain: 'Each += copies the ENTIRE accumulated prefix into a fresh object: O(N²) bytes over the loop.', tone: 'warn' },
        { log: '100,000 intermediate Strings created', explain: 'The compiler cannot fix a loop-level concat — the objects are per-iteration garbage.', tone: 'error' },
        { log: 'StringBuilder sb; sb.append(i) → one char[]', explain: 'The backing array doubles when full: occasional array copy, amortized O(1) per char.', tone: 'info' },
        { log: 'same 100k: ~2,800 ms vs ~4 ms', explain: 'That is the whole lesson: concat in loops ALWAYS goes to StringBuilder.', tone: 'info' },
      ],
    },
  ],
  lambda: [
    {
      label: '🎯 target typing',
      steps: [
        { log: 'val = x -> x >= 18  (no type written!)', explain: 'A lambda has no standalone type — only the assignment target gives it meaning.', tone: 'info' },
        { log: 'target = Predicate<Integer> → test(Integer) found', explain: 'The compiler hunts a functional interface: exactly one abstract method matching the shape.', tone: 'info' },
        { log: 'assign the same expr to Runnable → COMPILE ERROR', explain: 'A Runnable returns void: same source text, different target, rejected because shapes disagree.', tone: 'warn' },
        { log: 'vs anonymous class: no extra .class file emitted', explain: 'javac records the body as a private synthetic method — the class spins up lazily via invokedynamic.', tone: 'info' },
      ],
    },
    {
      label: '🪄 method refs ×4',
      steps: [
        { log: 'Integer::parseInt → static method ref', explain: 'The lambda body becomes a direct call: n -> Integer.parseInt(n).', tone: 'info' },
        { log: 'String::toUpperCase → unbound ref', explain: 'The RECEIVER becomes argument #1: s -> s.toUpperCase().', tone: 'info' },
        { log: 'System.out::println → bound instance ref', explain: 'The instance is captured once; the lambda supplies only the remaining args.', tone: 'info' },
        { log: 'ArrayList::new → constructor ref', explain: 'All four kinds are just shorter spellings — javac unfolds them into the same shape.', tone: 'info' },
      ],
    },
    {
      label: '🔒 effective finality',
      steps: [
        { log: 'int n = 4; lambda x -> x + n ✓ compiles', explain: 'The captured value is copied into the lambda instance: effectively final is the contract.', tone: 'info' },
        { log: 'n++ inside the lambda → COMPILE ERROR', explain: 'Captured locals must stay effectively final — the snapshot would silently invite race conditions.', tone: 'error' },
        { log: 'mutation via fields or AtomicBoolean works', explain: 'Objects escape by reference — the lambda shares them, read-write, at understood cost.', tone: 'info' },
        { log: 'inside a lambda this = enclosing instance', explain: 'Unlike anonymous classes, a lambda has no this of its own — a frequent review finding.', tone: 'warn' },
      ],
    },
  ],
  io: [
    {
      label: '🪆 decorator batching',
      steps: [
        { log: 'bare FileInputStream.read() → 1 syscall', explain: 'Every read crosses user→kernel: ~1 µs of overhead swamps the single byte fetched.', tone: 'info' },
        { log: 'read a 1 KB file byte-by-byte → 1,024 syscalls', explain: 'A thousand context switches for one kilobyte — IO time is syscall time.', tone: 'warn' },
        { log: 'wrap BufferedInputStream(8 KB) → 1 syscall / 8 KB', explain: 'The decorator fills its internal array with big reads; app code drains from memory.', tone: 'info' },
        { log: 'try-with-resources auto-closes → fd recycled', explain: 'close() runs even mid-exception: file descriptors are a leakable OS resource.', tone: 'info' },
      ],
    },
    {
      label: '🚚 transferTo zero-copy',
      steps: [
        { log: 'byte[] loop copy: disk→kernel buf→user buf', explain: 'Two hops per chunk, CPU copies every byte through user space.', tone: 'warn' },
        { log: '…then user buf→socket kernel buf', explain: 'The third hop — the classic InputStream.transfer loop is 2 copies + 2 syscalls per chunk.', tone: 'warn' },
        { log: 'FileChannel.transferTo → ONE sendfile syscall', explain: 'Page cache streams straight into the socket buffer inside the kernel.', tone: 'info' },
        { log: 'CPU freed · throughput ≈ ×3', explain: 'This is how Kafka and nginx serve files: move bytes in the kernel, not in Java.', tone: 'info' },
      ],
    },
    {
      label: '🔤 charset boundary',
      steps: [
        { log: 'InputStream sees bytes: 0xC3 0xA9', explain: 'A byte stream delivers numbers only — text meaning comes from a charset decision.', tone: 'info' },
        { log: 'decode as UTF-8 → "é"', explain: 'Two bytes form one code point with UTF-8.', tone: 'info' },
        { log: 'decode as Windows-1252 → "Ã©"', explain: 'Same bytes, wrong charset = the classic mojibake — the data is corrupted byte-level.', tone: 'error' },
        { log: 'Reader/Writer wrap bytes WITH a charset', explain: 'Always pass StandardCharsets.UTF_8 explicitly; the platform default is the trap.', tone: 'info' },
      ],
    },
  ],
  collections: [
    {
      label: '🔄 hash lifecycle',
      steps: [
        { log: 'put("dawn") hash 0x2f → bin 15', explain: 'hash & (n-1) masks to a bucket — power-of-two capacity makes it one AND instruction.', tone: 'info' },
        { log: 'put("ben") → bin 7', explain: 'Uniform hashing distributes keys across the table.', tone: 'info' },
        { log: 'put("cat") → bin 15 collision → equals walk', explain: 'A bin collision means a walk; equals() confirms identity — why equals/hashCode must agree.', tone: 'info' },
        { log: 'bin 15 grows to 9 → TREEIFY → red-black', explain: 'Long bins upgrade to RB-trees: O(log n) worst case replaces O(n).', tone: 'info' },
        { log: 'size 13 > 0.75×16=12 → RESIZE ×2 · rehash all', explain: 'Every entry is re-hashed on resize — pre-size large maps to dodge the spike.', tone: 'warn' },
        { log: 'get("dawn") → 1 probe, hit', explain: 'Amortized O(1) — the point of the whole design.', tone: 'info' },
      ],
    },
    {
      label: '🧟 mutable key',
      steps: [
        { log: 'put(key) → bin 3', explain: 'Entry parked by the hash at insert time.', tone: 'info' },
        { log: 'key.name mutated → hashCode changes', explain: 'The stored bucket no longer matches the computed hash.', tone: 'warn' },
        { log: 'get(key) → new hash → new bin → EMPTY', explain: 'The entry is UNREACHABLE — silent data loss inside a plain HashMap.', tone: 'error' },
        { log: 'remove(key) also fails — the entry leaks', explain: 'Neither lookup nor removal can find it: permanent garbage inside the bin.', tone: 'error' },
        { log: 'rule: keys must be immutable', explain: 'String/record keys have final fields — safe by construction.', tone: 'info' },
      ],
    },
    {
