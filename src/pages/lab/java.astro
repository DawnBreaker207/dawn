---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SUBS, TABS } from '@/scripts/lab/java/java-tabs';
import { SIMCASES, SIM_VIZ } from '@/data/java';
import JavaRegularTab from '@/components/lab/java/JavaRegularTab.astro';
import JavaConcurrencyTab from '@/components/lab/java/JavaConcurrencyTab.astro';
import JavaJvmTab from '@/components/lab/java/JavaJvmTab.astro';
import JavaConceptPicker from '@/components/lab/java/JavaConceptPicker.astro';
import '@/styles/lab-java.css';

export const prerender = true;
---

<BaseLayout
  title="Java & Spring Lab"
  description="Java concurrency, collections, strings, streams, lambdas, generics, exceptions, classloading and JIT, IO, JVM memory, Spring IoC, AOP, JPA, Security, meta-programming, Web/REST, testing, auto-configuration, transactions, async events, messaging and externalized config — one route, tab by concept, every mechanism drawn."
  fullBleed={true}
>
  <!-- Topbar Action Slot: Segment Switcher + Concept Dropdown Picker + Version Badge -->
  <div slot="topbar-actions" class="flex items-center gap-2">
    <div class="inline-flex rounded-lg border border-(--border) bg-(--bg-alt) p-0.5 font-mono text-[11px] shadow-sm">
      <button
        type="button"
        data-jx-segment="java"
        class="jx-seg-btn cursor-pointer rounded-md px-2 py-0.5 font-mono font-semibold transition-all bg-(--fg) text-(--bg) shadow-sm"
      >
        ☕ Java
      </button>
      <button
        type="button"
        data-jx-segment="spring"
        class="jx-seg-btn cursor-pointer rounded-md px-2 py-0.5 font-mono font-semibold transition-all text-(--fg-dim) hover:text-(--fg)"
      >
        🍃 Spring
      </button>
    </div>
    <JavaConceptPicker />
    <span class="hidden sm:inline-flex items-center gap-1 rounded border border-(--border) bg-(--bg-alt) px-2 py-0.5 text-[10px] text-amber-500 font-mono">
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-amber-500"></span>
      Java 21 · Spring 6
    </span>
  </div>

  <div class="java-lab" data-sims={JSON.stringify({ cases: SIMCASES, viz: SIM_VIZ })}>
    <!-- Active Concept Content Panels (Full-bleed stage) -->
    <div class="flex-1 min-h-0 overflow-hidden relative">
      {TABS.map((tab, index) => (
        <section data-jx-panel={tab.id} hidden={index !== 0} class="h-full">
          {tab.id === 'jvm'
            ? <JavaJvmTab tab={tab} />
            : tab.id === 'concurrency'
              ? <JavaConcurrencyTab tab={tab} subs={SUBS} simcases={SIMCASES} simviz={SIM_VIZ} />
              : <JavaRegularTab tab={tab} cases={SIMCASES[tab.id] ?? []} viz={SIM_VIZ[tab.id] ?? []} />
          }
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  import { registerTab, bootEngine, initJVMVisualizer } from '@/scripts/lab/java/sim-engine';

  function initJavaLabUI() {
    // Hide empty blog rail on lab pages so 3D workbench expands to full width
    document.documentElement.setAttribute('data-rail', 'hidden');

    // 1. Register simulation data into engine
    const root = document.querySelector<HTMLElement>('[data-sims]');
    if (root) {
      try {
        const p = JSON.parse(root.dataset.sims ?? '{}');
        const cases: Record<string, unknown[]> = p.cases ?? {};
        const viz: Record<string, unknown[]> = p.viz ?? {};
        for (const topic of Object.keys(cases)) {
          registerTab(topic, { cases: cases[topic] as never, viz: (viz[topic] ?? []) as never });
        }
      } catch { /* malformed JSON — skip */ }
    }

    bootEngine();
    initJVMVisualizer();

    // 2. Setup Segment Controller
    const segButtons = document.querySelectorAll<HTMLButtonElement>('[data-jx-segment]');
    const springTabIds = new Set([
      'ioc', 'scope', 'aop', 'jpa', 'security', 'metaprog', 'web', 'testing',
      'autoconfig', 'tx', 'async', 'messaging', 'config'
    ]);

    const setSegment = (seg: 'java' | 'spring') => {
      segButtons.forEach((btn) => {
        const active = btn.dataset.jxSegment === seg;
        btn.className = active
          ? 'jx-seg-btn cursor-pointer rounded-md px-2 py-0.5 font-mono font-semibold transition-all bg-(--fg) text-(--bg) shadow-sm'
          : 'jx-seg-btn cursor-pointer rounded-md px-2 py-0.5 font-mono font-semibold transition-all text-(--fg-dim) hover:text-(--fg)';
      });
    };

    segButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetSeg = btn.dataset.jxSegment as 'java' | 'spring';
        setSegment(targetSeg);
        const currentActiveBtn = document.querySelector<HTMLElement>('[data-jx-tab].border-\\(--fg\\)');
        const currentId = currentActiveBtn?.dataset.jxTab ?? '';
        const inSpring = springTabIds.has(currentId);
        if ((targetSeg === 'spring' && !inSpring) || (targetSeg === 'java' && inSpring)) {
          const firstTabInSeg = document.querySelector<HTMLElement>(`[data-jx-seg="${targetSeg}"]`);
          firstTabInSeg?.click();
        }
      });
    });

    // 3. Dropdown Menu & Search Filter Handling
    const dropdownRoot = document.getElementById('java-concept-picker-root');
    const dropdownBtn  = document.getElementById('btn-java-concept-dropdown');
    const dropdownMenu = document.getElementById('java-concept-dropdown-menu');
    const titleEl      = document.getElementById('java-active-concept-title');
    const searchInput  = document.getElementById('java-concept-search') as HTMLInputElement | null;
    const tabBtns      = document.querySelectorAll<HTMLElement>('[data-jx-tab]');

    if (dropdownBtn && dropdownMenu && dropdownBtn.dataset.bound !== 'true') {
      dropdownBtn.dataset.bound = 'true';
      dropdownBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !dropdownMenu.hidden;
        dropdownMenu.hidden = isOpen;
        dropdownBtn.setAttribute('aria-expanded', String(!isOpen));
        if (!isOpen && searchInput) {
          setTimeout(() => searchInput.focus(), 50);
        }
      });

      document.addEventListener('click', (e) => {
        if (dropdownRoot && !dropdownRoot.contains(e.target as Node)) {
          dropdownMenu.hidden = true;
          dropdownBtn.setAttribute('aria-expanded', 'false');
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !dropdownMenu.hidden) {
          dropdownMenu.hidden = true;
          dropdownBtn.setAttribute('aria-expanded', 'false');
          dropdownBtn.focus();
        }
      });
    }

    if (searchInput && searchInput.dataset.bound !== 'true') {
      searchInput.dataset.bound = 'true';
      searchInput.addEventListener('input', () => {
        const query = searchInput.value.toLowerCase().trim();
        tabBtns.forEach((btn) => {
          const text = (btn.textContent ?? '').toLowerCase();
          const matches = !query || text.includes(query);
          btn.style.display = matches ? '' : 'none';
        });
      });
    }

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (dropdownMenu && dropdownBtn) {
          dropdownMenu.hidden = true;
          dropdownBtn.setAttribute('aria-expanded', 'false');
        }
        const id = btn.dataset.jxTab ?? '';
        const inSpring = springTabIds.has(id);
        setSegment(inSpring ? 'spring' : 'java');
        if (titleEl) {
          titleEl.textContent = btn.querySelector('.java-item-text')?.textContent ?? btn.textContent ?? '';
        }
      });
    });

    // 4. Auto-detect segment from initial Hash
    const initialHash = window.location.hash.slice(1);
    if (initialHash && springTabIds.has(initialHash)) {
      setSegment('spring');
    } else {
      setSegment('java');
    }
  }

  initJavaLabUI();
  document.addEventListener('astro:page-load', initJavaLabUI);
</script>

<style is:global>
  .jx-btn {
    font-family: var(--font-mono, ui-monospace, monospace) !important;
    font-size: 12px !important;
    line-height: 1rem !important;
  }
  .jx-seg-btn {
    font-family: var(--font-mono, ui-monospace, monospace) !important;
    font-size: 11px !important;
    line-height: 1rem !important;
  }
  .jx-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11px;
    padding: 0.22rem 0;
  }
  .jx-n {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--fg);
    padding: 0.28rem 0.6rem;
    white-space: nowrap;
  }
  .jx-n.hot { border-color: rgb(245 158 11 / 0.55); color: rgb(252 211 77); }
  .jx-n.io  { border-color: rgb(16 185 129 / 0.5); color: rgb(110 231 183); }
  .jx-n.bad { border-color: rgb(244 63 94 / 0.5); color: rgb(253 164 175); }
  .jx-a { color: var(--fg-faint); }
  .jx-tag { color: var(--fg-faint); font-size: 10px; }
  @media (max-width: 380px) {
    .jx-n {
      gap: 0.2rem;
      padding: 0.2rem 0.4rem;
    }
  }
</style>
