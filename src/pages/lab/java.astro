---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SUBS, TABS } from '@/scripts/lab/java/java-tabs';
import { SIMCASES, SIM_VIZ } from '@/scripts/lab/java/java-data';
import JavaRegularTab from '@/components/JavaRegularTab.astro';
import JavaConcurrencyTab from '@/components/JavaConcurrencyTab.astro';
import JavaJvmTab from '@/components/JavaJvmTab.astro';

export const prerender = true;

// Segment 1: Core Java (12 concepts)
const JAVA_GROUPS = [
  { short: 'Runtime', ids: ['concurrency', 'jvm', 'jmm', 'io'] },
  { short: 'Memory', ids: ['collections', 'string'] },
  { short: 'Language', ids: ['streams', 'lambda', 'modern', 'generics', 'jit', 'errors'] },
];

// Segment 2: Spring Boot (13 concepts)
const SPRING_GROUPS = [
  { short: 'Core', ids: ['ioc', 'scope', 'aop', 'autoconfig'] },
  { short: 'Data', ids: ['jpa', 'tx'] },
  { short: 'Enterprise', ids: ['security', 'web', 'async', 'messaging', 'config', 'testing', 'metaprog'] },
];

const SHORT: Record<string, string> = {
  concurrency: 'Concurrency', jvm: 'JVM/GC', jmm: 'JMM', io: 'IO/NIO',
  collections: 'Collections', string: 'String',
  streams: 'Streams', lambda: 'Lambda', modern: 'Records', generics: 'Generics', jit: 'JIT', errors: 'Errors',
  ioc: 'IoC', scope: 'Scope', aop: 'AOP', autoconfig: 'Autoconfig',
  jpa: 'JPA', tx: 'Transactions',
  security: 'Security', web: 'Web/REST', async: 'Async', messaging: 'Messaging', config: 'Config', testing: 'Testing', metaprog: 'Meta',
};
---

<BaseLayout
  title="Java & Spring Lab"
  description="Java concurrency, collections, strings, streams, lambdas, generics, exceptions, classloading and JIT, IO, JVM memory, Spring IoC, AOP, JPA, Security, meta-programming, Web/REST, testing, auto-configuration, transactions, async events, messaging and externalized config — one route, tab by concept, every mechanism drawn."
>
  <header class="mb-6 border-b border-(--border) pb-5">
    <div class="mb-2 flex items-center gap-2">
      <h1 class="m-0 font-mono text-[clamp(28px,4.5vw,48px)] leading-[0.96] tracking-[-0.06em] text-(--fg)">
        java &amp; spring lab
      </h1>
      <span class="inline-flex items-center gap-1 rounded-full border border-(--border) bg-(--bg-alt) px-2.5 py-0.5 text-[10px] text-amber-500 font-mono">
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-amber-500"></span>
        Java 21 · Spring 6
      </span>
    </div>
    <p class="mt-1 text-sm text-(--fg-dim)">
      Core theory, hand-drawn mechanics, concise code — 25 step-by-step simulations.
    </p>
  </header>

  <div class="space-y-5" data-sims={JSON.stringify({ cases: SIMCASES, viz: SIM_VIZ })}>
    <!-- Segment Control -->
    <div class="space-y-2.5">
      <div class="flex items-center">
        <!-- Root Segment Switcher -->
        <div class="inline-flex rounded-xl border border-(--border) bg-(--bg-alt) p-1 font-mono text-xs shadow-sm">
          <button
            type="button"
            data-jx-segment="java"
            class="jx-seg-btn cursor-pointer rounded-lg px-4 py-2 font-mono text-xs font-semibold transition-all bg-(--fg) text-(--bg) shadow-sm"
          >
            ☕ Core Java (12)
          </button>
          <button
            type="button"
            data-jx-segment="spring"
            class="jx-seg-btn cursor-pointer rounded-lg px-4 py-2 font-mono text-xs font-semibold transition-all text-(--fg-dim) hover:text-(--fg)"
          >
            🍃 Spring Boot (13)
          </button>
        </div>
      </div>

      <!-- Segment 1: Core Java Tabs -->
      <div data-jx-seg-content="java" class="rounded-xl border border-(--border) bg-(--bg-alt) p-2.5 space-y-1.5">
        {JAVA_GROUPS.map((grp) => (
          <div class="flex flex-wrap items-center gap-1.5">
            <span class="w-16 shrink-0 font-mono text-[10px] uppercase tracking-wider text-(--fg-faint)">{grp.short}</span>
            {grp.ids.map((id) => {
              const tab = TABS.find((t) => t.id === id);
              if (!tab) return null;
              return (
                <button
                  type="button"
                  data-jx-tab={tab.id}
                  class="jx-btn cursor-pointer rounded-lg border border-(--border) bg-(--bg) px-2.5 py-1.5 text-xs font-mono font-semibold text-(--fg-dim) transition-all hover:border-(--fg-dim) hover:text-(--fg) touch-manipulation min-h-[34px]"
                >
                  {SHORT[tab.id] ?? tab.title}
                </button>
              );
            })}
          </div>
        ))}
      </div>

      <!-- Segment 2: Spring Boot Tabs -->
      <div data-jx-seg-content="spring" hidden class="rounded-xl border border-(--border) bg-(--bg-alt) p-2.5 space-y-1.5">
        {SPRING_GROUPS.map((grp) => (
          <div class="flex flex-wrap items-center gap-1.5">
            <span class="w-16 shrink-0 font-mono text-[10px] uppercase tracking-wider text-(--fg-faint)">{grp.short}</span>
            {grp.ids.map((id) => {
              const tab = TABS.find((t) => t.id === id);
              if (!tab) return null;
              return (
                <button
                  type="button"
                  data-jx-tab={tab.id}
                  class="jx-btn cursor-pointer rounded-lg border border-(--border) bg-(--bg) px-2.5 py-1.5 text-xs font-mono font-semibold text-(--fg-dim) transition-all hover:border-(--fg-dim) hover:text-(--fg) touch-manipulation min-h-[34px]"
                >
                  {SHORT[tab.id] ?? tab.title}
                </button>
              );
            })}
          </div>
        ))}
      </div>
    </div>

    <!-- Active Concept Content Panels -->
    {TABS.map((tab, index) => (
      <section data-jx-panel={tab.id} hidden={index !== 0}>
        <div class="mb-2 flex items-center justify-between border-b border-(--border) pb-2">
          <div class="flex items-center gap-2">
            <span class="text-md font-semibold tracking-tight text-(--fg)">{tab.title}</span>
          </div>
          <span class={`rounded-sm border border-(--border) px-1.5 py-0.5 font-mono text-[10px] ${tab.tone}`}>{tab.badge}</span>
        </div>
        {tab.id === 'jvm'
          ? <JavaJvmTab tab={tab} />
          : tab.id === 'concurrency'
            ? <JavaConcurrencyTab tab={tab} subs={SUBS} simcases={SIMCASES} simviz={SIM_VIZ} />
            : <JavaRegularTab tab={tab} cases={SIMCASES[tab.id] ?? []} viz={SIM_VIZ[tab.id] ?? []} />
        }
      </section>
    ))}
  </div>
</BaseLayout>

<script>
  import { registerTab, bootEngine, initJVMVisualizer } from '@/scripts/lab/java/sim-engine';

  function initJavaLabUI() {
    // 1. Register simulation data into engine
    const root = document.querySelector<HTMLElement>('[data-sims]');
    if (root) {
      try {
        const p = JSON.parse(root.dataset.sims ?? '{}');
        const cases: Record<string, unknown[]> = p.cases ?? {};
        const viz: Record<string, unknown[]> = p.viz ?? {};
        for (const topic of Object.keys(cases)) {
          registerTab(topic, { cases: cases[topic] as never, viz: (viz[topic] ?? []) as never });
        }
      } catch { /* malformed JSON — skip */ }
    }

    bootEngine();
    initJVMVisualizer();

    // 2. Setup Segment Controller
    const segButtons = document.querySelectorAll<HTMLButtonElement>('[data-jx-segment]');
    const segContents = document.querySelectorAll<HTMLElement>('[data-jx-seg-content]');

    const springTabIds = new Set([
      'ioc', 'scope', 'aop', 'jpa', 'security', 'metaprog', 'web', 'testing',
      'autoconfig', 'tx', 'async', 'messaging', 'config'
    ]);

    const setSegment = (seg: 'java' | 'spring') => {
      segButtons.forEach((btn) => {
        const active = btn.dataset.jxSegment === seg;
        btn.className = active
          ? 'jx-seg-btn cursor-pointer rounded-lg px-4 py-2 font-mono text-xs font-semibold transition-all bg-(--fg) text-(--bg) shadow-sm'
          : 'jx-seg-btn cursor-pointer rounded-lg px-4 py-2 font-mono text-xs font-semibold transition-all text-(--fg-dim) hover:text-(--fg)';
      });
      segContents.forEach((c) => {
        c.hidden = c.dataset.jxSegContent !== seg;
      });
    };

    segButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetSeg = btn.dataset.jxSegment as 'java' | 'spring';
        setSegment(targetSeg);
        // Automatically click first tab in this segment if current active panel is not in it
        const currentActiveBtn = document.querySelector<HTMLElement>('[data-jx-tab].border-\\(--fg\\)');
        const currentId = currentActiveBtn?.dataset.jxTab ?? '';
        const inSpring = springTabIds.has(currentId);
        if ((targetSeg === 'spring' && !inSpring) || (targetSeg === 'java' && inSpring)) {
          const firstTabInSeg = document.querySelector<HTMLElement>(`[data-jx-seg-content="${targetSeg}"] [data-jx-tab]`);
          firstTabInSeg?.click();
        }
      });
    });


    // 3. Auto-detect segment from initial Hash
    const initialHash = window.location.hash.slice(1);
    if (initialHash && springTabIds.has(initialHash)) {
      setSegment('spring');
    } else {
      setSegment('java');
    }


  }

  document.addEventListener('astro:page-load', initJavaLabUI);
</script>

<style is:global>
  .jx-btn {
    font-family: var(--font-mono, ui-monospace, monospace) !important;
    font-size: 12px !important;
    line-height: 1rem !important;
  }
  .jx-seg-btn {
    font-family: var(--font-mono, ui-monospace, monospace) !important;
    font-size: 12px !important;
    line-height: 1rem !important;
  }
  .jx-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11px;
    padding: 0.22rem 0;
  }
  .jx-n {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--fg);
    padding: 0.28rem 0.6rem;
    white-space: nowrap;
  }
  .jx-n.hot { border-color: rgb(245 158 11 / 0.55); color: rgb(252 211 77); }
  .jx-n.io  { border-color: rgb(16 185 129 / 0.5); color: rgb(110 231 183); }
  .jx-n.bad { border-color: rgb(244 63 94 / 0.5); color: rgb(253 164 175); }
  .jx-a { color: var(--fg-faint); }
  .jx-tag { color: var(--fg-faint); font-size: 10px; }
  @media (max-width: 380px) {
    .jx-n {
      gap: 0.2rem;
      padding: 0.2rem 0.4rem;
    }
  }
</style>
