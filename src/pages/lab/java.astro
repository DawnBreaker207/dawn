    code: `@RestController
class UserController {
    @PostMapping("/users")
    ResponseEntity<UserDto> create(@RequestBody @Valid NewUser in) {
        var saved = userService.create(in);
        return ResponseEntity.created(URI.create("/users/" + saved.getId())).body(saved);
