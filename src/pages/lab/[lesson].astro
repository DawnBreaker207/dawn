---
import ArchitectureLabLayout from '@/layouts/ArchitectureLabLayout.astro';
import { CURRICULUM_MODULES } from '@/data/curriculum';
import { LAB_TRACK_PAGES } from '@/data/lab-track-pages';
import { ALL_SCENES } from '@/data/scenes';
import { SITE } from '@/lib/site';
import { labDescription, labTitle } from '@/lib/utils/seo';

export const prerender = true;

export async function getStaticPaths() {
  // Lab routes that have their own page file in src/pages/lab/.
  const OWN_PAGES = new Set(['pathfinding', 'spider', 'terminal']);

  const lessonPaths = CURRICULUM_MODULES.flatMap((mod) =>
    mod.lessons
      .filter((lesson) => !OWN_PAGES.has(lesson.id) && !(lesson.id in LAB_TRACK_PAGES))
      .map((lesson) => {
        const scene = ALL_SCENES[lesson.id];
        return {
          params: { lesson: lesson.id },
          props: {
            lessonId: lesson.id,
            moduleId: mod.id,
            trackId: mod.trackId,
            title: labTitle(lesson.title, SITE.title),
            description: labDescription(
              scene?.summary || `Interactive visual architecture lab simulating ${lesson.title}.`,
            ),
          },
        };
      })
  );

  const trackPaths = Object.entries(LAB_TRACK_PAGES).map(([slug, page]) => ({
    params: { lesson: slug },
    props: {
      ...page,
      title: labTitle(page.title, SITE.title),
      description: labDescription(page.description),
    },
  }));

  return [...lessonPaths, ...trackPaths];
}

interface Props {
  lessonId: string;
  moduleId?: string;
  trackId?: string;
  title: string;
  description: string;
}

const { lessonId, moduleId, trackId, title, description } = Astro.props;
---

<ArchitectureLabLayout
  lessonId={lessonId}
  moduleId={moduleId}
  trackId={trackId}
  title={title}
  description={description}
/>
