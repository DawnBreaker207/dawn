---
import ArchitectureLabLayout from '@/layouts/ArchitectureLabLayout.astro';
import { CURRICULUM_MODULES } from '@/data/curriculum';
import { ALL_SCENES } from '@/data/scenes';
import BTreeTraversal from '@/components/lab/sql/BTreeTraversal.astro';
import MvccTimeline from '@/components/lab/sql/MvccTimeline.astro';
import PartitionVisualizer from '@/components/lab/sql/PartitionVisualizer.astro';

export const prerender = true;

export async function getStaticPaths() {
  const EXCLUDED_ROUTES = new Set([
    'architecture',
    'foundations',
    'aws-cloud',
    'microservices',
    'k8s',
    'request-lifecycle',
    'system-design',
    'distributed',
    'security',
    'java',
    'sql',
    'pathfinding',
    'spider',
    'terminal',
  ]);

  return CURRICULUM_MODULES.flatMap((mod) =>
    mod.lessons
      .filter((lesson) => !EXCLUDED_ROUTES.has(lesson.id))
      .map((lesson) => {
        const scene = ALL_SCENES[lesson.id];
        return {
          params: { lesson: lesson.id },
          props: {
            lessonId: lesson.id,
            title: `${lesson.title} · Interactive Visual Architecture Lab`,
            description: scene?.summary || `Interactive visual architecture lab simulating ${lesson.title}.`,
          },
        };
      })
  );
}

interface Props {
  lessonId: string;
  title: string;
  description: string;
}

const { lessonId, title, description } = Astro.props;
---

<ArchitectureLabLayout
  lessonId={lessonId}
  title={title}
  description={description}
>
  {lessonId === 'indexes' && <BTreeTraversal slot="visualizer-2d" />}
  {lessonId === 'transactions' && <MvccTimeline slot="visualizer-2d" />}
  {lessonId === 'sharding' && <PartitionVisualizer slot="visualizer-2d" />}
</ArchitectureLabLayout>
