---
import BaseLayout from '@/layouts/BaseLayout.astro';

export const prerender = true;

// Giant single statement for the execution-order dissection. Clause spans
// carry data-step = the phase in which the ENGINE actually runs that clause
// (logical processing order, not the written order).
const EO_SQL = `<span class="eo-cl" data-step="1">WITH top_products AS ( -- CTE: parsed up here… runs where it is joined
  SELECT   product_id,
           SUM(quantity) AS sold
  FROM     order_items
  GROUP BY product_id
  HAVING   SUM(quantity) > 500
),
avg_ticket AS ( -- consumed once, materialized when WHERE first reads it
  SELECT AVG(total_usd) AS avg_total
  FROM   orders
)</span>
<span class="eo-cl" data-step="13">SELECT
  c.name                                      AS customer,
  SUM(oi.quantity)                            AS units,
  ROUND(SUM(oi.quantity * oi.unit_price), 2)  AS revenue,
  <span class="eo-cl" data-step="13">CASE -- per-row at projection time
    WHEN c.country = 'VN' THEN 'domestic'
    WHEN c.tier IS NOT NULL THEN c.tier
    ELSE COALESCE(c.segment, 'international')
  END</span> AS segment,
  <span class="eo-cl" data-step="14">ROW_NUMBER() OVER ( -- window fn: after GROUP BY/HAVING, before ORDER BY
    PARTITION BY c.country
    ORDER BY SUM(oi.quantity * oi.unit_price) DESC
  )</span> AS cc_rank</span>
FROM <span class="eo-cl" data-step="2">( -- inner query: base of the whole pipeline
  SELECT   o.customer_id,
           SUM(o.total_usd) AS lifetime_spend
  FROM     orders o</span>
  <span class="eo-cl" data-step="3">WHERE  o.status IN ('paid', 'shipped')
    AND  o.created_at >= DATE '2026-01-01'</span>
  <span class="eo-cl" data-step="4">GROUP BY o.customer_id</span>
) AS big_spenders
JOIN <span class="eo-cl" data-step="5">orders o      ON o.customer_id = big_spenders.customer_id</span>
JOIN <span class="eo-cl" data-step="6">order_items oi ON oi.order_id   = o.id</span>
JOIN <span class="eo-cl" data-step="7">products p     ON p.id          = oi.product_id
JOIN top_products tp ON tp.product_id = p.id -- CTE executes here</span>
JOIN <span class="eo-cl" data-step="8">customers c    ON c.id = o.customer_id</span>
WHERE <span class="eo-cl" data-step="9">c.country = 'VN'
  AND o.total_usd > (SELECT avg_total FROM avg_ticket)</span>
  AND <span class="eo-cl" data-step="10">EXISTS ( -- correlated: re-evaluated PER candidate row
        SELECT 1
        FROM   reviews r
        WHERE  r.order_id = o.id
          AND  r.rating >= 4 )</span>
<span class="eo-cl" data-step="11">GROUP BY c.name, c.country</span>
<span class="eo-cl" data-step="12">HAVING SUM(oi.quantity * oi.unit_price) > 1000000
   AND COUNT(*) > 3</span>
<span class="eo-cl" data-step="15">UNION
SELECT '— (no segment)', 0, 0, 'domestic', 0</span>
<span class="eo-cl" data-step="16">ORDER BY revenue DESC</span>
<span class="eo-cl" data-step="17">LIMIT 10;</span>`;

// CASE-driven query routing: one API endpoint, four statement shapes.
// CASE picks values inside SQL; which SHAPE the statement takes is decided
// in the app layer before the query is sent. code blocks are illustrative.
const CASE_BRANCHES: { pill: string; plan: string; skips: string; note: string; code: string }[] = [
  {
    pill: "metric = 'revenue'",
    plan: 'full 17-phase pipeline — exactly the dissected statement',
    skips: 'nothing — CTEs, window, UNION all run',
    note: "Revenue keeps the giant statement. Note the split of responsibilities: CASE routes a VALUE inside SQL; routing the QUERY SHAPE was decided in the app layer before the statement was ever sent.",
    code: `-- the full dissection from the panel above, verified digest:
WITH top_products AS (...), avg_ticket AS (...)
SELECT ... CASE segment ... ROW_NUMBER() OVER (...)
FROM (inner) JOIN ×5 ... GROUP BY ... HAVING ...
UNION ... ORDER BY revenue LIMIT 10
-- 2 CTEs · 5 joins · correlated EXISTS · window · UNION`,
  },
  {
    pill: "metric = 'units'",
    plan: '6-phase lean pipeline',
    skips: 'inner query, both CTEs, HAVING, window, UNION',
    note: 'A leaner metric takes a leaner shape — no big_spenders black box, so the planner starts straight from the fact tables and skips every aggregation layer.',
    code: `SELECT p.name, SUM(oi.quantity) AS units
FROM   order_items oi
JOIN   products p ON p.id = oi.product_id
WHERE  oi.shipped_at >= DATE '2026-01-01'
GROUP BY p.name
ORDER BY units DESC
LIMIT 10;
-- phases: FROM → JOIN → WHERE → GROUP BY → ORDER BY → LIMIT`,
  },
  {
    pill: "metric = 'refund'",
    plan: '3-phase detail report',
    skips: 'all aggregation, customers dim, ranking, dedupe',
    note: 'Line-item shape — refunds report row by row, so every GROUP BY/HAVING/UNION stage disappears from the pipeline.',
    code: `SELECT o.id, r.reason, -(o.total_usd) AS refund_amount
FROM   refunds r
JOIN   orders o ON o.id = r.order_id
WHERE  r.created_at >= DATE '2026-01-01';
-- phases: FROM → JOIN → WHERE — everything else never runs`,
  },
  {
    pill: 'metric IS NULL',
    plan: 'COALESCE guard — tiny default view',
    skips: 'the branching logic entirely',
    note: 'No branch was chosen, so no branch ran. CASE can pick a VALUE inside an expression (COALESCE fallback here); SQL has no IF around statements — a NULL metric sends a different, much smaller query.',
    code: `SELECT 'no metric selected' AS notice,
       COALESCE((SELECT AVG(total_usd) FROM orders), 0) AS default_view
LIMIT 1;
-- CASE-in-expression fallback: the value is picked inside SQL,
-- the missing branch is picked by the caller.`,
  },
];

// True logical execution order of the statement above (illustrative row counts).
const EO_STEPS: { clause: string; title: string; detail: string; rows: string }[] = [
  {
    clause: '1',
    title: 'WITH — CTEs parsed, not run',
    detail: 'Non-recursive CTEs are parsed up here and INLINED where referenced (avg_ticket) — forcing MATERIALIZED would run them standalone.',
    rows: '2 CTEs defined',
  },
  {
    clause: '2',
    title: 'FROM — inner query base',
    detail: 'orders enters the pipeline first; the inner query is a black box the outer one waits on.',
    rows: '172,000 rows',
  },
  {
    clause: '3',
    title: 'WHERE — inner query',
    detail: 'Pushes down the status + date filters before any grouping happens.',
    rows: '64,300 rows',
  },
  {
    clause: '4',
    title: 'GROUP BY — derived table',
    detail: 'Hash-aggregates spend per customer_id; the result materializes as big_spenders.',
    rows: '9,850 groups',
  },
  {
    clause: '5',
    title: 'JOIN ← big_spenders',
    detail: 'Re-attaches each matching order to its spender (nested loop + PK index lookup).',
    rows: '64,300 rows',
  },
  {
    clause: '6',
    title: 'JOIN order_items',
    detail: 'Hash join: small build side in work_mem, then probe the line-items stream.',
    rows: '511,700 rows',
  },
  {
    clause: '7',
    title: 'CTE + products join',
    detail: 'top_products runs for real right here (its HAVING keeps >500 sold); semi filter against the product dim.',
    rows: '214,900 rows',
  },
  {
    clause: '8',
    title: 'JOIN customers',
    detail: 'PK join to the dimension fetches name/country/tier for every surviving row.',
    rows: '511,700 rows',
  },
  {
    clause: '9',
    title: 'WHERE — outer filters',
    detail: 'Country = VN and spend > the cached avg_ticket — first read of the CTE materializes it as one constant.',
    rows: '88,400 rows',
  },
  {
    clause: '10',
    title: 'EXISTS — correlated, per row',
    detail: 'The OPPOSITE of the cached scalar: re-evaluated for every candidate row until one match; planners turn it into a semi-join.',
    rows: '61,900 rows',
  },
  {
    clause: '11',
    title: 'GROUP BY — outer',
    detail: 'Hash-aggregates by (name, country); only grouped columns stay available downstream.',
    rows: '6,120 groups',
  },
  {
    clause: '12',
    title: 'HAVING — aggregate filter',
    detail: 'Filters on SUM and COUNT(*) together; WHERE sees raw rows, HAVING sees group aggregates.',
    rows: '214 groups',
  },
  {
    clause: '13',
    title: 'SELECT — CASE & projection',
    detail: 'CASE chains are evaluated per row with COALESCE fallbacks; column names only exist from here on.',
    rows: '214 rows',
  },
  {
    clause: '14',
    title: 'window function',
    detail: 'ROW_NUMBER runs after GROUP BY/HAVING but before ORDER BY — PARTITION BY slices, no rows removed.',
    rows: '+1 rank col',
  },
  {
    clause: '15',
    title: 'UNION — dedupe pass',
    detail: 'Appends the guard branch, then sorts + de-duplicates both sides. UNION ALL would skip this.',
    rows: '215 rows',
  },
  {
    clause: '16',
    title: 'ORDER BY — top-N',
    detail: 'Sorts on the aliased output column revenue — it references the projection, not a source column.',
    rows: 'sorted',
  },
  {
    clause: '17',
    title: 'LIMIT — the handoff',
    detail: 'Caps the stream at 10 rows and hands the result set to the client.',
    rows: '10 rows',
  },
];
---

<BaseLayout
  title="Visual SQL EXPLAIN & Query Plan Explorer"
  description="Interactive PostgreSQL query plan simulator — compare Seq Scan vs B-Tree, fix Hibernate N+1, watch the engine run."
>
  <header class="mb-6 border-b border-(--border) pb-5">
    <div class="mb-2 flex items-center gap-2 font-mono text-xs text-(--fg-faint)">
      <span class="ml-auto inline-flex items-center gap-1 rounded-full border border-(--border) bg-(--bg-alt) px-2 py-0.5 text-[10px] text-cyan-400">
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-cyan-400"></span>
        PostgreSQL 16 Simulator
      </span>
    </div>
    <h1 class="m-0 font-mono text-[clamp(28px,4.5vw,48px)] leading-[0.96] tracking-[-0.06em] text-(--fg)">
      sql explain explorer
    </h1>
    <p id="sp-explain" class="mt-2 max-w-3xl text-sm leading-relaxed text-(--fg-dim)">
      Without an index Postgres reads every data block of users sequentially — O(N) — while a B-Tree walks
      Root → Branch → Leaf in 3–4 buffer hits, O(log N). Press run to watch the same statement run twice and
      cost 142.5 ms vs 0.08 ms; the theory card below stays collapsed for later.
    </p>
  </header>

  <div class="space-y-5">
    <!-- Theory (collapsed by default) -->
    <details class="group rounded-xl border border-(--border) bg-(--bg-alt) p-4 font-mono text-xs">
      <summary class="flex cursor-pointer select-none items-center justify-between font-semibold text-(--fg)">
        <span class="flex items-center gap-2"><span class="text-(--accent)">📖 Indexing & query optimization fundamentals</span></span>
        <span class="text-(--fg-faint) transition-transform group-open:rotate-180">▼</span>
      </summary>
      <div class="mt-4 grid grid-cols-1 gap-4 border-t border-(--border) pt-3 text-(--fg-dim) md:grid-cols-2">
        <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
          <strong class="text-cyan-400">Seq Scan vs B-Tree</strong>
          <p class="mt-1">With no index, every data block is read sequentially (O(N)). A B-Tree walks Root → Branch → Leaf in just 3–4 buffer hits (O(log N)).</p>
          <p class="mt-1.5 border-l-2 border-amber-500/60 pl-2 text-amber-200/80">why O(log N) holds: ~500 pointers per level → 1B rows in 4 levels — depth stays flat while the table grows. The price: slower writes and a warmer cache.</p>
        </div>
        <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
          <strong class="text-rose-400">Hibernate N+1</strong>
          <p class="mt-1">1 query to fetch the parent list + N queries per child. Fix with <code class="text-emerald-400">JOIN FETCH</code> / <code class="text-emerald-400">@EntityGraph</code> — one query total.</p>
          <p class="mt-1.5 border-l-2 border-amber-500/60 pl-2 text-amber-200/80">why it hides: every single query looks fast; the cost lives in 51 network roundtrips, invisible per-query. Only the total wall-clock betrays it.</p>
        </div>
        <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
          <strong class="text-amber-400">Hash Join vs Nested Loop</strong>
          <p class="mt-1">Hash Join hashes the small table into RAM, then scans the big one (best for large sets). Nested Loop fits when the outer table is small and the inner one is indexed.</p>
          <p class="mt-1.5 border-l-2 border-amber-500/60 pl-2 text-amber-200/80">why two algorithms: hash buys throughput, nested loop buys early exit — the planner chooses by estimated row counts, so stale statistics flip the pick.</p>
        </div>
        <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
          <strong class="text-emerald-400">Covering Index</strong>
          <p class="mt-1">Every SELECT/WHERE column already lives inside the index → no trip back to the Table Heap (<code class="text-emerald-400">Heap Fetches: 0</code>).</p>
          <p class="mt-1.5 border-l-2 border-amber-500/60 pl-2 text-amber-200/80">why the heap trip hurts: each fetch is one random page read per row; folding columns into the index turns them into a single sequential range scan.</p>
        </div>
      </div>
    </details>

    <!-- B-tree internals (advanced) -->
    <details class="group rounded-xl border border-(--border) bg-(--bg-alt) p-4 font-mono text-xs">
      <summary class="flex cursor-pointer select-none items-center justify-between font-semibold text-(--fg)">
        <span class="flex items-center gap-2"><span class="text-(--accent)">🌳 B-tree internals — advanced</span></span>
        <span class="text-(--fg-faint) transition-transform group-open:rotate-180">▼</span>
      </summary>
      <div class="mt-4 space-y-4 border-t border-(--border) pt-3 text-(--fg-dim)">
        <pre class="thin-scrollbar overflow-x-auto rounded-lg border border-(--border) bg-black/50 p-3 text-[11px] leading-relaxed text-(--fg)">        ┌───────────────────────────────────────────────┐
        │ header: LSN · high key · right-link → sibling │
        ├───────────────────────────────────────────────┤
 ptr →  │ ItemId 1 · ItemId 2 · ItemId 3 …   (grow down)│
        │                  … free space …               │
        │              (tuples grow up)                 │
        │ ██ key+TID ██ ██ key+TID ██ ██ key+TID ██     │
        └───────────────────────────────────────────────┘
        internal page: ‹pointer · key› pairs — leaf adds the heap TID</pre>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
            <strong class="text-cyan-400">8 KB page anatomy</strong>
            <p class="mt-1">Header carries the WAL recovery LSN, the High Key guard and the right-link; ItemId pointers grow down from the front, index tuples grow up from the back, free space sits between them. The leaf tuple stores key + ctid — the heap row address every scan hands back.</p>
          </div>
          <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
            <strong class="text-cyan-400">Fanout math (why 3–4 levels is enough)</strong>
            <p class="mt-1">≈ 300 entries per page → 3 levels hold ~27M rows, 4 levels ~8B. A descent is one binary search per page (~9 comparisons) plus one page read; the root is always cached and branches usually are, so the leaf read is the only real IO — at any table size.</p>
          </div>
          <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
            <strong class="text-cyan-400">Page splits: 50/50 vs rightmost</strong>
            <p class="mt-1">Random keys fill a page to ~66% then split 50/50 — the two halves inherit one page. Monotone keys (ids, created_at) always insert at the RIGHTMOST page, so Postgres fast-splits: the old page keeps everything. Sequential keys → ~100% fill, a smaller index — but every writer hammers the same rightmost page (a hotspot, not a bloat).</p>
          </div>
          <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
            <strong class="text-cyan-400">Really a Lehman-Yao B-link tree</strong>
            <p class="mt-1">Every page stores a High Key + right-sibling link. A reader that lands past the High Key hops right along the link — a concurrent split never forces re-descending or latching the whole path. That is where the high-concurrency claim in `nbtree` comes from.</p>
          </div>
          <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
            <strong class="text-cyan-400">TID, HOT &amp; index bloat</strong>
            <p class="mt-1">UPDATE changing an indexed column inserts a new entry into EVERY index. If no indexed column changed and the new version stays on the same heap page, it becomes HOT: indexes keep pointing at the old TID and follow the forward chain. Bloat = dead index tuples, not deleted rows — REINDEX / pg_repack reclaim.</p>
          </div>
          <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
            <strong class="text-cyan-400">Ordering &amp; practicals</strong>
            <p class="mt-1">▸ ORDER BY works only in index order; DESC just walks the same tree backward — mixed ASC/DESC needs per-column DDL order. ▸ INCLUDE adds leaf-covered columns without widening the sort key. ▸ Partial index (WHERE active) for a small hot subset. ▸ Expression index on lower(email). ▸ Dedup (PG13) packs duplicate keys into posting lists.</p>
          </div>
        </div>
      </div>
    </details>

    <!-- Scenario picker -->
    <div class="flex flex-wrap items-center gap-2 rounded-xl border border-(--border) bg-(--bg-alt) p-3 font-mono text-xs">
      <span class="mr-1 text-[11px] uppercase tracking-wider text-(--fg-faint)">Scenario:</span>
      <button
        type="button" data-plan-preset="index_vs_seq"
        class="plan-btn cursor-pointer rounded-lg border border-(--fg) bg-(--fg) px-3 py-1.5 font-semibold text-(--bg)"
      >⚡ Seq Scan vs Index</button>
      <button
        type="button" data-plan-preset="hibernate_n_plus_1"
        class="plan-btn cursor-pointer rounded-lg border border-(--border) bg-(--bg) px-3 py-1.5 font-semibold text-(--fg-dim) transition-colors hover:border-(--fg-dim) hover:text-(--fg)"
      >💣 N+1 vs JOIN FETCH</button>
      <button
        type="button" data-plan-preset="hash_vs_nested"
        class="plan-btn cursor-pointer rounded-lg border border-(--border) bg-(--bg) px-3 py-1.5 font-semibold text-(--fg-dim) transition-colors hover:border-(--fg-dim) hover:text-(--fg)"
      >🔄 Hash vs Nested Loop</button>
      <button
        type="button" data-plan-preset="index_only"
        class="plan-btn cursor-pointer rounded-lg border border-(--border) bg-(--bg) px-3 py-1.5 font-semibold text-(--fg-dim) transition-colors hover:border-(--fg-dim) hover:text-(--fg)"
      >💎 Covering Index</button>
      <button
        type="button" data-plan-preset="join_anti"
        class="plan-btn cursor-pointer rounded-lg border border-(--border) bg-(--bg) px-3 py-1.5 font-semibold text-(--fg-dim) transition-colors hover:border-(--fg-dim) hover:text-(--fg)"
      >🧲 Anti-Join</button>
      <button
        type="button" data-plan-preset="topn_window"
        class="plan-btn cursor-pointer rounded-lg border border-(--border) bg-(--bg) px-3 py-1.5 font-semibold text-(--fg-dim) transition-colors hover:border-(--fg-dim) hover:text-(--fg)"
      >🥇 Top-N per Group</button>
      <button
        type="button" data-plan-preset="keyset_page"
        class="plan-btn cursor-pointer rounded-lg border border-(--border) bg-(--bg) px-3 py-1.5 font-semibold text-(--fg-dim) transition-colors hover:border-(--fg-dim) hover:text-(--fg)"
      >📜 Keyset Pagination</button>
      <button
        type="button" data-plan-preset="composite_prefix"
        class="plan-btn cursor-pointer rounded-lg border border-(--border) bg-(--bg) px-3 py-1.5 font-semibold text-(--fg-dim) transition-colors hover:border-(--fg-dim) hover:text-(--fg)"
      >🧱 Composite Prefix</button>
      <button
        type="button" data-plan-preset="execution_order"
        class="plan-btn cursor-pointer rounded-lg border border-(--border) bg-(--bg) px-3 py-1.5 font-semibold text-(--fg-dim) transition-colors hover:border-(--fg-dim) hover:text-(--fg)"
      >🧩 Execution Order</button>
    </div>

    <!-- Engine: run button + log stream, one card -->
    <div class="rounded-xl border border-cyan-500/40 bg-cyan-950/10 p-4 font-mono text-xs">
      <div class="flex flex-col items-stretch gap-3 border-b border-cyan-500/20 pb-3 sm:flex-row sm:items-center">
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-2">
            <span class="font-bold text-(--fg)">Postgres Execution Engine</span>
            <span id="engine-status-badge" class="rounded border border-cyan-500/50 bg-cyan-500/10 px-2 py-0.5 text-[10px] font-bold text-cyan-400">
              STANDBY
            </span>
          </div>
          <p class="mt-1 text-[11px] text-(--fg-dim)">Runs both strategies in sequence — the numbers on the two cards below count up on their own.</p>
        </div>
        <button
          type="button" id="btn-simulate-run"
          class="cursor-pointer rounded-lg border border-cyan-500 bg-cyan-500/20 px-4 py-2 font-semibold text-cyan-300 transition-all hover:bg-cyan-500/30 active:scale-95"
        >▶ Run simulation</button>
        <button
          type="button" id="btn-simulate-replay"
          class="cursor-pointer rounded-lg border border-(--border) bg-(--bg) px-3 py-2 font-semibold text-(--fg-dim) transition-colors hover:text-(--fg) active:scale-95"
        >↻ Replay</button>
      </div>
      <div class="mt-2 flex flex-wrap items-center gap-4 border-b border-cyan-500/20 pb-2.5">
        <span class="text-[10px] uppercase tracking-wider text-(--fg-faint)">⚙ step control:</span>
        <label class="flex cursor-pointer select-none items-center gap-1.5 text-[10px] text-(--fg-dim)">
          <input type="checkbox" id="sp-step-mode" checked class="accent-cyan-400" />
          step mode — pause after every log line
        </label>
        <label class="flex items-center gap-1.5 text-[10px] text-(--fg-dim)">
          delay
          <input
            type="number" id="sp-delay" min="50" max="3000" step="50" value="420"
            class="w-16 rounded border border-(--border) bg-(--bg) px-1.5 py-0.5 text-center text-(--fg)"
          />
          ms/line
        </label>
        <button
          type="button" id="sp-next"
          class="hidden cursor-pointer rounded border border-(--accent) bg-(--accent)/10 px-2.5 py-1 text-[10px] text-(--accent)"
        >▶ next step ▸</button>
      </div>
      <div id="engine-log-stream" class="thin-scrollbar mt-3 max-h-40 overflow-y-auto rounded-lg bg-black/60 p-3 font-mono text-[11px] text-(--fg-dim)">
        <div class="text-(--fg-faint)">[Engine Log] Pick a scenario, then hit run…</div>
      </div>
    </div>

    <!-- Strategy A vs B -->
    <div data-ab-grid class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <div id="card-strategy-a" class="rounded-xl border border-rose-500/30 bg-rose-950/10 p-4 font-mono text-xs">
        <div class="mb-2.5 flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-rose-400" id="title-strategy-a">No Index (Seq Scan)</span>
          <span class="rounded bg-rose-500/20 px-2 py-0.5 text-[10px] font-semibold text-rose-300" id="badge-strategy-a">Sequential Scan</span>
        </div>
        <pre class="overflow-x-auto rounded-lg border border-(--border) bg-(--bg) p-3 text-[11px] text-(--fg)" id="code-strategy-a">-- Full scan of the users table (1M rows)
EXPLAIN ANALYZE
SELECT * FROM users
WHERE email = 'dawn@dev.com';</pre>
        <div class="mt-3 grid grid-cols-3 gap-2 border-t border-(--border) pt-2.5">
          <div>
            <div class="text-[10px] uppercase text-(--fg-faint)">Time</div>
            <div class="mt-0.5 text-sm font-bold text-rose-400" id="time-strategy-a">—</div>
          </div>
          <div>
            <div class="text-[10px] uppercase text-(--fg-faint)">Cost</div>
            <div class="mt-0.5 text-sm font-bold text-(--fg)" id="cost-strategy-a">—</div>
          </div>
          <div>
            <div class="text-[10px] uppercase text-(--fg-faint)">Rows</div>
            <div class="mt-0.5 text-sm font-bold text-(--fg)" id="rows-strategy-a">—</div>
          </div>
        </div>
      </div>

      <div id="card-strategy-b" class="rounded-xl border border-emerald-500/30 bg-emerald-950/10 p-4 font-mono text-xs">
        <div class="mb-2.5 flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-400" id="title-strategy-b">With a B-Tree Index</span>
          <span class="rounded bg-emerald-500/20 px-2 py-0.5 text-[10px] font-semibold text-emerald-300" id="badge-strategy-b">Index Scan (B-Tree)</span>
        </div>
        <pre class="overflow-x-auto rounded-lg border border-(--border) bg-(--bg) p-3 text-[11px] text-(--fg)" id="code-strategy-b">-- Create index, then query
CREATE INDEX idx_users_email ON users(email);

EXPLAIN ANALYZE
SELECT * FROM users
WHERE email = 'dawn@dev.com';</pre>
        <div class="mt-3 grid grid-cols-3 gap-2 border-t border-(--border) pt-2.5">
          <div>
            <div class="text-[10px] uppercase text-(--fg-faint)">Time</div>
            <div class="mt-0.5 text-sm font-bold text-emerald-400" id="time-strategy-b">—</div>
          </div>
          <div>
            <div class="text-[10px] uppercase text-(--fg-faint)">Cost</div>
            <div class="mt-0.5 text-sm font-bold text-(--fg)" id="cost-strategy-b">—</div>
          </div>
          <div>
            <div class="text-[10px] uppercase text-(--fg-faint)">Rows</div>
            <div class="mt-0.5 text-sm font-bold text-(--fg)" id="rows-strategy-b">—</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Execution order dissection (single giant statement) -->
    <div id="eo-panel" hidden class="mb-2 rounded-xl border border-cyan-500/40 bg-cyan-950/10 p-4 font-mono text-xs">
      <p class="mb-3 border-b border-cyan-500/20 pb-2 text-[11px] tracking-widest text-(--fg-faint) uppercase">
        execution order dissected
        <span class="ml-1 normal-case text-(--fg-dim)">written top → bottom · engine runs it 1 → 17 — press run to walk each phase</span>
      </p>
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-[1.3fr_1fr]">
        <div class="min-w-0">
          <p class="mb-2 text-[10px] uppercase tracking-wider text-(--fg-faint)">the statement — 2 CTEs, window fn, CASE, correlated EXISTS, 5 joins</p>
          <pre
            id="eo-sql"
            class="thin-scrollbar max-h-[26rem] overflow-auto rounded-lg border border-(--border) bg-black/50 p-3 text-[11px] leading-relaxed text-(--fg)"
            set:html={EO_SQL}
          />
        </div>
        <div class="min-w-0">
          <p class="mb-2 text-[10px] uppercase tracking-wider text-(--fg-faint)">how the engine actually runs it</p>
          <ol id="eo-steps" class="thin-scrollbar max-h-[26rem] space-y-1 overflow-y-auto pr-1">
            {EO_STEPS.map((step, index) => (
              <li
                data-eo-step
                data-title={step.title}
                data-rows={step.rows}
                class="rounded-lg border border-transparent px-3 py-1.5 text-[11px] text-(--fg-dim)"
              >
                <span class="mr-2 font-bold text-cyan-400">{String(index + 1).padStart(2, '0')}</span>
                <span class="font-semibold text-(--fg)">{step.title}</span>
                <span class="float-right font-mono text-[10px] text-(--fg-faint)">{step.rows}</span>
                <span class="mt-0.5 block pl-7 text-[10px] leading-snug">{step.detail}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>

    <!-- CASE routing: same endpoint, four query shapes -->
    <div class="mb-2 rounded-xl border border-amber-500/40 bg-amber-950/10 p-4 font-mono text-xs">
      <p class="mb-3 border-b border-amber-500/20 pb-2 text-[11px] tracking-widest text-(--fg-faint) uppercase">
        case routing
        <span class="ml-1 normal-case text-(--fg-dim)">one endpoint · four query shapes — the missing branch never touches the database</span>
      </p>
      <div id="case-pills" class="flex flex-wrap gap-2">
        {CASE_BRANCHES.map((branch, index) => (
          <button
            type="button"
            data-case-idx={index}
            class:list={[
              'cursor-pointer rounded-full border px-3 py-1 text-[11px] transition-colors',
              index === 0
                ? 'border-amber-400 bg-amber-500/20 text-amber-200'
                : 'border-amber-500/40 text-(--fg-dim) hover:text-(--fg)',
            ]}
          >{branch.pill}</button>
        ))}
      </div>
      <div class="mt-3">
        {CASE_BRANCHES.map((branch, index) => (
          <div data-case-idx={index} hidden={index !== 0}>
            <div class="grid grid-cols-1 gap-4 lg:grid-cols-[1.15fr_1fr]">
              <div class="min-w-0">
                <p class="mb-2 text-[10px] uppercase tracking-wider text-(--fg-faint)">query shape for this branch</p>
                <pre class="thin-scrollbar max-h-72 overflow-auto rounded-lg border border-(--border) bg-black/50 p-3 text-[11px] leading-relaxed text-(--fg)">{branch.code}</pre>
              </div>
              <div class="min-w-0 space-y-2.5">
                <div class="flex flex-wrap gap-1.5">
                  <span class="rounded-sm border border-emerald-500/50 px-1.5 py-0.5 font-mono text-[10px] text-emerald-300">runs: {branch.plan}</span>
                  <span class="rounded-sm border border-rose-500/40 px-1.5 py-0.5 font-mono text-[10px] text-rose-300">skips: {branch.skips}</span>
                </div>
                <p class="text-[11px] leading-relaxed text-(--fg-dim)">{branch.note}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  interface Scenario {
    id: string;
    name: string;
    explain: string;
    titleA: string;
    badgeA: string;
    codeA: string;
    titleB: string;
    badgeB: string;
    codeB: string;
    timeA: string;
    costA: string;
    rowsA: string;
    timeB: string;
    costB: string;
    rowsB: string;
    logStepsA: string[];
    logStepsB: string[];
  }

  const SCENARIOS: Record<string, Scenario> = {
    index_vs_seq: {
      id: 'index_vs_seq',
      name: 'Seq Scan vs B-Tree Index',
      explain:
        'Without an index Postgres reads every data block of users sequentially — O(N) — while a B-Tree walks Root → Branch → Leaf in 3–4 buffer hits, O(log N). Press run to watch the same statement run twice and cost 142.5 ms vs 0.08 ms.',
      titleA: 'No Index (Seq Scan)',
      badgeA: 'Sequential Scan',
      codeA: "-- Full scan of the users table (1M rows)\nEXPLAIN ANALYZE\nSELECT * FROM users\nWHERE email = 'dawn@dev.com';",
      titleB: 'With a B-Tree Index',
      badgeB: 'Index Scan (B-Tree)',
      codeB: "-- Create index, then query\nCREATE INDEX idx_users_email ON users(email);\n\nEXPLAIN ANALYZE\nSELECT * FROM users\nWHERE email = 'dawn@dev.com';",
      timeA: '142.5 ms',
      costA: '18450.00',
      rowsA: '1,000,000',
      timeB: '0.08 ms',
      costB: '4.28',
      rowsB: '1 row · 1780x faster',
      logStepsA: [
        '[A] Launching a Sequential Scan over "users"…',
        '[A] Reading block by block from disk — 250,000 rows scanned…',
        '[A] Pushing through shared buffers — 750,000 rows…',
        '[A] Scanned 1,000,000 rows, filtered down to 1 result. 142.5 ms.',
      ],
      logStepsB: [
        '[B] Index Scan on "idx_users_email"…',
        '[B] Walking the B-Tree: Root → Branch → Leaf (3 buffer hits).',
        '[B] Tuple matched, done in 0.08 ms.',
      ],
    },

    hibernate_n_plus_1: {
      id: 'hibernate_n_plus_1',
      name: 'Hibernate N+1 vs JOIN FETCH',
      explain:
        'The classic ORM trap: lazy loading turns one query into 51 network roundtrips while the code looks innocent. JOIN FETCH / @EntityGraph collapses them into a single Hash Join roundtrip — 128x less network chatter for the same rows.',
      titleA: 'The N+1 Disaster',
      badgeA: '1 + N Queries',
      codeA: '// Lazy loading: 1 + 50 queries!\nList<Author> authors = authorRepo.findAll();\nfor (Author a : authors) {\n  System.out.println(a.getBooks().size()); // one query per loop\n}',
      titleB: 'JOIN FETCH',
      badgeB: 'Single Query',
      codeB: '// Fetch everything in one query\n@Query("SELECT a FROM Author a JOIN FETCH a.books")\nList<Author> findAllWithBooks();',
      timeA: '48.5 ms',
      costA: '1250.00',
      rowsA: '51 roundtrips',
      timeB: '0.90 ms',
      costB: '32.10',
      rowsB: '1 query · 54x faster',
      logStepsA: [
        '[A] Query 1/51: SELECT * FROM authors (50 authors)…',
        '[A] Query 2/51: books WHERE author_id = 1 (0.8 ms roundtrip)…',
        '[A] Query 3/51 … 51/51 — network latency ×50.',
        '[A] Total: 48.5 ms just to return 50 authors.',
      ],
      logStepsB: [
        '[B] Query 1/1: JOIN authors × books…',
        '[B] The Hash Join returns every Author + Book row in one roundtrip.',
        '[B] Done in 0.90 ms.',
      ],
    },

    hash_vs_nested: {
      id: 'hash_vs_nested',
      name: 'Hash Join vs Nested Loop',
      explain:
        'Two ways to join: Nested Loop probes the inner table once per outer row (fine when sets are small), Hash Join builds an in-memory hash of the small side and streams the big one through it. Same data: 312.4 ms vs 14.2 ms.',
      titleA: 'Nested Loop on a large set',
      badgeA: 'Nested Loop',
      codeA: "EXPLAIN ANALYZE\nSELECT * FROM orders o\nJOIN order_items i ON o.id = i.order_id\nWHERE o.created_at >= '2026-01-01';",
      titleB: 'Hash Join',
      badgeB: 'In-Memory Hash',
      codeB: "SET enable_nestloop = off;\n\nEXPLAIN ANALYZE\nSELECT * FROM orders o\nJOIN order_items i ON o.id = i.order_id\nWHERE o.created_at >= '2026-01-01';",
      timeA: '312.4 ms',
      costA: '42100.00',
      rowsA: '500,000 loop iterations',
      timeB: '14.2 ms',
      costB: '3850.00',
      rowsB: 'hash match · 22x faster',
      logStepsA: [
        '[A] Nested Loop: looping over each order_id, scanning order_items…',
        '[A] 500,000 iterations, CPU-bound O(N×M)…',
        '[A] Finished: 312.4 ms.',
      ],
      logStepsB: [
        '[B] Build Phase: hashing 10,000 orders into work_mem (2.1 ms)…',
        '[B] Probe Phase: scanning order_items, O(1) lookups against the hash table…',
        '[B] Done in 14.2 ms.',
      ],
    },

    index_only: {
      id: 'index_only',
      name: 'Covering Index',
      explain:
        'A Covering Index stores the SELECT/WHERE columns right on the index leaf, so the engine never falls back to the Table Heap (Heap Fetches: 0). Reach for INCLUDE when a hot query keeps coming back to the heap for one extra column.',
      titleA: 'Plain Index + Heap Fetch',
      badgeA: 'Index Scan + Heap',
      codeA: "-- 'status' not in the index → extra Table Heap read\nSELECT id, email, status FROM users\nWHERE email = 'dawn@dev.com';",
      titleB: 'Covering Index (INCLUDE)',
      badgeB: 'Index Only Scan',
      codeB: "-- Store the status column inside the index\nCREATE INDEX idx_users_cover\nON users(email) INCLUDE (status);\n\nSELECT id, email, status FROM users\nWHERE email = 'dawn@dev.com';",
      timeA: '1.25 ms',
      costA: '8.45',
      rowsA: '1 index + 1 heap fetch',
      timeB: '0.04 ms',
      costB: '1.42',
      rowsB: '0 heap fetch · 31x faster',
      logStepsA: [
        '[A] Reading B-Tree "idx_users_email" to find the email…',
        '[A] "status" is not in the index → extra Table Heap block read!',
        '[A] Finished: 1.25 ms.',
      ],
      logStepsB: [
        '[B] Reading the Covering Index "idx_users_cover"…',
        '[B] Every column already sits on the B-Tree leaves.',
        '[B] Heap Fetches = 0. 0.04 ms.',
      ],
    },

    join_anti: {
      id: 'join_anti',
      name: 'Anti-Join (NOT IN vs LEFT JOIN)',
      explain:
        'The customers-without-orders question: NOT IN builds a 90,000-row id list and re-filters every row — and ONE NULL in orders.customer_id collapses the whole answer to zero rows (three-valued logic). LEFT JOIN + WHERE o.id IS NULL compiles to a dedicated Hash ANTI Join — a single probe pass, NULL-safe, cheap at any size.',
      titleA: 'NOT IN Subquery',
      badgeA: 'Three-Valued Trap',
      codeA: "-- The obvious shape — NOT IN with three-valued logic\nEXPLAIN ANALYZE\nSELECT c.name FROM customers c\nWHERE c.id NOT IN (SELECT o.customer_id FROM orders o);\n-- ONE NULL in orders.customer_id -> result: 0 rows, silently",
      titleB: 'LEFT JOIN + IS NULL',
      badgeB: 'Hash ANTI Join',
      codeB: "-- NULL-safe anti-join: the planner builds one hash table then probes\nEXPLAIN ANALYZE\nSELECT c.name FROM customers c\nLEFT JOIN orders o ON o.customer_id = c.id\nWHERE o.id IS NULL;",
      timeA: '96.2 ms',
      costA: '23410.55',
      rowsA: '0 rows · NULL trap',
      timeB: '11.4 ms',
      costB: '3120.10',
      rowsB: '12,400 · 8.4x faster',
      logStepsA: [
        '[A] Planning NOT IN (SELECT customer_id FROM orders)…',
        '[A] Materializing the subplan — 90,000 customer_ids hashed…',
        '[A] Filtering 1,000,000 customers against the id list, row by row…',
        '[A] One NULL slipped into orders → NOT IN yields 0 rows. 96.2 ms.',
      ],
      logStepsB: [
        '[B] Hash LEFT JOIN customers ⇢ orders — build side: customers…',
        '[B] ANTI predicate: keep only rows WHERE o.id IS NULL…',
        '[B] Single hash probe pass — no per-row subquery, NULL-safe…',
        '[B] 12,400 customers with zero orders. 11.4 ms.',
      ],
    },

    topn_window: {
      id: 'topn_window',
      name: 'Top-N per Group (Window)',
      explain:
        '"Latest order per customer": the correlated subquery fires once PER customer row — 100,000 executions plus an index probe each — while ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY created_at DESC) sorts once and keeps rn = 1 in a single pass. One sort beats N executions, and rn also kills the tied rows the MAX() trick would duplicate.',
      titleA: 'Correlated Subquery',
      badgeA: '1 Exec per Row',
      codeA: "-- correlated scalar subquery — re-runs for every outer row\nEXPLAIN ANALYZE\nSELECT * FROM orders o\nWHERE o.created_at = (SELECT MAX(o2.created_at)\n                      FROM orders o2\n                      WHERE o2.customer_id = o.customer_id);",
      titleB: 'Window ROW_NUMBER',
      badgeB: 'Single Pass',
      codeB: "-- window: one sort, one filter, tie-proof\nWITH ranked AS (\n  SELECT *, ROW_NUMBER() OVER (\n    PARTITION BY customer_id\n    ORDER BY created_at DESC, id DESC\n  ) rn FROM orders)\nSELECT * FROM ranked WHERE rn = 1;",
      timeA: '312.8 ms',
      costA: '61240.22',
      rowsA: '100,000 sub-runs',
      timeB: '48.6 ms',
      costB: '18760.40',
      rowsB: '9,850 · 6.4x faster',
      logStepsA: [
        '[A] Correlated subquery resolved per row…',
        '[A] Customer 1: SELECT MAX(created_at)… Customer 2: again… repeat…',
        '[A] 100,000 customers → 100,000 sub-executions + an index probe each…',
        '[A] Done at 312.8 ms — a tie would even duplicate rows.',
      ],
      logStepsB: [
        '[B] Window: one sort by (customer_id, created_at DESC, id DESC)…',
        '[B] Each PARTITION boundary restarts the row counter…',
        '[B] Filter rn = 1 → exactly one row per customer survives…',
        '[B] 9,850 latest orders in a single pass. 48.6 ms.',
      ],
    },

    keyset_page: {
      id: 'keyset_page',
      name: 'OFFSET vs Keyset Pagination',
      explain:
        'OFFSET 100000 walks and DISCARDS 100,000 tuples before page 5,001 can render — latency grows linearly with page depth. Keyset pagination resumes with WHERE (created_at, id) < (last_seen) and seeks straight into the index: page 9,000 costs exactly what page 1 costs, and rows shifting between requests no longer emit duplicate pages.',
      titleA: 'OFFSET Deep Page',
      badgeA: 'Walk & Discard',
      codeA: "-- deep page: the engine walks, then throws away\nEXPLAIN ANALYZE\nSELECT * FROM orders\nORDER BY created_at DESC\nLIMIT 20 OFFSET 100000;",
      titleB: 'Keyset Seek',
      badgeB: 'Resume Cursor',
      codeB: "-- keyset: seek to last_seen, discard nothing\nEXPLAIN ANALYZE\nSELECT * FROM orders\nWHERE (created_at, id) < ($1, $2)\nORDER BY created_at DESC, id DESC\nLIMIT 20;",
      timeA: '488.9 ms',
      costA: '88210.31',
      rowsA: '100,020 walked',
      timeB: '0.21 ms',
      costB: '4.62',
      rowsB: '20 rows · 2328x faster',
      logStepsA: [
        '[A] ORDER BY created_at DESC — full sort of 1,000,000 rows…',
        '[A] OFFSET 100000 → walking and DISCARDING 100,000 tuples…',
        '[A] 20 rows left after throwing away 100,000. 488.9 ms…',
        '[A] Robbing page 9,001 the same way costs even more.',
      ],
      logStepsB: [
        '[B] Keyset: resume WHERE (created_at, id) < ($1, $2)…',
        '[B] Index seek lands DIRECTLY at the resume point…',
        '[B] 20 tuples read in index order — nothing discarded…',
        '[B] Page 9,000 costs the same as page 1. 0.21 ms.',
      ],
    },

    composite_prefix: {
      id: 'composite_prefix',
      name: 'Composite Index Prefix',
      explain:
        'A composite index is a phone book sorted by (status, created_at): the leading column rules. WHERE status = ? AND created_at > ? pins the prefix, then ranges inside it; WHERE created_at alone skips the first column — the tree is sorted by status, so no single contiguous created_at slice exists to seek, and the planner falls back to a full Seq Scan. Column order IS the design: equality first, range last.',
      titleA: 'Skipped Prefix',
      badgeA: 'Seq Scan',
      codeA: "-- index (status, created_at) exists… but this query\n-- never mentions the leading column\nEXPLAIN ANALYZE\nSELECT * FROM orders\nWHERE created_at > now() - interval '30 days';\n-- sorted by status -> no contiguous created_at slice -> Seq Scan",
      titleB: 'Full Prefix Use',
      badgeB: 'Index Scan',
      codeB: "-- equality pins column 1, the range stays inside it\nEXPLAIN ANALYZE\nSELECT * FROM orders\nWHERE status = 'paid'\n  AND created_at > now() - interval '30 days';\n-- (status, created_at): equality first, range last",
      timeA: '131.7 ms',
      costA: '20180.00',
      rowsA: '1,000,000 scanned',
      timeB: '2.9 ms',
      costB: '418.35',
      rowsB: '38,100 · 45x faster',
      logStepsA: [
        '[A] Predicates: created_at range only — no filter on status…',
        '[A] The index is sorted by status FIRST — created_at is scattered…',
        '[A] No leading boundary to seek → planner flips to Seq Scan…',
        '[A] 1,000,000 rows walked, 38,100 kept. 131.7 ms.',
      ],
      logStepsB: [
        '[B] status = paid → B-Tree locates the paid slice instantly…',
        '[B] created_at range scans WITHIN that slice (leftmost prefix)…',
        '[B] Heap fetches only the 38,100 matching tuples…',
        '[B] 2.9 ms — equality first, range last, skip no column before the range.',
      ],
    },

    execution_order: {
      id: 'execution_order',
      name: 'Giant Query — Execution Order',
      explain:
        'One statement, 2 CTEs, 5 joins, correlated EXISTS, a window fn, CASE and UNION. SQL reads top → bottom, but the engine executes a fixed pipeline (1 → 17): press run to highlight phase by phase, then try the CASE routing panel below to see how branches swap the whole query shape.',
      titleA: 'Written order',
      badgeA: 'top → bottom',
      codeA: '// One giant statement — walk it in the dissection panel below.\n// The panel highlights each clause in true engine order (1 → 14).',
      titleB: 'Execution order',
      badgeB: 'engine pipeline',
      codeB: 'WITH (2 CTEs) → inner FROM/WHERE/GROUP BY → re-JOIN\n→ hash joins + CTE at reference → cached scalar → correlated EXISTS\n→ GROUP BY → HAVING → SELECT (CASE, COALESCE) → window fn\n→ UNION dedupe → ORDER BY → LIMIT',
      timeA: '—',
      costA: '—',
      rowsA: '5 tables · 2 inner queries',
      timeB: '—',
      costB: '—',
      rowsB: '17 pipeline phases · 5 joins · 2 CTEs',
      logStepsA: ['(walked in the dissection panel on the right)'],
      logStepsB: ['(walked in the dissection panel on the right)'],
    },
  };

  // Count-up animation for "142.5 ms"-style values
  const tween = (el: HTMLElement | null, targetText: string, dur = 600) => {
    if (!el) return;
    if (el.textContent === targetText) return;
    const m = targetText.match(/[\d,.]+/);
    if (!m) {
      el.textContent = targetText;
      return;
    }
    const target = Number(m[0].replace(/,/g, ''));
    const dec = m[0].includes('.') ? m[0].split('.')[1].length : 0;
    const idx = m.index ?? 0;
    const prefix = targetText.slice(0, idx);
    const suffix = targetText.slice(idx + m[0].length);
    const t0 = performance.now();
    const step = (now: number) => {
      const k = Math.min(1, (now - t0) / dur);
      const eased = 1 - Math.pow(1 - k, 2);
      el.textContent = dec
        ? prefix + (target * eased).toFixed(dec) + suffix
        : prefix + Math.round(target * eased).toLocaleString() + suffix;
      if (k < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  function initSqlPlanExplorer() {
    let currentScenario = SCENARIOS.index_vs_seq;
    let isSimulating = false;
    const $ = (id: string) => document.getElementById(id);

    // Step setting: step mode pauses after each log line until Next is
    // clicked; otherwise the configured per-line delay applies.
    let resumeStep: (() => void) | null = null;
    const nextBtn = $('sp-next');
    const stepMode = () => ($('sp-step-mode') as HTMLInputElement | null)?.checked ?? false;
    const stepDelay = () => Math.max(50, Number(($('sp-delay') as HTMLInputElement | null)?.value) || 420);
    const stepWait = () => {
      if (!nextBtn) return Promise.resolve();
      if (stepMode()) {
        nextBtn.classList.remove('hidden');
        return new Promise<void>((resolve) => {
          resumeStep = resolve;
        }).then(() => nextBtn.classList.add('hidden'));
      }
      return new Promise<void>((resolve) => setTimeout(resolve, stepDelay()));
    };
    const advanceStep = () => {
      resumeStep?.();
      resumeStep = null;
    };
    nextBtn?.addEventListener('click', advanceStep);
    const setMetrics = (s: Scenario) => {
      tween($('time-strategy-a'), s.timeA);
      tween($('cost-strategy-a'), s.costA);
      tween($('rows-strategy-a'), s.rowsA);
      tween($('time-strategy-b'), s.timeB);
      tween($('cost-strategy-b'), s.costB);
      tween($('rows-strategy-b'), s.rowsB);
    };

    const renderScenario = (sc: Scenario) => {
      currentScenario = sc;
      const set = (id: string, v: string) => {
        const el = $(id);
        if (el) el.textContent = v;
      };
      set('title-strategy-a', sc.titleA);
      set('badge-strategy-a', sc.badgeA);
      set('title-strategy-b', sc.titleB);
      set('badge-strategy-b', sc.badgeB);
      set('code-strategy-a', sc.codeA);
      set('code-strategy-b', sc.codeB);
      $('sp-explain')?.replaceChildren(sc.explain ?? '');
      ['time-strategy-a', 'cost-strategy-a', 'rows-strategy-a', 'time-strategy-b', 'cost-strategy-b', 'rows-strategy-b'].forEach((id) => set(id, '—'));
      const badge = $('engine-status-badge');
      if (badge) {
        badge.textContent = 'STANDBY';
        badge.className = 'rounded border border-cyan-500/50 bg-cyan-500/10 px-2 py-0.5 text-[10px] font-bold text-cyan-400';
      }
      const stream = $('engine-log-stream');
      if (stream) {
        stream.innerHTML = `<div class="text-(--fg-faint)">[Engine Log] Scenario "${sc.name}" loaded. Hit run…</div>`;
      }

      // The giant-query scenario swaps the A/B cards for the dissection panel.
      const isEo = sc.id === 'execution_order';
      const abGrid = document.querySelector<HTMLElement>('[data-ab-grid]');
      const eoPanel = document.getElementById('eo-panel');
      if (abGrid) abGrid.hidden = isEo;
      if (eoPanel) eoPanel.hidden = !isEo;
      eoPanel?.querySelectorAll<HTMLElement>('.eo-cl, #eo-steps [data-eo-step]').forEach((el) => {
        el.classList.remove('eo-active', 'eo-done');
      });
    };

    const runSimulation = async () => {
      if (isSimulating) return;
      isSimulating = true;

      const badge = $('engine-status-badge');
      const stream = $('engine-log-stream');
      if (badge) {
        badge.textContent = 'EXECUTING…';
        badge.className = 'rounded border border-amber-500 bg-amber-500/20 px-2 py-0.5 text-[10px] font-bold text-amber-300 animate-pulse';
      }
      if (stream) stream.innerHTML = '';
      const d = currentScenario;
      const appendLog = (line: string, ok = false) => {
        if (!stream) return;
        const div = document.createElement('div');
        div.className = ok ? 'text-emerald-400' : 'text-rose-400';
        div.textContent = line;
        stream.append(div);
        stream.scrollTop = stream.scrollHeight;
      };

      if (d.id === 'execution_order') {
        // Walk the giant statement in true engine order: highlight the active
        // clause + step, log every phase into the same engine log.
        const steps = Array.from(document.querySelectorAll<HTMLElement>('#eo-steps [data-eo-step]'));
        const clauses = Array.from(document.querySelectorAll<HTMLElement>('#eo-sql [data-step]'));
        const paint = (current: number) => {
          clauses.forEach((cl) => {
            const at = Number(cl.dataset.step);
            cl.classList.toggle('eo-active', at === current);
            cl.classList.toggle('eo-done', at < current);
          });
          steps.forEach((li, index) => {
            li.classList.toggle('eo-active', index === current - 1);
            li.classList.toggle('eo-done', index < current - 1);
          });
        };
        paint(0);
        for (let i = 0; i < steps.length; i++) {
          const li = steps[i];
          paint(i + 1);
          const last = i === steps.length - 1;
          appendLog(`[EO] ${String(i + 1).padStart(2, '0')}/${steps.length} ${li.dataset.title} — ${li.dataset.rows}`, last);
          await stepWait();
        }
        appendLog('[EO] written order ≠ execution order — ORDER BY/LIMIT act on output, not source.', true);
        if (badge) {
          badge.textContent = 'DONE — pipeline walked ✓';
          badge.className = 'rounded border border-emerald-500 bg-emerald-500/20 px-2 py-0.5 text-[10px] font-bold text-emerald-300';
        }
        isSimulating = false;
        return;
      }

      appendLog('== PHASE 1: unoptimized ==');
      for (const line of d.logStepsA) {
        appendLog(line);
        await stepWait();
      }
      tween($('time-strategy-a'), d.timeA);
      tween($('cost-strategy-a'), d.costA);
      tween($('rows-strategy-a'), d.rowsA);
      await stepWait();

      appendLog('== PHASE 2: optimized ==', true);
      for (const line of d.logStepsB) {
        appendLog(line, true);
        await stepWait();
      }
      tween($('time-strategy-b'), d.timeB);
      tween($('cost-strategy-b'), d.costB);
      tween($('rows-strategy-b'), d.rowsB);

      if (badge) {
        badge.textContent = 'DONE — faster ✓';
        badge.className = 'rounded border border-emerald-500 bg-emerald-500/20 px-2 py-0.5 text-[10px] font-bold text-emerald-300';
      }
      isSimulating = false;
    };

    document.querySelectorAll<HTMLButtonElement>('.plan-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.planPreset;
        if (!id || !SCENARIOS[id]) return;
        document.querySelectorAll('.plan-btn').forEach((b) => {
          b.className =
            'plan-btn cursor-pointer rounded-lg border border-(--border) bg-(--bg) px-3 py-1.5 font-semibold text-(--fg-dim) transition-colors hover:border-(--fg-dim) hover:text-(--fg)';
        });
        btn.className = 'plan-btn cursor-pointer rounded-lg border border-(--fg) bg-(--fg) px-3 py-1.5 font-semibold text-(--bg)';
        renderScenario(SCENARIOS[id]);
      });
    });

    // CASE-routing switcher: one endpoint resolved to four statement shapes.
    const pillBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('#case-pills [data-case-idx]'));
    const caseBlocks = Array.from(document.querySelectorAll<HTMLElement>('[data-case-idx]')).filter((el) => !el.closest('#case-pills'));
    pillBtns.forEach((pill) => {
      pill.addEventListener('click', () => {
        const idx = Number(pill.dataset.caseIdx);
        pillBtns.forEach((btn) => {
          const on = btn === pill;
          btn.className = `cursor-pointer rounded-full border px-3 py-1 text-[11px] transition-colors ${
            on
              ? 'border-amber-400 bg-amber-500/20 text-amber-200'
              : 'border-amber-500/40 text-(--fg-dim) hover:text-(--fg)'
          }`;
        });
        caseBlocks.forEach((block) => {
          block.hidden = Number(block.dataset.caseIdx) !== idx;
        });
      });
    });

    $('btn-simulate-run')?.addEventListener('click', runSimulation);
    // Replay = reset the cards, then stream the same scenario again.
    $('btn-simulate-replay')?.addEventListener('click', () => {
      renderScenario(currentScenario);
      runSimulation();
    });
    renderScenario(currentScenario);
  }

  document.addEventListener('astro:page-load', initSqlPlanExplorer);
</script>

<style is:global>
  .eo-cl {
    border-radius: 4px;
    padding-inline: 2px;
    transition: background-color 0.25s, opacity 0.25s, box-shadow 0.25s;
  }
  .eo-cl:hover {
    background: rgb(34 211 238 / 0.12);
  }
  .eo-active {
    background: rgb(34 211 238 / 0.22);
    box-shadow: inset 0 0 0 1px rgb(34 211 238 / 0.55);
  }
  li.eo-active {
    border-color: rgb(34 211 238 / 0.55);
    background: rgb(34 211 238 / 0.1);
    color: var(--fg);
  }
  .eo-done {
    opacity: 0.45;
  }
</style>
