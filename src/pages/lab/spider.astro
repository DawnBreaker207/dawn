---
import BaseLayout from '@/layouts/BaseLayout.astro';

export const prerender = true;
---

<BaseLayout title="Spider">
  <header class="mb-9 border-b border-(--border) pb-7">
    <h1 class="m-0 font-mono text-[clamp(40px,6vw,74px)] leading-[0.96] tracking-[-0.07em] text-(--fg)">
      spider
    </h1>
    <p class="mt-4 max-w-[42.5rem] text-lg text-(--fg-dim)">
      Interactive web drawing — two spiders follow your cursor. Move to draw.
    </p>
  </header>

  <section class="cursor-pointer overflow-hidden rounded-xl border border-(--border) bg-black" style="height: 62vh">
    <canvas id="spider-canvas" class="block h-full w-full"></canvas>
  </section>
</BaseLayout>