---
import BaseLayout from '@/layouts/BaseLayout.astro';

export const prerender = true;

// Static shell first; telemetry hydrates post-paint from view=full JSON.

const WINDOWS = [
  { key: 'today', label: 'today' },
  { key: 'last7Days', label: 'last 7 days' },
  { key: 'last30Days', label: 'last 30 days' },
];
---

<BaseLayout title="Token burn" description="Token-burn telemetry for AI pair-coding sessions — all-time totals, daily burn chart, and the breakdown by model.">
  <header class="mb-9 border-b border-(--border) pb-7">
    <h1 class="m-0 font-mono text-[clamp(40px,6vw,74px)] leading-[0.96] tracking-[-0.07em] text-(--fg)">
      token burn
    </h1>
    <p class="mt-4 max-w-[42.5rem] text-lg text-(--fg-dim)">
      Every token burned pair-coding with AI agents — pulled nightly from my own local usage
      telemetry. Costs are estimated retail figures, not invoices.
    </p>
  </header>

  <div data-token-burn>
    <p
      data-tok-error
      hidden
      class="mb-8 rounded-lg border border-(--border) bg-(--bg-alt) px-4 py-3 font-mono text-[13px] text-(--fg-dim)"
    >
      telemetry is unavailable right now.
    </p>

    {/* ── All-time: typographic hero (house ledger voice) ────── */}
    <section class="tok-sec mb-8" style="animation-delay: 40ms">
      <p class="m-0 font-mono text-[11px] tracking-widest text-(--fg-faint) uppercase">
        <span class="text-(--accent)">❯</span> tokens burned — all time
      </p>
      <p
        data-tok-hero-tokens
        class="m-0 mt-2 min-h-[1em] font-mono text-[clamp(38px,7.5vw,86px)] leading-none font-black tracking-tighter text-(--fg) tabular-nums"
      >
        <span class="tok-skel inline-block h-[0.72em] w-[10ch] rounded-md" aria-hidden="true"></span>
        <span class="sr-only">Loading all-time tokens…</span>
      </p>
      <p class="m-0 mt-3 flex flex-wrap gap-x-6 gap-y-1 font-mono text-[13px] text-(--fg-dim)">
        {[
          { key: 'spend', label: 'spend' },
          { key: 'sessions', label: 'sessions' },
          { key: 'machines', label: 'machines' },
        ].map((m) => (
          <span class="inline-flex items-baseline gap-1.5">
            <span class="text-(--fg-faint)">{m.label}</span>
            <b data-tok-stat={m.key} class="min-w-12 font-medium text-(--fg) tabular-nums">
              <span class="tok-skel inline-block h-[0.9em] w-10 rounded align-baseline" aria-hidden="true"></span>
              <span class="sr-only">Loading {m.label}…</span>
            </b>
          </span>
        ))}
      </p>
    </section>

    {/* ── Recent burn: ledger rows ──────────────────────────── */}
    <section class="tok-sec mb-12" style="animation-delay: 100ms">
      <p class="m-0 mb-1 font-mono text-[11px] tracking-widest text-(--fg-faint) uppercase">
        <span class="text-(--accent)">❯</span> recent burn
      </p>
      <dl class="m-0">
        {
          WINDOWS.map(({ key, label }) => (
            <div class="flex items-baseline justify-between gap-4 border-t border-(--border) py-2.5 last:border-b">
              <dt class="m-0 shrink-0 font-mono text-[12px] tracking-[0.06em] text-(--fg-faint) uppercase">{label}</dt>
              <dd class="m-0 flex items-baseline gap-3 text-right">
                <b data-tok-window={key} class="font-mono text-[clamp(16px,2vw,20px)] font-semibold tracking-[-0.02em] text-(--fg) tabular-nums">
                  <span class="tok-skel inline-block h-[0.85em] w-14 rounded align-baseline" aria-hidden="true"></span>
                  <span class="sr-only">Loading {label} tokens…</span>
                </b>
                <span data-tok-window-meta={key} class="font-mono text-[11px] text-(--fg-faint)">
                  <span class="tok-skel inline-block h-[0.9em] w-24 rounded align-baseline" aria-hidden="true"></span>
                </span>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    {/* ── Daily burn chart ──────────────────────────────────── */}
    <section data-tok-chart-section class="tok-sec mb-12" style="animation-delay: 160ms">
      <p class="mb-3 flex items-center gap-3 border-b border-(--border) pb-2 font-mono text-[11px] tracking-widest text-(--fg-faint) uppercase">
        daily burn
        <span class="flex-1 border-t border-(--border)" aria-hidden="true"></span>
        <span class="tracking-normal text-(--fg-dim) normal-case">
          <span data-tok-chart-count>—</span>
          ·
          <span data-tok-chart-peak>—</span>
        </span>
      </p>
      <div class="border border-(--border) bg-(--bg) p-4">
        <div class="relative h-44 pl-11">
          <div class="absolute right-0 left-11 top-0">
            <span data-tok-chart-max class="absolute right-full mr-2 -translate-y-1/2 font-mono text-[9px] text-(--fg-faint) tabular-nums">—</span>
            <span class="block h-px border-t border-dashed border-(--border)"></span>
          </div>
          <div class="absolute right-0 left-11 top-1/2">
            <span data-tok-chart-mid class="absolute right-full mr-2 -translate-y-1/2 font-mono text-[9px] text-(--fg-faint) tabular-nums">—</span>
            <span class="block h-px border-t border-dashed border-(--border)"></span>
          </div>
          <div class="absolute right-0 left-11 bottom-0">
            <span class="absolute right-full bottom-0 mr-2 font-mono text-[9px] text-(--fg-faint) tabular-nums">0</span>
            <span class="block h-px bg-(--border)"></span>
          </div>
          <div data-tok-chart-bars class="absolute inset-0 left-11 flex items-end gap-px"></div>
        </div>
        <div class="mt-2 flex justify-between pl-11 font-mono text-[10px] text-(--fg-faint)">
          <span data-tok-chart-first>—</span>
          <span data-tok-chart-last>—</span>
        </div>
      </div>
    </section>

    {/* ── By model ──────────────────────────────────────────── */}
    <section data-tok-models-section class="tok-sec mb-10" style="animation-delay: 220ms">
      <p class="mb-3 flex items-center gap-3 border-b border-(--border) pb-2 font-mono text-[11px] tracking-widest text-(--fg-faint) uppercase">
        by model
        <span class="flex-1 border-t border-(--border)" aria-hidden="true"></span>
        <span data-tok-model-count class="tracking-normal text-(--fg-dim) normal-case">—</span>
      </p>
      <div data-tok-models class="border-b border-(--border)">
        {Array.from({ length: 6 }, (_, index) => index).map((row) => (
          <div class="flex items-center gap-3 border-t border-(--border) px-4 py-2.5">
            <span class="tok-skel h-3 w-5 shrink-0 rounded" />
            <span class="tok-skel h-2 w-2 shrink-0 rounded-full" />
            <span class="tok-skel h-4 w-4 shrink-0 rounded-full" />
            <span class:list={['tok-skel h-4 shrink-0 rounded', row % 3 === 0 ? 'w-36' : row % 3 === 1 ? 'w-28' : 'w-32']} />
            <span class:list={['tok-skel ml-auto hidden h-1.5 shrink-0 rounded-full sm:block', row === 0 ? 'w-10/12' : row === 1 ? 'w-7/12' : 'w-5/12']} />
            <span class="tok-skel h-4 w-14 shrink-0 rounded" />
            <span class="tok-skel h-4 w-8 shrink-0 rounded" />
            <span class="tok-skel h-4 w-12 shrink-0 rounded" />
          </div>
        ))}
      </div>
    </section>

    {/* ── Provenance ────────────────────────────────────────── */}
    <p class="tok-sec font-mono text-[11px] leading-relaxed text-(--fg-faint)" style="animation-delay: 280ms">
      <span class="text-(--fg-dim)">machines</span>
      {' '}
      <span data-tok-machines class="inline-block min-w-24">—</span>
      <span data-tok-last-wrap hidden>
        {' '}· <span class="text-(--fg-dim)">last activity</span> <span data-tok-last></span>
      </span>
      {' '}· sources: opencode + antigravity + claude code · cost is an estimate
    </p>
  </div>
</BaseLayout>

<script>
  import '@/scripts/token-burn-page';
</script>

<style is:global>
  @keyframes tok-skel-pulse {
    0%, 100% { opacity: 0.45; }
    50% { opacity: 0.85; }
  }
  @keyframes tok-bar-grow {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }
  @keyframes tok-rise {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  .tok-sec {
    animation: tok-rise 0.55s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .tok-skel {
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--border) 82%, var(--bg)),
      color-mix(in srgb, var(--border) 45%, var(--bg)),
      color-mix(in srgb, var(--border) 82%, var(--bg))
    );
    animation: tok-skel-pulse 1.2s ease-in-out infinite;
  }
  .tok-stack {
    /* % seg heights need a definite parent: full column, bars anchored bottom */
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    transform-origin: bottom;
    opacity: 0.78;
    animation: tok-bar-grow 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .tok-stack.is-peak { opacity: 1; }
  .tok-seg { display: block; width: 100%; }
  .tok-bar-group { min-height: 100%; }
  .tok-bar-group:hover .tok-stack { opacity: 1; }
  .tok-tooltip {
    display: none;
    pointer-events: none;
    position: absolute;
    bottom: 100%;
    left: 50%;
    z-index: 10;
    margin-bottom: 4px;
    transform: translateX(-50%);
    border: 1px solid var(--border);
    background: var(--bg);
    padding: 4px 8px;
    border-radius: 4px;
    font: 10px/1.3 ui-monospace, SFMono-Regular, Menlo, monospace;
    white-space: nowrap;
    color: var(--fg);
    box-shadow: 3px 3px 0 var(--border);
  }
  .tok-bar-group:hover .tok-tooltip { display: block; }
  .tok-model-row {
    border-top: 1px solid var(--border);
    font-family: ui-monospace, SFMono-Regular, 'JetBrains Mono', Menlo, monospace;
    font-variant-numeric: tabular-nums;
    transition: background 0.15s ease;
  }
  .tok-model-row:hover { background: color-mix(in srgb, var(--bg-alt) 60%, transparent); }
  .tok-model-bar { background: var(--fg); opacity: 0.55; }
  .tok-model-row:first-child .tok-model-bar { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .tok-skel, .tok-stack, .tok-sec { animation: none; }
  }
</style>
