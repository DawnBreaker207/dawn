---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Greeting from '@/components/home/Greeting.astro';
import Heading from '@/components/home/Heading.astro';
import TypedBios from '@/components/home/TypedBios.astro';
import ShortDescription from '@/components/home/ShortDescription.astro';
import BlogLinks from '@/components/home/BlogLinks.astro';
import { getPosts } from '@/lib/utils/blog';

export const prerender = true;

const posts = await getPosts();
---

<BaseLayout>
  <div class="relative space-y-6 pt-4 md:space-y-16 lg:pt-12">
    <div class="mt-4 max-w-[42.5rem] space-y-4 md:space-y-6">
      <Greeting />
      <Heading />
      <TypedBios />
      <div class="text-base leading-7 text-(--fg-dim) md:text-lg md:leading-8">
        <ShortDescription />
        <BlogLinks />
      </div>
    </div>

    <div class="border-b border-(--border) pb-9">
      <div class="mb-4 flex items-end justify-between">
        <h2 class="m-0 text-[26px] tracking-tighter text-(--fg)">Latest Posts</h2>
        <span class="font-mono text-xs text-(--fg-dim)">data/blog/*.mdx</span>
      </div>
      {
        posts.slice(0, 3).map((post) => {
          const date = new Intl.DateTimeFormat('en-CA').format(post.data.date);
          return (
            <a
              href={`/blog/${post.id}`}
              class="grid grid-cols-1 items-start gap-4.5 border-t border-(--border) py-4.5 no-underline first-of-type:border-t-0 md:grid-cols-[92px_1fr_auto]"
            >
              <time class="pt-0.5 font-mono text-xs text-(--fg-dim)">{date}</time>
              <div>
                <h3 class="mb-1.75 text-[20px] tracking-[-0.04em] text-(--fg)">{post.data.title}</h3>
                <p class="m-0 leading-snug text-(--fg-dim)">{post.data.summary}</p>
              </div>
              {post.data.tags[0] && (
                <span class="pt-0.5 font-mono text-[12px] text-(--accent-dim)">#{post.data.tags[0]}</span>
              )}
            </a>
          );
        })
      }
    </div>
  </div>
</BaseLayout>