---
import BaseLayout from '@/layouts/BaseLayout.astro';
import StatusStrip from '@/components/home/StatusStrip.astro';
import Hero from '@/components/home/Hero.astro';
import EverydayToolbox from '@/components/home/EverydayToolbox.astro';
import FeaturedLabs from '@/components/home/FeaturedLabs.astro';
import FeaturedProjects from '@/components/home/FeaturedProjects.astro';
import CurrentRadar from '@/components/home/CurrentRadar.astro';
import { getPosts, readingMinutes } from '@/lib/utils/blog';

export const prerender = true;

const posts = await getPosts();
const latestPosts = posts.slice(0, 4);
---

<BaseLayout
  title="Tung Anh (Dawn) — Software Engineer"
  description="A small corner of the internet. Personal workbench of Tung Anh exploring Java, TypeScript, PostgreSQL, and interactive 2.5D architecture simulations."
>
  <div class="relative space-y-12 pt-3 pb-16 md:space-y-18 lg:pt-6 max-w-full overflow-x-hidden">
    <!-- 1. Quiet Status Pill -->
    <div>
      <StatusStrip />
    </div>

    <!-- 2. Hero Section -->
    <Hero />

    <!-- 3. Everyday Toolbox -->
    <EverydayToolbox />

    <!-- 4. The Showcase: Interactive 2.5D Architecture Labs (with Track Filters) -->
    <FeaturedLabs />

    <!-- 5. Featured Projects -->
    <FeaturedProjects />

    <!-- 6. Workbench Radar: Building & Researching -->
    <CurrentRadar />

    <!-- 7. Latest Writings -->
    <section id="latest-posts" class="space-y-4 md:space-y-5">
      <div class="flex items-baseline justify-between border-b border-(--border) pb-3">
        <div>
          <h2 class="text-xl font-bold tracking-tight text-(--fg) sm:text-2xl md:text-3xl">
            Latest Writings
          </h2>
          <p class="text-sm text-(--fg-dim) mt-1">
            Casual engineering notes, tutorials, and deep-dives.
          </p>
        </div>
        <span class="font-mono text-xs sm:text-sm text-(--fg-faint) hidden sm:inline">data/blog/*.mdx</span>
      </div>

      <div class="divide-y divide-(--border)">
        {
          latestPosts.map((post) => {
            const date = new Intl.DateTimeFormat('en-CA').format(post.data.date);
            const minutes = readingMinutes(post);
            return (
              <a
                href={`/blog/${post.id}`}
                data-umami-event="home-latest-post"
                class="group flex flex-col gap-2 py-4.5 no-underline transition-colors sm:flex-row sm:items-baseline sm:justify-between min-w-0"
              >
                <div class="space-y-1.5 max-w-2xl min-w-0">
                  <h3 class="text-lg font-bold text-(--fg) group-hover:text-(--accent) transition-colors sm:text-xl">
                    {post.data.title}
                  </h3>
                  {post.data.summary && (
                    <p class="text-sm leading-relaxed text-(--fg-dim) line-clamp-2">
                      {post.data.summary}
                    </p>
                  )}
                </div>

                <div class="flex items-center gap-3 shrink-0 font-mono text-xs sm:text-sm text-(--fg-faint)">
                  {post.data.tags && post.data.tags[0] && (
                    <span class="rounded bg-(--accent-subtle) px-2 py-0.5 text-(--accent) font-medium">
                      #{post.data.tags[0]}
                    </span>
                  )}
                  <span>{minutes} min read</span>
                  <time>{date}</time>
                </div>
              </a>
            );
          })
        }
      </div>

      <div class="pt-2 text-right">
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 font-mono text-sm font-semibold text-(--fg-dim) hover:text-(--accent) transition-colors"
        >
          <span>All articles ({posts.length})</span>
          <span>&rarr;</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
