---
import { SITE } from '@/lib/site';
---

<div class="z-10 mb-8 md:mb-0">
  <div
    class="flex flex-col overflow-hidden rounded-lg shadow-demure dark:bg-dark dark:shadow-mondegreen bg-white outline-1 outline-gray-100 outline-solid dark:outline-gray-600"
  >
    <img
      src="/static/images/avatar.jpg"
      alt={SITE.title}
      width="550"
      height="350"
      loading="eager"
      style="object-position: 50% 15%; aspect-ratio: 4/4; width: 100%"
    />
  </div>
</div>