---
import Link from '@/components/ui/Link.astro';
import type { GithubRepository } from '@/types/server';

interface Props {
  project: {
    type: 'work' | 'self';
    title: string;
    description?: string;
    imgSrc: string;
    url?: string;
    repo?: string | GithubRepository | null;
    builtWith: string[];
  };
}

const { project } = Astro.props;
const { title, description, imgSrc, url, builtWith } = project;

const repository = typeof project.repo === 'object' && project.repo !== null ? project.repo : null;

const href = repository?.url || url || '';

const mainLanguage = repository
  ? repository.languages.find((language) => language.name !== 'CSS') ?? repository.languages[0]
  : undefined;
---

<div class="md max-w-[544px] p-4 md:w-1/2">
  <div class="shadow-nextjs dark:shadow-nextjs-dark flex h-full flex-col overflow-hidden rounded-lg border border-transparent">
    <img
      data-zoom
      src={imgSrc}
      alt={title}
      width="1088"
      height="612"
      loading="lazy"
      class="cursor-zoom-in object-cover object-center md:h-36 lg:h-60"
    />

    <div class="p-6">
      <h2 class="mb-3 text-2xl leading-8 font-bold tracking-tight">
        {href ? (
          <Link href={href} aria-label={`Link to ${title}`}>{title}</Link>
        ) : (
          title
        )}
      </h2>
      <p class="prose mb-3 max-w-none text-gray-500 dark:text-gray-400">
        {repository?.description || description}
      </p>

      <div class="mb-3 flex flex-wrap space-x-1.5">
        <span class="shrink-0">Built with: </span>
        {builtWith?.map((tool: string, index: number) => (
          <span class="font-semibold text-gray-600 dark:text-gray-300">
            {tool}
            {index !== builtWith.length - 1 && ','}
          </span>
        ))}
        .
      </div>

      {repository ? (
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-4">
            <div class="flex items-center space-x-1.5">
              {mainLanguage && (
                <>
                  <span
                    class="inline-block h-4 w-4 rounded-full"
                    style={`background-color: ${mainLanguage.color}`}
                  />
                  <span>{mainLanguage.name}</span>
                </>
              )}
            </div>
            <div class="flex items-center space-x-1.5">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
              </svg>
              <span>{repository.stargazerCount}</span>
            </div>
            <div class="flex items-center space-x-1.5">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="18" r="3" />
                <circle cx="6" cy="6" r="3" />
                <circle cx="18" cy="6" r="3" />
                <path d="M18 9v2a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9" />
                <path d="M12 12v3" />
              </svg>
              <span>{repository.forkCount}</span>
            </div>
          </div>
          <div class="flex items-center space-x-2">
            {repository.homepageUrl && (
              <>
                <a
                  href={repository.homepageUrl}
                  target="_blank"
                  rel="noreferrer"
                  class="flex items-center"
                  data-umami-event="project-demo"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M15 3h6v6" />
                    <path d="M10 14 21 3" />
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                  </svg>
                </a>
                <span class="text-gray-400 dark:text-gray-500">|</span>
              </>
            )}
            <a
              href={repository.url}
              target="_blank"
              rel="noreferrer"
              class="flex items-center space-x-1"
              data-umami-event="project-repo"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                <path d="M9 18c-4.51 2-5-2-7-2" />
              </svg>
            </a>
          </div>
        </div>
      ) : href ? (
        <Link
          href={href}
          class="text-primary text-base leading-6 font-medium hover:text-sky-600 dark:hover:text-sky-400"
          aria-label={`Link to ${title}`}
        >
          Learn more &rarr;
        </Link>
      ) : null}
    </div>
  </div>
</div>