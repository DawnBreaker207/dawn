---
import type { GithubRepository } from '@/types/server';

interface Props {
  project: {
    type: 'work' | 'self';
    title: string;
    description?: string;
    imgSrc: string;
    url?: string;
    repo?: string | GithubRepository | null;
    builtWith: string[];
  };
}

const { project } = Astro.props;
const { title, imgSrc, builtWith } = project;

// Local brand logos in /public/static/icons (devicon `-original` set, 128x128;
// Umami + Ng-Zorro kept from official sources). Add a new stack here, drop a
// file into public/static/icons/, done.
const STACK_ICONS: Record<string, string> = {
  React: 'react',
  Tailwind: 'tailwind',
  Java: 'java',
  Spring: 'spring',
  TypeScript: 'typescript',
  PostgreSQL: 'postgres',
  Antd: 'antd',
  Angular: 'angular',
  JavaScript: 'javascript',
  'Ng-Zorro': 'ngzorro',
  NestJs: 'nestjs',
  MySQL: 'mysql',
  Redis: 'redis',
  NextJS: 'nextjs',
  Prisma: 'prisma',
  Notion: 'notion',
  Umami: 'umami',
};

const repository = typeof project.repo === 'object' && project.repo !== null ? project.repo : null;

const owner = repository?.nameWithOwner || (typeof project.repo === 'string' ? project.repo : '');
const homepage = repository?.homepageUrl || project.url || '';
const href = repository?.url || (project.repo ? `https://github.com/${String(project.repo)}` : homepage);
const repoHref = repository?.url || (project.repo ? `https://github.com/${String(project.repo)}` : '');
const description = repository?.description || project.description || 'No description provided yet.';

const mainLanguage = repository
  ? repository.languages.find((l) => l.name !== 'CSS') ?? repository.languages[0]
  : undefined;
---

<div
  class="group flex min-h-[240px] flex-col gap-3 rounded-2xl border border-(--border) bg-(--bg) p-4 transition-shadow hover:shadow-[4px_4px_0_var(--border)]"
>
  <div class="flex items-start justify-between gap-3">
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class="flex min-w-0 items-center gap-3 no-underline"
    >
      {imgSrc ? (
        <img
          src={imgSrc}
          alt={title}
          width="40"
          height="40"
          loading="lazy"
          class="h-10 w-10 shrink-0 rounded-lg object-cover"
        />
      ) : (
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-(--border) bg-(--bg-alt) text-(--fg-faint)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" />
          </svg>
        </span>
      )}
      <div class="min-w-0">
        <h3 class="m-0 truncate text-[17px] font-semibold tracking-[-0.02em] text-(--fg) group-hover:text-(--accent)">
          {title}
        </h3>
        {owner && (
          <div class="mt-1 truncate font-mono text-[11px] text-(--fg-dim)">{owner}</div>
        )}
      </div>
    </a>

    <div class="flex shrink-0 items-center gap-1.5">
      {homepage && (
        <a
          href={homepage}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="View demo"
          title="View demo"
          class="grid h-9 w-9 place-items-center rounded-md border border-(--border) bg-(--bg-alt) text-(--fg-dim) transition-colors hover:border-(--accent) hover:text-(--accent)"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" /><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
          </svg>
        </a>
      )}
      {repoHref && (
        <a
          href={repoHref}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub repository"
          title="GitHub repository"
          class="grid h-9 w-9 place-items-center rounded-md border border-(--border) bg-(--bg-alt) text-(--fg-dim) transition-colors hover:border-(--accent) hover:text-(--accent)"
        >
          <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.5c-2.24.49-2.71-.95-2.71-.95-.37-.93-.9-1.18-.9-1.18-.73-.5.06-.49.06-.49.81.06 1.24.83 1.24.83.72 1.23 1.88.88 2.34.67.07-.52.28-.88.51-1.08-1.78-.2-3.65-.89-3.65-3.96 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.22 2.2.82a7.42 7.42 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.96.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0z" />
          </svg>
        </a>
      )}
    </div>
  </div>

  <a href={href} target="_blank" rel="noopener noreferrer" class="no-underline">
    <p class="m-0 line-clamp-3 text-[15px] leading-snug text-(--fg-dim)">{description}</p>
  </a>

  <div class="mt-auto grid grid-cols-2 gap-3 border-t border-(--border) pt-3 font-mono text-xs text-(--fg-dim)">
    {repository ? (
      <div>
        <div class="text-[10px] uppercase tracking-[0.08em] text-(--fg-faint)">Stars</div>
        <div class="mt-1 flex items-center gap-1.5 text-(--fg)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
          </svg>
          <span>{repository.stargazerCount}</span>
        </div>
      </div>
    ) : (
      <div class="min-w-0">
        <div class="text-[10px] uppercase tracking-[0.08em] text-(--fg-faint)">Links</div>
        <div class="mt-1 flex min-h-5 flex-wrap items-center gap-x-3 gap-y-1 text-(--fg)">
          <span class="flex items-center gap-1 whitespace-nowrap">
            <span class="text-(--fg-faint)">↗</span>
            <span>{homepage ? new URL(homepage.startsWith('http') ? homepage : `https://${homepage}`).hostname : 'repo'}</span>
          </span>
        </div>
      </div>
    )}

    <div>
      <div class="text-[10px] uppercase tracking-[0.08em] text-(--fg-faint)">Stack</div>
      <div class="mt-1 flex min-h-5 flex-wrap items-center gap-1.5">
        {builtWith.map((tool) => {
          const icon = STACK_ICONS[tool];
          if (icon) {
            return (
              <img
                src={`/static/icons/${icon}.svg`}
                alt={tool}
                title={tool}
                loading="lazy"
                class="h-6 w-auto shrink-0 rounded-sm bg-white p-0.5 dark:bg-(--bg-alt)"
              />
            );
          }
          return <span class="text-[11px] text-(--fg-dim)">{tool}</span>;
        })}
      </div>
    </div>

    {repository && (
      <div>
        <div class="text-[10px] uppercase tracking-[0.08em] text-(--fg-faint)">Language</div>
        <div class="mt-1 flex h-5 items-center gap-1.5 truncate text-(--fg)">
          {mainLanguage ? (
            <>
              <span
                class="inline-block h-2.5 w-2.5 shrink-0 rounded-full border border-(--border)"
                style={`background-color: ${mainLanguage.color}`}
              />
              <span class="truncate">{mainLanguage.name}</span>
            </>
          ) : (
            <span class="text-(--fg-faint)">—</span>
          )}
        </div>
      </div>
    )}
  </div>
</div>