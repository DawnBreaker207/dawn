---
import type { Tab } from '@/lib/site';

interface Props {
  tabs: Tab[];
}

const { tabs } = Astro.props;
const active = tabs.at(-1) ?? { path: '/', label: 'README.md' };
---

<nav class="studio-topbar flex min-h-11 shrink-0 items-stretch border-b border-(--border) bg-(--bg)">
  <button
    id="toggle-sidebar"
    type="button"
    class="studio-mobile-toggle grid min-w-11 shrink-0 cursor-pointer place-items-center border-r border-(--border) px-3 text-(--fg-faint) hover:bg-(--bg-alt) hover:text-(--fg) lg:hidden"
    data-mobile-toggle="sidebar"
    aria-controls="sidebar"
    aria-expanded="false"
    aria-label="Open site explorer"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M3 6h18M3 12h18M3 18h18" />
    </svg>
  </button>

  <div id="tab-scroll" class="tab-bar thin-scrollbar flex min-w-0 flex-1 overflow-x-auto">
    <div
      id="tab-root"
      class="contents"
      data-tab-path={active.path}
      data-tab-label={active.label}
    ></div>
  </div>

  <button
    id="toggle-rail-mobile"
    type="button"
    class="studio-mobile-toggle grid min-w-11 shrink-0 cursor-pointer place-items-center border-l border-(--border) px-3 text-(--fg-faint) hover:bg-(--bg-alt) hover:text-(--fg) lg:hidden"
    data-mobile-toggle="rail"
    aria-controls="rail"
    aria-expanded="false"
    aria-label="Open runtime activity"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M4 4h16v7H4zM4 13h16v7H4z" />
    </svg>
  </button>

  <button
    id="toggle-rail"
    type="button"
    class="tip tip--down hidden shrink-0 cursor-pointer border-l border-(--border) px-3.5 text-(--fg-faint) hover:bg-(--bg-alt) hover:text-(--fg) lg:grid lg:place-items-center"
    data-rail-toggle
    data-tip="hide right rail"
    aria-controls="rail"
    aria-expanded="true"
    aria-label="Hide right rail"
  >
    <svg class="rail-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M9 6l6 6-6 6" />
    </svg>
  </button>
</nav>