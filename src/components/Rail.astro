---
import CommitGraph from '@/components/CommitGraph';
---

<aside
  id="rail"
  class="thin-scrollbar min-w-0 shrink-0 flex-col border-l border-(--border) bg-(--bg) overflow-y-auto"
  transition:persist
>
  <div class="border-b border-(--border) px-3 py-2 text-[11px] tracking-[0.12em] text-(--fg-faint) uppercase">
    Commits
  </div>
  <div class="p-3">
    <CommitGraph client:visible />
  </div>
</aside>
