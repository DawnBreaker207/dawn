---
import CommitGraph from '@/components/CommitGraph';
import { GITHUB_REPO_PATH } from '@/lib/site';
---

<aside
  id="rail"
  class="hidden lg:flex min-w-0 shrink-0 flex-col border-l border-(--border) bg-(--bg) overflow-y-auto"
>
  <div class="border-b border-(--border) px-3 py-2 text-[11px] tracking-[0.12em] text-(--fg-faint) uppercase">
    Commits
  </div>
  <div class="p-3">
    <p class="mb-3 text-[12px] text-(--fg-dim)">Commit activity</p>
    <CommitGraph client:load />
    <a
      href={`https://github.com/${GITHUB_REPO_PATH}`}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-3 inline-block text-[12px] hover:no-underline"
    >
      xem chi tiết →
    </a>
  </div>
</aside>