---
import PartitionVisualizer from '@/components/lab/sql/PartitionVisualizer.astro';
---

<div data-sql-pane="partition" hidden>
  <!-- Left Stage Column: Interactive Partition Pruning Visualizer -->
  <div class="sql-stage-col thin-scrollbar space-y-4">
    <PartitionVisualizer />
  </div>

  <!-- Right Guide Column: Partitioning Strategies & Pruning Rules -->
  <div class="sql-guide-col thin-scrollbar">
    <!-- Concept strip -->
    <div class="grid grid-cols-3 gap-2 font-mono text-xs">
      <div class="rounded-lg border border-(--border) bg-(--bg) p-2 text-center">
        <div class="text-base">🗂️</div>
        <div class="mt-0.5 font-bold text-cyan-500">Range/List/Hash</div>
        <div class="text-[10px] text-(--fg-faint)">3 strategies</div>
      </div>
      <div class="rounded-lg border border-(--border) bg-(--bg) p-2 text-center">
        <div class="text-base">✂️</div>
        <div class="mt-0.5 font-bold text-emerald-500">Pruning</div>
        <div class="text-[10px] text-(--fg-faint)">skip partitions</div>
      </div>
      <div class="rounded-lg border border-(--border) bg-(--bg) p-2 text-center">
        <div class="text-base">📦</div>
        <div class="mt-0.5 font-bold text-amber-500">Sub-tables</div>
        <div class="text-[10px] text-(--fg-faint)">own stats</div>
      </div>
    </div>

    <!-- Theory: partition types DDL -->
    <details class="group rounded-xl border border-(--border) bg-(--bg-alt)">
      <summary class="flex cursor-pointer select-none items-center justify-between gap-3 p-3 font-mono text-xs text-(--fg-dim) hover:text-(--fg) [&::-webkit-details-marker]:hidden">
        <span class="font-semibold">Partition types — Range, List, Hash</span>
        <svg class="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="border-t border-(--border) p-4 space-y-3 font-mono text-xs">
        <div class="grid grid-cols-1 gap-3 md:grid-cols-3">
          <div class="rounded-lg border border-cyan-500/30 bg-(--bg) p-3 space-y-2">
            <p class="text-[10px] font-semibold text-cyan-400">RANGE — time series</p>
            <pre class="sql-details-pre thin-scrollbar text-[10px]">{`CREATE TABLE orders (
  id         BIGINT,
  created_at TIMESTAMPTZ
) PARTITION BY RANGE (created_at);

CREATE TABLE orders_2024_q1
  PARTITION OF orders
  FOR VALUES FROM ('2024-01-01')
            TO   ('2024-04-01');

CREATE TABLE orders_2024_q2
  PARTITION OF orders
  FOR VALUES FROM ('2024-04-01')
            TO   ('2024-07-01');`}</pre>
            <p class="text-[10px] text-(--fg-faint) border-l-2 border-cyan-500/40 pl-2">Best for time-based data with rolling deletes — drop a partition instead of DELETE.</p>
          </div>
          <div class="rounded-lg border border-amber-500/30 bg-(--bg) p-3 space-y-2">
            <p class="text-[10px] font-semibold text-amber-400">LIST — categorical</p>
            <pre class="sql-details-pre thin-scrollbar text-[10px]">{`CREATE TABLE orders (
  id      BIGINT,
  country TEXT
) PARTITION BY LIST (country);

CREATE TABLE orders_vn
  PARTITION OF orders
  FOR VALUES IN ('VN');

CREATE TABLE orders_us
  PARTITION OF orders
  FOR VALUES IN ('US', 'CA');

CREATE TABLE orders_other
  PARTITION OF orders
  DEFAULT;`}</pre>
            <p class="text-[10px] text-(--fg-faint) border-l-2 border-amber-500/40 pl-2">Best when you query by a low-cardinality column. DEFAULT catches stragglers.</p>
          </div>
          <div class="rounded-lg border border-violet-500/30 bg-(--bg) p-3 space-y-2">
            <p class="text-[10px] font-semibold text-violet-400">HASH — sharding</p>
            <pre class="sql-details-pre thin-scrollbar text-[10px]">{`CREATE TABLE orders (
  id      BIGINT,
  user_id BIGINT
) PARTITION BY HASH (user_id);

-- 4 even shards
CREATE TABLE orders_0
  PARTITION OF orders
  FOR VALUES WITH (MODULUS 4, REMAINDER 0);

CREATE TABLE orders_1
  PARTITION OF orders
  FOR VALUES WITH (MODULUS 4, REMAINDER 1);
-- ... 2, 3`}</pre>
            <p class="text-[10px] text-(--fg-faint) border-l-2 border-violet-500/40 pl-2">Even distribution. No pruning on range queries — only equality on the hash key.</p>
          </div>
        </div>
      </div>
    </details>

    <!-- Theory: when to use / pitfalls -->
    <details class="group rounded-xl border border-(--border) bg-(--bg-alt)">
      <summary class="flex cursor-pointer select-none items-center justify-between gap-3 p-3 font-mono text-xs text-(--fg-dim) hover:text-(--fg) [&::-webkit-details-marker]:hidden">
        <span class="font-semibold">When to partition — pitfalls & monitoring</span>
        <svg class="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="border-t border-(--border) p-4 space-y-3 font-mono text-xs text-(--fg-dim)">
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
          <div class="space-y-2">
            <p class="text-[10px] font-semibold text-emerald-400">When to partition</p>
            <ul class="space-y-1 text-[11px] list-none">
              <li>✓ Table > 100 GB — planner stats degrade</li>
              <li>✓ Rolling deletes (drop old partitions in O(1))</li>
              <li>✓ Every query filters on the partition key</li>
              <li>✓ VACUUM can't keep up — partition = smaller table</li>
            </ul>
            <p class="text-[10px] font-semibold text-rose-400 mt-2">When NOT to partition</p>
            <ul class="space-y-1 text-[11px] list-none">
              <li>✗ Table &lt; 10 GB — overhead, no benefit</li>
              <li>✗ Queries rarely filter on partition key</li>
              <li>✗ Foreign keys to partitioned table (limited)</li>
              <li>✗ You need UPDATE to move a row between partitions</li>
            </ul>
          </div>
          <div class="space-y-2">
            <p class="text-[10px] font-semibold text-(--fg-faint)">Check pruning is working</p>
            <pre class="sql-details-pre thin-scrollbar text-[10px]">{`-- Should show only matching child tables
EXPLAIN (ANALYZE, BUFFERS)
SELECT * FROM orders
WHERE created_at = '2024-06-15';

-- If you see ALL partitions → pruning disabled
-- Check: partition key must be in WHERE exactly
-- enable_partition_pruning = on  (default)`}</pre>
            <pre class="sql-details-pre thin-scrollbar mt-2 text-[10px]">{`-- Partition sizes
SELECT
  child.relname AS partition,
  pg_size_pretty(pg_relation_size(child.oid)) AS size
FROM pg_inherits
JOIN pg_class parent ON pg_inherits.inhparent = parent.oid
JOIN pg_class child  ON pg_inherits.inhrelid  = child.oid
WHERE parent.relname = 'orders'
ORDER BY pg_relation_size(child.oid) DESC;`}</pre>
          </div>
        </div>
      </div>
    </details>
  </div>
</div>
