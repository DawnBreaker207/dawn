---
import ReplicationTimeline from '@/components/lab/sql/ReplicationTimeline.astro';
---

<div data-sql-pane="replication" hidden>
  <!-- Left Stage Column: Interactive Replication Simulator -->
  <div class="sql-stage-col thin-scrollbar space-y-4">
    <ReplicationTimeline />
  </div>

  <!-- Right Guide Column: WAL Streaming & Failover Theory -->
  <div class="sql-guide-col thin-scrollbar">
    <!-- Concept strip -->
    <div class="grid grid-cols-3 gap-2 font-mono text-xs">
      <div class="rounded-lg border border-(--border) bg-(--bg) p-2 text-center">
        <div class="text-base">📡</div>
        <div class="mt-0.5 font-bold text-cyan-500">WAL Stream</div>
        <div class="text-[10px] text-(--fg-faint)">byte-for-byte</div>
      </div>
      <div class="rounded-lg border border-(--border) bg-(--bg) p-2 text-center">
        <div class="text-base">⏱️</div>
        <div class="mt-0.5 font-bold text-amber-500">Sync vs Async</div>
        <div class="text-[10px] text-(--fg-faint)">trade-off</div>
      </div>
      <div class="rounded-lg border border-(--border) bg-(--bg) p-2 text-center">
        <div class="text-base">🔁</div>
        <div class="mt-0.5 font-bold text-emerald-500">Logical</div>
        <div class="text-[10px] text-(--fg-faint)">selective</div>
      </div>
    </div>

    <!-- Theory: Streaming vs Logical -->
    <details class="group rounded-xl border border-(--border) bg-(--bg-alt)">
      <summary class="flex cursor-pointer select-none items-center justify-between gap-3 p-3 font-mono text-xs text-(--fg-dim) hover:text-(--fg) [&::-webkit-details-marker]:hidden">
        <span class="font-semibold">Streaming vs Logical replication</span>
        <svg class="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="border-t border-(--border) p-4 space-y-3 font-mono text-xs text-(--fg-dim)">
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
          <div class="rounded-lg border border-cyan-500/30 bg-(--bg) p-3 space-y-2">
            <p class="text-[10px] font-semibold text-cyan-400">Physical (Streaming) Replication</p>
            <ul class="space-y-1 text-[11px] list-none">
              <li>✓ Streams raw WAL bytes — exact block-level copy</li>
              <li>✓ Standby is byte-for-byte identical to primary</li>
              <li>✓ Used for HA failover (pg_basebackup + streaming)</li>
              <li>✗ Same PG major version required</li>
              <li>✗ Cannot replicate a subset of tables</li>
            </ul>
            <pre class="sql-details-pre thin-scrollbar mt-2 text-[10px]">{`-- primary pg_hba.conf
host replication replicator standby_ip/32 md5

-- standby postgresql.conf
primary_conninfo = 'host=primary ...'
hot_standby = on`}</pre>
          </div>
          <div class="rounded-lg border border-violet-500/30 bg-(--bg) p-3 space-y-2">
            <p class="text-[10px] font-semibold text-violet-400">Logical Replication</p>
            <ul class="space-y-1 text-[11px] list-none">
              <li>✓ Row-level changes (INSERT/UPDATE/DELETE decoded)</li>
              <li>✓ Selective — replicate specific tables or schemas</li>
              <li>✓ Cross-version, cross-platform</li>
              <li>✓ Used for migrations, read-scaling, event streaming</li>
              <li>✗ DDL not replicated automatically</li>
              <li>✗ Sequences not synced</li>
            </ul>
            <pre class="sql-details-pre thin-scrollbar mt-2 text-[10px]">{`-- on publisher
CREATE PUBLICATION my_pub FOR TABLE orders, users;

-- on subscriber
CREATE SUBSCRIPTION my_sub
  CONNECTION 'host=publisher ...'
  PUBLICATION my_pub;`}</pre>
          </div>
        </div>
      </div>
    </details>

    <!-- Theory: monitoring lag -->
    <details class="group rounded-xl border border-(--border) bg-(--bg-alt)">
      <summary class="flex cursor-pointer select-none items-center justify-between gap-3 p-3 font-mono text-xs text-(--fg-dim) hover:text-(--fg) [&::-webkit-details-marker]:hidden">
        <span class="font-semibold">Monitor replication lag — psql queries</span>
        <svg class="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="border-t border-(--border) p-4 font-mono text-xs text-(--fg-dim)">
        <pre class="sql-details-pre thin-scrollbar">{`-- On PRIMARY: check standby lag
SELECT client_addr,
       state,
       sent_lsn,
       write_lsn,
       flush_lsn,
       replay_lsn,
       write_lag,
       flush_lag,
       replay_lag
  FROM pg_stat_replication;

-- replay_lag > 0 → standby is behind
-- flush_lag  > write_lag → standby disk is slow
-- sync_state = 'async' | 'sync' | 'quorum'

-- On STANDBY: how far behind am I?
SELECT now() - pg_last_xact_replay_timestamp() AS replication_lag;
-- > 30s → investigate primary load or network

-- Bytes of WAL not yet applied on standby
SELECT pg_wal_lsn_diff(pg_current_wal_lsn(), replay_lsn) AS lag_bytes
  FROM pg_stat_replication;`}</pre>
      </div>
    </details>
  </div>
</div>
