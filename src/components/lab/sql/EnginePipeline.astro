---
import LabWorkbench from '@/components/lab/LabWorkbench.astro';
import { engineLesson } from '@/data/labs/sql-engine-lesson';
import DtsSceneRenderer from '@/components/widget/DtsSceneRenderer';
import { sqlEngineLesson } from '@/lib/dts/lessons';
import SqlPipelineDiagram from '@/components/lab/sql/SqlPipelineDiagram.astro';
---

<!-- Cyan accent scoped via CSS cascade -->
<div id="ep-wb-container" style="--wb-accent: #22d3ee; --wb-accent-rgb: 34 211 238;">
  <LabWorkbench lesson={engineLesson}>

    <DtsSceneRenderer slot="canvas" lesson={sqlEngineLesson} client:idle />

    <!-- controls slot: query preset picker + Execute / Reset -->
    <div slot="controls" class="flex flex-wrap items-center justify-between gap-3 p-3.5 bg-(--bg-alt)">
      <div class="flex flex-wrap items-center gap-1.5">
        <span class="text-[10px] uppercase tracking-wider text-(--fg-faint) font-mono mr-1">Query:</span>
        <button type="button" data-ep="point_lookup" class="ep-pick ep-pick-on cursor-pointer rounded-lg border px-2.5 py-1 font-mono text-xs font-semibold">Point Lookup</button>
        <button type="button" data-ep="range_scan"   class="ep-pick cursor-pointer rounded-lg border border-(--border) bg-(--bg) px-2.5 py-1 font-mono text-xs font-semibold text-(--fg-dim) hover:text-(--fg)">Range Scan</button>
        <button type="button" data-ep="hash_join"    class="ep-pick cursor-pointer rounded-lg border border-(--border) bg-(--bg) px-2.5 py-1 font-mono text-xs font-semibold text-(--fg-dim) hover:text-(--fg)">Hash Join</button>
        <button type="button" data-ep="insert"       class="ep-pick cursor-pointer rounded-lg border border-(--border) bg-(--bg) px-2.5 py-1 font-mono text-xs font-semibold text-(--fg-dim) hover:text-(--fg)">INSERT</button>
        <button type="button" data-ep="update"       class="ep-pick cursor-pointer rounded-lg border border-(--border) bg-(--bg) px-2.5 py-1 font-mono text-xs font-semibold text-(--fg-dim) hover:text-(--fg)">UPDATE</button>
        <button type="button" data-ep="delete"       class="ep-pick cursor-pointer rounded-lg border border-(--border) bg-(--bg) px-2.5 py-1 font-mono text-xs font-semibold text-(--fg-dim) hover:text-(--fg)">DELETE</button>
      </div>
      <div class="flex items-center gap-2">
        <button id="ep-run"   type="button" class="cursor-pointer rounded-lg border border-cyan-500 bg-cyan-500/15 px-4 py-1.5 font-mono text-xs font-semibold text-cyan-600 dark:text-cyan-400 transition-all hover:bg-cyan-500/25 active:scale-95">▶ Execute</button>
        <button id="ep-reset" type="button" class="hidden cursor-pointer rounded-lg border border-(--border) bg-(--bg) px-3 py-1.5 font-mono text-xs text-(--fg-dim) hover:text-(--fg)">↺ Reset</button>
        <span   id="ep-status" class="font-mono text-[10px] text-(--fg-faint)">ready</span>
      </div>
    </div>

    <!-- default slot: Engine State card + Technical Specs accordion -->
    <div class="ep-state-card mt-4">
      <div class="mb-2 flex items-center justify-between font-mono text-[11px] text-(--fg-dim)">
        <span class="font-semibold uppercase tracking-wider">Shared Buffers (8KB Slots)</span>
        <span id="ep-buf-count" class="text-[10px] text-(--fg-faint)">0 / 12</span>
      </div>
      <div id="ep-bufs" class="grid grid-cols-4 gap-1 mb-3"></div>
      <div class="grid grid-cols-2 gap-2 border-t border-(--border) pt-2 font-mono text-[10.5px]">
        <div>
          <div class="text-[9px] uppercase tracking-wider text-(--fg-faint)">WAL Buffer</div>
          <div class="text-(--fg) font-bold" id="ep-wal-written">0 B written</div>
          <div class="text-[9.5px] text-(--fg-dim)" id="ep-fsync">—</div>
        </div>
        <div>
          <div class="text-[9px] uppercase tracking-wider text-(--fg-faint)">Active Lock</div>
          <div class="text-amber-500 font-bold" id="ep-locks">none</div>
          <div class="text-[9.5px] text-(--fg-dim)">AccessShareLock</div>
        </div>
      </div>
    </div>

    <details class="group rounded-xl border border-(--border) bg-(--bg-alt) transition-colors mt-4">
      <summary class="flex cursor-pointer select-none items-center justify-between gap-3 p-4 font-mono text-xs text-(--fg-dim) hover:text-(--fg) [&::-webkit-details-marker]:hidden">
        <span class="font-semibold tracking-wide">Technical Specs: SQL Query Statement & EXPLAIN ANALYZE Plan</span>
        <svg class="h-4 w-4 shrink-0 transition-transform group-open:rotate-180 text-(--fg-dim)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </summary>
      <div class="grid grid-cols-1 gap-4 border-t border-(--border) p-4 md:grid-cols-2">
        <div>
          <div class="mb-1 text-[10px] font-mono uppercase tracking-wider text-(--fg-faint)">SQL Query</div>
          <pre id="ep-sql" class="min-h-[90px] overflow-x-auto rounded-lg border border-(--border) bg-(--terminal) p-3 font-mono text-[11px] leading-relaxed"></pre>
        </div>
        <div>
          <div class="mb-1 text-[10px] font-mono uppercase tracking-wider text-(--fg-faint)">EXPLAIN Plan Output</div>
          <pre id="ep-plan" class="min-h-[90px] overflow-x-auto rounded-lg border border-cyan-500/25 bg-cyan-950/10 p-3 font-mono text-[11px] leading-relaxed text-cyan-400"></pre>
        </div>
      </div>
    </details>

    <!-- 2D Pipeline Stage Diagram -->
    <div class="mt-4">
      <SqlPipelineDiagram />
    </div>

  </LabWorkbench>
</div>

<style>
  .stage-canvas-placeholder {
    flex: 1;
    min-height: 220px;
    background: var(--bg-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ep-state-card {
    background: var(--bg-alt);
    border: 1.5px solid var(--border);
    border-radius: 14px;
    padding: 16px;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.12);
  }

  /* Buffer slot chips */
  .ep-buf {
    border-radius: 4px;
    border: 1px solid var(--border);
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 8.5px;
    font-weight: 700;
    color: var(--fg-faint);
    background: var(--bg);
    transition: all 0.2s;
  }

  .ep-buf-sys  { border-color: rgb(99 102 241 / 0.5); background: rgb(99 102 241 / 0.12); color: #818cf8; }
  .ep-buf-idx  { border-color: rgb(34 211 238 / 0.5); background: rgb(34 211 238 / 0.12); color: #67e8f9; }
  .ep-buf-heap { border-color: rgb(251 191 36 / 0.5); background: rgb(251 191 36 / 0.12); color: #fbbf24; }
  .ep-buf-hash { border-color: rgb(192 132 252 / 0.5); background: rgb(192 132 252 / 0.12); color: #c084fc; }

  .ep-pick-on {
    border-color: var(--fg);
    background: var(--fg);
    color: var(--bg);
  }
</style>

<script>
  import { PRESETS } from '@/scripts/lab/sql/engine-presets';
  import type { Preset, BufSlot } from '@/scripts/lab/sql/engine-presets';

  function initEngineWorkbench() {
    const container = document.getElementById('ep-wb-container');
    if (!container) return;
    const wbRoot = container.querySelector<HTMLElement>('.wb-root');
    if (!wbRoot) return;

    let cur = 'point_lookup';
    let curStageIdx = 0;
    let running = false;
    let aborted = false;
    let bufUsed = 0;
    let walTotal = 0;
    let activeLocks: string[] = [];

    const delay = (ms: number) => new Promise<void>(res => setTimeout(res, ms));

    // — Engine State card helpers —

    function renderBuffers() {
      const el = document.getElementById('ep-bufs');
      if (!el) return;
      el.innerHTML = '';
      for (let i = 0; i < 12; i++) {
        const d = document.createElement('div');
        d.className = 'ep-buf';
        d.id = `ep-buf-${i}`;
        d.textContent = '·';
        el.appendChild(d);
      }
      bufUsed = 0;
      const count = document.getElementById('ep-buf-count');
      if (count) count.textContent = '0 / 12';
    }

    function addBufferSlot(slot: BufSlot) {
      if (bufUsed >= 12) return;
      const el = document.getElementById(`ep-buf-${bufUsed}`);
      if (el) {
        el.textContent = slot.label;
        el.className = `ep-buf ep-buf-${slot.kind}`;
      }
      bufUsed++;
      const count = document.getElementById('ep-buf-count');
      if (count) count.textContent = `${bufUsed} / 12`;
    }

    // — LabWorkbench bridge —

    // When the user (or EP) navigates a step, override guide-body/callout with preset-specific text
    wbRoot.addEventListener('wb:step-change', (e: Event) => {
      const idx = (e as CustomEvent<{ idx: number }>).detail?.idx;
      if (typeof idx !== 'number') return;
      curStageIdx = idx;
      const stage = PRESETS[cur]?.stages[idx];
      if (!stage) return;

      const body = wbRoot.querySelector<HTMLElement>('[data-wb="guide-body"]');
      if (body) body.innerHTML = `<p>${stage.detail}</p>`;

      const callout = wbRoot.querySelector<HTMLElement>('[data-wb="guide-callout"]');
      if (callout) {
        callout.textContent = stage.callout || stage.detail;
        callout.style.display = '';
      }
    });

    function navigateTo(i: number) {
      curStageIdx = i;
      wbRoot!.dispatchEvent(new CustomEvent('wb:navigate', { detail: { idx: i }, bubbles: true }));
    }

    // — Preset rendering —

    function renderPreset(id: string) {
      const p = PRESETS[id];
      if (!p) return;
      const sql = document.getElementById('ep-sql');
      if (sql) sql.textContent = p.sql;
      const plan = document.getElementById('ep-plan');
      if (plan) plan.textContent = p.plan;
      navigateTo(0);
    }

    // — Pipeline execution —

    async function executePipeline() {
      const preset = PRESETS[cur];
      if (!preset) return;
      running = true;
      aborted = false;

      const runBtn = document.getElementById('ep-run');
      const resetBtn = document.getElementById('ep-reset');
      const status = document.getElementById('ep-status');
      runBtn?.classList.add('hidden');
      resetBtn?.classList.remove('hidden');

      for (let i = 0; i < preset.stages.length; i++) {
        if (aborted) break;
        const s = preset.stages[i];
        navigateTo(i);
        if (status) status.textContent = `${s.icon} ${s.name}...`;

        for (const b of (s.addBufs ?? [])) {
          if (aborted) break;
          addBufferSlot(b);
        }

        if (s.walBytes) {
          walTotal += s.walBytes;
          const w = document.getElementById('ep-wal-written');
          if (w) w.textContent = `${walTotal} B written`;
        }

        if (s.fsync) {
          const fsyncEl = document.getElementById('ep-fsync') as HTMLElement | null;
          if (fsyncEl) {
            fsyncEl.textContent = '✓ fsynced to disk';
            fsyncEl.style.color = '#4ade80';
          }
        }

        if (s.clearLocks) {
          activeLocks = [];
        } else if (s.addLocks?.length) {
          activeLocks.push(...s.addLocks.map(l => l.mode));
        }
        const locksEl = document.getElementById('ep-locks');
        if (locksEl) locksEl.textContent = activeLocks.join(', ') || 'none';

        await delay(Math.min(s.simMs * 2.2, 1200));
      }

      if (!aborted && status) status.textContent = '✓ completed';
      running = false;
    }

    function resetEngine() {
      aborted = true;
      running = false;
      walTotal = 0;
      activeLocks = [];
      renderBuffers();

      const w = document.getElementById('ep-wal-written');
      if (w) w.textContent = '0 B written';
      const fsyncEl = document.getElementById('ep-fsync') as HTMLElement | null;
      if (fsyncEl) {
        fsyncEl.textContent = '—';
        fsyncEl.style.color = '';
      }
      const locksEl = document.getElementById('ep-locks');
      if (locksEl) locksEl.textContent = 'none';

      const runBtn = document.getElementById('ep-run');
      const resetBtn = document.getElementById('ep-reset');
      const status = document.getElementById('ep-status');
      runBtn?.classList.remove('hidden');
      resetBtn?.classList.add('hidden');
      if (status) status.textContent = 'ready';

      renderPreset(cur);
    }

    // — Wire up controls —

    renderBuffers();
    renderPreset(cur);

    container.querySelectorAll<HTMLButtonElement>('[data-ep]').forEach(btn => {
      btn.addEventListener('click', () => {
        if (running) return;
        cur = btn.dataset.ep || 'point_lookup';
        container.querySelectorAll('[data-ep]').forEach(b => b.classList.remove('ep-pick-on'));
        btn.classList.add('ep-pick-on');
        resetEngine();
      });
    });

    document.getElementById('ep-run')?.addEventListener('click', () => {
      if (!running) executePipeline();
    });

    document.getElementById('ep-reset')?.addEventListener('click', resetEngine);
  }

  initEngineWorkbench();
  document.addEventListener('astro:page-load', initEngineWorkbench);
</script>
