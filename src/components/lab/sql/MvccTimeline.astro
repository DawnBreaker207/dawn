---
// MvccTimeline.astro — 2D Split Stage: Temporal Swimlanes (t0→t5) + Dual Txn SQL Flow
// Visualizes xmin/xmax tuple version states between Txn A (Writer) and Txn B (Reader).

interface Props {
  initialIsoLevel?: 'READ COMMITTED' | 'REPEATABLE READ';
}

const { initialIsoLevel = 'READ COMMITTED' } = Astro.props;

const txnACode = [
  '-- Txn A (xid 100, Writer)',
  't0: BEGIN;',
  't1: UPDATE accounts SET balance = 500 WHERE id = 1;',
  't2: -- (uncommitted row visible only to Txn A)',
  't4: COMMIT;'
];

const txnBCode = [
  '-- Txn B (xid 101, Reader)',
  't0: BEGIN;',
  't1: SELECT balance FROM accounts WHERE id = 1; -- sees 1000',
  't3: SELECT balance FROM accounts WHERE id = 1; -- RC sees 500 vs RR sees 1000',
  't5: COMMIT;'
];
---

<div class="split-stage-root mvcc-stage-root">
  <!-- Top: 2D Visual Stage (~60%) -->
  <div class="visual-stage-area">
    <div class="stage-header">
      <div class="flex items-center gap-2">
        <span class="font-mono text-[10px] uppercase tracking-wider text-(--fg-faint)">MVCC Version Chain &amp; Timeline</span>
        <span class="state-badge" id="mvcc-badge-iso">READ COMMITTED</span>
      </div>
      <div class="flex items-center gap-1 font-mono text-[10px]">
        <button type="button" class="mvcc-iso-btn is-active" data-iso="rc" data-track-event="sql-mvcc-iso-rc">READ COMMITTED</button>
        <button type="button" class="mvcc-iso-btn" data-iso="rr" data-track-event="sql-mvcc-iso-rr">REPEATABLE READ</button>
      </div>
    </div>

    <svg class="stage-svg" viewBox="0 0 680 230" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Time Grid Axis -->
      <line x1="120" y1="20" x2="640" y2="20" stroke="var(--border)" stroke-width="1.5" />
      <g class="font-mono text-[9px] fill-(--fg-faint)">
        <text x="140" y="14" text-anchor="middle">t0</text>
        <text x="240" y="14" text-anchor="middle">t1</text>
        <text x="340" y="14" text-anchor="middle">t2</text>
        <text x="440" y="14" text-anchor="middle">t3</text>
        <text x="540" y="14" text-anchor="middle">t4 (Commit)</text>
        <text x="620" y="14" text-anchor="middle">t5</text>
      </g>

      <!-- Swimlane 1: Txn A (Writer) -->
      <g class="swimlane-group" transform="translate(20, 35)">
        <rect width="90" height="45" rx="6" class="swimlane-label-box fill-amber-500/10 stroke-amber-500/30" />
        <text x="45" y="20" text-anchor="middle" class="font-mono text-[10px] font-bold fill-amber-500">Txn A</text>
        <text x="45" y="34" text-anchor="middle" class="font-mono text-[8.5px] fill-(--fg-faint)">xid 100 (Writer)</text>

        <!-- Txn A life bar -->
        <line x1="110" y1="22" x2="520" y2="22" stroke="#f59e0b" stroke-width="3" stroke-linecap="round" />
        <!-- Action markers -->
        <circle cx="120" cy="22" r="4" fill="#f59e0b" />
        <circle cx="220" cy="22" r="5" fill="#f43f5e" />
        <circle cx="520" cy="22" r="5" fill="#10b981" />
        <text x="220" y="40" text-anchor="middle" class="font-mono text-[8.5px] fill-(--fg-dim)">UPDATE</text>
        <text x="520" y="40" text-anchor="middle" class="font-mono text-[8.5px] fill-emerald-500">COMMIT</text>
      </g>

      <!-- Center: Tuple Version Chain -->
      <g class="version-chain-group" transform="translate(20, 95)">
        <rect width="90" height="50" rx="6" class="swimlane-label-box fill-cyan-500/10 stroke-cyan-500/30" />
        <text x="45" y="22" text-anchor="middle" class="font-mono text-[10px] font-bold fill-cyan-400">Row Version</text>
        <text x="45" y="36" text-anchor="middle" class="font-mono text-[8.5px] fill-(--fg-faint)">Tuple Chain</text>

        <!-- Version 1 box -->
        <g id="mvcc-box-v1" transform="translate(130, 5)">
          <rect width="180" height="40" rx="6" class="node-box border-emerald-500" />
          <text x="90" y="16" text-anchor="middle" class="font-mono text-[9px] font-bold fill-(--fg)">v1 (xmin: 90, xmax: 100)</text>
          <text x="90" y="30" text-anchor="middle" class="font-mono text-[9.5px] fill-emerald-400 font-semibold" id="mvcc-v1-data">balance: 1000 (Live → Dead)</text>
        </g>

        <!-- Version 2 box -->
        <g id="mvcc-box-v2" transform="translate(340, 5)">
          <rect width="180" height="40" rx="6" class="node-box border-amber-500" />
          <text x="90" y="16" text-anchor="middle" class="font-mono text-[9px] font-bold fill-(--fg)">v2 (xmin: 100, xmax: ∞)</text>
          <text x="90" y="30" text-anchor="middle" class="font-mono text-[9.5px] fill-amber-400 font-semibold" id="mvcc-v2-data">balance: 500 (Live after t4)</text>
        </g>
      </g>

      <!-- Swimlane 2: Txn B (Reader) -->
      <g class="swimlane-group" transform="translate(20, 160)">
        <rect width="90" height="45" rx="6" class="swimlane-label-box fill-indigo-500/10 stroke-indigo-500/30" />
        <text x="45" y="20" text-anchor="middle" class="font-mono text-[10px] font-bold fill-indigo-400">Txn B</text>
        <text x="45" y="34" text-anchor="middle" class="font-mono text-[8.5px] fill-(--fg-faint)">xid 101 (Reader)</text>

        <!-- Txn B life bar -->
        <line x1="110" y1="22" x2="600" y2="22" stroke="#6366f1" stroke-width="3" stroke-linecap="round" />
        <!-- Action markers -->
        <circle cx="120" cy="22" r="4" fill="#6366f1" />
        <circle cx="220" cy="22" r="5" fill="#38bdf8" />
        <circle cx="420" cy="22" r="5" fill="#38bdf8" />
        <circle cx="600" cy="22" r="4" fill="#6366f1" />
        <text x="220" y="38" text-anchor="middle" class="font-mono text-[8.5px] fill-(--fg-dim)">SELECT (sees 1000)</text>
        <text x="420" y="38" text-anchor="middle" class="font-mono text-[8.5px] font-bold" id="mvcc-lbl-read2" fill="#22d3ee">SELECT (sees 500)</text>
      </g>
    </svg>
  </div>

  <!-- Bottom: Synced Dual Txn Code Flow Tracker (~40%) -->
  <div class="code-flow-tracker grid grid-cols-1 md:grid-cols-2 gap-3">
    <!-- Txn A Code -->
    <div class="txn-code-col">
      <div class="tracker-header">
        <span class="font-mono text-[10px] uppercase tracking-wider text-amber-500 font-bold">Txn A (Writer)</span>
        <span class="text-[9.5px] text-(--fg-faint)">xid 100</span>
      </div>
      <div class="code-lines-container font-mono text-[11px] space-y-1">
        {txnACode.map((line, idx) => (
          <div class={`code-line ${idx === 2 ? 'is-active' : ''}`} data-line-idx={idx}>
            <span class="line-content">{line}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Txn B Code -->
    <div class="txn-code-col">
      <div class="tracker-header">
        <span class="font-mono text-[10px] uppercase tracking-wider text-indigo-400 font-bold">Txn B (Reader)</span>
        <span class="text-[9.5px] text-(--fg-faint)" id="mvcc-snap-badge">Snapshot at each statement</span>
      </div>
      <div class="code-lines-container font-mono text-[11px] space-y-1">
        {txnBCode.map((line, idx) => (
          <div class={`code-line ${idx === 3 ? 'is-active' : ''}`} data-line-idx={idx}>
            <span class="line-content">{line}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  function setupMvccTimeline() {
    const root = document.querySelector('.mvcc-stage-root');
    if (!root) return;

    const isoBtns = root.querySelectorAll<HTMLButtonElement>('.mvcc-iso-btn');
    const badge = root.querySelector('#mvcc-badge-iso');
    const snapBadge = root.querySelector('#mvcc-snap-badge');
    const lblRead2 = root.querySelector('#mvcc-lbl-read2');

    function setIso(iso: 'rc' | 'rr') {
      isoBtns.forEach(btn => btn.classList.toggle('is-active', btn.dataset.iso === iso));

      if (iso === 'rc') {
        badge && (badge.textContent = 'READ COMMITTED');
        snapBadge && (snapBadge.textContent = 'Snapshot at each statement');
        if (lblRead2) {
          lblRead2.textContent = 'SELECT (sees 500)';
          lblRead2.setAttribute('fill', '#22d3ee');
        }
      } else {
        badge && (badge.textContent = 'REPEATABLE READ');
        snapBadge && (snapBadge.textContent = 'Snapshot at transaction start (t0)');
        if (lblRead2) {
          lblRead2.textContent = 'SELECT (sees 1000 - frozen)';
          lblRead2.setAttribute('fill', '#a78bfa');
        }
      }
    }

    isoBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        setIso(btn.dataset.iso as 'rc' | 'rr');
      });
    });

    document.addEventListener('wb:step-change', ((e: CustomEvent) => {
      const stepIdx = e.detail?.index ?? 0;
      const linesA = root.querySelectorAll('.txn-code-col:first-child .code-line');
      const linesB = root.querySelectorAll('.txn-code-col:last-child .code-line');
      linesA.forEach((l, idx) => l.classList.toggle('is-active', idx === (stepIdx % linesA.length)));
      linesB.forEach((l, idx) => l.classList.toggle('is-active', idx === (stepIdx % linesB.length)));
    }) as EventListener);
  }

  document.addEventListener('astro:page-load', setupMvccTimeline);
  setupMvccTimeline();
</script>

<style>
  .split-stage-root {
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--bg-alt);
    overflow: hidden;
  }
  .visual-stage-area {
    padding: 16px;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .stage-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }
  .state-badge {
    padding: 2px 8px;
    border-radius: 9999px;
    font-size: 10px;
    font-family: monospace;
    font-weight: 700;
    background: rgba(34, 211, 238, 0.15);
    color: #22d3ee;
    border: 1px solid rgba(34, 211, 238, 0.3);
  }
  .mvcc-iso-btn {
    padding: 2px 8px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--bg-alt);
    color: var(--fg-dim);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .mvcc-iso-btn:hover {
    color: var(--fg);
  }
  .mvcc-iso-btn.is-active {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
    font-weight: 600;
  }
  .stage-svg {
    width: 100%;
    height: auto;
    max-height: 220px;
  }
  .swimlane-label-box {
    stroke-width: 1;
  }
  .node-box {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.5;
  }
  .code-flow-tracker {
    background: var(--terminal, #18181b);
    padding: 12px 16px;
  }
  .tracker-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 4px;
  }
  .code-line {
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--fg-dim);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .code-line.is-active {
    background: rgba(34, 211, 238, 0.15);
    color: #22d3ee;
    font-weight: 600;
  }
</style>
