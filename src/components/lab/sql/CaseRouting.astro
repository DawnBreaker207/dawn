---
import type { CaseBranch } from '@/scripts/lab/sql/execution-order'

interface Props {
  caseBranches: CaseBranch[];
}
const { caseBranches } = Astro.props;
---

<!-- CASE routing: same endpoint, four query shapes -->
<div class="mb-2 rounded-xl border border-amber-500/40 bg-amber-950/10 p-4 font-mono text-xs">
  <p class="mb-3 border-b border-amber-500/20 pb-2 text-[11px] tracking-widest text-(--fg-faint) uppercase">
    case routing
    <span class="ml-1 normal-case text-(--fg-dim)">one endpoint · four query shapes — the missing branch never touches the database</span>
  </p>
  <div id="case-pills" class="flex flex-wrap gap-2">
    {caseBranches.map((branch, index) => (
      <button
        type="button"
        data-case-idx={index}
        class:list={[
          'cursor-pointer rounded-full border px-3 py-1 text-[11px] transition-colors',
          index === 0
            ? 'border-amber-400 bg-amber-500/20 text-amber-700 dark:text-amber-200'
            : 'border-amber-500/40 text-(--fg-dim) hover:text-(--fg)',
        ]}
      >{branch.pill}</button>
    ))}
  </div>
  <div class="mt-3">
    {caseBranches.map((branch, index) => (
      <div data-case-idx={index} hidden={index !== 0}>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-[1.15fr_1fr]">
          <div class="min-w-0">
            <p class="mb-2 text-[10px] uppercase tracking-wider text-(--fg-faint)">query shape for this branch</p>
            <pre class="thin-scrollbar max-h-72 overflow-auto rounded-lg border border-(--border) bg-(--terminal) p-3 text-[11px] leading-relaxed text-(--fg)">{branch.code}</pre>
          </div>
          <div class="min-w-0 space-y-2.5">
            <div class="flex flex-wrap gap-1.5">
              <span class="rounded-sm border border-emerald-500/50 px-1.5 py-0.5 font-mono text-[10px] text-emerald-700 dark:text-emerald-300">runs: {branch.plan}</span>
              <span class="rounded-sm border border-rose-500/40 px-1.5 py-0.5 font-mono text-[10px] text-rose-600 dark:text-rose-300">skips: {branch.skips}</span>
            </div>
            <p class="text-[11px] leading-relaxed text-(--fg-dim)">{branch.note}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>
