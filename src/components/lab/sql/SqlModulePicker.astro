---
interface Props {
  currentModule?: string;
}

const { currentModule = 'engine' } = Astro.props;

const MODULES = [
  { id: 'engine', num: '01', title: 'Engine Pipeline', icon: '⚡' },
  { id: 'explain', num: '02', title: 'EXPLAIN Explorer', icon: '🔍' },
  { id: 'btree', num: '03', title: 'B-Tree Index', icon: '🌲' },
  { id: 'mvcc', num: '04', title: 'MVCC & Isolation', icon: '🛡️' },
  { id: 'footprint', num: '05', title: 'Index Footprint', icon: '📊' },
  { id: 'infra', num: '06', title: 'Connection Pool', icon: '🔄' },
  { id: 'partition', num: '07', title: 'Partitioning', icon: '📑' },
  { id: 'replication', num: '08', title: 'WAL Replication', icon: '📡' },
];
---

<div class="sql-module-picker-root" id="sql-module-picker-root">
  <button
    id="btn-sql-module-dropdown"
    type="button"
    class="sql-dropdown-trigger"
    aria-haspopup="true"
    aria-expanded="false"
    title="Switch PostgreSQL 16 Module"
  >
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
      <path d="M6 6h10"></path>
      <path d="M6 10h10"></path>
    </svg>
    <span id="sql-active-module-title" class="sql-module-name font-mono">01 · Engine Pipeline</span>
    <span class="sql-module-tag font-mono">8 Modules ▾</span>
  </button>

  <div id="sql-dropdown-menu" class="sql-dropdown-menu" hidden>
    <div class="sql-dropdown-header">
      <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-(--fg-faint)">PostgreSQL 16 Modules</span>
      <span class="font-mono text-[10px] text-(--fg-dim)">8 Topics</span>
    </div>
    <div class="sql-dropdown-list thin-scrollbar">
      {MODULES.map((m) => (
        <button
          type="button"
          class:list={[
            'sql-dropdown-item',
            m.id === currentModule && 'is-current'
          ]}
          data-sql-tab={m.id}
          data-sql-title={`${m.num} · ${m.title}`}
        >
          <span class="sql-item-dot">●</span>
          <span class="sql-item-text">{m.num} · {m.title}</span>
          <span class="sql-active-badge font-mono" data-sql-pill={m.id} hidden={m.id !== currentModule}>Active</span>
        </button>
      ))}
    </div>
  </div>
</div>

<style>
  .sql-module-picker-root {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .sql-dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 11.5px;
    font-weight: 600;
    font-family: var(--font-mono, monospace);
    padding: 3px 9px;
    border-radius: 6px;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--fg);
    cursor: pointer;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    transition: all 0.15s ease;
  }

  .sql-dropdown-trigger:hover,
  .sql-dropdown-trigger[aria-expanded="true"] {
    background: var(--bg-alt);
    border-color: var(--accent);
    color: var(--accent);
  }

  .sql-module-name {
    max-width: 170px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sql-module-tag {
    font-size: 9.5px;
    padding: 1px 5px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    font-weight: 700;
  }

  .sql-dropdown-menu {
    position: absolute;
    top: calc(100% + 5px);
    right: 0;
    width: 280px;
    max-height: 380px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 12px 32px -4px rgba(0, 0, 0, 0.28), 0 0 0 1px rgba(0, 0, 0, 0.05);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: sqlFadeIn 0.15s ease-out;
  }

  @keyframes sqlFadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .sql-dropdown-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    background: var(--bg-alt);
    border-bottom: 1px solid var(--border);
  }

  .sql-dropdown-list {
    display: flex;
    flex-direction: column;
    padding: 4px;
    max-height: 320px;
    overflow-y: auto;
  }

  .sql-dropdown-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    border-radius: 6px;
    font-size: 11.5px;
    font-family: var(--font-mono, monospace);
    color: var(--fg-dim);
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    width: 100%;
    transition: all 0.12s ease;
  }

  .sql-dropdown-item:hover {
    background: var(--bg-hover);
    color: var(--fg);
  }

  .sql-dropdown-item.is-current {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent);
    font-weight: 600;
  }

  .sql-item-dot {
    font-size: 7px;
    opacity: 0.6;
    color: currentColor;
  }

  .sql-item-text {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sql-active-badge {
    font-size: 9px;
    padding: 1px 5px;
    border-radius: 3px;
    background: var(--accent);
    color: #ffffff;
    font-weight: 700;
  }
</style>
