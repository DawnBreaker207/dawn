---
// SqlPipelineDiagram.astro — 2D Split Stage: Visual Pipeline + Synced SQL Flow Tracker
// Listens for 'wb:step-change' to animate query lifecycle stages and highlight execution plan steps.

interface Props {
  initialStage?: string;
}

const sqlCode = `SELECT u.name, count(o.id) AS total_orders
FROM users u
JOIN orders o ON u.id = o.user_id
WHERE u.status = 'active'
GROUP BY u.name
ORDER BY total_orders DESC;

-- [Stage 1: Parse]    Tokenized SQL -> Abstract Syntax Tree (AST)
-- [Stage 2: Analyze]  Catalog lookups (pg_class, pg_attribute) & View rewrite
-- [Stage 3: Plan]     Cost Model evaluation: SeqScan vs IndexScan (Cost: 42.5)
-- [Stage 4: Execute]  Volcano iterator pull model (GetNext() chain)
-- [Stage 5: Commit]   WAL record written & fsync before ACK`;

const lines = sqlCode.trim().split('\n');
---

<div class="split-stage-root sql-pipeline-stage-root">
  <!-- Top: 2D Visual Stage (~60%) -->
  <div class="visual-stage-area">
    <div class="stage-header">
      <span class="font-mono text-[10px] uppercase tracking-wider text-(--fg-faint)">PostgreSQL Engine Pipeline</span>
      <span class="stage-badge" id="sql-badge-stage">Stage 1 · Parse</span>
    </div>

    <svg class="stage-svg" viewBox="0 0 640 230" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <marker id="sql-arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 8 5 L 0 9 z" fill="var(--border-hover, #71717a)" />
        </marker>
        <linearGradient id="active-grad" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#06b6d4" />
          <stop offset="100%" stop-color="#0284c7" />
        </linearGradient>
      </defs>

      <!-- Connection Lines between Stages -->
      <path d="M 125 115 L 145 115" stroke="currentColor" class="pipe-line" marker-end="url(#sql-arrow)" />
      <path d="M 255 115 L 275 115" stroke="currentColor" class="pipe-line" marker-end="url(#sql-arrow)" />
      <path d="M 385 115 L 405 115" stroke="currentColor" class="pipe-line" marker-end="url(#sql-arrow)" />
      <path d="M 515 115 L 535 115" stroke="currentColor" class="pipe-line" marker-end="url(#sql-arrow)" />

      <!-- Stage 1: Parse -->
      <g class="pipe-node is-active" data-stage="1" transform="translate(20, 85)">
        <rect width="105" height="60" rx="8" class="pipe-box" />
        <text x="52" y="25" text-anchor="middle" class="pipe-icon">📝</text>
        <text x="52" y="40" text-anchor="middle" class="pipe-title font-mono font-bold">1. PARSE</text>
        <text x="52" y="52" text-anchor="middle" class="pipe-sub font-mono">Lexer & AST</text>
      </g>

      <!-- Stage 2: Analyze & Rewrite -->
      <g class="pipe-node" data-stage="2" transform="translate(150, 85)">
        <rect width="105" height="60" rx="8" class="pipe-box" />
        <text x="52" y="25" text-anchor="middle" class="pipe-icon">🔎</text>
        <text x="52" y="40" text-anchor="middle" class="pipe-title font-mono font-bold">2. ANALYZE</text>
        <text x="52" y="52" text-anchor="middle" class="pipe-sub font-mono">Catalog OIDs</text>
      </g>

      <!-- Stage 3: Plan & Optimize -->
      <g class="pipe-node" data-stage="3" transform="translate(280, 85)">
        <rect width="105" height="60" rx="8" class="pipe-box" />
        <text x="52" y="25" text-anchor="middle" class="pipe-icon">🗺️</text>
        <text x="52" y="40" text-anchor="middle" class="pipe-title font-mono font-bold">3. PLAN</text>
        <text x="52" y="52" text-anchor="middle" class="pipe-sub font-mono">Cost Model</text>
      </g>

      <!-- Stage 4: Execute -->
      <g class="pipe-node" data-stage="4" transform="translate(410, 85)">
        <rect width="105" height="60" rx="8" class="pipe-box" />
        <text x="52" y="25" text-anchor="middle" class="pipe-icon">⚙️</text>
        <text x="52" y="40" text-anchor="middle" class="pipe-title font-mono font-bold">4. EXECUTE</text>
        <text x="52" y="52" text-anchor="middle" class="pipe-sub font-mono">Volcano Engine</text>
      </g>

      <!-- Stage 5: Commit & WAL -->
      <g class="pipe-node" data-stage="5" transform="translate(540, 85)">
        <rect width="90" height="60" rx="8" class="pipe-box" />
        <text x="45" y="25" text-anchor="middle" class="pipe-icon">💾</text>
        <text x="45" y="40" text-anchor="middle" class="pipe-title font-mono font-bold">5. WAL</text>
        <text x="45" y="52" text-anchor="middle" class="pipe-sub font-mono">fsync / ACK</text>
      </g>
    </svg>
  </div>

  <!-- Bottom: Code Flow Tracker (~40%) -->
  <div class="code-tracker-area thin-scrollbar">
    <div class="code-header">
      <span class="font-mono text-[10px] text-(--fg-faint)">QueryLifecycle.sql</span>
      <span class="font-mono text-[10px] text-cyan-400" id="sql-step-hint">Step 1 — Lexer tokenizes SQL</span>
    </div>
    <pre class="code-pre"><code>{lines.map((line, idx) => (
      <div class:list={['code-line', idx === 0 && 'line-active']} data-line-idx={idx}>
        <span class="line-num">{idx + 1}</span>
        <span class="line-content">{line}</span>
      </div>
    ))}</code></pre>
  </div>
</div>

<style>
  .split-stage-root {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    min-height: 480px;
    background: var(--bg);
    border-radius: 10px;
    overflow: hidden;
  }

  .visual-stage-area {
    flex: 1 1 58%;
    min-height: 240px;
    padding: 12px 16px;
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--border);
    position: relative;
    background: var(--bg-alt);
  }

  .stage-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }

  .stage-badge {
    font-family: var(--font-mono, monospace);
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 4px;
    background: color-mix(in srgb, #06b6d4 15%, transparent);
    color: #06b6d4;
    border: 1px solid color-mix(in srgb, #06b6d4 30%, transparent);
  }

  .stage-svg {
    width: 100%;
    height: 100%;
    max-height: 230px;
    display: block;
    margin: auto;
  }

  .pipe-line {
    color: var(--border-hover, #71717a);
    stroke-width: 1.5;
    fill: none;
    transition: stroke 0.25s;
  }

  .pipe-box {
    fill: var(--bg);
    stroke: var(--border);
    stroke-width: 1.5;
    transition: all 0.25s ease;
  }

  .pipe-icon {
    font-size: 14px;
  }

  .pipe-title {
    fill: var(--fg);
    font-size: 10.5px;
    letter-spacing: 0.04em;
  }

  .pipe-sub {
    fill: var(--fg-dim);
    font-size: 8.5px;
  }

  /* Active Node Glow */
  .pipe-node.is-active .pipe-box {
    stroke: #06b6d4;
    fill: color-mix(in srgb, #06b6d4 12%, var(--bg));
    stroke-width: 2.2;
    filter: drop-shadow(0 0 10px rgba(6, 182, 212, 0.35));
  }

  .pipe-node.is-active .pipe-title {
    fill: #06b6d4;
  }

  .code-tracker-area {
    flex: 1 1 42%;
    min-height: 180px;
    overflow-y: auto;
    background: var(--terminal, #121214);
    color: var(--fg);
    padding: 10px 14px;
    font-family: var(--font-mono, monospace);
  }

  .code-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 6px;
    margin-bottom: 6px;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }

  .code-pre {
    margin: 0;
    font-size: 11px;
    line-height: 1.6;
  }

  .code-line {
    display: flex;
    align-items: baseline;
    padding: 1px 6px;
    border-radius: 4px;
    transition: background 0.2s, box-shadow 0.2s;
  }

  .line-num {
    width: 24px;
    text-align: right;
    margin-right: 12px;
    color: var(--fg-faint);
    user-select: none;
    font-size: 10px;
  }

  .line-content {
    flex: 1;
    white-space: pre;
  }

  .code-line.line-active {
    background: color-mix(in srgb, #06b6d4 18%, transparent);
    box-shadow: inset 2px 0 0 #06b6d4;
    color: #ffffff;
    font-weight: 500;
  }
</style>

<script>
  function initSqlPipelineSync() {
    const root = document.querySelector('.sql-pipeline-stage-root');
    if (!root) return;

    const badge = root.querySelector('#sql-badge-stage');
    const hint = root.querySelector('#sql-step-hint');
    const nodes = root.querySelectorAll<SVGGElement>('.pipe-node');
    const lines = root.querySelectorAll<HTMLElement>('.code-line');

    const STAGE_LINE_MAP = [
      { stage: '1', name: 'Stage 1 · Parse', line: 7, text: 'Lexer & Parser build ParseTree' },
      { stage: '2', name: 'Stage 2 · Analyze', line: 8, text: 'Catalog lookup and view rewrite' },
      { stage: '3', name: 'Stage 3 · Plan', line: 9, text: 'Planner calculates cheapest execution cost' },
      { stage: '4', name: 'Stage 4 · Execute', line: 10, text: 'Volcano model pulls rows via GetNext()' },
      { stage: '5', name: 'Stage 5 · Commit', line: 11, text: 'WAL record fsync() & buffer dirty flush' },
    ];

    const syncToStep = (idx: number) => {
      const mapping = STAGE_LINE_MAP[idx % STAGE_LINE_MAP.length];
      if (!mapping) return;

      if (badge) badge.textContent = mapping.name;
      if (hint) hint.textContent = mapping.text;

      nodes.forEach((node) => {
        const isTarget = node.dataset.stage === mapping.stage;
        node.classList.toggle('is-active', isTarget);
      });

      lines.forEach((line) => {
        const isTarget = Number(line.dataset.lineIdx) === mapping.line;
        line.classList.toggle('line-active', isTarget);
      });
    };

    // Listen to wb:step-change from SimulationWorkbench
    const onStepChange = (e: Event) => {
      const customEvent = e as CustomEvent<{ idx?: number; index?: number }>;
      const stepIdx = customEvent.detail?.idx ?? customEvent.detail?.index;
      if (typeof stepIdx === 'number') {
        syncToStep(stepIdx);
      }
    };
    window.addEventListener('wb:step-change', onStepChange);
    document.addEventListener('wb:step-change', onStepChange);

    nodes.forEach((node) => {
      node.style.cursor = 'pointer';
      node.setAttribute('data-track-event', 'sql-pipeline-stage-click');
      node.addEventListener('click', () => {
        const stageNum = parseInt(node.dataset.stage || '1', 10);
        (window as any).umami?.track('sql-pipeline-stage-click', { stage: stageNum });
        window.dispatchEvent(new CustomEvent('wb:navigate', { detail: { idx: stageNum - 1 } }));
      });
    });
  }

  initSqlPipelineSync();
  document.addEventListener('astro:page-load', initSqlPipelineSync);
</script>
