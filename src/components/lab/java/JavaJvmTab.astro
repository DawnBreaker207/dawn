---
import LabWorkbench from '@/components/lab/LabWorkbench.astro';
import { jvmLesson } from '@/data/labs/java-jvm-lesson';

interface Props {
  tab: unknown;
}
---

<!-- Emerald accent scoped via CSS cascade -->
<div id="jvm-wb-container" style="--wb-accent: #10b981; --wb-accent-rgb: 16 185 129;">
  <LabWorkbench lesson={jvmLesson}>

    <!-- canvas slot: Generational Heap Pool Visualization -->
    <!-- IDs (bar-eden, eden-objects, bar-s0, …) used by sim-engine.ts via getElementById -->
    <div slot="canvas" class="jvm-pools-canvas">
      <div class="font-mono text-xs space-y-3 p-4 h-full overflow-y-auto">
        <div class="flex items-center justify-between border-b border-(--border) pb-2 font-semibold">
          <span class="text-sky-500 uppercase tracking-wider text-[11px]">Young Generation (96 MB)</span>
          <span id="label-eden" class="text-[10px] text-(--fg-faint)">0 / 64 MB</span>
        </div>

        <!-- Eden -->
        <div>
          <div class="flex items-center justify-between mb-1">
            <span class="text-(--fg) font-bold text-[11px]">Eden Space (64 MB)</span>
            <span class="text-[9.5px] text-(--fg-faint)">TLAB buffer</span>
          </div>
          <div class="w-full overflow-hidden rounded border border-(--border) bg-(--bg)">
            <div id="bar-eden" class="h-2 bg-sky-500 transition-all duration-300" style="width: 0%"></div>
          </div>
          <div id="eden-objects" class="mt-1.5 flex min-h-[32px] flex-wrap content-start gap-1"></div>
        </div>

        <!-- Survivors -->
        <div class="grid grid-cols-2 gap-2 pt-1 border-t border-(--border)">
          <div>
            <div class="flex items-center justify-between mb-1">
              <span class="font-bold text-[10px] text-emerald-500">S0 (16MB)</span>
              <span id="label-s0" class="text-[9px] text-(--fg-faint)">0 MB</span>
            </div>
            <div class="w-full overflow-hidden rounded border border-(--border) bg-(--bg)">
              <div id="bar-s0" class="h-1.5 bg-emerald-500 transition-all duration-300" style="width: 0%"></div>
            </div>
            <div id="s0-objects" class="mt-1 flex min-h-[24px] flex-wrap content-start gap-0.5"></div>
          </div>
          <div>
            <div class="flex items-center justify-between mb-1">
              <span class="font-bold text-[10px] text-emerald-500">S1 (16MB)</span>
              <span id="label-s1" class="text-[9px] text-(--fg-faint)">0 MB</span>
            </div>
            <div class="w-full overflow-hidden rounded border border-(--border) bg-(--bg)">
              <div id="bar-s1" class="h-1.5 bg-emerald-500 transition-all duration-300" style="width: 0%"></div>
            </div>
            <div id="s1-objects" class="mt-1 flex min-h-[24px] flex-wrap content-start gap-0.5"></div>
          </div>
        </div>

        <!-- Old Gen (Tenured) -->
        <div class="pt-2 border-t border-(--border)">
          <div class="flex items-center justify-between mb-1">
            <span class="font-bold text-[11px] text-amber-500">Old Gen (Tenured 128 MB)</span>
            <span id="label-tenured" class="text-[10px] text-(--fg-faint)">0 / 128 MB</span>
          </div>
          <div class="w-full overflow-hidden rounded border border-(--border) bg-(--bg)">
            <div id="bar-tenured" class="h-2 bg-amber-500 transition-all duration-300" style="width: 0%"></div>
          </div>
          <div id="tenured-objects" class="mt-1.5 flex min-h-[32px] flex-wrap content-start gap-1"></div>
        </div>
      </div>
    </div>

    <!-- controls slot: heap action buttons -->
    <div slot="controls" class="flex flex-wrap items-center justify-between gap-3 p-3.5 bg-(--bg-alt)">
      <div class="flex flex-wrap items-center gap-1.5 font-mono text-xs">
        <span class="mr-1 text-[10px] uppercase tracking-wider text-(--fg-faint)">Heap:</span>
        <button type="button" id="btn-alloc-10" class="cursor-pointer rounded-lg border border-(--border) bg-(--bg) px-2.5 py-1 text-(--fg) transition-colors hover:border-(--fg-dim) hover:text-(--accent) active:scale-95">+10 obj</button>
        <button type="button" id="btn-alloc-50" class="cursor-pointer rounded-lg border border-(--border) bg-(--bg) px-2.5 py-1 text-(--fg) transition-colors hover:border-(--fg-dim) hover:text-(--accent) active:scale-95">+50 obj</button>
        <button type="button" id="btn-minor-gc" class="cursor-pointer rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-2.5 py-1 text-emerald-600 dark:text-emerald-400 transition-colors hover:bg-emerald-500/20 active:scale-95">▶ Minor GC</button>
        <button type="button" id="btn-major-gc" class="cursor-pointer rounded-lg border border-amber-500/40 bg-amber-500/10 px-2.5 py-1 text-amber-600 dark:text-amber-400 transition-colors hover:bg-amber-500/20 active:scale-95">🧹 Full GC</button>
        <button type="button" id="btn-leak-sim" class="cursor-pointer rounded-lg border border-rose-500/40 bg-rose-500/10 px-2.5 py-1 text-rose-600 dark:text-rose-400 transition-colors hover:bg-rose-500/20 active:scale-95">💧 Leak ×20</button>
        <button type="button" id="btn-reset-heap" class="cursor-pointer rounded-lg border border-(--border) bg-(--bg) px-2.5 py-1 text-(--fg-dim) transition-colors hover:text-(--fg)">↻ Reset</button>
      </div>
      <div class="flex items-center gap-3 font-mono text-xs text-(--fg-dim)">
        <label class="flex cursor-pointer select-none items-center gap-1 text-[11px]">
          <input type="checkbox" id="jvm-step-mode" class="accent-(--accent)" />
          Step Mode
        </label>
        <button
          type="button" id="jvm-next"
          class="hidden cursor-pointer rounded-lg border border-(--accent) bg-(--accent)/10 px-2.5 py-0.5 text-[11px] text-(--accent)"
        >▶ next step ▸</button>
      </div>
    </div>

    <!-- default slot: GC telemetry metrics -->
    <details class="group rounded-xl border border-(--border) bg-(--bg-alt) transition-colors mt-4">
      <summary class="flex cursor-pointer select-none items-center justify-between gap-3 p-4 font-mono text-xs text-(--fg-dim) hover:text-(--fg) [&::-webkit-details-marker]:hidden">
        <span class="font-semibold tracking-wide">Technical Specs: JVM Telemetry, Pause Durations & HotSpot Flags</span>
        <svg class="h-4 w-4 shrink-0 transition-transform group-open:rotate-180 text-(--fg-dim)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </summary>
      <div class="grid grid-cols-2 gap-3 p-4 border-t border-(--border) font-mono text-xs sm:grid-cols-4">
        <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
          <div class="text-[10px] uppercase tracking-wider text-(--fg-faint)">Heap Utilization</div>
          <div id="metric-heap-pct" class="mt-0.5 text-lg font-bold text-(--fg)">0%</div>
          <div id="metric-heap-bytes" class="text-[10px] text-(--fg-dim)">0 / 224 MB</div>
        </div>
        <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
          <div class="text-[10px] uppercase tracking-wider text-(--fg-faint)">Minor GCs</div>
          <div id="metric-minor-count" class="mt-0.5 text-lg font-bold text-emerald-600 dark:text-emerald-400">0</div>
          <div id="metric-minor-time" class="text-[10px] text-(--fg-dim)">0 ms pause</div>
        </div>
        <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
          <div class="text-[10px] uppercase tracking-wider text-(--fg-faint)">Full GCs</div>
          <div id="metric-major-count" class="mt-0.5 text-lg font-bold text-amber-600 dark:text-amber-400">0</div>
          <div id="metric-major-time" class="text-[10px] text-(--fg-dim)">0 ms pause</div>
        </div>
        <div class="rounded-lg border border-(--border) bg-(--bg) p-3">
          <div class="text-[10px] uppercase tracking-wider text-(--fg-faint)">STW Total</div>
          <div id="metric-stw-total" class="mt-0.5 text-lg font-bold text-rose-600 dark:text-rose-400">0 ms</div>
          <div id="metric-live-objects" class="text-[10px] text-(--fg-dim)">0 objects</div>
        </div>
      </div>
    </details>

  </LabWorkbench>
</div>

<style>
  .jvm-pools-canvas {
    flex: 1;
    min-height: 320px;
    background: var(--bg-alt);
    overflow-y: auto;
  }
</style>
