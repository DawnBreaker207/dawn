---
import LabSimCard from '@/components/widget/LabSimCard.astro';
import type { JavaTab } from '@/scripts/lab/java/java-tabs';
import type { SimCase, VizCfg } from '@/scripts/lab/java/sim-engine';

interface Props {
  tab: JavaTab;
  cases: SimCase[];
  viz: VizCfg[];
}
const { tab, cases, viz } = Astro.props;
---

<div class="java-workbench">
  <!-- Left Visual Stage: Interactive Simulation -->
  <div class="java-stage-col thin-scrollbar">
    <LabSimCard topic={tab.id} cases={cases} code={viz[0]?.code} track={viz[0]?.track} />
  </div>

  <!-- Right Guide Panel: Theory, Mechanism & Code -->
  <div class="java-guide-col thin-scrollbar">
    <div class="rounded-xl border border-(--border) bg-(--bg) p-4 font-mono text-xs space-y-3">
      <div class="flex items-center justify-between border-b border-(--border) pb-2 font-semibold text-(--fg)">
        <span class:list={[tab.tone, 'font-bold uppercase tracking-wider text-[11px]']}>📖 Theory &amp; Mechanism</span>
        <span class="text-[10px] text-(--fg-faint)">Deep Dive</span>
      </div>
      <p class="font-sans text-sm leading-relaxed text-(--fg-dim)"><strong class="mr-1 text-(--fg)">🎯 The idea:</strong>{tab.explain}</p>
      <div class="rounded-lg border border-amber-500/30 bg-amber-500/10 px-3 py-2 font-sans text-xs leading-relaxed">
        <strong class="mr-1 text-amber-600 dark:text-amber-400">Why it works:</strong>
        <span class="text-(--fg-dim)">{tab.why}</span>
      </div>
      <div>
        <p class="text-[10px] font-semibold uppercase tracking-wider text-(--fg-faint)">⚙ Mechanism Flow</p>
        <p class="mt-1 font-sans text-xs leading-relaxed text-(--fg-faint)">{tab.flow}</p>
        <div class="mt-1.5" set:html={tab.diagram} />
      </div>
      <div>
        <p class="text-[10px] font-semibold uppercase tracking-wider text-(--fg-faint)">⌨ Code Implementation</p>
        <pre
          class="thin-scrollbar overflow-auto rounded-lg border border-(--border) bg-(--terminal) p-3 font-mono text-[11px] leading-relaxed text-(--fg)"
          set:text={tab.code}
        />
      </div>
    </div>
  </div>
</div>
