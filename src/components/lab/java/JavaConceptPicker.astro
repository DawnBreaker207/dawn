---
import { TABS } from '@/scripts/lab/java/java-tabs';

// Segment 1: Core Java (12 concepts)
const JAVA_GROUPS = [
  { short: 'Runtime', ids: ['concurrency', 'jvm', 'jmm', 'io'] },
  { short: 'Memory', ids: ['collections', 'string'] },
  { short: 'Language', ids: ['streams', 'lambda', 'modern', 'generics', 'jit', 'errors'] },
];

// Segment 2: Spring Boot (13 concepts)
const SPRING_GROUPS = [
  { short: 'Core', ids: ['ioc', 'scope', 'aop', 'autoconfig'] },
  { short: 'Data', ids: ['jpa', 'tx'] },
  { short: 'Enterprise', ids: ['security', 'web', 'async', 'messaging', 'config', 'testing', 'metaprog'] },
];

const SHORT: Record<string, string> = {
  concurrency: 'Concurrency', jvm: 'JVM/GC', jmm: 'JMM', io: 'IO/NIO',
  collections: 'Collections', string: 'String',
  streams: 'Streams', lambda: 'Lambda', modern: 'Records', generics: 'Generics', jit: 'JIT', errors: 'Errors',
  ioc: 'IoC', scope: 'Scope', aop: 'AOP', autoconfig: 'Autoconfig',
  jpa: 'JPA', tx: 'Transactions',
  security: 'Security', web: 'Web/REST', async: 'Async', messaging: 'Messaging', config: 'Config', testing: 'Testing', metaprog: 'Meta',
};
---

<div class="java-concept-picker-root" id="java-concept-picker-root">
  <button
    id="btn-java-concept-dropdown"
    type="button"
    class="java-dropdown-trigger"
    aria-haspopup="true"
    aria-expanded="false"
    title="Browse all 25 Java & Spring Concepts"
  >
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
      <path d="M6 6h10"></path>
      <path d="M6 10h10"></path>
    </svg>
    <span id="java-active-concept-title" class="java-concept-name font-mono" data-jx-current>Concurrency</span>
    <span class="java-concept-tag font-mono">25 Concepts ▾</span>
  </button>

  <div id="java-concept-dropdown-menu" class="java-dropdown-menu" hidden>
    <!-- Filter search input -->
    <div class="java-search-wrap">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        id="java-concept-search"
        type="text"
        placeholder="Filter concepts (e.g. jvm, aop, jpa)..."
        autocomplete="off"
      />
    </div>

    <!-- Scrollable Concepts List -->
    <div class="java-dropdown-list thin-scrollbar">
      <!-- Core Java Group -->
      <div class="java-group-header">
        <span class="font-bold text-amber-500">☕ Core Java</span>
        <span class="text-[10px] text-(--fg-faint)">12 Topics</span>
      </div>
      {JAVA_GROUPS.map((grp) => (
        <div class="java-cat-wrap" data-cat={grp.short.toLowerCase()}>
          <div class="java-cat-title">{grp.short}</div>
          <div class="java-cat-items">
            {grp.ids.map((id) => {
              const tab = TABS.find((t) => t.id === id);
              if (!tab) return null;
              return (
                <button
                  type="button"
                  data-jx-tab={tab.id}
                  data-jx-seg="java"
                  class="java-dropdown-item"
                >
                  <span class="java-item-dot">●</span>
                  <span class="java-item-text">{SHORT[tab.id] ?? tab.title}</span>
                </button>
              );
            })}
          </div>
        </div>
      ))}

      <!-- Spring Boot Group -->
      <div class="java-group-header mt-2">
        <span class="font-bold text-emerald-500">🍃 Spring Boot</span>
        <span class="text-[10px] text-(--fg-faint)">13 Topics</span>
      </div>
      {SPRING_GROUPS.map((grp) => (
        <div class="java-cat-wrap" data-cat={grp.short.toLowerCase()}>
          <div class="java-cat-title">{grp.short}</div>
          <div class="java-cat-items">
            {grp.ids.map((id) => {
              const tab = TABS.find((t) => t.id === id);
              if (!tab) return null;
              return (
                <button
                  type="button"
                  data-jx-tab={tab.id}
                  data-jx-seg="spring"
                  class="java-dropdown-item"
                >
                  <span class="java-item-dot">●</span>
                  <span class="java-item-text">{SHORT[tab.id] ?? tab.title}</span>
                </button>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .java-concept-picker-root {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .java-dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 11.5px;
    font-weight: 600;
    font-family: var(--font-mono, monospace);
    padding: 3px 9px;
    border-radius: 6px;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--fg);
    cursor: pointer;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    transition: all 0.15s ease;
  }

  .java-dropdown-trigger:hover,
  .java-dropdown-trigger[aria-expanded="true"] {
    background: var(--bg-alt);
    border-color: var(--accent);
    color: var(--accent);
  }

  .java-concept-name {
    max-width: 150px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .java-concept-tag {
    font-size: 9.5px;
    padding: 1px 5px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    font-weight: 700;
  }

  .java-dropdown-menu {
    position: absolute;
    top: calc(100% + 5px);
    right: 0;
    width: 320px;
    max-height: 420px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 12px 32px -4px rgba(0, 0, 0, 0.28), 0 0 0 1px rgba(0, 0, 0, 0.05);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: jxFadeIn 0.15s ease-out;
  }

  @keyframes jxFadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .java-search-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    background: var(--bg-alt);
    border-bottom: 1px solid var(--border);
    color: var(--fg-dim);
  }

  .java-search-wrap input {
    background: transparent;
    border: none;
    outline: none;
    font-size: 11px;
    font-family: var(--font-mono, monospace);
    color: var(--fg);
    width: 100%;
  }

  .java-dropdown-list {
    display: flex;
    flex-direction: column;
    padding: 6px;
    max-height: 360px;
    overflow-y: auto;
  }

  .java-group-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 8px;
    font-size: 11px;
    font-family: var(--font-mono, monospace);
    border-bottom: 1px dashed var(--border);
    margin-bottom: 4px;
  }

  .java-cat-wrap {
    margin-bottom: 6px;
  }

  .java-cat-title {
    font-size: 9.5px;
    font-family: var(--font-mono, monospace);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fg-faint);
    padding: 2px 8px;
  }

  .java-cat-items {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;
  }

  .java-dropdown-item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 8px;
    border-radius: 5px;
    font-size: 11px;
    font-family: var(--font-mono, monospace);
    color: var(--fg-dim);
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    text-align: left;
    transition: all 0.12s ease;
  }

  .java-dropdown-item:hover {
    background: var(--bg-hover);
    color: var(--fg);
  }

  .java-dropdown-item.border-\(--fg\) {
    background: color-mix(in srgb, var(--accent) 10%, transparent) !important;
    color: var(--accent) !important;
    border-color: var(--accent) !important;
    font-weight: 600;
  }

  .java-item-dot {
    font-size: 6px;
    opacity: 0.6;
    color: currentColor;
  }

  .java-item-text {
    font-weight: 600;
  }

  .java-item-detail {
    margin-left: auto;
    font-size: 9px;
  }
</style>
