---
import type { Lesson } from '@/lib/simulator/types';
import { MODULES, CHAPTER_KINDS } from '@/lib/simulator/curriculum';
import { getNextLessonInTrack } from '@/data/curriculum';

interface Props {
  lesson: Lesson;
}

const { lesson } = Astro.props;

// Locate curriculum module info for crumb
let moduleNum = '01';
let moduleTitle = 'Foundations';
let lessonIdxInMod = 1;
let totalLessonsInMod = 3;
let currentTrackId: string | undefined;

for (const mod of MODULES) {
  const idx = mod.lessons.findIndex(l => l.id === lesson.id);
  if (idx !== -1) {
    moduleNum = mod.num;
    moduleTitle = mod.title;
    lessonIdxInMod = idx + 1;
    totalLessonsInMod = mod.lessons.length;
    currentTrackId = (mod as any).trackId;
    break;
  }
}

const nextLessonInfo = getNextLessonInTrack(lesson.id, currentTrackId);

const s0 = lesson.steps[0];
const totalSteps = lesson.steps.length;
const c0Kind = s0?.chapter && CHAPTER_KINDS[s0.chapter as keyof typeof CHAPTER_KINDS]
  ? CHAPTER_KINDS[s0.chapter as keyof typeof CHAPTER_KINDS]
  : { label: s0?.chapter || 'STEP', tone: 'sand' };

const LEGEND_DEFS: Record<string, [string, string]> = {
  req: ['<i class="lg lg--req"></i>', 'request'],
  res: ['<i class="lg lg--res"></i>', 'response'],
  slow: ['<i class="lg lg--slow"></i>', 'slow request'],
  queue: ['<i class="lg lg--slow"></i>', 'waiting'],
  heavy: ['<i class="lg lg--heavy"></i>', 'heavy request'],
  mine: ['<i class="lg lg--mine"></i>', 'Alice’s request'],
  write: ['<i class="lg lg--write"></i>', 'write'],
  kill: ['<i class="lg lg--kill"></i>', 'invalidate'],
  msg: ['<i class="lg lg--msg"></i>', 'message'],
  poison: ['<i class="lg lg--poison"></i>', 'poison message'],
  push: ['<i class="lg lg--push"></i>', 'server push'],
  empty: ['<i class="lg lg--empty"></i>', 'empty response'],
  retry: ['<i class="lg lg--slow"></i>', 'retry'],
  telemetry: ['<i class="lg lg--write"></i>', 'telemetry'],
  attack: ['<i class="lg lg--poison"></i>', 'attacker'],
  ping: ['<i class="lg lg--ping"></i>', 'health check'],
  fail: ['<i class="lg lg--fail">×</i>', 'failed request'],
};

const legendItems = (lesson.legend ?? []).map((item: any) => {
  const [key, customLabel] = Array.isArray(item) ? item : [item, undefined];
  const def = LEGEND_DEFS[key];
  const icon = def ? def[0] : `<i class="lg lg--${key}"></i>`;
  const label = customLabel ?? (def ? def[1] : key);
  return { icon, label };
});

const METRIC_CONFIGS: Record<string, { label: string; icon: string }> = {
  dns: {
    label: 'DNS lookup',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg>`,
  },
  connect: {
    label: 'Connect',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="16" y="16" width="6" height="6" rx="1"></rect><rect x="2" y="16" width="6" height="6" rx="1"></rect><rect x="9" y="2" width="6" height="6" rx="1"></rect><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"></path><path d="M12 12V8"></path></svg>`,
  },
  request: {
    label: 'Request + server',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"></rect><rect width="20" height="8" x="2" y="14" rx="2" ry="2"></rect><line x1="6" x2="6.01" y1="6" y2="6"></line><line x1="6" x2="6.01" y1="18" y2="18"></line></svg>`,
  },
  download: {
    label: 'Download',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg>`,
  },
  total: {
    label: 'Total',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="10" x2="14" y1="2" y2="2"></line><line x1="12" x2="15" y1="14" y2="11"></line><circle cx="12" cy="14" r="8"></circle></svg>`,
  },
  subnets: {
    label: 'Subnets',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="7" x="3" y="3" rx="1.5"></rect><rect width="7" height="7" x="14" y="3" rx="1.5"></rect><rect width="7" height="7" x="14" y="14" rx="1.5"></rect><rect width="7" height="7" x="3" y="14" rx="1.5"></rect></svg>`,
  },
  nat_gw: {
    label: 'NAT Gateway',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>`,
  },
  sec_groups: {
    label: 'Sec Groups',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>`,
  },
  endpoints: {
    label: 'Endpoints',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="m10 15 5-3-5-3v6z"></path></svg>`,
  },
  security_posture: {
    label: 'Posture',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>`,
  },
  az_active: {
    label: 'Active AZs',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>`,
  },
  asg_capacity: {
    label: 'ASG Capacity',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="M6 12h12"></path></svg>`,
  },
  failover_sec: {
    label: 'Failover',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>`,
  },
  stage: {
    label: 'Stage',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>`,
  },
  buffers: {
    label: 'Buffers',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>`,
  },
  wal: {
    label: 'WAL Log',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>`,
  },
  locks: {
    label: 'Locks',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>`,
  },
  threads: {
    label: 'Threads',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 20V10"></path><path d="M12 20V4"></path><path d="M6 20v-6"></path></svg>`,
  },
  queue: {
    label: 'Queue',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"></rect><line x1="8" y1="4" x2="8" y2="20"></line><line x1="16" y1="4" x2="16" y2="20"></line></svg>`,
  },
  mode: {
    label: 'Mode',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>`,
  },
  queue_depth: {
    label: 'Queue Depth',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>`,
  },
  fanout_topics: {
    label: 'Fanout',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>`,
  },
  lambda_concurrency: {
    label: 'Concurrency',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>`,
  },
  dlq_messages: {
    label: 'DLQ Dead',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>`,
  },
  serverless_uptime: {
    label: 'Uptime',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>`,
  },
  lon: {
    label: 'London Edge',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg>`,
  },
  syd: {
    label: 'Sydney Edge',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg>`,
  },
  origin: {
    label: 'Origin Load',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2"></rect><rect x="2" y="14" width="20" height="8" rx="2"></rect></svg>`,
  },
  hitRate: {
    label: 'Cache Hit %',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>`,
  },
  rps: {
    label: 'RPS Rate',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg>`,
  },
  p95: {
    label: 'p95 Latency',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>`,
  },
  errors: {
    label: 'Errors',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>`,
  },
  healthy: {
    label: 'Healthy',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>`,
  },
  users: {
    label: 'Users',
    icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>`,
  },
};

const activeMetricKeys = lesson.metrics && lesson.metrics.length > 0 ? lesson.metrics : ['dns', 'connect', 'request', 'download', 'total'];
---

<div class="body" id="dts-body" data-wb-lesson={JSON.stringify(lesson)} data-next-lesson={nextLessonInfo ? JSON.stringify(nextLessonInfo) : ''}>
  <!-- LEFT: Sheet (lesson header, 3D stage, bottom timeline) -->
  <main class="sheet">
    <div class="lesson-head is-fresh" id="head">
      <div class="crumb">{moduleNum}. {moduleTitle} <span>/</span> Lesson {lessonIdxInMod} of {totalLessonsInMod}</div>
      <div class="lesson-head__row">
        <h1 class="title">{lesson.title}</h1>
        <div class="tags">
          <span class="tag tag--sand">
            <svg class="i " width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>
            {lesson.minutes} min
          </span>
          <span class="tag tag--mint">
            <svg class="i " width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 20h.01"></path><path d="M7 20v-4"></path><path d="M12 20v-8"></path><path d="M17 20V8"></path><path d="M22 4v16"></path></svg>
            {lesson.level}
          </span>
          <span class="tag tag--violet">
            <svg class="i " width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5h10"></path><path d="M11 12h10"></path><path d="M11 19h10"></path><path d="M4 4h1v5"></path><path d="M4 9h2"></path><path d="M6.5 20H3.4c0-1 2.6-1.925 2.6-3.5a1.5 1.5 0 0 0-2.6-1.02"></path></svg>
            {totalSteps} steps
          </span>
        </div>
      </div>
      <p class="subtitle" title={lesson.summary}>{lesson.summary}</p>
    </div>

    <section class="card stage">
      <!-- HUD Chips rendered dynamically from activeMetricKeys -->
      <div class="stage__hud is-fresh" id="hud">
        {activeMetricKeys.map((k: string) => {
          const cfg = METRIC_CONFIGS[k] || {
            label: k.charAt(0).toUpperCase() + k.slice(1).replace(/_/g, ' '),
            icon: `<svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle></svg>`,
          };
          const initialVal = (s0?.metrics as any)?.[k];
          return (
            <div class="chip" data-k={k} data-level={initialVal == null ? 'none' : 'good'}>
              <span class="chip__label" set:html={`${cfg.icon}${cfg.label}`} />
              <span class="chip__value" data-val={k}>
                {initialVal == null ? '—' : typeof initialVal === 'number' ? `${initialVal} ms` : initialVal}
              </span>
            </div>
          );
        })}
      </div>

      <!-- Stage Tools -->
      <div class="stage__tools">
        <div class="view-mode-toggle" id="view-mode-toggle" hidden>
          <button type="button" class="mode-btn is-active" data-view-mode="3d" title="3D Isometric Simulation">3D View</button>
          <button type="button" class="mode-btn" data-view-mode="2d" title="2D Deep-Dive Visualizer">2D Deep-Dive</button>
        </div>
        <button class="tool tool--fit" id="fit" data-t-title="Back to the whole diagram (0)" title="Back to the whole diagram (0)" hidden="">
          <svg class="i " width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" x2="16.65" y1="21" y2="16.65"></line><line x1="8" x2="14" y1="11" y2="11"></line></svg>
          <span data-t="Fit">Fit</span>
        </button>
        <button class="tool" id="replay" data-t-title="Replay this step (R)" title="Replay this step (R)">
          <svg class="i " width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
          <span data-t="Replay">Replay</span>
        </button>
        <button class="tool" id="pause" title="Pause traffic (Space)">
          <svg class="i " width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="14" y="3" width="5" height="18" rx="1"></rect><rect x="5" y="3" width="5" height="18" rx="1"></rect></svg>
          <span>Pause</span>
        </button>
        <button class="tool tool--expand" id="expand" title="Full screen" aria-label="Show the diagram full screen">
          <svg class="i " width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"></path><path d="m21 3-7 7"></path><path d="m3 21 7-7"></path><path d="M9 21H3v-6"></path></svg>
        </button>
      </div>

      <!-- Canvas Area for DtsSceneRenderer -->
      <div class="stage__canvas" id="canvas">
        <slot name="canvas" />
      </div>

      <!-- Optional 2D Deep-Dive Visualizer Area -->
      <div class="stage__2d-visualizer" id="visualizer-2d" hidden>
        <slot name="visualizer-2d" />
      </div>

      <!-- Stage Legend -->
      {legendItems.length > 0 && (
        <div class="stage__legend is-fresh" id="legend">
          {legendItems.map((item) => (
            <span><Fragment set:html={item.icon} />{item.label}</span>
          ))}
        </div>
      )}
    </section>

    <!-- Bottom Horizontal Timeline -->
    <section class="card timeline is-fresh" id="timeline">
      <div class="timeline__head">
        <span class="eyebrow">In this lesson</span>
        <span class="timeline__count" id="tl-count">Step 1 of {totalSteps}</span>
      </div>
      <div class="timeline__track" style={`--n: ${totalSteps}`}>
        <div class="timeline__rail"><span id="tl-fill" style="width: 0%"></span></div>
        <ol class="timeline__steps" id="timeline-steps">
          {lesson.steps.map((step, idx) => {
            const chp = step.chapter && CHAPTER_KINDS[step.chapter as keyof typeof CHAPTER_KINDS]
              ? CHAPTER_KINDS[step.chapter as keyof typeof CHAPTER_KINDS]
              : null;
            return (
              <li class={idx === 0 ? 'is-current' : ''} data-step-idx={idx}>
                <button type="button" data-step={idx} title={step.title}>
                  <span class={`timeline__dot ${chp ? `chapter-dot--${chp.tone}` : ''}`}>{idx + 1}</span>
                  <span class="timeline__label">{step.short}</span>
                </button>
              </li>
            );
          })}
        </ol>
      </div>
    </section>
  </main>

  <!-- RIGHT: Rail (Step Guide card & Learning Goals card) -->
  <aside class="rail">
    <section class="card guide" id="guide">
      <div class="guide__meta">
        <span class="eyebrow" id="guide-step-label">Step 1 / {totalSteps}</span>
        <div class="guide__meta-end">
          <span class={`chapter chapter--${c0Kind.tone}`} id="guide-chapter-badge">{c0Kind.label}</span>
        </div>
      </div>
      <div class="guide__content is-in" id="guide-content" style="--slide: 0px;">
        <h2 class="guide__title" id="guide-title">{s0?.title}</h2>
        <div class="guide__body" id="guide-body">
          {s0?.body.map(p => <p set:html={p} />)}
        </div>
        
        <div
          class={`callout callout--${s0?.callout?.kind || 'insight'}`}
          id="guide-callout"
          style={!s0?.callout ? 'display: none;' : ''}
        >
          <div class="callout__icon">
            <svg class="i " width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg>
          </div>
          <div>
            <div class="callout__title" id="guide-callout-title">{s0?.callout?.title || 'Key idea'}</div>
            <p id="guide-callout-text" set:html={s0?.callout?.text || ''}></p>
          </div>
        </div>

        <div
          class="changes"
          id="guide-changes"
          style={!s0?.changes || s0.changes.length === 0 ? 'display: none;' : ''}
        >
          <div class="eyebrow">What changed</div>
          <ul id="guide-changes-list">
            {(s0?.changes || []).map((chg) => {
              const t = chg.startsWith('+') ? 'add' : chg.startsWith('−') || chg.startsWith('-') ? 'del' : 'mod';
              const sym = { add: '+', del: '−', mod: '~' }[t];
              return <li class={`chg chg--${t}`}><b>{sym}</b><span>{chg.slice(2)}</span></li>;
            })}
          </ul>
        </div>
      </div>

      <div class="guide__nav">
        <button class="btn-ghost" id="back" type="button" disabled>
          <svg class="i " width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
          Back
        </button>
        <button class="btn-pop btn-next" id="next" type="button" disabled={totalSteps <= 1 && !nextLessonInfo}>
          <span class="btn-next__label" id="guide-next-label">
            {lesson.steps[1]?.short ? `Next: ${lesson.steps[1].short}` : nextLessonInfo ? `Next: ${nextLessonInfo.title}` : 'Finish Track ✓'}
          </span>
          <svg class="i " width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </button>
      </div>

      <div class="guide__hint">
        <svg class="i " width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 8h.01"></path><path d="M12 12h.01"></path><path d="M14 8h.01"></path><path d="M16 12h.01"></path><path d="M18 8h.01"></path><path d="M6 8h.01"></path><path d="M7 16h10"></path><path d="M8 12h.01"></path><rect width="20" height="16" x="2" y="4" rx="2"></rect></svg>
        <span><kbd>←</kbd> <kbd>→</kbd> step · <kbd>R</kbd> replay · <kbd>Space</kbd> pause</span>
      </div>
    </section>

    {lesson.goals && lesson.goals.length > 0 && (
      <section class="card goals is-fresh" id="goals">
        <div class="eyebrow">You’ll learn</div>
        <ul id="goals-list">
          {lesson.goals.map((g, idx) => (
            <li data-goal-step={g.step !== undefined ? g.step : idx + 1}>
              <span class="check">
                <svg class="i " width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
              </span>
              {g.text}
            </li>
          ))}
        </ul>
      </section>
    )}
  </aside>
</div>

<script>
  import { CHAPTER_KINDS } from '@/lib/simulator/curriculum';

  function initDtsWorkbench() {
    const root = document.getElementById('dts-body');
    if (!root) return;

    const lessonData = root.getAttribute('data-wb-lesson');
    if (!lessonData) return;
    const lesson = JSON.parse(lessonData);
    const steps = lesson.steps || [];
    const total = steps.length;
    let curIdx = 0;

    const rawNext = root.getAttribute('data-next-lesson');
    const nextLesson = rawNext ? JSON.parse(rawNext) : null;

    const elStepLabel = document.getElementById('guide-step-label');
    const elChapterBadge = document.getElementById('guide-chapter-badge');
    const elGuideTitle = document.getElementById('guide-title');
    const elGuideBody = document.getElementById('guide-body');
    const elGuideCallout = document.getElementById('guide-callout');
    const elGuideCalloutTitle = document.getElementById('guide-callout-title');
    const elGuideCalloutText = document.getElementById('guide-callout-text');
    const elGuideChanges = document.getElementById('guide-changes');
    const elGuideChangesList = document.getElementById('guide-changes-list');
    const elGuideNextLabel = document.getElementById('guide-next-label');
    const elBtnBack = document.getElementById('back') as HTMLButtonElement | null;
    const elBtnNext = document.getElementById('next') as HTMLButtonElement | null;
    const elTimeline = document.getElementById('timeline');
    const elTimelineCount = document.getElementById('tl-count');
    const elTimelineRailFill = document.getElementById('tl-fill');
    const elTimelineSteps = document.getElementById('timeline-steps');
    const elGoalsList = document.getElementById('goals-list');
    const elHud = document.getElementById('hud');

    function checkTimelineTightness() {
      if (!elTimelineSteps || !elTimeline) return;
      const stepWidth = elTimelineSteps.clientWidth / Math.max(1, elTimelineSteps.children.length);
      elTimeline.classList.toggle('is-tight', stepWidth > 0 && stepWidth < 70);
    }

    let isInitialized = false;
    let prevChapter = '';
    const prevMetrics: Record<string, number | null | undefined> = {};

    function renderStep(idx: number, force = false) {
      if (idx < 0 || idx >= total) return;
      if (!force && isInitialized && idx === curIdx) return;
      const prevIdx = curIdx;
      curIdx = idx;
      const s = steps[idx];
      if (!s) return;

      // Slide direction for Guide transition (+1 for next, -1 for back, 0 for initial)
      const dir = !isInitialized ? 0 : Math.sign(idx - prevIdx);

      // Clone ghost for sliding out previous guide content
      const guideEl = document.getElementById('guide');
      const contentEl = document.getElementById('guide-content');
      let ghost: HTMLElement | null = null;
      let ghostBounds: { top: number; left: number; width: number; height: number; scroll: number } | null = null;
      if (isInitialized && dir !== 0 && guideEl && contentEl) {
        ghost = contentEl.cloneNode(true) as HTMLElement;
        ghostBounds = {
          top: contentEl.offsetTop,
          left: contentEl.offsetLeft,
          width: contentEl.offsetWidth,
          height: contentEl.offsetHeight,
          scroll: contentEl.scrollTop,
        };
        guideEl.querySelectorAll('.guide__ghost').forEach((e) => e.remove());
      }

      isInitialized = true;

      // Notify DtsSceneRenderer and 2D Deep-Dive Visualizers
      const stepEvtDetail = { idx, step: s, index: idx };
      root?.dispatchEvent(new CustomEvent('wb:step-change', { detail: stepEvtDetail, bubbles: true }));
      window.dispatchEvent(new CustomEvent('wb:step-change', { detail: stepEvtDetail }));
      document.dispatchEvent(new CustomEvent('wb:step-change', { detail: stepEvtDetail }));

      // Guide meta
      if (elStepLabel) elStepLabel.textContent = `Step ${idx + 1} / ${total}`;
      const chp = s.chapter && (CHAPTER_KINDS as any)[s.chapter]
        ? (CHAPTER_KINDS as any)[s.chapter]
        : { label: s.chapter ? s.chapter.toUpperCase() : 'STEP', tone: 'sand' };
      if (elChapterBadge) {
        elChapterBadge.textContent = chp.label;
        elChapterBadge.className = `chapter chapter--${chp.tone}`;
        if (dir !== 0 && prevChapter !== s.chapter) {
          elChapterBadge.style.setProperty('--slide', `${dir * 14}px`);
          elChapterBadge.classList.remove('is-in');
          void elChapterBadge.offsetWidth;
          elChapterBadge.classList.add('is-in');
        }
      }
      prevChapter = s.chapter || '';

      // Guide Title & Body
      if (elGuideTitle) elGuideTitle.textContent = s.title;
      if (elGuideBody) {
        elGuideBody.innerHTML = (s.body || []).map((p: string) => `<p>${p}</p>`).join('');
      }

      // Callout
      if (elGuideCallout) {
        if (s.callout) {
          elGuideCallout.style.display = 'flex';
          elGuideCallout.className = `callout callout--${s.callout.kind || 'insight'}`;
          if (elGuideCalloutTitle) elGuideCalloutTitle.textContent = s.callout.title || 'Key idea';
          if (elGuideCalloutText) elGuideCalloutText.innerHTML = s.callout.text || '';
        } else {
          elGuideCallout.style.display = 'none';
        }
      }

      // Changes ("What changed")
      if (elGuideChanges && elGuideChangesList) {
        if (s.changes && s.changes.length > 0) {
          elGuideChanges.style.display = 'block';
          elGuideChangesList.innerHTML = s.changes.map((chg: string) => {
            const t = chg.startsWith('+') ? 'add' : chg.startsWith('−') || chg.startsWith('-') ? 'del' : 'mod';
            const sym = { add: '+', del: '−', mod: '~' }[t];
            return `<li class="chg chg--${t}"><b>${sym}</b><span>${chg.slice(2)}</span></li>`;
          }).join('');
        } else {
          elGuideChanges.style.display = 'none';
          elGuideChangesList.innerHTML = '';
        }
      }

      // Slide In animation on new guide content
      if (contentEl) {
        contentEl.style.setProperty('--slide', `${dir * 36}px`);
        contentEl.classList.remove('is-in');
        void contentEl.offsetWidth;
        contentEl.classList.add('is-in');
      }

      // Append and remove sliding ghost
      if (ghost && ghostBounds && guideEl) {
        ghost.className = 'guide__content guide__ghost';
        ghost.style.cssText = `top:${ghostBounds.top}px;left:${ghostBounds.left}px;width:${ghostBounds.width}px;height:${ghostBounds.height}px;--slide:${-dir * 36}px;position:absolute;`;
        guideEl.appendChild(ghost);
        ghost.scrollTop = ghostBounds.scroll;
        setTimeout(() => ghost?.remove(), 200);
      }

      // Nav buttons
      if (elBtnBack) elBtnBack.disabled = idx === 0;
      if (elBtnNext) {
        const isLastStep = idx === total - 1;
        if (!isLastStep) {
          elBtnNext.disabled = false;
          elBtnNext.title = '';
          if (elGuideNextLabel) {
            elGuideNextLabel.textContent = `Next: ${steps[idx + 1]?.short || ''}`;
          }
        } else {
          if (nextLesson && nextLesson.href) {
            elBtnNext.disabled = false;
            elBtnNext.title = `Next lesson: ${nextLesson.title}`;
            if (elGuideNextLabel) {
              const displayTitle = nextLesson.title.length <= 18 ? nextLesson.title : `${nextLesson.title.slice(0, 16)}…`;
              elGuideNextLabel.textContent = `Next: ${displayTitle}`;
            }
          } else {
            elBtnNext.disabled = true;
            elBtnNext.title = 'You have completed all lessons in this track';
            if (elGuideNextLabel) {
              elGuideNextLabel.textContent = 'Finish Track ✓';
            }
          }
        }
      }

      // Timeline
      if (elTimelineCount) elTimelineCount.textContent = `Step ${idx + 1} of ${total}`;
      if (elTimelineRailFill) {
        const pct = total > 1 ? (idx / (total - 1)) * 100 : 0;
        elTimelineRailFill.style.width = `${pct}%`;
      }
      if (elTimelineSteps) {
        const lis = elTimelineSteps.querySelectorAll('li');
        lis.forEach((li, i) => {
          li.classList.toggle('is-done', i < idx);
          li.classList.toggle('is-current', i === idx);
        });
      }
      checkTimelineTightness();

      // Goals
      if (elGoalsList) {
        const lis = elGoalsList.querySelectorAll('li');
        lis.forEach((li) => {
          const goalStep = parseInt(li.getAttribute('data-goal-step') || '99', 10);
          const isHit = goalStep <= idx + 1;
          li.classList.toggle('is-hit', isHit);
          const chk = li.querySelector('.check');
          if (chk) chk.classList.toggle('is-on', isHit);
        });
      }

      // HUD Metrics with count-up animation & chip-flash
      if (elHud) {
        const metrics = s.metrics || {};
        const allKeys = Array.from(new Set([
          ...(lesson.metrics || []),
          ...Object.keys(metrics),
        ]));

        allKeys.forEach((k) => {
          const valEl = elHud.querySelector(`[data-val="${k}"]`) as HTMLElement | null;
          const chipEl = elHud.querySelector(`[data-k="${k}"]`) as HTMLElement | null;
          if (!valEl || !chipEl) return;

          const oldVal = prevMetrics[k];
          const newVal = metrics[k];
          prevMetrics[k] = newVal;

          const changed = oldVal !== undefined && oldVal !== newVal;
          if (changed && dir !== 0) {
            chipEl.classList.remove('is-changed');
            void chipEl.offsetWidth;
            chipEl.classList.add('is-changed');
          }

          const isTween = dir !== 0 && typeof oldVal === 'number' && typeof newVal === 'number' && oldVal !== newVal;

          if (!isTween) {
            if (changed && dir !== 0) {
              valEl.classList.remove('is-swap');
              void valEl.offsetWidth;
              valEl.classList.add('is-swap');
            }
            valEl.textContent = newVal == null ? '—' : typeof newVal === 'number' ? `${newVal} ms` : String(newVal);
            chipEl.setAttribute('data-level', newVal == null || newVal === '—' ? 'none' : 'good');
          } else {
            const startW = chipEl.offsetWidth;
            valEl.textContent = `${newVal} ms`;
            const endW = chipEl.offsetWidth;
            valEl.textContent = `${oldVal} ms`;
            chipEl.style.width = `${startW}px`;

            const startTime = performance.now();
            const duration = 900;
            const animId = {};
            (chipEl as any)._anim = animId;

            const stepAnim = (now: number) => {
              if ((chipEl as any)._anim !== animId) return;
              const p = Math.min(1, (now - startTime) / duration);
              const ease = 1 - (1 - p) ** 3;
              const currentVal = Math.round(Number(oldVal) + (Number(newVal) - Number(oldVal)) * ease);
              valEl.textContent = `${currentVal} ms`;
              chipEl.style.width = `${startW + (endW - startW) * ease}px`;
              if (p < 1) {
                requestAnimationFrame(stepAnim);
              } else {
                chipEl.style.width = '';
                valEl.textContent = `${newVal} ms`;
                chipEl.setAttribute('data-level', 'good');
              }
            };
            requestAnimationFrame(stepAnim);
          }
        });
      }
    }

    // Button event handlers
    elBtnBack?.addEventListener('click', () => renderStep(curIdx - 1));
    elBtnNext?.addEventListener('click', () => {
      if (curIdx === total - 1 && nextLesson?.href) {
        window.location.href = nextLesson.href;
        return;
      }
      renderStep(curIdx + 1);
    });

    // Timeline clicks
    elTimeline?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-step]') as HTMLElement | null;
      if (btn) {
        const step = parseInt(btn.getAttribute('data-step') || '0', 10);
        renderStep(step);
      }
    });

    // Window event listeners with cleanup
    if ((window as any).__dts_wb_controller) {
      (window as any).__dts_wb_controller.abort();
    }
    const controller = new AbortController();
    (window as any).__dts_wb_controller = controller;

    // Recalculate timeline tightness on window resize
    window.addEventListener('resize', () => {
      checkTimelineTightness();
    }, { signal: controller.signal });

    // Custom external event wb:navigate
    const onNavigate = (e: Event) => {
      const detail = (e as CustomEvent).detail;
      const step = detail?.idx ?? detail?.step ?? 0;
      renderStep(step);
    };
    root.addEventListener('wb:navigate', onNavigate, { signal: controller.signal });
    window.addEventListener('wb:navigate', onNavigate, { signal: controller.signal });

    // View Mode Toggle (3D Simulator vs 2D Deep-Dive Visualizer)
    const elViewToggle = document.getElementById('view-mode-toggle');
    const elCanvas = document.getElementById('canvas');
    const elViz2d = document.getElementById('visualizer-2d');
    if (elViz2d && elViz2d.firstElementChild && elViewToggle) {
      elViewToggle.hidden = false;
      const btns = elViewToggle.querySelectorAll<HTMLButtonElement>('[data-view-mode]');
      btns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const mode = btn.getAttribute('data-view-mode');
          btns.forEach((b) => b.classList.toggle('is-active', b === btn));
          if (mode === '2d') {
            if (elCanvas) elCanvas.hidden = true;
            elViz2d.hidden = false;
          } else {
            if (elCanvas) elCanvas.hidden = false;
            elViz2d.hidden = true;
          }
        });
      });
    }

    // Keyboard shortcuts: ArrowLeft / ArrowRight / R (replay) / Space (pause) / 0 (fit)
    window.addEventListener('keydown', (e) => {
      if (document.activeElement?.tagName === 'INPUT' || document.activeElement?.tagName === 'TEXTAREA') return;
      if (e.key === 'ArrowRight') {
        if (curIdx === total - 1 && nextLesson?.href) {
          window.location.href = nextLesson.href;
          return;
        }
        renderStep(curIdx + 1);
      }
      if (e.key === 'ArrowLeft') renderStep(curIdx - 1);
      if (e.key === 'r' || e.key === 'R') {
        document.getElementById('replay')?.click();
      }
      if (e.key === ' ' || e.code === 'Space') {
        e.preventDefault();
        document.getElementById('pause')?.click();
      }
      if (e.key === '0') {
        document.getElementById('fit')?.click();
      }
    }, { signal: controller.signal });

    // Initialize Step 0
    renderStep(0);
  }

  document.addEventListener('astro:page-load', initDtsWorkbench);
</script>
