---
import { CURRICULUM_MODULES, CURRICULUM_TRACKS, type Module, type Lesson, getLessonHref } from '@/data/curriculum';

interface Props {
  currentLessonId: string;
  trackId?: string;
  moduleId?: string;
}

const { currentLessonId, trackId: propTrackId, moduleId: propModuleId } = Astro.props;

// 1. Resolve active module
let activeModule = propModuleId ? CURRICULUM_MODULES.find((m) => m.id === propModuleId) : undefined;
if (!activeModule) {
  activeModule = CURRICULUM_MODULES.find((m) => m.lessons.some((l) => l.id === currentLessonId));
}
if (!activeModule) {
  activeModule = CURRICULUM_MODULES[0];
}

// 2. Resolve active track encompassing related modules (e.g. Java Runtime + Spring Framework)
let activeTrack = propTrackId ? CURRICULUM_TRACKS.find((t) => t.id === propTrackId) : undefined;
if (!activeTrack) {
  activeTrack = CURRICULUM_TRACKS.find((t) => t.moduleIds.includes(activeModule.id) || t.id === activeModule.trackId);
}
if (!activeTrack) {
  activeTrack = CURRICULUM_TRACKS[0];
}

// 3. Resolve all modules in this track
const visibleModules = CURRICULUM_MODULES.filter((m) => activeTrack.moduleIds.includes(m.id) || m.trackId === activeTrack.id);
const totalVisibleLessons = visibleModules.reduce((acc, m) => acc + m.lessons.length, 0);

const activeModIdx = visibleModules.findIndex((m) => m.id === activeModule.id);
const initialModNum = String((activeModIdx !== -1 ? activeModIdx : 0) + 1).padStart(2, '0');
let activeLessonTitle = `${initialModNum} · ${activeModule.lessons[0]?.title || activeModule.title}`;
for (let i = 0; i < visibleModules.length; i++) {
  const mod = visibleModules[i];
  const modNum = String(i + 1).padStart(2, '0');
  const found = mod.lessons.find((l) => l.id === currentLessonId);
  if (found) {
    activeLessonTitle = `${modNum} · ${found.title}`;
    break;
  }
}

interface SectionGroup {
  title: string | null;
  lessons: Lesson[];
}
---

<!-- Dropdown Root -->
<div class="chapter-dropdown-root" id="chapter-picker-root">
  <button
    id="btn-chapter-dropdown"
    type="button"
    class="chapter-dropdown-trigger"
    data-umami-event="chapter-picker-toggle"
    aria-haspopup="true"
    aria-expanded="false"
    title={`Browse ${activeTrack.title} chapters`}
  >
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
      <path d="M6 6h10"></path>
      <path d="M6 10h10"></path>
    </svg>
    <span id="chapter-active-title" class="chapter-name font-mono">{activeLessonTitle}</span>
    <svg class="chapter-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m6 9 6 6 6-6" />
    </svg>
  </button>

  <!-- Dropdown Menu (Floating Panel) -->
  <div id="chapter-dropdown-menu" class="chapter-dropdown-menu" hidden>
    <!-- Search filter inside dropdown -->
    <div class="dropdown-search-wrap">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        id="dropdown-search-input"
        type="text"
        data-umami-event="chapter-picker-search"
        placeholder="Search chapters..."
        autocomplete="off"
      />
    </div>

    <!-- Scoped to Track Modules -->
    <div class="dropdown-list-scroll thin-scrollbar" id="dropdown-list-container">
      {visibleModules.map((mod: Module, modIdx: number) => {
        const modNum = String(modIdx + 1).padStart(2, '0');
        const sectionGroups: SectionGroup[] = [];
        for (const lesson of mod.lessons) {
          const curSection = lesson.section || null;
          const lastGroup = sectionGroups[sectionGroups.length - 1];
          if (!lastGroup || lastGroup.title !== curSection) {
            sectionGroups.push({ title: curSection, lessons: [lesson] });
          } else {
            lastGroup.lessons.push(lesson);
          }
        }

        return (
          <div class="dropdown-module-group" data-module-id={mod.id} data-track-id={mod.trackId}>
            <div class="dropdown-module-header font-mono">
              <span class="mod-num">{modNum}</span>
              <span class="mod-title">{mod.title}</span>
            </div>
            <div class="dropdown-lessons-list">
              {sectionGroups.map((group) => (
                <div class="dropdown-section-group" data-section-title={group.title || ''}>
                  {group.title && (
                    <div class="dropdown-section-label font-mono">
                      {group.title}
                    </div>
                  )}
                  {group.lessons.map((lesson: Lesson) => {
                    const isCurrent = lesson.id === currentLessonId;
                    const href = getLessonHref(lesson.id);
                    return (
                      <button
                        type="button"
                        class:list={[
                          'dropdown-lesson-btn',
                          isCurrent && 'is-current',
                        ]}
                        data-lesson-id={lesson.id}
                        data-lesson-title={`${modNum} · ${lesson.title}`}
                        data-lesson-href={href}
                        data-native="true"
                        data-umami-event="chapter-select"
                      >
                        <span class="lesson-dot">●</span>
                        <span class="lesson-text">{lesson.title}</span>
                        <span class="active-check font-mono" data-lesson-pill={lesson.id} hidden={!isCurrent}>✓</span>
                      </button>
                    );
                  })}
                </div>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</div>

<style>
  .chapter-dropdown-root {
    position: relative;
    display: inline-flex;
    align-items: center;
    z-index: 50;
  }

  .chapter-dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 11.5px;
    font-weight: 600;
    font-family: var(--font-mono, monospace);
    padding: 3px 9px;
    border-radius: 6px;
    background: var(--bg-alt, var(--bg));
    border: 1px solid var(--border);
    color: var(--fg);
    cursor: pointer;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    transition: all 0.15s ease;
  }

  .chapter-dropdown-trigger:hover,
  .chapter-dropdown-trigger[aria-expanded="true"] {
    background: var(--bg-hover, var(--bg-alt));
    border-color: var(--accent);
    color: var(--accent);
  }

  .chapter-name {
    max-width: clamp(180px, 24vw, 320px);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .chapter-caret {
    width: 11px;
    height: 11px;
    color: var(--fg-faint);
    transition: transform 0.15s ease;
    flex-shrink: 0;
  }

  .chapter-dropdown-trigger[aria-expanded="true"] .chapter-caret {
    transform: rotate(180deg);
  }

  .chapter-dropdown-menu {
    position: absolute;
    top: calc(100% + 5px);
    right: 0;
    width: 320px;
    max-height: 420px;
    background: var(--bg-alt, #ffffff);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: 0 12px 32px -4px rgba(0, 0, 0, 0.25), 0 0 0 1px var(--border);
    z-index: 9999;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: dropdownFadeIn 0.15s ease-out;
  }

  @keyframes dropdownFadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .dropdown-search-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-subtle, var(--bg));
    color: var(--fg-dim);
  }

  .dropdown-search-wrap input {
    background: transparent;
    border: none;
    outline: none;
    font-size: 11px;
    font-family: var(--font-mono, monospace);
    color: var(--fg);
    width: 100%;
  }

  .dropdown-list-scroll {
    overflow-y: auto;
    max-height: 350px;
    padding: 4px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--bg-alt, #ffffff);
  }

  .dropdown-module-group {
    display: flex;
    flex-direction: column;
  }

  .dropdown-module-group + .dropdown-module-group {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px dashed var(--border);
  }

  .dropdown-module-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fg-faint);
    border-bottom: 1px dashed var(--border);
  }

  .mod-num {
    color: var(--accent);
  }

  .mod-title {
    flex: 1;
  }

  .mod-count {
    font-size: 9px;
    opacity: 0.7;
  }

  .dropdown-lessons-list {
    display: flex;
    flex-direction: column;
    padding: 2px 0;
  }

  .dropdown-section-group {
    display: flex;
    flex-direction: column;
  }

  .dropdown-section-label {
    font-size: 9.5px;
    font-weight: 600;
    color: var(--fg-faint);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 6px 8px 2px 8px;
    opacity: 0.85;
  }

  .dropdown-lesson-btn {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 5px 8px;
    border-radius: 5px;
    font-size: 11px;
    font-family: var(--font-mono, monospace);
    color: var(--fg-dim);
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    width: 100%;
    transition: all 0.12s ease;
  }

  .dropdown-lesson-btn:hover {
    background: var(--bg-hover);
    color: var(--fg);
  }

  .dropdown-lesson-btn.is-current {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent);
    font-weight: 600;
  }

  .lesson-dot {
    font-size: 6px;
    opacity: 0.6;
    color: currentColor;
  }

  .lesson-text {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .active-check {
    font-size: 11px;
    color: var(--accent);
    font-weight: 700;
    margin-inline-start: 6px;
    flex-shrink: 0;
  }

  .active-check[hidden] {
    display: none !important;
  }
</style>

<script>
  function setupChapterDropdown() {
    const root = document.getElementById('chapter-picker-root');
    const trigger = document.getElementById('btn-chapter-dropdown');
    const menu = document.getElementById('chapter-dropdown-menu');
    const searchInput = document.getElementById('dropdown-search-input') as HTMLInputElement | null;
    const titleDisplay = document.getElementById('chapter-active-title');
    const lessonBtns = document.querySelectorAll<HTMLButtonElement>('.dropdown-lesson-btn');

    if (!root || !trigger || !menu) return;

    const applyFilters = () => {
      const q = searchInput ? searchInput.value.trim().toLowerCase() : '';
      const groups = menu.querySelectorAll<HTMLElement>('.dropdown-module-group');

      groups.forEach((grp) => {
        let matchCount = 0;
        const sectionGroups = grp.querySelectorAll<HTMLElement>('.dropdown-section-group');
        if (sectionGroups.length > 0) {
          sectionGroups.forEach((sec) => {
            let secMatches = 0;
            const btns = sec.querySelectorAll<HTMLButtonElement>('.dropdown-lesson-btn');
            btns.forEach((btn) => {
              const text = (btn.dataset.lessonTitle || btn.textContent || '').toLowerCase();
              const visible = !q || text.includes(q);
              btn.style.display = visible ? 'flex' : 'none';
              if (visible) secMatches++;
            });
            sec.style.display = secMatches > 0 ? 'flex' : 'none';
            matchCount += secMatches;
          });
        } else {
          const btns = grp.querySelectorAll<HTMLButtonElement>('.dropdown-lesson-btn');
          btns.forEach((btn) => {
            const text = (btn.dataset.lessonTitle || btn.textContent || '').toLowerCase();
            const visible = !q || text.includes(q);
            btn.style.display = visible ? 'flex' : 'none';
            if (visible) matchCount++;
          });
        }

        grp.style.display = matchCount > 0 ? 'flex' : 'none';
      });
    };

    const toggleMenu = (open?: boolean) => {
      const isCurrentlyOpen = !menu.hidden;
      const willOpen = open !== undefined ? open : !isCurrentlyOpen;
      menu.hidden = !willOpen;
      trigger.setAttribute('aria-expanded', String(willOpen));
      if (willOpen && searchInput) {
        setTimeout(() => searchInput.focus(), 50);
      }
    };

    if (trigger.dataset.bound !== 'true') {
      trigger.dataset.bound = 'true';
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMenu();
      });

      document.addEventListener('click', (e) => {
        if (!root.contains(e.target as Node)) {
          toggleMenu(false);
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !menu.hidden) {
          toggleMenu(false);
          trigger.focus();
        }
      });
    }

    if (searchInput && searchInput.dataset.bound !== 'true') {
      searchInput.dataset.bound = 'true';
      searchInput.addEventListener('input', () => {
        applyFilters();
      });
    }

    lessonBtns.forEach((btn) => {
      if (btn.dataset.bound !== 'true') {
        btn.dataset.bound = 'true';
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const lessonId = btn.dataset.lessonId;
          const lessonTitle = btn.dataset.lessonTitle;
          const targetHref = btn.dataset.lessonHref || (lessonId ? `/lab/${lessonId}` : '');
          if (!lessonId || !targetHref) return;

          lessonBtns.forEach((b) => {
            const isTarget = b === btn;
            b.classList.toggle('is-current', isTarget);
            const pill = b.querySelector<HTMLElement>('[data-lesson-pill]');
            if (pill) pill.hidden = !isTarget;
          });

          if (titleDisplay && lessonTitle) {
            titleDisplay.textContent = lessonTitle;
          }

          // Navigate to the target page
          (window as any).umami?.track('lab-chapter-select', { lesson: lessonId, title: lessonTitle || '' });
          if (window.location.pathname !== targetHref) {
            window.location.href = targetHref;
            return;
          }

          // Same page — reset step
          window.location.hash = `#/${lessonId}/1`;
          toggleMenu(false);
        });
      }
    });

    // Auto-select lesson from current pathname
    const currentLesson = window.location.pathname.match(/\/lab\/([\w-]+)/)?.[1];
    if (currentLesson) {
      const matchBtn = Array.from(lessonBtns).find(
        (b) => b.dataset.lessonId === currentLesson || b.dataset.lessonHref === window.location.pathname
      );
      if (matchBtn) {
        const lessonTitle = matchBtn.dataset.lessonTitle;
        if (titleDisplay && lessonTitle) titleDisplay.textContent = lessonTitle;
        lessonBtns.forEach((b) => {
          const isTarget = b === matchBtn;
          b.classList.toggle('is-current', isTarget);
          const pill = b.querySelector<HTMLElement>('[data-lesson-pill]');
          if (pill) pill.hidden = !isTarget;
        });
      }
    }
  }

  setupChapterDropdown();
  document.addEventListener('astro:page-load', setupChapterDropdown);
</script>
