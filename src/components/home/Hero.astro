---
import { GITHUB_USERNAME } from '@/lib/site';
import Twemoji from '@/components/ui/Twemoji.astro';
import TypedBios from '@/components/home/TypedBios.astro';

const NAV_LINKS = [
  { label: 'labs/', href: '/lab', event: 'home-nav-labs' },
  { label: 'projects/', href: '#featured-projects', event: 'home-nav-projects' },
  { label: 'writing/', href: '#latest-posts', event: 'home-nav-writing' },
  { label: 'about/', href: '/about', event: 'home-nav-about' },
  { label: 'github ↗', href: `https://github.com/${GITHUB_USERNAME}`, external: true, event: 'home-nav-github' },
];
---

<header class="space-y-5 sm:space-y-7 max-w-full">
  <!-- 1. Authentic Header -->
  <div class="space-y-2.5 sm:space-y-3.5">
    <div class="flex flex-wrap items-center gap-2 font-mono text-xs sm:text-sm text-(--fg-dim)">
      <span class="font-medium text-(--fg)">Tung Anh</span>
      <span class="text-(--fg-faint)">/</span>
      <span class="font-medium text-(--accent)">Dawn</span>
      <span class="inline-flex items-center ml-0.5 align-middle">
        <Twemoji emoji="flag-vietnam" size="base" />
      </span>
      <span class="text-(--fg-faint)">•</span>
      <span>Software Engineer</span>
    </div>

    <h1 class="bg-gradient-to-r from-rose-600 via-pink-600 to-amber-500 bg-clip-text text-transparent text-3xl font-extrabold tracking-tight leading-tight sm:text-6xl md:text-7xl sm:leading-[1.12] dark:from-rose-400 dark:via-pink-400 dark:to-amber-300 break-words">
      A small corner of the internet.
    </h1>

    <p class="text-base font-normal text-(--fg-dim) sm:text-xl md:text-2xl sm:leading-relaxed">
      Part workbench, part notebook — exploring software from the ground up.
    </p>
  </div>

  <!-- 2. Personal Typewriter Log -->
  <div class="rounded-xl border border-(--border) bg-(--bg-alt) p-3.5 sm:p-4 shadow-xs">
    <TypedBios />
  </div>

  <!-- 3. Grounded, Human Description -->
  <p class="max-w-3xl text-base leading-relaxed text-(--fg-dim) sm:text-lg md:text-xl md:leading-8">
    I build web applications with <span class="font-medium text-(--fg)">Java (Spring Boot)</span> and <span class="font-medium text-(--fg)">TypeScript (Angular / React)</span>. Endlessly curious about how real systems come together — from database query planning in PostgreSQL to distributed streaming and memory models. This site is my playground: a mix of interactive 2.5D architecture labs, personal projects, and casual engineering notes.
  </p>

  <!-- 4. Quiet, Tasteful Navigation Links -->
  <nav class="flex flex-wrap items-center gap-x-5 gap-y-2.5 font-mono text-sm sm:text-base text-(--fg-dim) pt-1">
    {NAV_LINKS.map((link) => (
      <a
        href={link.href}
        target={link.external ? '_blank' : undefined}
        rel={link.external ? 'noopener noreferrer' : undefined}
        data-umami-event={link.event}
        class="py-0.5 font-medium transition-colors hover:text-(--accent) underline underline-offset-4 decoration-(--border) hover:decoration-(--accent)"
      >
        {link.label}
      </a>
    ))}
  </nav>
</header>
