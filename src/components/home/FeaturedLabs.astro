---
interface LabItem {
  href: string;
  title: string;
  track: 'jvm' | 'db' | 'cloud';
  category: string;
  tagClass: string;
  scope: string;
  desc: string;
  cta: string;
}

const ALL_LABS: LabItem[] = [
  {
    href: '/lab/java',
    title: 'Java & Spring Framework Internals',
    track: 'jvm',
    category: 'Runtime & Memory',
    tagClass: 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/25',
    scope: '26 chapters • JVM Heap',
    desc: 'Interactive 2.5D simulation of JVM memory allocation, TLAB, Loom Virtual Threads, JIT compilation, and Spring IoC bean lifecycles.',
    cta: 'Open simulation',
  },
  {
    href: '/lab/sql',
    title: 'PostgreSQL & SQL Query Engine',
    track: 'db',
    category: 'Database Core',
    tagClass: 'bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border-cyan-500/25',
    scope: 'Query Planner • B-Tree',
    desc: 'Visual query execution plans — dissecting Index Scans vs Seq Scans, B-Tree root-to-leaf traversals, Buffer Pool hits, and connection pool sizing.',
    cta: 'Inspect query plans',
  },
  {
    href: '/lab/k8s',
    title: 'Kubernetes & Docker Lab',
    track: 'cloud',
    category: 'Cloud Native',
    tagClass: 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/25',
    scope: 'Cgroups • CNI • HPA',
    desc: 'Tracing how Linux cgroups and namespaces isolate containers, API Server etcd watch loops, Flannel/Calico CNI, and horizontal pod autoscaling.',
    cta: 'Explore container cluster',
  },
  {
    href: '/lab/kafka-cluster-kraft',
    title: 'Kafka & Event Streaming',
    track: 'cloud',
    category: 'Event Driven',
    tagClass: 'bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/25',
    scope: 'KRaft • ISR Replicas',
    desc: 'Simulating append-only log segments, zero-copy pagecache transfers, partition rebalances, and consumer lag tracking.',
    cta: 'Simulate stream pipeline',
  },
  {
    href: '/lab/redis-event-loop',
    title: 'Redis In-Memory Engine',
    track: 'db',
    category: 'In-Memory DB',
    tagClass: 'bg-rose-500/10 text-rose-600 dark:text-rose-400 border-rose-500/25',
    scope: 'epoll • SkipList',
    desc: 'Single-thread epoll Event Loop, ZSET SkipList, SDS Strings, RDB/AOF persistence and 16384 slot cluster sharding.',
    cta: 'Inspect Redis internals',
  },
  {
    href: '/lab/distributed',
    title: 'Distributed Systems Core',
    track: 'cloud',
    category: 'Distributed Core',
    tagClass: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/25',
    scope: 'Raft • CAP • Sharding',
    desc: 'Master distributed primitives: Leader election heartbeats, log replication quorums, virtual ring token placement, and 2PC commits.',
    cta: 'Explore Distributed Lab',
  },
];

const TRACK_FILTERS = [
  { id: 'all', label: 'All' },
  { id: 'jvm', label: 'JVM & Runtime' },
  { id: 'db', label: 'Databases' },
  { id: 'cloud', label: 'Cloud & Distributed' },
];
---

<section class="space-y-4 md:space-y-5" id="labs-section">
  <!-- Header & Filter Row -->
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between border-b border-(--border) pb-3">
    <div>
      <div class="flex items-center gap-2">
        <h2 class="text-xl font-bold tracking-tight text-(--fg) sm:text-2xl md:text-3xl">
          Interactive Architecture Labs
        </h2>
        <span class="rounded bg-(--accent-subtle) px-2 py-0.5 font-mono text-xs font-semibold text-(--accent)">
          DTS 2.5D
        </span>
      </div>
      <p class="text-xs sm:text-sm text-(--fg-dim) mt-1">
        Visual simulation workbench stepping through real system internals, memory, and packet flows.
      </p>
    </div>

    <!-- Filter Tabs (Optimized for small mobile screens) -->
    <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 font-mono text-xs sm:text-sm">
      {TRACK_FILTERS.map((f, i) => (
        <button
          type="button"
          data-track-filter={f.id}
          class:list={[
            'rounded-lg px-2.5 py-1 sm:px-3 sm:py-1.5 font-medium transition-all cursor-pointer border',
            i === 0
              ? 'border-(--accent) bg-(--accent-subtle) text-(--accent)'
              : 'border-(--border) bg-(--bg-alt) text-(--fg-dim) hover:text-(--fg) hover:border-(--border-hover)',
          ]}
        >
          {f.label}
        </button>
      ))}
    </div>
  </div>

  <!-- Cards Grid -->
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2" id="labs-grid">
    {ALL_LABS.map((lab) => (
      <a
        href={lab.href}
        data-track={lab.track}
        class="lab-card group relative flex flex-col justify-between rounded-xl border border-(--border) bg-(--bg-alt) p-4.5 sm:p-5.5 no-underline transition-all duration-200 hover:-translate-y-0.5 hover:border-(--accent) hover:shadow-[0_4px_20px_-4px_rgba(225,29,72,0.12)] min-w-0"
      >
        <div class="space-y-3 min-w-0">
          <!-- Top Row: Pastel Badge & Scope -->
          <div class="flex flex-wrap items-center justify-between gap-1.5 font-mono text-xs">
            <span class:list={['rounded-md border px-2 py-0.5 font-semibold text-xs', lab.tagClass]}>
              {lab.category}
            </span>
            <span class="text-(--fg-faint) text-xs">
              {lab.scope}
            </span>
          </div>

          <!-- Title -->
          <h3 class="text-lg sm:text-xl font-bold text-(--fg) group-hover:text-(--accent) transition-colors">
            {lab.title}
          </h3>

          <!-- Description -->
          <p class="text-sm leading-relaxed text-(--fg-dim) sm:text-base">
            {lab.desc}
          </p>
        </div>

        <!-- Footer -->
        <div class="mt-4 pt-3 border-t border-(--border-subtle) flex items-center justify-between font-mono text-xs sm:text-sm">
          <span class="text-(--fg-faint) text-xs">2.5D simulation</span>
          <span class="font-medium text-(--fg) group-hover:text-(--accent) transition-colors flex items-center gap-1.5">
            <span>{lab.cta}</span>
            <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
          </span>
        </div>
      </a>
    ))}
  </div>

  <!-- Footer link: Overflow-protected for mobile -->
  <div class="pt-1 text-right">
    <a
      href="/lab"
      class="group inline-flex items-center gap-1.5 font-mono text-xs sm:text-sm font-medium text-(--fg-dim) hover:text-(--accent) transition-colors max-w-full"
    >
      <span class="hidden sm:inline">Browse all 108 interactive architectural scenes across 10 tracks</span>
      <span class="sm:hidden">Explore all 108 interactive scenes</span>
      <span class="group-hover:translate-x-0.5 transition-transform shrink-0">&rarr;</span>
    </a>
  </div>
</section>

<script>
  function setupLabFilters() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-track-filter]');
    const cards = document.querySelectorAll<HTMLElement>('.lab-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const track = btn.dataset.trackFilter;

        filterButtons.forEach((b) => {
          b.classList.remove('border-(--accent)', 'bg-(--accent-subtle)', 'text-(--accent)');
          b.classList.add('border-(--border)', 'bg-(--bg-alt)', 'text-(--fg-dim)');
        });
        btn.classList.remove('border-(--border)', 'bg-(--bg-alt)', 'text-(--fg-dim)');
        btn.classList.add('border-(--accent)', 'bg-(--accent-subtle)', 'text-(--accent)');

        cards.forEach((card) => {
          if (track === 'all' || card.dataset.track === track) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  setupLabFilters();
  document.addEventListener('astro:page-load', setupLabFilters);
</script>
