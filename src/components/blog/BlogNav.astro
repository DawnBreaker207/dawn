---
import Link from '@/components/ui/Link.astro';

interface Props {
  next?: { path: string; title: string };
  prev?: { path: string; title: string };
}

const { next, prev } = Astro.props;
---

{
  (prev || next) && (
    <div class="flex flex-col gap-2 py-4 md:flex-row md:justify-between md:gap-12 xl:py-8">
      {prev && prev.path ? (
        <div class="flex flex-col gap-1">
          <span class="tracking-wide text-gray-500 dark:text-gray-400">{`←  Previous post`}</span>
          <Link href={`/${prev.path}`}>
            <div data-umami-event="post-nav-prev">{prev.title}</div>
          </Link>
        </div>
      ) : (
        <div />
      )}
      {next && next.path && (
        <div class="flex flex-col items-end gap-1 text-right">
          <span class="tracking-wide text-gray-500 dark:text-gray-400">{`Next post  →`}</span>
          <Link href={`/${next.path}`}>
            <div data-umami-event="post-nav-next">{next.title}</div>
          </Link>
        </div>
      )}
    </div>
  )
}