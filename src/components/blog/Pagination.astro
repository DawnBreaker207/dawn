---
import Link from '@/components/ui/Link.astro';

interface Props {
  basePath: string;
  currentPage: number;
  totalPages: number;
}

const { basePath, currentPage, totalPages } = Astro.props;
const prevPage = currentPage - 1 > 0;
const nextPage = currentPage + 1 <= totalPages;
---

<div class="space-y-2 pt-6 pb-8 md:space-y-5">
  <nav class="flex justify-between">
    {!prevPage && <button class="cursor-auto disabled:opacity-50" disabled>Previous</button>}
    {prevPage && (
      <Link href={currentPage - 1 === 1 ? `/${basePath}/` : `/${basePath}/page/${currentPage - 1}`} rel="prev">
        Previous
      </Link>
    )}
    <span>
      {currentPage} of {totalPages}
    </span>
    {!nextPage && <button class="cursor-auto disabled:opacity-50" disabled>Next</button>}
    {nextPage && <Link href={`/${basePath}/page/${currentPage + 1}`} rel="next">Next</Link>}
  </nav>
</div>