---
import Link from '@/components/ui/Link.astro';
import { SITE, formatDate } from '@/lib/site';
import { readingMinutes, type Post } from '@/lib/utils/blog';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { id, data } = post;
const image = data.images && data.images.length > 0 ? data.images[0] : SITE.socialBanner;
const minutes = readingMinutes(post);
---

<article class="group h-full flex flex-col overflow-hidden rounded-xl border border-(--border) bg-(--bg-alt) transition-colors hover:border-(--accent)">
  <Link
    href={`/blog/${id}`}
    data-track-event="blog-card-image"
    class="block aspect-video w-full overflow-hidden border-b border-(--border) bg-(--bg)"
  >
    <img
      src={image}
      alt={data.title}
      width="600"
      height="338"
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
    />
  </Link>

  <div class="flex flex-1 flex-col justify-between gap-3 p-4 sm:p-5">
    <div class="space-y-2">
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-(--fg-faint)">
        <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
        <span class="text-(--border)">·</span>
        <span>{minutes} min read</span>
      </div>

      <h3 class="m-0 text-base sm:text-lg font-bold leading-snug text-(--fg) group-hover:text-(--accent) transition-colors">
        <Link href={`/blog/${id}`} data-track-event="blog-card-title" class="no-underline text-inherit">
          {data.title}
        </Link>
      </h3>

      {data.summary && (
        <p class="m-0 line-clamp-2 text-sm leading-relaxed text-(--fg-dim)">
          {data.summary}
        </p>
      )}
    </div>

    {data.tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 pt-1">
        {data.tags.slice(0, 3).map((tag) => (
          <span class="rounded border border-(--border) bg-(--bg) px-2 py-0.5 font-mono text-[11px] text-(--fg-dim)">
            #{tag}
          </span>
        ))}
      </div>
    )}
  </div>
</article>