---
interface Props {
  toc: { value: string; url: string; depth: number }[];
  class?: string;
}

const { toc, class: cls } = Astro.props;
---

<details class={`space-y-4 [&_.chevron-right]:open:rotate-90 ${cls ?? ''}`} open>
  <summary class="flex cursor-pointer items-center gap-1 marker:content-none">
    <svg
      class="chevron-right rotate-0 transition-transform"
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m9 18 6-6-6-6" />
    </svg>
    <span class="text-lg font-medium">Table of Contents</span>
  </summary>

  <ul class="flex flex-col space-y-2" data-toc>
    {toc.map(({ value, depth, url }) => (
      <li
        class="text-gray-500 dark:text-gray-400"
        style={`padding-left: ${(depth - 2) * 16}px`}
      >
        <a href={url} data-toc-id={url.slice(1)} class="toc-link break-words hover:text-gray-700 dark:hover:text-gray-200">{value}</a>
      </li>
    ))}
  </ul>
</details>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-id]'));
  if (links.length) {
    const scroller = document.querySelector('.studio-content') ?? window;

    function pickActive(): void {
      const isWin = scroller instanceof Window;
      const scrollerTop = isWin ? 0 : scroller.getBoundingClientRect().top;
      const viewH = isWin ? innerHeight : scroller.clientHeight;
      const scrollTop = isWin ? scroller.scrollY : scroller.scrollTop;
      const threshold = scrollTop + Math.min(240, viewH * 0.35);

      let active: HTMLElement | null = null;
      for (const link of links) {
        const el = document.getElementById(link.dataset.tocId!);
        if (!el) continue;
        const absTop = el.getBoundingClientRect().top - scrollerTop + scrollTop;
        if (absTop <= threshold) active = link;
        else if (active) break;
      }
      for (const link of links) link.classList.toggle('is-active', link === active);
    }

    let raf = 0;
    const onScroll = (): void => {
      if (raf) return;
      raf = window.requestAnimationFrame(() => {
        raf = 0;
        pickActive();
      });
    };
    scroller.addEventListener('scroll', onScroll, { passive: true });
    pickActive();
  }
</script>