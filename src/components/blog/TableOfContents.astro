---
interface Props {
  toc: { value: string; url: string; depth: number }[];
  class?: string;
}

const { toc, class: cls } = Astro.props;
---

<details class={`space-y-4 [&_.chevron-right]:open:rotate-90 ${cls ?? ''}`} open>
  <summary class="flex cursor-pointer items-center gap-1.5 marker:content-none text-(--fg)">
    <svg
      class="chevron-right rotate-0 transition-transform text-(--fg-faint)"
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m9 18 6-6-6-6" />
    </svg>
    <span class="font-mono text-xs tracking-[0.08em] uppercase text-(--fg-dim)">Table of Contents</span>
  </summary>

  <ul class="flex flex-col space-y-1 text-sm border-l border-(--border)" data-toc>
    {toc.map(({ value, depth, url }) => (
      <li
        class="relative"
        style={`padding-left: ${Math.max(0, (depth - 2) * 12)}px`}
      >
        <a
          href={url}
          data-toc-id={url.slice(1)}
          data-umami-event={`toc-${value.toLowerCase().replace(/[^\w]+/g, '-').slice(0, 30)}`}
          class="toc-link block py-1 pl-3 text-xs leading-relaxed text-(--fg-dim) transition-colors hover:text-(--fg)"
        >
          {value}
        </a>
      </li>
    ))}
  </ul>
</details>

<script>
  function initTocScrollSpy() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-id]'));
    if (!links.length) return;

    const scroller = document.querySelector('.studio-content') ?? window;

    function pickActive(): void {
      const isWin = scroller instanceof Window;
      const scrollerTop = isWin ? 0 : scroller.getBoundingClientRect().top;
      const viewH = isWin ? window.innerHeight : scroller.clientHeight;
      const scrollTop = isWin ? scroller.scrollY : scroller.scrollTop;
      const threshold = scrollTop + Math.min(220, viewH * 0.32);

      let active: HTMLElement | null = null;
      for (const link of links) {
        const id = link.dataset.tocId;
        if (!id) continue;
        const el = document.getElementById(id);
        if (!el) continue;
        const absTop = el.getBoundingClientRect().top - scrollerTop + scrollTop;
        if (absTop <= threshold) {
          active = link;
        } else if (active) {
          break;
        }
      }

      for (const link of links) {
        const isActive = link === active;
        link.classList.toggle('is-active', isActive);
        if (isActive) {
          link.setAttribute('aria-current', 'true');
        } else {
          link.removeAttribute('aria-current');
        }
      }
    }

    let raf = 0;
    const onScroll = (): void => {
      if (raf) return;
      raf = window.requestAnimationFrame(() => {
        raf = 0;
        pickActive();
      });
    };

    scroller.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    pickActive();
  }

  // Support both initial load & Astro View Transitions
  document.addEventListener('astro:page-load', initTocScrollSpy);
</script>