---
import Link from '@/components/ui/Link.astro';
import { readingMinutes, type Post } from '@/lib/utils/blog';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { id, data } = post;
const date = new Intl.DateTimeFormat('en-CA').format(data.date);
const minutes = readingMinutes(post);
---

<Link
  href={`/blog/${id}`}
  data-track-event="blog-row-click"
  class="group grid grid-cols-1 items-baseline gap-2.5 py-4.5 no-underline transition-colors md:grid-cols-[100px_1fr_auto]"
>
  <time class="font-mono text-xs sm:text-sm text-(--fg-faint) tabular-nums">{date}</time>
  <div class="min-w-0 space-y-1">
    <h3 class="m-0 text-base sm:text-lg font-semibold leading-snug text-(--fg) transition-colors group-hover:text-(--accent)">
      {data.title}
    </h3>
    {data.summary && (
      <p class="m-0 line-clamp-1 text-sm text-(--fg-dim)">{data.summary}</p>
    )}
  </div>
  <div class="flex shrink-0 items-center gap-3 font-mono text-xs text-(--fg-faint)">
    {data.tags[0] && (
      <span class="rounded border border-(--border) bg-(--bg-alt) px-2 py-0.5 text-(--accent)">
        #{data.tags[0]}
      </span>
    )}
    <span>{minutes} min</span>
  </div>
</Link>