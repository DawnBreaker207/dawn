---
import { CURRENT_BRANCH, GITHUB_USERNAME, GITHUB_REPO_PATH, SITE_VERSIONS } from '@/lib/site';
import stats from '@/build-stats.json';

// build-stats.json is regenerated by scripts/build-stats.mjs on every `astro
// build`. Live parts (clock diff, commit-ago, version popover) run in
// app-shell.ts.
const { stargazers, commit, commitDate } = stats;
const fullCommit =
  (commit && commit !== '?' && `https://github.com/${GITHUB_REPO_PATH}/commit/${commit}`) || '';
const repoUrl = `https://github.com/${GITHUB_REPO_PATH}`;
---

<footer
  class="studio-statusbar flex h-[26px] min-h-[26px] min-w-0 items-center justify-between gap-1.5 sm:gap-2 border-t border-(--border) bg-(--bg-alt) px-2 sm:px-3 font-mono text-[11px] text-(--fg-dim) select-none"
>
  <div class="flex min-w-0 items-center gap-1 sm:gap-1.5 whitespace-nowrap">
    <span
      id="statusbar-vim-mode"
      class="hidden sm:inline-block rounded border border-(--border) px-1.5 py-0.2 text-[10px] font-semibold text-(--accent) bg-(--bg) select-none"
      title="Vim Mode (Press ? for shortcuts)"
    >
      NORMAL
    </span>
    <a
      href="/lab/terminal"
      class="inline-flex items-center justify-center h-[20px] min-w-[20px] px-1 rounded text-(--fg-faint) hover:text-(--fg) hover:bg-(--bg-hover) transition-colors"
      aria-label="Open terminal"
      title="Open terminal"
      data-umami-event="footer-terminal"
    >
      <span class="font-mono leading-none" aria-hidden="true">❯_</span>
    </a>
    <a
      href="/rss.xml"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center h-[20px] min-w-[20px] px-1 rounded text-(--fg-faint) hover:text-(--fg) hover:bg-(--bg-hover) transition-colors"
      aria-label="RSS feed"
      title="Open RSS feed in a new tab"
      data-umami-event="footer-rss"
    >
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
        <path d="M5 11a8 8 0 0 1 8 8" />
        <path d="M5 5a14 14 0 0 1 14 14" />
        <circle cx="6.5" cy="17.5" r="1.2" fill="currentColor" stroke="none" />
      </svg>
    </a>
    <span class="hidden shrink-0 text-(--fg-faint) lg:inline">{GITHUB_USERNAME}@[::1]:443</span>
    <span class="flex min-w-0 items-center">
      <span class="hidden sm:inline shrink-0 text-(--fg-faint)">~/</span>
      <a
        href={repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="min-w-0 truncate text-(--fg) px-1 py-0.5 rounded hover:bg-(--bg-hover) hover:text-(--fg) transition-colors"
        title={`View ${GITHUB_REPO_PATH} source on GitHub${stargazers ? `, ${stargazers.toLocaleString('en-US')} stars` : ''}`}
      >
        <span class="sm:hidden">~/Blog</span>
        <span class="hidden sm:inline">{GITHUB_REPO_PATH}</span>
      </a>
    </span>
    <span class="hidden shrink-0 text-(--fg-faint) lg:inline">
      (stargazers: {stargazers.toLocaleString('en-US')})
    </span>
  </div>

  <div class="flex shrink-0 items-center gap-1 sm:gap-2">
    <a
      href={fullCommit || undefined}
      target="_blank"
      rel="noopener noreferrer"
      class="hidden whitespace-nowrap text-(--fg) px-1.5 py-0.5 rounded hover:bg-(--bg-hover) transition-colors md:inline"
      title="View last commit on GitHub"
      data-commit-time={commitDate}
    >
      #{commit || '?'} <span class="text-(--fg-dim)" data-commit-ago></span>
    </a>
    <span class="hidden text-(--fg-faint) md:inline" aria-hidden="true">·</span>

    <a
      href="https://time.is/Hanoi"
      target="_blank"
      rel="noopener noreferrer"
      class="hidden sm:inline-flex whitespace-nowrap text-(--fg) px-1.5 py-0.5 rounded hover:bg-(--bg-hover) transition-colors"
    >
      Hanoi <span data-local-time>--:--</span><span class="ml-1 hidden text-(--fg-faint) sm:inline" data-local-time-diff></span>
    </a>
    <span class="hidden sm:inline text-(--fg-faint)" aria-hidden="true">·</span>

    <!-- Streamlined Ambient Settings Dropdown (Sound, Weather, Tokens) -->
    <details class="relative" id="ambient-settings" data-ambient-details>
      <summary
        class="inline-flex items-center gap-1 cursor-pointer select-none px-1.5 py-0.5 rounded text-[11px] text-(--fg-dim) hover:text-(--fg) hover:bg-(--bg-hover) list-none [&::-webkit-details-marker]:hidden transition-colors"
        title="Settings (Sound, Weather, Tokens)"
        aria-label="Settings"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
        <span class="hidden sm:inline text-[11px]">Settings</span>
        <span id="ambient-active-dot" class="w-1.5 h-1.5 rounded-full bg-emerald-500 hidden animate-pulse" title="Active background effects running"></span>
      </summary>

      <div class="absolute bottom-full right-0 mb-2 w-56 rounded-lg border border-(--border) bg-(--bg-alt) p-3 shadow-lg flex flex-col gap-2.5 z-50 text-[11px]">
        <div class="text-[10px] font-bold text-(--fg-faint) uppercase tracking-wider pb-1 border-b border-(--border)">
          Environment & Ambience
        </div>

        <!-- Keyboard Sound -->
        <div class="flex items-center justify-between">
          <span class="text-(--fg-dim)">Keyboard:</span>
          <button
            type="button"
            id="btn-keyboard-sound"
            class="inline-flex items-center gap-1.5 rounded px-2 py-1 bg-(--bg) border border-(--border) text-(--fg) hover:border-(--accent) cursor-pointer select-none"
            title="Cycle keyboard sound"
            aria-label="Cycle keyboard sound profile"
            data-umami-event="ambient-sound-toggle"
          >
            <span>⌨️</span>
            <span id="keyboard-sound-label" class="font-mono text-[10px]">sound: off</span>
          </button>
        </div>

        <!-- Weather Engine -->
        <div class="flex items-center justify-between">
          <span class="text-(--fg-dim)">Weather:</span>
          <button
            type="button"
            id="btn-global-weather"
            class="inline-flex items-center gap-1.5 rounded px-2 py-1 bg-(--bg) border border-(--border) text-(--fg) hover:border-sky-400 cursor-pointer select-none"
            title="Cycle weather overlay"
            aria-label="Toggle atmospheric weather overlay"
            data-umami-event="ambient-weather-toggle"
          >
            <span class="weather-icon">⛅</span>
            <span id="weather-label" class="font-mono text-[10px]">weather: off</span>
          </button>
        </div>

        <!-- Weather Volume -->
        <div class="flex items-center justify-between pt-1">
          <span class="text-(--fg-faint) text-[10px]">Audio Vol:</span>
          <input
            type="range"
            id="weather-vol"
            min="0"
            max="100"
            value="100"
            class="h-1 w-20 cursor-pointer align-middle accent-sky-400"
            title="Weather ambience volume"
            aria-label="Weather ambience volume"
          />
        </div>

        <!-- Token Burn Telemetry -->
        <div class="pt-1 border-t border-(--border) flex items-center justify-between">
          <span class="text-(--fg-dim)">AI Telemetry:</span>
          <a
            href="/tokens"
            class="inline-flex items-center gap-1 text-(--fg) hover:text-(--accent) no-underline font-mono text-[10px]"
            title="View AI Token Burn Telemetry"
          >
            <span>🔥</span>
            <span data-footer-tokens>tokens</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </details>
    <span class="text-(--fg-faint)" aria-hidden="true">·</span>

    <button
      id="toggle-theme"
      data-theme-toggle
      type="button"
      data-umami-event="theme-toggle"
      class="tip inline-flex items-center justify-center h-[20px] min-w-[20px] px-1 rounded text-(--fg-faint) hover:text-(--fg) hover:bg-(--bg-hover) cursor-pointer transition-colors"
      data-tip="Light / Dark"
      aria-label="Toggle light/dark theme"
    >
      ◐
    </button>

    <button
      type="button"
      id="btn-keyboard-help"
      class="hidden sm:inline-flex items-center justify-center w-[18px] h-[18px] rounded border border-(--border) text-[10px] text-(--fg-faint) hover:text-(--fg) hover:bg-(--bg-hover) cursor-pointer select-none transition-colors"
      title="Keyboard Shortcuts (?)"
      aria-label="Show keyboard shortcuts"
    >
      ?
    </button>

    <div class="version-menu" data-version-menu>
      <button
        type="button"
        class="version-trigger"
        data-version-trigger
        data-umami-event="version-menu"
        aria-haspopup="menu"
        aria-expanded="false"
        aria-label="Switch site version (git branch)"
        title="Switch site version"
      >
        <span class="git-branch-icon" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
            <path d="M9.5 3.25a2.25 2.25 0 1 1 3 2.122V6A2.5 2.5 0 0 1 10 8.5H6a1 1 0 0 0-1 1v1.128a2.251 2.251 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.493 2.493 0 0 1 6 7h4a1 1 0 0 0 1-1v-.628A2.25 2.25 0 0 1 9.5 3.25Zm-6 0a.75.75 0 1 0 1.5 0 .75.75 0 0 0-1.5 0Zm8.25-.75a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM4.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Z" />
          </svg>
        </span>
        <span class="hidden sm:inline">{CURRENT_BRANCH}</span>
        <svg class="version-caret" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 15l6-6 6 6" />
        </svg>
      </button>
      <div class="version-popover version-popover--right" data-version-popover role="menu" hidden>
        <div class="version-popover-title">Checkout version</div>
        {
          SITE_VERSIONS.map((version) => {
            const isCurrentSite = version.href === '/';
            const isExternal = !isCurrentSite && version.href.startsWith('http');
            return (
              <a
                href={version.href}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener noreferrer' : undefined}
                class="version-item"
                role="menuitem"
                data-version-item
                aria-current={version.current ? 'true' : undefined}
              >
                <span class="git-branch-icon" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
                    <path d="M9.5 3.25a2.25 2.25 0 1 1 3 2.122V6A2.5 2.5 0 0 1 10 8.5H6a1 1 0 0 0-1 1v1.128a2.251 2.251 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.493 2.493 0 0 1 6 7h4a1 1 0 0 0 1-1v-.628A2.25 2.25 0 0 1 9.5 3.25Zm-6 0a.75.75 0 1 0 1.5 0 .75.75 0 0 0-1.5 0Zm8.25-.75a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM4.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Z" />
                  </svg>
                </span>
                <span class="version-item-branch">{version.branch}</span>
                <span class="version-item-label">{version.label}</span>
                {version.current && <span class="version-item-check" aria-hidden="true">✓</span>}
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
</footer>