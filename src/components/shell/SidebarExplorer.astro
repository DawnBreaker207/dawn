---
import { getCollection } from 'astro:content';
import { HOST, SITE } from '@/lib/site';
import ExplorerFileIcon from './ExplorerFileIcon.astro';

interface Props {
  activePath: string;
}

const { activePath } = Astro.props;

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const recentPosts = sortedPosts.slice(0, 3).map((p) => ({
  id: p.id,
  href: `/blog/${p.id}`,
  label: `${p.id}.mdx`,
  title: p.data.title,
  isActive: activePath === `/blog/${p.id}`,
}));

const inBlogIndex = activePath === '/blog' || activePath.startsWith('/blog/page/');

const TRACK_SLUG_MAP: Record<string, string[]> = {
  '/lab/foundations': [
    'foundations', 'request-lifecycle', 'latency-throughput', 'napkin-math',
    'vertical-horizontal', 'load-balancing', 'stateless', 'caching', 'cdn',
  ],
  '/lab/sql': [
    'sql', 'sql-engine', 'sql-execution-order',
    'sql-complex-queries', 'indexes', 'sql-connection-pool',
    'storage-engines', 'sql-footprint', 'sql-nosql',
    'transactions', 'mysql-innodb',
  ],
  '/lab/distributed': [
    'distributed', 'replication', 'sharding', 'consistent-hashing',
    'unique-ids', 'cap', 'consensus',
  ],
  '/lab/microservices': [
    'microservices', 'service-discovery', 'sagas', 'apis', 'queues', 'pubsub', 'realtime',
  ],
  '/lab/k8s': [
    'k8s', 'docker-internals', 'docker-images-storage', 'k8s-control-plane',
    'k8s-worker-node', 'k8s-networking-cni', 'k8s-services-ingress',
    'k8s-storage-csi', 'k8s-autoscaling-hpa',
  ],
  '/lab/java': [
    'java', 'java-types-boxing', 'java-string-internals',
    'java-collections', 'java-lambda', 'java-core-apis', 'java-io-nio',
    'java-jdbc', 'java-metaprogramming', 'java-classloader', 'java-jvm-memory',
    'java-jmm-cas-aqs',
    'java-virtual-threads', 'java-spring-ioc', 'java-spring-aop',
    'java-spring-mvc', 'java-spring-jpa',
    'java-spring-security',
    'java-spring-actuator-testing',
  ],
  '/lab/system-design': [
    'system-design', 'ai-agent-architecture', 'hld-lld', 'design-url-shortener', 'design-news-feed',
    'design-chat', 'batch-stream', 'redundancy', 'rate-limiting', 'timeouts-retries', 'observability',
  ],
  '/lab/aws-cloud': [
    'aws-cloud', 'aws-vpc', 'aws-ha', 'aws-storage-db', 'files', 'aws-serverless',
  ],
  '/lab/git': [
    'git', 'git-environments-lifecycle', 'git-commands-taxonomy', 'git-branching-workflows',
    'git-dag-objects', 'git-refs-symbolic', 'git-detached-head-reflog', 'git-worktrees-concurrency',
    'git-three-way-diff3', 'git-rerere-engine', 'git-rebase-onto-surgery', 'git-crlf-line-endings',
    'git-index-lock-stash', 'git-bisect-automation', 'git-submodule-subtree',
  ],
  '/lab/angular': [
    'angular', 'angular-architecture-overview', 'angular-modules-standalone', 'angular-component-lifecycle',
    'angular-services-di', 'angular-http-interceptors', 'angular-router-pipeline', 'angular-pipes-memoization',
    'angular-ivy-incremental-dom', 'angular-zonejs-dirty-checking', 'angular-change-detection-onpush',
    'angular-signals-dag', 'angular-zoneless-architecture', 'angular-control-flow', 'angular-defer-loading',
    'angular-hydration-replay',
  ],
  '/lab/devops': [
    'devops', 'devops-culture-silos', 'cicd-tools-evolution', 'cicd-pipeline-internals',
    'gitops-argocd', 'devops-dora-metrics',
  ],
};

const labSlug = activePath.startsWith('/lab/') ? activePath.replace('/lab/', '') : '';
const isSpecializedRoute = ['architecture', '', 'terminal', 'pathfinding', 'spider'].includes(labSlug);

const CURRICULUM_TRACK_ITEMS = [
  { href: '/lab/git', label: 'git.sim', iconType: 'git', title: 'Git Deep Internals & Practical Case Resolver (14 labs)' },
  { href: '/lab/foundations', label: 'network.sim', iconType: 'network', title: 'Networking & Web Scale (8 labs)' },
  { href: '/lab/sql', label: 'storage.sim', iconType: 'storage', title: 'Database & Storage Tier (8 labs)' },
  { href: '/lab/angular', label: 'angular.sim', iconType: 'angular', title: 'Angular Core Architecture & Modern Mechanics (15 labs)' },
  { href: '/lab/java', label: 'java.sim', iconType: 'java', title: 'Java Runtime & Concurrency Engine (27 labs)' },
  { href: '/lab/devops', label: 'devops.sim', iconType: 'devops', title: 'DevOps Engineering & Progressive Delivery (5 labs)' },
  { href: '/lab/k8s', label: 'k8s.sim', iconType: 'k8s', title: 'Containers & Kubernetes Orchestration (8 labs)' },
  { href: '/lab/distributed', label: 'distributed.sim', iconType: 'distributed', title: 'Distributed Systems Core (6 labs)' },
  { href: '/lab/microservices', label: 'microservices.sim', iconType: 'microservices', title: 'Microservices & Event-Driven (7 labs)' },
  { href: '/lab/aws-cloud', label: 'aws-cloud.sim', iconType: 'cloud', title: 'AWS Cloud Architecture SAA-C03 (6 labs)' },
  { href: '/lab/system-design', label: 'system-design.sim', iconType: 'system', title: 'System Design & AI Agents (10 labs)' },
].map((item) => ({
  ...item,
  isActive: activePath === item.href || (!isSpecializedRoute && !!TRACK_SLUG_MAP[item.href]?.includes(labSlug)),
}));
---

<aside
  id="sidebar"
  class="flex min-w-0 shrink-0 flex-col border-r border-(--border) bg-(--bg) overflow-x-hidden"
>
  <a href="/" data-track-event="explorer-logo" class="flex items-center gap-2.5 px-3 pt-3 pb-2 font-extrabold no-underline text-(--fg)">
    <span class="flex h-9 w-9 items-center justify-center rounded-xl border border-(--border) font-mono text-base shadow-[2px_2px_0_var(--border)]" aria-hidden="true">❯_</span>
    <span class="row-label truncate font-mono">{HOST}.dev</span>
  </a>

  <div class="thin-scrollbar min-h-0 flex-1 overflow-y-auto overflow-x-hidden pb-3">
  <details class="sidebar-sec" open>
    <summary class="sidebar-section-header" data-umami-event="sidebar-sec-explorer">
      <span class="tree-title px-1 py-1 font-mono text-[11px] font-semibold tracking-[0.12em] text-(--fg-faint) uppercase">explorer</span>
      <span class="section-toggle" aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 6l6 6-6 6" />
        </svg>
      </span>
    </summary>

  <nav class="tree-children space-y-0.5 py-1">
    <a
      href="/"
      class:list={['explorer-row no-underline', activePath === '/' && 'is-active']}
      aria-current={activePath === '/' ? 'page' : undefined}
      data-track-event="explorer-readme"
    >
      <span class="explorer-caret" aria-hidden="true"></span>
      <span class="explorer-icon">
        <ExplorerFileIcon type="markdown" />
      </span>
      <span class="row-label truncate">README.md</span>
    </a>

    <details class="tree-sec" data-sec="blog" open>
      <summary class="explorer-row" data-umami-event="sidebar-folder-blog">
        <span class="explorer-caret">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 6l6 6-6 6" />
          </svg>
        </span>
        <span class="explorer-icon">
          <svg class="folder-closed" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
          </svg>
          <svg class="folder-open" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8.5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
            <path d="M6 11.5h12" />
          </svg>
        </span>
        <span class="row-label truncate">blog/</span>
      </summary>
      <div class="tree-children">
        <a
          href="/blog"
          class:list={['explorer-row explorer-row--child no-underline', inBlogIndex && 'is-active']}
          aria-current={inBlogIndex ? 'page' : undefined}
          data-track-event="explorer-blog-index"
        >
          <span class="explorer-caret" aria-hidden="true"></span>
          <span class="explorer-icon">
            <ExplorerFileIcon type="astro" />
          </span>
          <span class="row-label truncate">index.astro</span>
        </a>
        {recentPosts.map((post) => (
          <a
            href={post.href}
            class:list={['explorer-row explorer-row--child no-underline', post.isActive && 'is-active']}
            aria-current={post.isActive ? 'page' : undefined}
            data-track-event="explorer-blog-post"
            title={post.title}
          >
            <span class="explorer-caret" aria-hidden="true"></span>
            <span class="explorer-icon">
              <ExplorerFileIcon type="markdown" />
            </span>
            <span class="row-label truncate">{post.label}</span>
          </a>
        ))}
        <a
          href="/topics"
          class:list={['explorer-row explorer-row--child no-underline', activePath.startsWith('/topics') && 'is-active']}
          aria-current={activePath.startsWith('/topics') ? 'page' : undefined}
          data-track-event="explorer-topics"
        >
          <span class="explorer-caret" aria-hidden="true"></span>
          <span class="explorer-icon">
            <ExplorerFileIcon type="astro" />
          </span>
          <span class="row-label truncate">topics.astro</span>
        </a>
      </div>
    </details>

    <a
      href="/projects"
      class:list={['explorer-row no-underline', activePath.startsWith('/projects') && 'is-active']}
      aria-current={activePath.startsWith('/projects') ? 'page' : undefined}
      data-track-event="explorer-projects"
    >
      <span class="explorer-caret" aria-hidden="true"></span>
      <span class="explorer-icon">
        <ExplorerFileIcon type="astro" />
      </span>
      <span class="row-label truncate">projects.astro</span>
    </a>

    <a
      href="/about"
      class:list={['explorer-row no-underline', activePath === '/about' && 'is-active']}
      aria-current={activePath === '/about' ? 'page' : undefined}
      data-track-event="explorer-about"
    >
      <span class="explorer-caret" aria-hidden="true"></span>
      <span class="explorer-icon">
        <ExplorerFileIcon type="markdown" />
      </span>
      <span class="row-label truncate">about.md</span>
    </a>

    <a
      href="/now"
      class:list={['explorer-row no-underline', activePath === '/now' && 'is-active']}
      aria-current={activePath === '/now' ? 'page' : undefined}
      data-track-event="explorer-now"
    >
      <span class="explorer-caret" aria-hidden="true"></span>
      <span class="explorer-icon">
        <ExplorerFileIcon type="markdown" />
      </span>
      <span class="row-label truncate">now.md</span>
    </a>
  </nav>
  </details>

  <!-- METRICS & TELEMETRY SECTION -->
  <details class="sidebar-sec" data-sec="metrics" open>
    <summary class="sidebar-section-header" data-umami-event="sidebar-sec-metrics">
      <span class="tree-title px-1 py-1 font-mono text-[11px] font-semibold tracking-[0.12em] text-(--fg-faint) uppercase">metrics & telemetry</span>
      <span class="section-toggle" aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 6l6 6-6 6" />
        </svg>
      </span>
    </summary>

    <nav class="tree-children space-y-0.5 py-1">
      <a
        href="/heatmap"
        class:list={['explorer-row no-underline', activePath === '/heatmap' && 'is-active']}
        aria-current={activePath === '/heatmap' ? 'page' : undefined}
        data-track-event="explorer-heatmap"
      >
        <span class="explorer-caret" aria-hidden="true"></span>
        <span class="explorer-icon">
          <ExplorerFileIcon type="astro" />
        </span>
        <span class="row-label truncate">heatmap.astro</span>
      </a>

      <a
        href="/tokens"
        class:list={['explorer-row no-underline', activePath === '/tokens' && 'is-active']}
        aria-current={activePath === '/tokens' ? 'page' : undefined}
        data-track-event="explorer-tokens"
      >
        <span class="explorer-caret" aria-hidden="true"></span>
        <span class="explorer-icon">
          <ExplorerFileIcon type="astro" />
        </span>
        <span class="row-label truncate">tokens.astro</span>
      </a>

      <a
        href="/books"
        class:list={['explorer-row no-underline', activePath === '/books' && 'is-active']}
        aria-current={activePath === '/books' ? 'page' : undefined}
        data-track-event="explorer-books"
      >
        <span class="explorer-caret" aria-hidden="true"></span>
        <span class="explorer-icon">
          <ExplorerFileIcon type="astro" />
        </span>
        <span class="row-label truncate">books.astro</span>
      </a>

      <a
        href={SITE.analytics.umamiSharedUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="explorer-row group no-underline"
        data-umami-event="explorer-stats"
      >
        <span class="explorer-caret" aria-hidden="true"></span>
        <span class="explorer-icon">
          <ExplorerFileIcon type="umami" />
        </span>
        <span class="row-label flex min-w-0 items-center gap-1">
          <span class="truncate">stats.umami</span>
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="flex-none opacity-0 transition-opacity group-hover:opacity-100"
          >
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <path d="M15 3h6v6" />
            <path d="M10 14L21 3" />
          </svg>
        </span>
      </a>
    </nav>
  </details>

  <!-- ARCHITECTURE LABS SECTION -->
  <details class="sidebar-sec" data-sec="lab" open>
    <summary class="sidebar-section-header" data-umami-event="sidebar-sec-labs">
      <span class="tree-title px-1 py-1 font-mono text-[11px] font-semibold tracking-[0.12em] text-(--fg-faint) uppercase">architecture labs</span>
      <span class="section-toggle" aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 6l6 6-6 6" />
        </svg>
      </span>
    </summary>

    <nav class="tree-children space-y-0.5 py-1">
      <a
        href="/lab"
        class:list={['explorer-row no-underline font-medium', activePath === '/lab' && 'is-active']}
        aria-current={activePath === '/lab' ? 'page' : undefined}
        title="Lab Overview & Directory"
        data-track-event="explorer-lab-readme"
      >
        <span class="explorer-caret" aria-hidden="true"></span>
        <span class="explorer-icon">
          <ExplorerFileIcon type="markdown" />
        </span>
        <span class="row-label truncate">README.md</span>
      </a>

      <div class="px-3 pt-1.5 pb-0.5 text-[10px] font-mono font-semibold uppercase tracking-wider text-(--fg-faint) opacity-80 flex items-center justify-between">
        <span>Blog Architecture</span>
        <span class="text-[9px] px-1 py-0.2 rounded bg-(--bg-alt) text-(--accent)">Edge-First</span>
      </div>
      <a
        href="/lab/architecture"
        class:list={['explorer-row no-underline font-medium', activePath === '/lab/architecture' && 'is-active']}
        aria-current={activePath === '/lab/architecture' ? 'page' : undefined}
        title="Dawn Blog actual deployment architecture"
        data-track-event="explorer-lab-arch"
      >
        <span class="explorer-caret" aria-hidden="true"></span>
        <span class="explorer-icon">
          <ExplorerFileIcon type="architecture" />
        </span>
        <span class="row-label truncate">dawn-blog.arch</span>
      </a>

      <!-- Curriculum Tracks (Folder) -->
      <details class="tree-sec" data-sec="curriculum">
        <summary class="explorer-row" data-umami-event="sidebar-folder-curriculum">
          <span class="explorer-caret">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 6l6 6-6 6" />
            </svg>
          </span>
          <span class="explorer-icon">
            <svg class="folder-closed" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
            </svg>
            <svg class="folder-open" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8.5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
              <path d="M6 11.5h12" />
            </svg>
          </span>
          <span class="row-label truncate">curriculum/</span>
        </summary>
        <div class="tree-children">
          {CURRICULUM_TRACK_ITEMS.map((item) => (
            <a
              href={item.href}
              class:list={['explorer-row explorer-row--child no-underline font-medium', item.isActive && 'is-active']}
              aria-current={item.isActive ? 'page' : undefined}
              title={item.title}
              data-track-event="explorer-curriculum-track"
            >
              <span class="explorer-caret" aria-hidden="true"></span>
              <span class="explorer-icon">
                <ExplorerFileIcon type={item.iconType as any} />
              </span>
              <span class="row-label truncate">{item.label}</span>
            </a>
          ))}
        </div>
      </details>

      <!-- Simulators & Extras (Folder) -->
      <details class="tree-sec" data-sec="simulators" open={activePath.startsWith('/lab/terminal') || activePath.startsWith('/lab/pathfinding') || activePath.startsWith('/lab/spider') || activePath.startsWith('/lab/2048') || activePath.startsWith('/lab/boids')}>
        <summary class="explorer-row" data-umami-event="sidebar-folder-simulators">
          <span class="explorer-caret">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 6l6 6-6 6" />
            </svg>
          </span>
          <span class="explorer-icon">
            <svg class="folder-closed" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
            </svg>
            <svg class="folder-open" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8.5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
              <path d="M6 11.5h12" />
            </svg>
          </span>
          <span class="row-label truncate">simulators/</span>
        </summary>
        <div class="tree-children">
          {[
            ['/lab/terminal', 'terminal.astro', 'astro'],
            ['/lab/pathfinding', 'pathfinding.astro', 'astro'],
            ['/lab/spider', 'spider.astro', 'astro'],
            ['/lab/2048', '2048.astro', 'astro'],
            ['/lab/boids', 'boids.astro', 'astro'],
          ].map(([href, label, icon]) => (
            <a
              href={href}
              class:list={['explorer-row explorer-row--child no-underline', activePath === href && 'is-active']}
              aria-current={activePath === href ? 'page' : undefined}
              data-track-event="explorer-simulator"
            >
              <span class="explorer-caret" aria-hidden="true"></span>
              <span class="explorer-icon">
                <ExplorerFileIcon type={icon as 'markdown' | 'astro' | 'umami'} />
              </span>
              <span class="row-label truncate">{label}</span>
            </a>
          ))}
        </div>
      </details>
    </nav>
  </details>
  </div>

  <div class="sidebar-ext" data-ext-overlay>
    <button
      type="button"
      class="sidebar-ext-toggle"
      data-ext-toggle
      data-umami-event="toggle-extensions"
      aria-expanded="false"
      aria-controls="sidebar-ext-list"
    >
      <span class="tree-title px-1 py-1 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-(--fg-faint)">extensions</span>
      <svg class="sidebar-ext-caret ml-auto" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="m9 18 6-6-6-6" />
      </svg>
    </button>
    <ul id="sidebar-ext-list" class="sidebar-ext-list" hidden>
      {[
        { icon: 'java', name: 'Java', ver: '21', href: '/lab/java' },
        { icon: 'typescript', name: 'TypeScript', ver: '5', href: '/lab/angular' },
        { icon: 'spring', name: 'Spring Boot', ver: '3.4', href: '/lab/java' },
        { icon: 'angular', name: 'Angular', ver: '20', href: '/lab/angular' },
        { icon: 'react', name: 'React', ver: '19', href: '/about' },
        { icon: 'postgres', name: 'PostgreSQL', ver: '17', href: '/lab/sql' },
        { icon: 'mysql', name: 'MySQL', ver: '8', href: '/lab/mysql-innodb' },
        { icon: 'redis', name: 'Redis', ver: '7', href: '/lab/redis-event-loop' },
      ].map((ext) => (
        <li class="sidebar-ext-item">
          <a
            href={ext.href}
            data-track-event="explorer-extension"
            class="flex w-full items-center gap-2 text-inherit no-underline hover:text-(--accent)"
          >
            <img
              src={`/static/icons/${ext.icon}.svg`}
              alt=""
              loading="lazy"
              class="h-4 w-auto shrink-0 rounded-sm bg-(--bg-alt) p-0.5"
            />
            <span>{ext.name}</span>
            <span class="text-(--fg-faint)">{ext.ver}</span>
            <span class="ext-check ml-auto" aria-hidden="true">☑</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</aside>