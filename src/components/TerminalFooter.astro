---
import LiveClock from '@/components/LiveClock';
import { GITHUB_USERNAME, GITHUB_REPO_PATH, HOST, V1_URL, REPO_DIR } from '@/lib/site';
import stats from '@/build-stats.json';

// build-stats.json is regenerated by scripts/build-stats.mjs on every `astro
// build` (loc/files from src+data, git short sha + branch, stargazers via the
// public GitHub REST API). LiveClock is the only client island here so the
// rest of the footer stays static SSR HTML.
const { stargazers, loc, files, commit, branch } = stats;
const v1 = import.meta.env.ASTRO_PUBLIC_V1_URL ?? V1_URL;
const fullCommit = (commit && commit !== '?' && `https://github.com/${GITHUB_REPO_PATH}/commit/${commit}`) || '';
---

<footer class="col-span-full border-t border-(--border) bg-(--terminal) text-[12px] leading-6 text-(--fg-faint)">
  <div class="grid grid-cols-[repeat(3,1fr)] items-start gap-x-6 px-4 py-2 max-lg:grid-cols-1 max-lg:gap-y-1">
    <div class="min-w-0">
      <p class="truncate max-lg:whitespace-normal max-lg:break-words">
        <span class="tip text-(--fg)" data-tip="GitHub profile">
          [{GITHUB_USERNAME}]@<span class="text-(--accent)">{HOST}</span>
        </span>
        {REPO_DIR}{' '}
        <a
          href={`https://github.com/${GITHUB_REPO_PATH}/stargazers`}
          target="_blank"
          rel="noopener noreferrer"
          class="tip text-(--fg-dim) hover:no-underline"
          data-tip="Stargazers"
        >
          (stargazers: {stargazers})
        </a>
      </p>
      <p class="truncate max-lg:whitespace-normal max-lg:break-words">
        <a href={fullCommit || undefined} class="tip text-(--fg-dim) hover:no-underline" data-tip={fullCommit ? `Cập nhật lúc build · ${commit}` : 'Cập nhật lúc build'}>
          <span class="text-(--accent-dim)">loc</span>: {loc.toLocaleString('en-US')} · <span class="text-(--accent-dim)">files</span>: {files.toLocaleString('en-US')}
        </a>
      </p>
    </div>
    <p class="min-w-0 truncate max-lg:whitespace-normal max-lg:break-words">
      <a
        href={fullCommit || undefined}
        class="tip text-(--accent) hover:no-underline"
        data-tip={fullCommit ? `commit ${commit} · click để xem` : 'commit'}
      >
        #{commit || '?'}
      </a>{' '}
      · Hà Nội <LiveClock client:load /> · <span class="tip text-(--fg-dim)" data-tip={`${branch} branch`}>{branch || '?'}</span>
    </p>
    <div class="flex min-w-0 items-center gap-1.5 justify-self-end max-lg:justify-self-start">
      <button
        id="toggle-theme"
        type="button"
        class="tip border border-(--border) px-2 py-0.5 text-(--fg-dim) hover:text-(--fg) hover:no-underline"
        data-tip="Light / Dark"
        aria-label="Toggle light/dark theme"
      >
        ◐
      </button>
      <a href="/" class="tip border border-(--border) px-2 py-0.5 text-(--fg) hover:no-underline" data-tip="main · Astro × npm">
        <span class="text-(--accent)">main</span> ✓
      </a>
      <a
        href={v1}
        class:list={['tip border border-(--border) px-2 py-0.5 text-(--fg-dim) hover:no-underline', v1 === '#' ? 'cursor-not-allowed' : '']}
        data-tip="v1 · Next.js × yarn"
        aria-disabled={v1 === '#' ? 'true' : undefined}
      >
        v1 · Next.js × yarn
      </a>
    </div>
  </div>
</footer>