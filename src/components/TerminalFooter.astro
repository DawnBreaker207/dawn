---
import { CURRENT_BRANCH, GITHUB_USERNAME, GITHUB_REPO_PATH, HOST, SITE_VERSIONS } from '@/lib/site';
import stats from '@/build-stats.json';

// build-stats.json is regenerated by scripts/build-stats.mjs on every `astro
// build`. Live parts (clock diff, commit-ago, version popover) run in
// app-shell.ts.
const { stargazers, commit, commitDate } = stats;
const fullCommit =
  (commit && commit !== '?' && `https://github.com/${GITHUB_REPO_PATH}/commit/${commit}`) || '';
const repoUrl = `https://github.com/${GITHUB_REPO_PATH}`;
---

<footer
  class="studio-statusbar flex min-w-0 items-center justify-between gap-2 border-t border-(--border) bg-(--bg-alt) px-3 font-mono text-[12px] text-(--fg-dim)"
>
  <div class="flex min-w-0 items-center gap-1 whitespace-nowrap">
    <a
      href="/lab/terminal"
      class="shrink-0 text-(--fg-faint) hover:text-(--fg)"
      aria-label="Open terminal"
      title="Open terminal"
    >
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
        <path d="M4 17l6-6-6-6M12 19h8" />
      </svg>
    </a>
    <a
      href="/help"
      class="shrink-0 text-(--fg-faint) hover:text-(--fg)"
      aria-label="Show help"
      title="Show help"
    >
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
        <circle cx="12" cy="12" r="9" />
        <path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 2.5-3 4" />
        <circle cx="12" cy="17.5" r="0.5" fill="currentColor" />
      </svg>
    </a>
    <a
      href="/rss.xml"
      target="_blank"
      rel="noopener noreferrer"
      class="shrink-0 text-(--fg-faint) hover:text-(--fg)"
      aria-label="RSS feed"
      title="Open RSS feed in a new tab"
    >
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
        <path d="M5 11a8 8 0 0 1 8 8" />
        <path d="M5 5a14 14 0 0 1 14 14" />
        <circle cx="6.5" cy="17.5" r="1.2" fill="currentColor" stroke="none" />
      </svg>
    </a>
    <span class="hidden shrink-0 text-(--fg-faint) lg:inline">{GITHUB_USERNAME}@[::1]:443</span>
    <span class="flex min-w-0 items-center">
      <span class="shrink-0 text-(--fg-faint)">~/</span>
      <a
        href={repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="min-w-0 truncate text-(--fg) underline decoration-(--border) underline-offset-3 hover:decoration-(--fg)"
        title={`View ${GITHUB_REPO_PATH} source on GitHub${stargazers ? `, ${stargazers.toLocaleString('en-US')} stars` : ''}`}
      >
        {GITHUB_REPO_PATH}
      </a>
    </span>
    <span class="hidden shrink-0 text-(--fg-faint) lg:inline">
      (stargazers: {stargazers.toLocaleString('en-US')})
    </span>
  </div>

  <div class="flex shrink-0 items-center gap-2 sm:gap-3">
    <a
      href={fullCommit || undefined}
      target="_blank"
      rel="noopener noreferrer"
      class="hidden whitespace-nowrap text-(--fg) underline decoration-(--border) underline-offset-3 hover:decoration-(--fg) md:inline"
      title="View last commit on GitHub"
      data-commit-time={commitDate}
    >
      #{commit || '?'} <span class="text-(--fg-dim)" data-commit-ago></span>
    </a>
    <span class="hidden text-(--fg-faint) md:inline" aria-hidden="true">·</span>

    <a
      href="https://time.is/Hanoi"
      target="_blank"
      rel="noopener noreferrer"
      class="whitespace-nowrap text-(--fg) underline decoration-(--border) underline-offset-3 hover:decoration-(--fg)"
    >
      Hanoi <span data-local-time>--:--</span><span class="ml-1 hidden text-(--fg-faint) sm:inline" data-local-time-diff></span>
    </a>
    <span class="text-(--fg-faint)" aria-hidden="true">·</span>

    <button
      id="toggle-theme"
      data-theme-toggle
      type="button"
      class="tip shrink-0 cursor-pointer px-1 text-(--fg-faint) hover:text-(--fg)"
      data-tip="Light / Dark"
      aria-label="Toggle light/dark theme"
    >
      ◐
    </button>

    <div class="version-menu" data-version-menu>
      <button
        type="button"
        class="version-trigger"
        data-version-trigger
        aria-haspopup="menu"
        aria-expanded="false"
        aria-label="Switch site version (git branch)"
        title="Switch site version"
      >
        <span class="git-branch-icon" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
            <path d="M9.5 3.25a2.25 2.25 0 1 1 3 2.122V6A2.5 2.5 0 0 1 10 8.5H6a1 1 0 0 0-1 1v1.128a2.251 2.251 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.493 2.493 0 0 1 6 7h4a1 1 0 0 0 1-1v-.628A2.25 2.25 0 0 1 9.5 3.25Zm-6 0a.75.75 0 1 0 1.5 0 .75.75 0 0 0-1.5 0Zm8.25-.75a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM4.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Z" />
          </svg>
        </span>
        <span class="hidden sm:inline">{CURRENT_BRANCH}</span>
        <svg class="version-caret" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 15l6-6 6 6" />
        </svg>
      </button>
      <div class="version-popover version-popover--right" data-version-popover role="menu" hidden>
        <div class="version-popover-title">Checkout version</div>
        {
          SITE_VERSIONS.map((version) => {
            const isCurrentSite = version.href === '/';
            const isExternal = !isCurrentSite && version.href.startsWith('http');
            return (
              <a
                href={version.href}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener noreferrer' : undefined}
                class="version-item"
                role="menuitem"
                data-version-item
                aria-current={version.current ? 'true' : undefined}
              >
                <span class="git-branch-icon" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
                    <path d="M9.5 3.25a2.25 2.25 0 1 1 3 2.122V6A2.5 2.5 0 0 1 10 8.5H6a1 1 0 0 0-1 1v1.128a2.251 2.251 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.493 2.493 0 0 1 6 7h4a1 1 0 0 0 1-1v-.628A2.25 2.25 0 0 1 9.5 3.25Zm-6 0a.75.75 0 1 0 1.5 0 .75.75 0 0 0-1.5 0Zm8.25-.75a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM4.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Z" />
                  </svg>
                </span>
                <span class="version-item-branch">{version.branch}</span>
                <span class="version-item-label">{version.label}</span>
                {version.current && <span class="version-item-check" aria-hidden="true">✓</span>}
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
</footer>